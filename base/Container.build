# droste-build-base-halo: TheRock gfx1151 ROCm SDK (rocm-sdk-devel) + toolchain for native builds

# Overrideable Arguments - General Build (override with '--build-arg <ARG_NAME>=<VALUE>'
ARG SERIES_NAME=droste
ARG ARCH_NAME=halo
ARG TARGET_NAME=build-base
ARG DESCRIPTION="TheRock gfx1151 ROCm SDK (rocm-sdk-devel) + toolchain"

# Image Names
ARG BASE_IMAGE=localhost/${SERIES_NAME}-runtime-base-${ARCH_NAME}

# Build image
FROM ${BASE_IMAGE}
ARG SERIES_NAME TARGET_NAME ARCH_NAME DESCRIPTION
LABEL description="${SERIES_NAME}-${TARGET_NAME}-${ARCH_NAME}: ${DESCRIPTION}"

# Host compilers + build tools & libraries
RUN apt-get -qq update && apt-get -qq install -y --no-install-recommends \
      gcc g++ make cmake ninja-build git patch rsync lld clang \
      libclang-dev libclang-rt-dev libcurl4-openssl-dev libomp-dev \
    && rm -rf /var/lib/apt/lists/* && apt-get clean

# TheRock ROCm SDK devel (amdclang++/hipcc, HIP headers, device bitcode, cmake configs).
# Versions come from the pin baked into the runtime base at /etc/droste/rocm-version.env.
#
# ⭐ FIRST STEP OF THE STAGED uv MIGRATION (s45). This file is deliberately first: it is
# BUILD-ONLY (never shipped to a user) and it is phase 1 of the CI matrix, so a failure
# is cheap and immediate. Half-migrated is a valid state — pip and uv produce the same
# venv, and the rest of the tree still uses pip.
# ✅ MEASURED BEFORE CHANGING, both tools against the real index (uv 0.12.5):
# they resolve the SAME three packages at the same version — rocm, rocm-sdk-core,
# rocm-sdk-devel, all 7.13.0a20260501.
# 🔧 `--prerelease` is NOT needed and is deliberately absent: the pin is an ALPHA
# (`7.13.0a…`), and uv accepts a prerelease whose specifier names it exactly, same as
# pip. Adding `--prerelease=allow` would also widen every DEPENDENCY to prereleases,
# which is a change pip never made here.
# 🔧 uv's `index-strategy` (default `first-index`) cannot bite on this line: there is
# ONE index, not an `--extra-index-url` pair.
# 🔧 uv finds /opt/venv via VIRTUAL_ENV, set as an image ENV in the runtime base — it
# does NOT follow PATH to a venv's pip the way this line used to rely on.
RUN . /etc/droste/rocm-version.env && \
      uv pip install --index-url ${ROCM_INDEX_URL} "rocm[devel]==${ROCM_SDK_DEVEL_VERSION}" && \
      rocm-sdk init

# Point /opt/rocm at the SDK root via `rocm-sdk path --root`
RUN ln -sfn "$(rocm-sdk path --root)" /opt/rocm

# Build env setup
ENV ROCM_PATH=/opt/rocm HIP_PATH=/opt/rocm \
    HIP_CLANG_PATH=/opt/rocm/lib/llvm/bin \
    HIP_DEVICE_LIB_PATH=/opt/rocm/lib/llvm/amdgcn/bitcode \
    CMAKE_PREFIX_PATH=/opt/rocm \
    PATH=/opt/venv/bin:/opt/rocm/bin:/opt/rocm/lib/llvm/bin:$PATH

# gfx1151-only. GFX_TARGET is NOT re-exported as an image ENV (that would be a second
# copy of the pin's truth): it lives in the inherited /etc/droste/rocm-version.env, and
# each carrier RUN sources that file to pass -DAMDGPU_TARGETS / --offload-arch.
