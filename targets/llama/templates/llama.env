# Removed upstream -- kept only to give a good error
# --------------------------------------------------
# These still parse, and every one of them exits with a message naming its
# replacement. They have no working value, so they are named here and are not
# offered as settings anywhere above.
#
#   flags:
#   --draft / --draft-n / --draft-max      -> --spec-draft-n-max
#   --draft-min / --draft-n-min            -> --spec-draft-n-min
#   --spec-ngram-size-n                    -> --spec-ngram-*-size-n
#   --spec-ngram-size-m                    -> --spec-ngram-*-size-m
#   --spec-ngram-min-hits                  -> --spec-ngram-*-min-hits


# Text-to-speech -- this box serves no vocoder model
# --------------------------------------------------
# Nothing here fails; there is simply no vocoder in the image for them to
# drive. --tts-oute-default is left out of the automatic-model menu above for
# the same reason.
#
#   flags:
#   --tts-use-guide-tokens  -mv  --model-vocoder  --tts-oute-default


