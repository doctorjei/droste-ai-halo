# droste-vllm-build: builds vLLM (flash-attention, aiter, vLLM wheels) against pinned TheRock SDK

# Overrideable Arguments - General Build (override with '--build-arg <ARG_NAME>=<VALUE>'
ARG SERIES_NAME=droste
ARG ARCH_NAME=halo
ARG TARGET_NAME=vllm-build
ARG BUILDER_DESC="builder image for vLLM (flash-attention, aiter, vLLM wheels)"
ARG DESCRIPTION="compiled outputs for vLLM image"

# Image Names
ARG BASE_IMAGE=localhost/${SERIES_NAME}-build-base-${ARCH_NAME}

# Build image
FROM ${BASE_IMAGE} AS builder
ARG SERIES_NAME TARGET_NAME ARCH_NAME BUILDER_DESC
LABEL description="${SERIES_NAME}-${TARGET_NAME}-${ARCH_NAME}: ${BUILDER_DESC}"

# ROCm Pin: inherited from the build base as /etc/droste/rocm-version.env; every RUN
# below that needs a version or the gfx target sources it (no ARG, no --build-arg).

# Pinned Dependencies
ARG FLASH_ATTENTION_REPO=https://github.com/ROCm/flash-attention.git
ARG FLASH_ATTENTION_BRANCH=main_perf
ARG FLASH_ATTENTION_REF=3f94643fb41bcedded28c85185a8e11d42ef1592
ARG VLLM_REPO=https://github.com/vllm-project/vllm.git
ARG VLLM_REF=v0.16.0
ARG FP8_KERNELS_REPO=https://github.com/leonyurko/vllm-fp8-strix-halo-kernel-support.git
ARG FP8_KERNELS_REF=50424f5525b8382353551e3301d0da56eca0be2b

# Install Torch
# uv (staged migration, s45 — this is a BUILD-ONLY image, never shipped). ✅ MEASURED
# against the real index before changing: uv resolves `torch==<pin>+rocm…` to the same
# 14 packages pip does, including triton+rocm and rocm-sdk-libraries — the LOCAL VERSION
# IDENTIFIER is handled identically, and no `--pre` is required (2.9.1 is a final release;
# the `+rocm…` part is local metadata, not a prerelease).
RUN . /etc/droste/rocm-version.env \
    && uv pip install --index-url ${ROCM_INDEX_URL} "torch==${TORCH_VERSION}"

# Python build backends. These are what the `uv build --no-build-isolation` steps below
# compile against, so they must land in the SAME venv — they do: uv finds /opt/venv via
# VIRTUAL_ENV (an image ENV from the runtime base), it does not follow PATH. Measured s46:
# that holds for `uv build` too, not just `uv pip` — the build backend is executed by the
# VIRTUAL_ENV interpreter even when the venv is off PATH entirely.
RUN uv pip install --upgrade \
      cmake ninja packaging wheel numpy "setuptools-scm>=8" "setuptools<80.0.0" \
      scikit-build-core pybind11 numba scipy

# Flash attention
ENV FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE \
    LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/lib64:$LD_LIBRARY_PATH

COPY patch_aiter_headers.py /opt/patch_aiter_headers.py

# THE RUN BELOW IS uv, NOT pip — migrated s46 (plan items 1 and 2). The claims that once
# kept it on pip were BOTH FALSE, and the retraction stays here so nobody re-derives them:
#   * "uv has NO `pip wheel` equivalent" — FALSE. I ran `uv pip --help`, saw no `wheel`
#     subcommand, and generalised. Wheel-building lives under a DIFFERENT VERB:
#     `uv build --wheel --no-build-isolation -o <dir> <src>`. `uv pip --help` is not
#     `uv --help`.
#   * "`--force-reinstall` maps to uv's broader `--reinstall`" — beside the point:
#     `--reinstall-package <NAME>` exists and is NARROWER than pip's flag.
# ✅ MEASURED against uv 0.12.5 before the swap, worst risk first:
#   * the backend runs under $VIRTUAL_ENV's interpreter (image ENV from the runtime base)
#     even with that venv off PATH ⇒ it compiles against the torch installed above;
#   * uv and pip emit the SAME wheel filename (both delegate naming to the backend), so
#     the `amd_aiter*.whl` / `flash_attn*.whl` / `vllm*.whl` globs still match — this was
#     the one difference that would have broken the chain;
#   * a setup.py-only project with NO pyproject.toml builds fine (ROCm/flash-attention is
#     exactly that shape at our pin);
#   * `--no-build-isolation` is equally lax in both — neither installer enforces
#     build-system.requires under it, which aiter needs (its requires name flydsl, psutil
#     and pandas, none of them installed here, and that is true of pip today too).
# ⚠️ `--reinstall-package` takes the DISTRIBUTION name, not the wheel filename:
# `amd-aiter`, read from aiter's own `setup.py` (`PACKAGE_NAME = "amd-aiter"`) at the
# pinned submodule commit — do not infer it from `amd_aiter*.whl`.
# 🚨 AND A WRONG NAME DOES NOT FAIL LOUDLY: measured, `--reinstall-package <wrong>` on an
# already-installed package is a SILENT no-op ("Checked 1 package", nothing installed).
# Harmless at THIS site — aiter is not installed before this line, so the wheel installs
# as a direct requirement either way — but never trust the flag to police its own name.
# `--no-deps` has no counterpart and needs none: `uv build` builds this project only.
#
# ── TWO MUTATIONS OF UPSTREAM SOURCE IN THIS CHAIN, BOTH GUARDED ──────────────
#
# 1. patch_aiter_headers.py — the SAME script the runtime stage runs, against the
#    aiter installed into THIS venv. The guard is a VERBATIM copy of the one in
#    targets/Container.vllm (only the script path differs: /opt here, parked under
#    /opt/resources/scripts/ there). Verbatim is the point — a header rewrite that
#    is policed in one stage and unpoliced in the other is the same silent no-op
#    wearing a different hat. Rationale for every line of it lives beside the
#    runtime copy; read that block, not a paraphrase here.
#    ⚠️ Why it matters HERE and not only there: this venv's headers are what
#    aiter's JIT compiles against for the module_aiter_enum.so staged into
#    /artifacts, which the runtime image drops in verbatim.
#
# 2. THE flash-attention setup.py EDIT, which deletes the block that pip-installs
#    third_party/aiter from source during the wheel build. We built and
#    header-patched aiter above; letting setup.py rebuild it would discard both.
#    🚨 A BARE re.sub CANNOT FAIL: it returns its input unchanged on no match and
#    exits 0. And the pattern is unusually fragile — two lazy [\s\S]*? runs
#    spanning ~9 lines, an else: branch and an assert — so it has THREE distinct
#    ways to go wrong, and the counts alone catch only one:
#      * no match at all            -> re.subn n == 0 (the `n == 1` check);
#      * match stops SHORT (e.g. a reflow puts `check=True,` on the git-submodule
#        call) -> n is still 1, but the pip install SURVIVES. Caught by the
#        after-count of `third_party/aiter` being 0, not by n;
#      * match runs PAST the block -> also n == 1, also 0 mentions left. Caught by
#        requiring the ck-backend branch to survive.
#    The REACHABILITY half is the FLASH_ATTENTION_TRITON_AMD_ENABLE line: that env
#    var (exported above) is the only thing selecting ROCM_BACKEND == "triton", and
#    the block being removed lives under that gate. If upstream renames it, our
#    export stops selecting the branch, the deletion becomes unread, and the build
#    quietly switches to the ck backend.
#    ⚠️ PERMANENT, NOT A STOPGAP: this is a local build decision, not a defect
#    anyone upstream would take a patch for. Nobody is watching for it to become
#    unnecessary, so this guard is the only thing that will ever report the drift.
#    ⚠️ Continuation lines are at column 0 on purpose — same idiom as
#    targets/Container.finetuning's multi-line `python -c`. The Dockerfile parser
#    joins them; leading indentation would be an IndentationError if it ever did not.
RUN mkdir -p /artifacts/wheels \
    && git clone "${FLASH_ATTENTION_REPO}" /opt/flash-attention \
    && cd /opt/flash-attention \
    && if [ -n "${FLASH_ATTENTION_REF}" ]; then git checkout "${FLASH_ATTENTION_REF}"; \
       else git checkout "${FLASH_ATTENTION_BRANCH}"; fi \
    && git submodule update --init third_party/aiter \
    && cd third_party/aiter \
    && git submodule update --init 3rdparty/composable_kernel \
    && export CK_DIR="$(pwd)/3rdparty/composable_kernel" \
    && uv build --wheel --no-build-isolation -o /artifacts/wheels . \
    && uv pip install --reinstall-package amd-aiter /artifacts/wheels/amd_aiter*.whl \
    && AITER_INC="$(python -c 'import sysconfig,os; print(os.path.join(sysconfig.get_path("purelib"),"aiter_meta","csrc","include"))')" \
    && sh -c ' \
        die() { echo "aiter-headers: FATAL: $*" >&2; \
                echo "aiter-headers: patch_aiter_headers.py OVERWRITES two upstream aiter headers" >&2; \
                echo "aiter-headers: WHOLESALE and RETURNS 0 WHETHER OR NOT IT WROTE ANYTHING -- a" >&2; \
                echo "aiter-headers: missing include dir or a renamed header makes it a silent no-op." >&2; \
                echo "aiter-headers: Without those RDNA3 fallbacks, gfx1151 has no scalar substitutes" >&2; \
                echo "aiter-headers: for the CDNA-only packed ISA aiter emits, and the failure appears" >&2; \
                echo "aiter-headers: at RUNTIME in a JIT-compiled kernel, not in this build." >&2; \
                echo "aiter-headers: READ the aiter tree at the pinned flash-attention submodule and" >&2; \
                echo "aiter-headers: re-derive the paths/markers in patch_aiter_headers.py. Do NOT" >&2; \
                echo "aiter-headers: delete this check to go green." >&2; \
                exit 1; }; \
        [ -d "$1" ] || die "$1 is not a directory -- aiter did not install, or its wheel layout moved"; \
        [ -f "$1/ck_tile/vec_convert.h" ] || die "$1/ck_tile/vec_convert.h is gone -- the header was renamed or moved"; \
        [ -f "$1/hip_reduce.h" ] || die "$1/hip_reduce.h is gone -- the header was renamed or moved"; \
        n=$(grep -rlF "vec_convert.h" "$1" | wc -l); \
        [ "$n" -ge 1 ] || die "nothing under $1 includes vec_convert.h -- rewriting it would be a silent no-op"; \
        n=$(grep -rlF "hip_reduce.h" "$1" | wc -l); \
        [ "$n" -ge 1 ] || die "nothing under $1 includes hip_reduce.h -- rewriting it would be a silent no-op"; \
        python /opt/patch_aiter_headers.py || die "patch_aiter_headers.py exited nonzero"; \
        grep -qF "CK_TILE_RDNA3_NO_PK_FP8" "$1/ck_tile/vec_convert.h" \
          || die "vec_convert.h carries no CK_TILE_RDNA3_NO_PK_FP8 after patching -- it was NOT rewritten"; \
        grep -qF "AITER_RDNA_NO_DPP_BCAST" "$1/hip_reduce.h" \
          || die "hip_reduce.h carries no AITER_RDNA_NO_DPP_BCAST after patching -- it was NOT rewritten"; \
        echo "aiter-headers: both RDNA3 fallback headers rewritten and verified"; \
       ' _ "${AITER_INC}" \
    && cd /opt/flash-attention \
    && python -c "\
import re, sys, os; \
f = 'setup.py'; \
T = '\nflash-attn-aiter: The pinned ROCm/flash-attention no longer matches what this edit\nflash-attn-aiter: assumes. READ setup.py at the CURRENT FLASH_ATTENTION_REF and RE-DERIVE the\nflash-attn-aiter: pattern AND the counts here against what you actually find there. Do NOT\nflash-attn-aiter: delete this check to go green, and do NOT go back to a bare re.sub: re.sub\nflash-attn-aiter: returns its input UNCHANGED on no match and exits 0, so the wheel build\nflash-attn-aiter: would then pip-install third_party/aiter FROM SOURCE, silently discarding\nflash-attn-aiter: the aiter wheel built and header-patched above -- i.e. shipping the stock\nflash-attn-aiter: CDNA-only kernels that gfx1151 cannot run.'; \
os.path.isfile(f) or sys.exit('flash-attn-aiter: FATAL: ' + f + ' does not exist -- the project layout moved.' + T); \
t = open(f).read(); \
'pass # patched' not in t or sys.exit('flash-attn-aiter: FATAL: ' + f + ' already carries the replacement -- refusing to patch twice.' + T); \
t.count('ROCM_BACKEND = \"triton\" if os.getenv(\"FLASH_ATTENTION_TRITON_AMD_ENABLE\", \"FALSE\") == \"TRUE\" else \"ck\"') == 1 or sys.exit('flash-attn-aiter: FATAL: setup.py no longer selects the triton backend from FLASH_ATTENTION_TRITON_AMD_ENABLE, which this image exports -- the block being removed would never RUN, so removing it is a silent no-op.' + T); \
t.count('    if ROCM_BACKEND == \"triton\":\n        if os.path.isdir(\".git\"):\n') == 1 or sys.exit('flash-attn-aiter: FATAL: the aiter block no longer sits directly under the triton-backend gate in setup.py -- it may have moved out from under the gate our env var selects.' + T); \
t.count('third_party/aiter') == 4 or sys.exit('flash-attn-aiter: FATAL: expected exactly 4 third_party/aiter mentions in setup.py before patching, found ' + str(t.count('third_party/aiter')) + '.' + T); \
r = re.subn(r'subprocess\.run\([\s\S]*?third_party/aiter[\s\S]*?check=True,\s*\)', 'pass # patched', t); \
r[1] == 1 or sys.exit('flash-attn-aiter: FATAL: the aiter-build pattern matched ' + str(r[1]) + ' spans, expected exactly 1.' + T); \
r[0].count('third_party/aiter') == 0 or sys.exit('flash-attn-aiter: FATAL: ' + str(r[0].count('third_party/aiter')) + ' third_party/aiter mention(s) SURVIVED -- the lazy match stopped SHORT of the pip install, so setup.py still builds aiter from source.' + T); \
r[0].count('pass # patched') == 1 or sys.exit('flash-attn-aiter: FATAL: expected exactly 1 replacement marker after patching.' + T); \
'\n            pass # patched\n' in r[0] or sys.exit('flash-attn-aiter: FATAL: the replacement did not land as a whole statement at the original 12-space indentation -- the match began mid-line.' + T); \
r[0].count('elif ROCM_BACKEND == \"ck\":') == 1 or sys.exit('flash-attn-aiter: FATAL: the ck-backend branch did not survive -- the lazy match ran PAST the aiter block and swallowed code this edit must not touch.' + T); \
open(f, 'w').write(r[0]); \
print('flash-attn-aiter: setup.py no longer builds third_party/aiter (1 span replaced, 0 mentions left)')" \
    && uv build --wheel --no-build-isolation -o /artifacts/wheels .

# vLLM
RUN apt-get -qq update && apt-get -qq install -y --no-install-recommends \
      rustc cargo python3.13-dev libdrm-dev && rm -rf /var/lib/apt/lists/* && apt-get clean \
      && uv pip install "setuptools-rust>=1.9.0"

# Prebuild aiter's import-time JIT module for the RUNTIME image. `import aiter` evaluates
# aiter/ops/enum.py at module scope, which JIT-compiles module_aiter_enum (a single CPU-only
# pybind11 .cu) — and the runtime image ships NO compiler by design, so it must arrive
# prebuilt. Only this module builds on a bare import (every other op is lazy, built on first
# call), so the import IS the narrowest possible trigger: aiter's official PREBUILD_KERNELS
# hook is coarser — even its smallest mode (3) also codegens module_fmha_v3* for gfx1151.
# Deliberately placed BELOW the vLLM apt layer, not up with aiter: it is the first thing in
# this stage that compiles a pybind11 module, so it is the first to need `Python.h`, and
# python3.13-dev arrives in that layer (nothing above it compiles against Python — aiter's
# wheel is pure packaging and flash-attn skips its C++ extension under Triton). CI run
# 31849687656 is the receipt: hipcc -isystem /usr/include/python3.13 -> file not found.
# The other two compilers it needs are already here: g++ (aiter's cpp_extension probes `c++`)
# and hipcc (the source is a .cu, so device bitcode is demanded even though the module is
# host-only). GPU_ARCHS is pinned because aiter's "native" default shells out to rocminfo,
# and no CI runner has a GPU. The .so is staged into /artifacts for the runtime to drop in.
# NB `find -L`: /opt/rocm is a SYMLINK to the SDK root, and find(1) does not descend into a
# symlinked start point unless told to — the bare `find` in the vLLM step below therefore
# yields "" (harmless there: it compiles with /opt/rocm/lib/llvm/bin/clang, which self-locates
# its bitcode). Plain `hipcc` does not, so here the path must actually resolve; `test -n`
# keeps an empty result from silently reaching hipcc as the ROCm-device-library error.
RUN . /etc/droste/rocm-version.env \
    && export HIP_DEVICE_LIB_PATH="$(find -L /opt/rocm -type d -name bitcode -print -quit)" \
    && test -n "${HIP_DEVICE_LIB_PATH}" \
    && GPU_ARCHS="${GFX_TARGET}" python -c "import aiter" \
    && mkdir -p /artifacts/aiter-jit \
    && cp /opt/venv/lib*/python*/site-packages/aiter/jit/*.so /artifacts/aiter-jit/ \
    && test -f /artifacts/aiter-jit/module_aiter_enum.so \
    && ls -l /artifacts/aiter-jit

COPY patch_strix.py       /opt/patch_strix.py
COPY patch_fp8_kernels.py /opt/patch_fp8_kernels.py
RUN git clone "${VLLM_REPO}" /opt/vllm \
    && cd /opt/vllm \
    && if [ -n "${VLLM_REF}" ]; then git checkout "${VLLM_REF}"; fi \
    && cp /opt/patch_strix.py /opt/patch_fp8_kernels.py . \
    && python patch_strix.py \
    && python patch_fp8_kernels.py

# Build the vLLM wheel
ENV ROCM_HOME=/opt/rocm \
    HIP_PATH=/opt/rocm \
    HIP_PLATFORM=amd \
    VLLM_TARGET_DEVICE=rocm \
    MAX_JOBS=4 \
    CC=/opt/rocm/lib/llvm/bin/clang \
    CXX=/opt/rocm/lib/llvm/bin/clang++
# The THREE ARCH VARIABLES ARE DELIBERATELY NOT `ENV`. `ENV` cannot source a file, so a
# literal gfx1151 up here would be a second source of truth beside GFX_TARGET in
# /etc/droste/rocm-version.env — exactly what base/Container.build refuses to create by
# not re-exporting GFX_TARGET as an image ENV. They are exported inside the build RUN
# instead, which is the idiom the other four builder files already use. Safe: nothing
# after this stage reads them (the final carrier is FROM scratch, and the aiter step
# above passes GPU_ARCHS itself).
RUN . /etc/droste/rocm-version.env \
    && export PYTORCH_ROCM_ARCH="${GFX_TARGET}" \
              HIP_ARCHITECTURES="${GFX_TARGET}" \
              AMDGPU_TARGETS="${GFX_TARGET}" \
    && cd /opt/vllm \
    && export HIP_DEVICE_LIB_PATH="$(find /opt/rocm -type d -name bitcode -print -quit)" \
    && echo "Compiling vLLM for ${GFX_TARGET} with bitcode: ${HIP_DEVICE_LIB_PATH}, clang: ${CC}" \
    && export CMAKE_ARGS="-DROCM_PATH=/opt/rocm -DHIP_PATH=/opt/rocm -DAMDGPU_TARGETS=${GFX_TARGET} -DHIP_ARCHITECTURES=${GFX_TARGET}" \
    && uv build --wheel --no-build-isolation -o /artifacts/wheels .

# Pure-python FP8 Triton kernels (leonyurko)
RUN git clone "${FP8_KERNELS_REPO}" /artifacts/fp8 \
    && cd /artifacts/fp8 && git checkout "${FP8_KERNELS_REF}" \
    && rm -rf /artifacts/fp8/.git

RUN echo "=== /artifacts/wheels ===" && ls -1 /artifacts/wheels

# --- Final carrier: ONLY the wheels + FP8 kernel tree
FROM scratch
ARG SERIES_NAME TARGET_NAME ARCH_NAME DESCRIPTION
LABEL description="${SERIES_NAME}-${TARGET_NAME}-${ARCH_NAME}: ${DESCRIPTION}"
COPY --from=builder /artifacts /artifacts
