# vllm.env -- vLLM environment configuration (half of box's config surface).
#
# Everything ships commented out; uncomment a line to set it. This box has two
# config files to accommodate vLLM's two types of settings:
#
#   /opt/data/vllm_config.yaml   FLAGS. Every `vllm serve` flag is a key; it
#                                includes model, memory, & scheduler settings.
#
#   /opt/data/vllm.env  (this)   ENVIRONMENT VARIABLES. These cannot be stored
#                                in YAML; many are read before YAML is parsed.
#
# When there is a flag variant, the flag typically takes precedence. Descriptions
# follow upstream documents at the pinned commit with notes for clarity where
# practical; they are not necessarily identical to upstream documentation.
#
# Reserved by Droste (do not set these)
# -------------------------------------
# Droste needs these arguments to remain unchanged for setup & teardown;
# changes are likely to break the box boot, services, and/or functionality.
#
#   --config, --port, DROSTE_VLLM_CONFIG, VLLM_TARGET_DEVICE
#
#
# Extra Arguments
# ---------------
# "Catch-all" for user-elected arguments. Note that vLLM incorporates YAML keys
# first; these settings OVERRIDE keys in vllm_config.yaml. "Mix & match" with
# YAML settings may cause boot failure due to exclusions, so users should
# confirm there are no conflicts in advance. vLLM logs duplicates as well. Other
# arguments reachable only via this setting are lists near this file's end.
#
# Entry should be one quoted value, to be split into separate arguments shell
# style, so an argument MAY contain spaces if you quote it; the value is never
# glob-expanded or re-evaluated.
#
# VLLM_EXTRA_ARGS="--attention-backend TRITON_ATTN --enforce-eager"


# ===============
#  MAIN SETTINGS
# ===============

# Model Sources
# -------------
# HF_TOKEN=                        # Token for HuggingFace (gated repos, etc) <!-- we need to fix this one way or another; if the default is passthrough, we need a way to show that value in the default. -->
# VLLM_MODEL_REDIRECT_PATH=        # File mapping repo IDs to local paths
#
# AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID-}          # S3 ID
# AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY-}  # S3 Key
# AWS_ENDPOINT_URL=${AWS_ENDPOINT_URL-}            # S3 URL
#
# These are botocore's names -- the ones every S3 path here reads (tensorizer,
# the Run:ai streamer, boto3); AWS_ENDPOINT_URL_S3 outranks AWS_ENDPOINT_URL
# where both are read. vLLM's own S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY /
# S3_ENDPOINT_URL are read and then dropped upstream, so they do nothing and are
# not offered. Credentials for a SINGLE load go on a flag instead:
# --model-loader-extra-config '{"s3_access_key_id": "...", "s3_endpoint": "..."}'
#
# {yes, no*}
# DROSTE_VLLM_HF_HUB_OFFLINE=no    # HuggingFace Hub in offline mode
# DROSTE_VLLM_USE_MODELSCOPE=no    # Use ModelScope instead of HuggingFace


# LoRA adapters
# -------------
# VLLM_LORA_RESOLVER_CACHE_DIR=        # local path for unknown LoRA adapters
# VLLM_LORA_RESOLVER_HF_REPO_LIST=     # remote HF repo(s) for LoRA adapters
#
# {yes, no*}
# DROSTE_VLLM_RT_LORA_UPDATES_OK=no    # Loading/unloading LoRAs at runtime


# Caches & Config
# ---------------
# VLLM_ASSETS_CACHE=${XDG_CACHE_HOME:-~/.cache}/vllm/assets
# VLLM_CACHE_ROOT=${XDG_CACHE_HOME:-~/.cache}/vllm
# VLLM_CONFIG_ROOT=${XDG_CONFIG_HOME:-~/.config}/vllm
#
# {yes, no}
# DROSTE_VLLM_USE_TRITON_AWQ=yes            # The five AWQ stanzas rely on this
# DROSTE_VLLM_DISABLE_COMPILE_CACHE=yes     # No persisted torch.compile graphs
# DROSTE_VLLM_ASSETS_CACHE_MODEL_CLEAN=no   # Clean model file in assets cache
# DROSTE_VLLM_V1_USE_OUTLINES_CACHE=no      # Outlines cache (unbounded/unsafe)
#
# {MiB}
# VLLM_XGRAMMAR_CACHE_MB=512


# Server liveness & timeouts
# --------------------------
# VLLM_ENGINE_READY_TIMEOUT_S=600   # Timeout for engine core(s) at startup
# VLLM_HTTP_TIMEOUT_KEEP_ALIVE=5    # Timeout for HTTP API connections
# VLLM_PLUGINS=    # List (comma-separated); unset -> load all; blank -> none.
#
# {yes, no*}
# DROSTE_VLLM_KEEP_ALIVE=no          # Keep server after AsyncLLMEngine errors


# Engine internals & throughput
# -----------------------------
# VLLM_ENABLE_V1_MULTIPROCESSING=1
# VLLM_RINGBUFFER_WARNING_INTERVAL=60
# VLLM_PROCESS_NAME_PREFIX=VLLM
# VLLM_RPC_BASE_PATH=                   # Default: temp dir; frontend<->engine ipc
# VLLM_OBJECT_STORAGE_SHM_BUFFER_NAME=  # Default: computed at runtime (uuid)
#
# VLLM_ROCM_SLEEP_MEM_CHUNK_SIZE=256    # Chunks (MiB) for sleeping allocations
# VLLM_V1_OUTPUT_PROC_CHUNK_SIZE=128    # Requests per asyncio output task
# VLLM_MSGPACK_ZERO_COPY_THRESHOLD=256  # Bytes; larger tensors sent separately
# VLLM_MQ_MAX_CHUNK_BYTES_MB=16         # RPC message queue chunk cap (MiB)
#
# {fork*, spawn}
# VLLM_WORKER_MULTIPROC_METHOD=fork
#
# {highest*, high, medium}
# VLLM_FLOAT32_MATMUL_PRECISION=highest    # float32 matrix precision (workers)


# ========
#  TUNING
# ========

# General
# -------
# VLLM_TUNED_CONFIG_FOLDER=
# VLLM_DISABLED_KERNELS=
#
# {on, off*}
# DROSTE_VLLM_LONG_MAX_MODEL_LEN_OK=off    # Can cause NaN values; be cautious
# DROSTE_VLLM_STRIX_FP8_TRITON=off         # Current data suggests off is better


# ROCM-Specific Per-Kernel Toggles
# --------------------------------
# {on*, off}
# DROSTE_VLLM_ROCM_FP8_PADDING=on
# DROSTE_VLLM_ROCM_MOE_PADDING=on
# DROSTE_VLLM_ROCM_CUSTOM_PAGED_ATTN=on


# Idle Behaviour & Timeouts
# -------------------------
# VLLM_RPC_TIMEOUT=10000
# VLLM_ENGINE_ITERATION_TIMEOUT_S=60
#
# {yes, no*}
# DROSTE_VLLM_SLEEP_WHEN_IDLE=no


# Security & Telemetry
# --------------------
# VLLM_API_KEY=                    # --api-key; one API key. /health is exempt.
# VLLM_USAGE_SOURCE=production
# VLLM_USAGE_STATS_SERVER=https://stats.vllm.ai
#
# {yes, no}
# DROSTE_VLLM_DO_NOT_TRACK=yes     # Covers VLLM_{DO_NOT_TRACK, NO_USAGE_STATS}
# DROSTE_VLLM_INSEC_SERIAL_OK=no   # Allow pickling for serialization


# API, Tool Calling, & Parsing
# ----------------------------
# VLLM_GPT_OSS_SYSTEM_TOOL_MCP_LABELS=           # Default: computed at runtime
# DROSTE_VLLM_TOOL_PARSE_REGEX_TIMEOUT_SECONDS=1
#
# {on, off*}
# DROSTE_VLLM_RESPONSES_API_STORE=off
#
# {yes, no}
# DROSTE_VLLM_TOOL_JSON_ERROR_AUTOMATIC_RETRY=no
# DROSTE_VLLM_GPT_OSS_HARMONY_SYSTEM_INSTRUCTIONS_OK=no


# MoE Models
# ----------
# VLLM_SHARED_EXPERTS_STREAM_TOKEN_THRESHOLD=256
#
# {tokens}
# VLLM_FUSED_MOE_CHUNK_SIZE=16384
# VLLM_MOE_DP_CHUNK_SIZE=256
#
# {on*, off}
# DROSTE_VLLM_FUSED_MOE_GROUPED_TOPK=on
# DROSTE_VLLM_FUSED_MOE_ACTIVATION_CHUNKING=on
# DROSTE_VLLM_MOE_DP_CHUNK=on
# DROSTE_VLLM_SHARED_EXPERTS_STREAM=on


# KV Cache & Attention
# --------------------
# Q_SCALE_CONSTANT=200
# K_SCALE_CONSTANT=200
# V_SCALE_CONSTANT=100
#
# {auto*, NHD, HND}
# DROSTE_VLLM_KV_CACHE_LAYOUT=auto
#
# {yes, no}
# DROSTE_VLLM_USE_MLA=yes
# DROSTE_VLLM_ROCM_FP8_MFMA_PAGE_ATTN=no
# DROSTE_VLLM_CHUNKED_LOCAL_ATTN_WITH_HYBRID_KV_CACHE_OK=yes


# Multimodal Input
# ----------------
# VLLM_IMAGE_FETCH_TIMEOUT=5               # Timeout for image fetching
# VLLM_VIDEO_FETCH_TIMEOUT=30              # Timeout for video fetching
# VLLM_AUDIO_FETCH_TIMEOUT=10              # Timeout for audio fetching
# VLLM_MEDIA_LOADING_THREAD_COUNT=8        # Max worker count, media threadpool
# VLLM_MAX_AUDIO_CLIP_FILESIZE_MB=25       # Maximum file size (MiB)
#
# {yes*, no}
# DROSTE_VLLM_MEDIA_REDIRECTS_OK=yes       # Allow HTTP redirects for fetching?
#
# {opencv*, opencv_dynamic, molmo2}
# DROSTE_VLLM_VIDEO_LOAD_BACKEND=opencv    # Video loader backend
#
# {http*}
# VLLM_MEDIA_CONNECTOR=http                # Yes, really only one option.
#
# {blake3*, sha256, sha512}
# VLLM_MM_HASHER_ALGORITHM=blake3


# Multi-Node Serving
# ------------------
# CUDA_VISIBLE_DEVICES=
# DROSTE_VLLM_LD_LIBRARY_PATH_ADD=
# LOCAL_RANK=0
#
# **NOTE: These are *not* single-node configurations, despite misleading names!
# VLLM_PORT=           # In distributed setup, manually sets node's port.
# VLLM_HOST_IP=        # In distributed setup, determines current node's IP
# VLLM_LOOPBACK_IP=    # Forces setup of loopback IP
#
# VLLM_DP_MASTER_PORT=0
# VLLM_DP_MASTER_IP=127.0.0.1
# VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=300
#
# VLLM_DP_RANK_LOCAL=0    # Defaults to VLLM_DP_RANK
# VLLM_DP_RANK=0
# VLLM_DP_SIZE=1
# VLLM_NCCL_SO_PATH=                          # Path to the NCCL library file
# VLLM_PP_LAYER_PARTITION=
# VLLM_RAY_BUNDLE_INDICES=
# VLLM_RAY_PER_WORKER_GPUS=1.0
#
# {strict*, fill, span}
# VLLM_RAY_DP_PACK_STRATEGY=strict
#
# {auto*, nccl, shm}
# VLLM_USE_RAY_COMPILED_DAG_CHANNEL_TYPE=auto
#
# {on, off}
# DROSTE_VLLM_PYNCCL=on
# DROSTE_VLLM_P2P_CHECK=off
# DROSTE_VLLM_RANDOMIZE_DP_DUMMY_INPUTS=off
# DROSTE_VLLM_RAY_COMPILED_DAG_OVERLAP_COMM=off
# DROSTE_VLLM_RAY_WRAPPED_PP_COMM=on


# Disaggregated prefill / KV transfer (also multi-node)
# -----------------------------------------------------
# VLLM_NIXL_SIDE_CHANNEL_HOST=localhost    # Address for NIXL handshake
# VLLM_NIXL_SIDE_CHANNEL_PORT=5600
# VLLM_NIXL_ABORT_REQUEST_TIMEOUT=480
# VLLM_MOONCAKE_BOOTSTRAP_PORT=8998
# VLLM_MOONCAKE_ABORT_REQUEST_TIMEOUT=480
# VLLM_MORIIO_CONNECTOR_READ_MODE=False
# VLLM_MORIIO_QP_PER_TRANSFER=1
# VLLM_MORIIO_POST_BATCH_SIZE=-1
# VLLM_MORIIO_NUM_WORKERS=1
# VLLM_KV_EVENTS_USE_INT_BLOCK_HASHES=1


# Compilation & startup cost
# --------------------------
# {binary*, unpacked}
# VLLM_COMPILE_CACHE_SAVE_FORMAT=binary
#
# {auto*, on, off}
# DROSTE_VLLM_AOT_COMPILE=auto    # auto: computed at runtime
#
# {on, off}
# DROSTE_VLLM_FORCE_AOT_LOAD=off
# DROSTE_VLLM_MEGA_AOT_ARTIFACT=off
# DROSTE_VLLM_INDUCTOR_MAX_AUTOTUNE=on
# DROSTE_VLLM_INDUCTOR_COORDINATE_DESCENT_TUNING=on
# DROSTE_VLLM_STANDALONE_COMPILE=on
# DROSTE_VLLM_BYTECODE_HOOK=on



# =========================
#  DEBUGGING & DEVELOPMENT
# =========================

# Logging
# -------
# VLLM_LOGGING_CONFIG_PATH=
# VLLM_LOG_STATS_INTERVAL=10.
# VLLM_LOG_BATCHSIZE_INTERVAL=-1
#
# {on, off}
# DROSTE_VLLM_CONFIGURE_LOGGING=on
# DROSTE_VLLM_DEBUG_LOG_API_SRV_RESP=off
# DROSTE_VLLM_LOG_LOGO=on
#
# {debug, info*, warning, warn, error, critical, fatal, notset}
# DROSTE_VLLM_LOGGING_LEVEL=info
#
# {auto*, always, never}
# DROSTE_VLLM_LOGGING_COLOR=auto
#
# {stdout*, stderr, traceback}
# DROSTE_VLLM_LOGGING_STREAM=stdout
#
# {<LogRecord-formatted string>}
# VLLM_LOGGING_PREFIX=""            # log fmt:"<prefix><levelname> %(asctime)s"
#
# Logs are formatted in Python LogRecord format; more info at:
# https://docs.python.org/3/library/logging.html#logrecord-attributes


# Tracing & Diagnostics
# ---------------------
# DROSTE_VLLM_DEBUG_DUMP_PATH=
# DROSTE_VLLM_PATTERN_MATCH_DEBUG=        # Node name to match
#
# {on, off*}
# DROSTE_VLLM_TRACE_FUNCTION=off
# DROSTE_VLLM_GC_DEBUG=off
# DROSTE_VLLM_DEBUG_WORKSPACE=off
# DROSTE_VLLM_LOG_MODEL_INSPECTION=off
# DROSTE_VLLM_DEBUG_MFU_METRICS=off
# DROSTE_VLLM_COMPUTE_NANS_IN_LOGITS=off
# DROSTE_VLLM_CUSTOM_SCOPES_FOR_PROFILING=off


# Development
# -----------
# VLLM_MOE_ROUTING_SIMULATION_STRATEGY=       # MoE routing strategy selector
# VLLM_TEST_FORCE_LOAD_FORMAT=dummy
#
# {on, off*}
# DROSTE_VLLM_SERVER_DEV_MODE=off
# DROSTE_VLLM_USE_V2_MODEL_RUNNER=off


# Experimental
# ------------
# DROSTE_VLLM_EXPERIMENTAL_PARSER_CONTEXT=no
# DROSTE_VLLM_ROCM_AITER_UNIFIED_ATTENTION=no   # Minimal testing on Strix Halo
# DROSTE_VLLM_ROCM_AITER=no                     # Minimal testing on Strix Halo



# =================================
#  NOT RELEVANT / USEFUL FOR BUILD
# =================================

# CUDA / NVIDIA-only Kernels
# --------------------------
# CUDA_HOME=   # path to cudatoolkit home directory (should contain bin, include, & lib paths)

# VLLM_USE_FLASHINFER_SAMPLER=                  # Uses flashinfer sampler (default: unset)
# VLLM_BLOCKSCALE_FP8_GEMM_FLASHINFER=0         # Allow FlashInfer FP8 block-scale GEMM for linear layers
# VLLM_USE_FLASHINFER_MOE_FP16=0                # Allow use of FlashInfer BF16 MoE kernels for fused moe ops
# VLLM_USE_FLASHINFER_MOE_FP8=0                 # Allow use of FlashInfer FP8 MoE kernels for fused moe ops
# VLLM_USE_FLASHINFER_MOE_FP4=0                 # Allow use of FlashInfer NVFP4 MoE kernels for fused moe ops
# VLLM_USE_FLASHINFER_MOE_INT4=0                # Allow use of FlashInfer MxInt4 MoE kernels for fused moe ops
# VLLM_USE_FLASHINFER_MOE_MXFP4_MXFP8=0         # If 1, use FlashInfer MXFP8 (activation) x MXFP4 (weight) MoE backend
# VLLM_USE_FLASHINFER_MOE_MXFP4_BF16=0          # If 1, use FlashInfer BF16 (activation) x MXFP4 (weight) MoE backend
# VLLM_USE_FLASHINFER_MOE_MXFP4_MXFP8_CUTLASS=0 # If 1, use FlashInfer CUTLASS backend for MXFP8 (activation) x MXFP4 (weight) MoE

# {int8, fp8}
# VLLM_MARLIN_INPUT_DTYPE=        # Activation dtype for marlin kernel
# VLLM_MXFP4_USE_MARLIN=          # Whether to use marlin kernel in mxfp4 quantization method
# VLLM_MARLIN_USE_ATOMIC_ADD=0    # Whether to use atomicAdd reduce in gptq/awq marlin kernel
# VLLM_TEST_FORCE_FP8_MARLIN=0    # Forces FP8 Marlin use for FP8 quantization regardless of FP8 hardware support

# {latency*, throughput, masked_gemm}
# VLLM_FLASHINFER_MOE_BACKEND=latency               # Flashinfer MoE backend for vLLM's fused Mixture-of-Experts support
# VLLM_FLASHINFER_ALLREDUCE_FUSION_THRESHOLDS_MB={} # Specifies communicated tensor size thresholds for vllm's flashinfer fused allreduce use
# VLLM_FLASHINFER_WORKSPACE_BUFFER_SIZE=413138944   # default: 394 MiB; control FlashInfer backend workspace buffer size
# VLLM_HAS_FLASHINFER_CUBIN=0                       # Cubin files have been pre-downloaded; flashinfer reads directly
# VLLM_ALLREDUCE_USE_SYMM_MEM=1                     # Whether to use pytorch symmetric memory for allreduce

# {flashinfer-cudnn, flashinfer-trtllm, flashinfer-cutlass, marlin, <none>}
# VLLM_NVFP4_GEMM_BACKEND=                 # Use specified backend (marlin for GPUs with no native FP4 support)
# VLLM_USE_DEEP_GEMM=1                     # Allow use of DeepGemm kernels for fused moe ops
# VLLM_MOE_USE_DEEP_GEMM=1                 # Allow use of DeepGemm specifically for MoE fused ops (overrides only MoE)
# VLLM_USE_DEEP_GEMM_E8M0=1                # Whether to use E8M0 scaling when DeepGEMM is used on Blackwell GPUs
# VLLM_USE_DEEP_GEMM_TMA_ALIGNED_SCALES=1  # Whether to create TMA-aligned scale tensor when DeepGEMM is used
# VLLM_USE_FBGEMM=0                        # Flag to enable FBGemm kernels on model execution

# {relax*, skip, full}
# VLLM_DEEP_GEMM_WARMUP=relax    # DeepGemm JITs the kernels on-demand

# VLLM_DEEPEPLL_NVFP4_DISPATCH=0                 # DeepEPLL kernels for NVFP4 quantization & dispatch method (Blackwell & DeepSeek only)
# VLLM_DEEPEP_BUFFER_SIZE_MB=1024                # The size in MB of the buffers (NVL and RDMA) used by DeepEP
# VLLM_DEEPEP_LOW_LATENCY_USE_MNNVL=0            # Allow MNNVL use by DeepEP for internode_ll kernel, (better latency on GB200 like system)
# VLLM_DEEPEP_HIGH_THROUGHPUT_FORCE_INTRA_NODE=0 # Force intranode kernel by DeepEP for inter-node communication in high throughput mode

# VLLM_CUDART_SO_PATH=                      # In some system, find_loaded_library() may not work
# VLLM_ENABLE_CUDAGRAPH_GC=0                # Controls garbage collection during CUDA graph capture
# VLLM_USE_NVFP4_CT_EMULATIONS=0            # Emulate NVFP4 generations on machines < 100 for compressed-tensors models
# VLLM_MAX_TOKENS_PER_EXPERT_FP4_MOE=163840 # Control maximum number of tokens / expert supported by NVFP4 MoE CUTLASS Kernel
# VLLM_NVTX_SCOPES_FOR_PROFILING=0          # Add optional nvtx scopes for profiling, disable to avoid overheads
# VLLM_DBO_COMM_SMS=20                      # Number of SMs to allocate for communication kernels when running DBO; rest of SMs on device will be allocated to compute
# VLLM_LORA_DISABLE_PDL=0                   # Disable PDL for LoRA; enabling on SM100 causes Triton compilation to fail
# VLLM_USE_NCCL_SYMM_MEM=0                  # Flag to enable NCCL symmetric memory allocation and registration
# VLLM_NCCL_INCLUDE_PATH=                   # NCCL header path


# TPU / XLA (Requires torch_xla & TPU)
# ------------------------------------
# VLLM_XLA_CACHE_PATH=${XDG_CACHE_HOME:-~/.cache}/vllm/xla_cache  # Path to the XLA persistent cache directory
# VLLM_XLA_CHECK_RECOMPILATION=0    # If set, assert on XLA recompilation after each execution step
# VLLM_XLA_USE_SPMD=0               # Enable SPMD mode for TPU backend
# VLLM_TPU_BUCKET_PADDING_GAP=0     # Gap between padding buckets for the forward pass
# VLLM_TPU_MOST_MODEL_LEN=          # default: unset
# VLLM_TPU_USING_PATHWAYS=          # Whether using Pathways


# CPU backend (this build is GPU-specific)
# ----------------------------------------
# VLLM_CPU_KVCACHE_SPACE=0          # CPU key-value cache space
# VLLM_CPU_OMP_THREADS_BIND=auto    # CPU core ids bound by OpenMP threads, e.g., "0-31", "0,1,2", "0-31,33"
# VLLM_CPU_NUM_OF_RESERVED_CPU=0    # CPU cores not used by OMP threads
# VLLM_CPU_SGL_KERNEL=0             # whether to use SGL kernels, optimized for small batch


# AITER (inert on Strix Halo)
# ---------------------------
# VLLM_ROCM_USE_AITER_PAGED_ATTN=False               # Whether to use aiter paged attention
# VLLM_ROCM_USE_AITER_LINEAR=True                    # Aiter linear op if enabled
# VLLM_ROCM_USE_AITER_MOE=True                       # Whether to use aiter moe ops
# VLLM_ROCM_USE_AITER_RMSNORM=True                   # use aiter rms norm op if aiter ops are enabled
# VLLM_ROCM_USE_AITER_MLA=True                       # Whether to use aiter mla ops
# VLLM_ROCM_USE_AITER_MHA=True                       # Whether to use aiter mha ops
# VLLM_ROCM_USE_AITER_FP4_ASM_GEMM=False             # Whether to use aiter fp4 gemm asm
# VLLM_ROCM_USE_AITER_TRITON_ROPE=False              # Whether to use aiter rope
# VLLM_ROCM_USE_AITER_FP8BMM=True                    # Whether to use aiter triton fp8 bmm kernel By default is enabled
# VLLM_ROCM_USE_AITER_FP4BMM=True                    # Whether to use aiter triton fp4 bmm kernel By default is enabled
# VLLM_ROCM_USE_AITER_UNIFIED_ATTENTION=False        # Use AITER triton unified attention for V1 attention
# VLLM_ROCM_USE_AITER_FUSION_SHARED_EXPERTS=False    # Whether to use aiter fusion shared experts ops
# VLLM_ROCM_USE_AITER_TRITON_GEMM=True               # Whether to use aiter triton kernels for gemm ops


# Other AMD cards -- upstream says MI3*
# -------------------------------------
# {NONE*, FP, INT8, INT6, INT4}
# VLLM_ROCM_QUICK_REDUCE_QUANTIZATION=NONE         # Custom quick allreduce kernel for MI3* cards (quant levels)
# VLLM_ROCM_QUICK_REDUCE_CAST_BF16_TO_FP16=True    # Custom quick allreduce kernel for MI3* cards (fp16)
# VLLM_ROCM_QUICK_REDUCE_MAX_SIZE_BYTES_MB=        # default: unset; Custom quick allreduce kernel for MI3* cards


# Misc.
# -----
# VLLM_CI_USE_S3=0    #  Whether to use S3 path for model loading in CI via RunAI Streamer
#
# {True, False}
# VLLM_ROCM_USE_SKINNY_GEMM=True          # Inert on Strix Halo
# VLLM_ROCM_SHUFFLE_KV_CACHE_LAYOUT=False # Inert on Strix Halo
