# this container's mounts + service, both lanes
#
# build-spec — llama port. Sourced bash consumed by the shared resolver
# (/opt/resources/resolve/droste-resolve.sh) via the shared entrypoint.
# Contract + row semantics: base/resolve/build-spec.example.

# ── SERVICE ──────────────────────────────────────────────────────────────────
# Placeholder argv; llama_pre_launch REBUILDS it after CFG_FILE is sourced so
# DROSTE_LLAMA_EXTRA_ARGS (from /opt/data/llama.cfg) can join the command line —
# SERVICE would otherwise be expanded at spec-source time, before the env file.
SERVICE=( llama-server )

# ── HEALTH — probe endpoint for droste-healthcheck.sh ────────────────────────
# llama-server's native /health: 200 once the model is loaded, 503 while loading.
# The 503 is deliberately NOT accepted (loading is not serving) — the podman
# --health-start-period must cover the load, or the box restart-loops.
HEALTH_PATH="/health"
HEALTH_ACCEPT="ok"

# ── CFG_FILE ─────────────────────────────────────────────────────────────────
# Seeded from the BUILD-GENERATED template (templates.yaml if_missing); carries
# LLAMA_ARG_* lines (llama-server reads them natively), the 73 DROSTE_LLAMA_* settings
# the tables below translate — 70 into argv, 3 into the environment — and
# DROSTE_LLAMA_EXTRA_ARGS.
# ⚠️ It is NOT sourced into this shell: droste::cfg_apply runs it in a CHILD shell
# and applies the difference, so a typo in it is a warning rather than a dead box.
# The practical consequence for anything written here is that the file is DATA — the
# SHELL STATE it builds (a cd, a function, a trap) dies with the child and only the
# variables it leaves behind reach us. Not a sandbox: a filesystem write in there still
# happens, because the child is a real shell.
CFG_FILE="/opt/data/llama.cfg"

# ── SERVE — the rows droste-serve.sh reads out of this spec ──────────────────
# The five SERVE settings live in the same CFG_FILE as everything else, under the
# prefix below: DROSTE_LLAMA_STARTUP_ENABLED / _HOST / _PORT / _TLS_CERT / _TLS_KEY.
# serve::read_config PARSES them with droste::cfg_get and never sources the file — that
# read also runs inside the healthcheck every 30s under --health-on-failure=restart,
# where an abort is a restart loop that ejects every shell in the box.
# 🚨 SERVE_CFG_PREFIX IS REQUIRED, and its absence is not a quiet degradation: a spec
# that names CFG_FILE and no prefix makes read_config refuse to serve and report the
# IMAGE as broken, because otherwise all five settings would read as absent and the box
# would silently stop serving.
SERVE_CFG_PREFIX="DROSTE_LLAMA_"
#
# 🚨 NO SERVE_HOST_FLAG ROW, AND THAT IS AN ANSWER RATHER THAN AN OMISSION: llama-server
# spells it --host, which is serve::apply_host's own default. The same goes for --port.
# ⭐ AND THIS BOX'S BEHAVIOUR CHANGES IN s60. It bound llama.cpp's own default —
# `params.hostname = "127.0.0.1"` (common/common.h:606) — while every sibling bound
# 0.0.0.0, and NOTHING REPORTED IT: the health probe asked 127.0.0.1, which a
# loopback-only listener answers perfectly. llama_argv now bakes `--host 0.0.0.0` (see
# the block above the SERVICE rebuild for the whole reason), and serve::apply_host
# REPLACES that token with the user's address in the serving lane — the same path
# comfyui and finetuning already take. ⚠️ BOTH HALVES ARE NEEDED: the launcher covers
# the merged box, the baked token covers a direct `podman run`, where no launcher runs
# at all. Neither alone delivers "all five default to 0.0.0.0".
# 🚨 WHICH IS WHY THIS SPEC MUST NEVER ASSIGN LLAMA_ARG_HOST — see the
# _wrong_on_clear entry in PRE_LAUNCH for the other half of that story. A variable we
# never set cannot be blank, and `LLAMA_ARG_HOST=""` binds ::1 only and restart-loops
# the box (s57). The template's reserved block names both spellings for the same reason.
#
# The port a user gets when they set none — llama-server's own, and the value llama.cfg
# already shows on its commented DROSTE_LLAMA_PORT line. 🚨 THE ROW IS WHAT MAKES THAT
# LINE TRUE (§7a, ruled s60): the address has a library-wide default and the port had
# none, so before this row an absent port did not mean "use 8080" — it meant the box
# refused to serve. ⚠️ NO BAKED TOKEN TO KEEP IT IN STEP WITH, unlike the address: this
# box's argv carries no --port at all, so a direct `podman run` gets llama.cpp's own
# 8080 and the two agree by coincidence rather than by construction. Changing this
# number without changing llama_argv would end that agreement silently.
SERVE_PORT_DEFAULT=8080
#
# ⚠️ THE TLS PAIR HAS NO LIBRARY DEFAULT, deliberately: there is no majority spelling,
# and a wrong flag is not a wrong value — the server rejects the argv and never starts.
# These are llama.cpp's own --ssl-cert-file / --ssl-key-file, the pair llama.cfg's
# Security block already names and the pair behind the native LLAMA_ARG_SSL_*_FILE
# variables the file still carries.
# ⭐ THE FLAGS ARE DECLARED HERE; WHETHER THEY ARE EMITTED IS THE LAUNCHER'S CALL —
# serve::apply_tls emits them ONLY when the user set both, because a flag we emit is
# parsed after the environment and would silently beat a user's own LLAMA_ARG_SSL_*
# line; a default here would destroy that choice for everyone.
SERVE_TLS_CERT_FLAG=--ssl-cert-file
SERVE_TLS_KEY_FLAG=--ssl-key-file

# ── OVERLAYS ─────────────────────────────────────────────────────────────────
# venv overlay is universal (per design). llama-server itself is a compiled
# binary — the overlay serves the user's own pip installs (whole venv, so
# console scripts in bin/ persist too). The upper is CACHE class (a pip install
# is re-runnable) → /opt/program-cache, which the installer may empty.
OVERLAYS=(
    "/opt/program-cache/venv:/opt/venv"
)

# ── SURFACES ─────────────────────────────────────────────────────────────────
SURFACES=()

# ── CACHES ───────────────────────────────────────────────────────────────────
# None. llama.cpp uses its own kernels (no Triton/MIOpen), and the slot store is
# CONSUMED in place: the --slot-save-path launch flag points INTO
# /opt/program-cache directly (no bind needed; dir pre-created in
# llama_pre_launch). The slots stay OUT of this array on purpose — a CACHES row
# is what offers a src to the cross-box shared store, and one box's saved KV
# slots mean nothing to another: cache CLASS, but never SHARED.
CACHES=()

# ── CRITICAL ─────────────────────────────────────────────────────────────────
# Shared HF cache: llama-server's -hf downloads land here (llama.cpp consolidated
# onto the standard HF hub cache); unbound = silent multi-GB re-download.
CRITICAL=(
    "hf-cache:$HOME/.cache/huggingface"
)

# ── OPTIONAL ─────────────────────────────────────────────────────────────────
# Read-only bind point for a local GGUF collection (LLAMA_ARG_MODEL can point
# here). Tell-once marker body: templates/mount_shared_models_here.
OPTIONAL=(
    "models:/opt/models:/opt/models/mount_shared_models_here"
)

# ── The llama.cfg → argv tables ──────────────────────────────────────────────
# ⭐ THESE TABLES ARE THE ONLY MAPPING. llama.cfg names a setting; this file says
# which flag it emits. There is NO derivation rule and there must never be one —
# 63 of the 70 names below happen to match `--$(lower suffix)` and seven do not
# (AUTO_MODEL, HF_TOKEN_FILE, BUILTIN_SPEC_DEFAULT, DRY_SEQ_BREAKERS and the three
# ENDPOINT_*), so a derivation would need seven exceptions. Jei's ruling on ds4
# stands here: A RULE WITH AN EXCEPTION IS WORSE THAN NO RULE, because a reader who
# derives a name gets a variable nothing reads. Adding a setting means editing
# llama.cfg AND this file; there is nothing to fall back on.
# ⚠️ 70 IS THIS SECTION'S COUNT, NOT THE FILE'S. Three more settings are wired further
# down, in the ENVIRONMENT tables — they have no flag to emit and never touch SERVICE.
#
# Every row was generated from the PINNED binary's own option table (paren-balanced
# parse of arg.cpp at 337f08e8) and not from llama.cfg's inline comments — three of
# those comments name the wrong flag today.
#
# 🚨 THE FOUR BOOLEAN KINDS ARE NOT INTERCHANGEABLE, and this is the whole reason
# every one of them is droste-named:
#   BOOL   has a real `--no-x` twin. on ⇒ `--x`, off ⇒ `--no-x`.
#   SWITCH is upstream `handler_void`: it has NO negation and is applied only
#          `if (is_truthy(value))`, so `off`/`no`/`false` are SILENTLY DISCARDED by
#          llama itself. off ⇒ WE EMIT NOTHING, which is the only way "off" can mean
#          off. A user cannot tell these two kinds apart by looking, which is why we
#          never expose the native names for either.
#   ONOFF  takes its answer as an ARGUMENT — `--fit on` — so both answers are
#          expressible and neither is a separate flag. Exactly one exists (see
#          LLAMA_ONOFF_FLAGS below for why it still cannot be a native line).
#   CHOICE is a menu where one value means "emit nothing" (comfyui's shape).
# ⚠️ UNSET IS A THIRD STATE, DISTINCT FROM off. An unset bool emits NEITHER flag, so
# upstream's own default stands. That matters for --kv-unified, whose help says the
# effective default is "enabled if number of slots is auto": emitting --no-kv-unified
# just because the line is commented out would suppress that.
#
# "<SUFFIX>:<flag>" — the variable is DROSTE_LLAMA_<SUFFIX>.
LLAMA_VALUE_FLAGS=(
    "TEMP:--temp"                       "TOP_P:--top-p"
    "MIN_P:--min-p"                     "TOP_N_SIGMA:--top-nsigma"
    "XTC_PROBABILITY:--xtc-probability" "XTC_THRESHOLD:--xtc-threshold"
    "TYPICAL_P:--typical-p"             "REPEAT_LAST_N:--repeat-last-n"
    "REPEAT_PENALTY:--repeat-penalty"   "PRESENCE_PENALTY:--presence-penalty"
    "FREQUENCY_PENALTY:--frequency-penalty"
    "DRY_MULTIPLIER:--dry-multiplier"   "DRY_BASE:--dry-base"
    "DRY_ALLOWED_LENGTH:--dry-allowed-length"
    "DRY_PENALTY_LAST_N:--dry-penalty-last-n"
    "DYNATEMP_RANGE:--dynatemp-range"   "DYNATEMP_EXP:--dynatemp-exp"
    "ADAPTIVE_TARGET:--adaptive-target" "ADAPTIVE_DECAY:--adaptive-decay"
    "MIROSTAT:--mirostat"               "MIROSTAT_LR:--mirostat-lr"
    "MIROSTAT_ENT:--mirostat-ent"       "SEED:--seed"
    "GRAMMAR:--grammar"                 "GRAMMAR_FILE:--grammar-file"
    "JSON_SCHEMA:--json-schema"         "JSON_SCHEMA_FILE:--json-schema-file"
    "SAMPLERS:--samplers"               "SAMPLING_SEQ:--sampler-seq"
)
# "<SUFFIX>:<on-flag>:<off-flag>"
LLAMA_BOOL_FLAGS=(
    "MODELS_AUTOLOAD:--models-autoload:--no-models-autoload"
    "UI:--ui:--no-ui"
    "UI_MCP_PROXY:--ui-mcp-proxy:--no-ui-mcp-proxy"
    "CACHE_PROMPT:--cache-prompt:--no-cache-prompt"
    "CACHE_IDLE_SLOTS:--cache-idle-slots:--no-cache-idle-slots"
    "CONTEXT_SHIFT:--context-shift:--no-context-shift"
    "KV_UNIFIED:--kv-unified:--no-kv-unified"
    "JINJA:--jinja:--no-jinja"
    "PREFILL_ASSISTANT:--prefill-assistant:--no-prefill-assistant"
    "SKIP_CHAT_PARSING:--skip-chat-parsing:--no-skip-chat-parsing"
    "ENDPOINT_SLOTS:--slots:--no-slots"
    "PERF:--perf:--no-perf"
    "MMPROJ_AUTO:--mmproj-auto:--no-mmproj-auto"
    "MMPROJ_OFFLOAD:--mmproj-offload:--no-mmproj-offload"
    "CONT_BATCHING:--cont-batching:--no-cont-batching"
    "MMAP:--mmap:--no-mmap"
    "DIRECT_IO:--direct-io:--no-direct-io"
    "KV_OFFLOAD:--kv-offload:--no-kv-offload"
    "REPACK:--repack:--no-repack"
    "LOG_PREFIX:--log-prefix:--no-log-prefix"
    "LOG_TIMESTAMPS:--log-timestamps:--no-log-timestamps"
)
# handler_void — no negation exists upstream. off ⇒ emit nothing.
# ⚠️ NO_HOST IS A POSITIVE FLAG. `--no-host` is llama's own spelling for "bypass the
# host buffer"; there is no `--host` boolean it negates. Any future "strip the --no-
# to turn it off" cleverness must never touch this row.
LLAMA_SWITCH_FLAGS=(
    "BUILTIN_SPEC_DEFAULT:--spec-default" "SPEC_DRAFT_CPU_MOE:--spec-draft-cpu-moe"
    "SWA_FULL:--swa-full"                 "ENDPOINT_METRICS:--metrics"
    "ENDPOINT_PROPS:--props"              "EMBEDDINGS:--embeddings"
    "RERANKING:--reranking"               "REUSE_PORT:--reuse-port"
    "OFFLINE:--offline"                   "MLOCK:--mlock"
    "CPU_MOE:--cpu-moe"                   "NO_HOST:--no-host"
    "BACKEND_SAMPLING:--backend-sampling" "IGNORE_EOS:--ignore-eos"
)
# ONOFF — the flag carries its own `on`/`off` argument. "<SUFFIX>:<flag>".
#
# 🚨 ONE ROW, AND IT IS HERE BECAUSE IT IS A BOOLEAN, NOT BECAUSE IT MISBEHAVES.
# `--fit` is the ONLY two-valued on/off option llama.cfg surfaces — checked at the
# pin rather than remembered: of the 84 native LLAMA_ARG_* names the file names,
# arg.cpp gives exactly one an `is_truthy`/`is_falsey` pair with no third answer
# (arg.cpp:2442-2454), three more are on/off/AUTO menus and so are not booleans
# (FLASH_ATTN, LOG_COLORS, REASONING), and none is a `handler_bool`. The naming rule
# (s53) has no degrees: EVERY boolean is droste-named, whatever its native does.
# ⚠️ SO THE REASON IS NOT THE `off` FALL-THROUGH THAT DAMNS THE SWITCH KIND. Upstream
# reads this one correctly — `off`, `disabled`, `false` and `0` all really do turn
# fitting off. What it does NOT read is `Off`, `OFF`, `no` or a stray trailing space:
# is_truthy/is_falsey are exact, case-sensitive std::string comparisons
# (arg.cpp:988-994), and anything they both reject THROWS out of the env loop and the
# server never starts. droste::bool case-folds, strips spaces, and accepts our whole
# vocabulary, which is what makes this box answer `off` the same way the other four do.
#
# 🚨 THE FAILURE MODE CHANGES, AND THIS IS NOT MERELY A RENAME. Say it plainly:
#   before   `LLAMA_ARG_FIT=Off` ⇒ upstream throws ⇒ the box does not start. LOUD.
#   after    `DROSTE_LLAMA_FIT=Off` ⇒ droste::bool folds it ⇒ fitting really is off.
#            `DROSTE_LLAMA_FIT=maybe` ⇒ we warn and emit nothing ⇒ the box starts on
#            llama's default instead of dying.
# ⭐ THE FIRST LINE IS THE WHOLE POINT — `Off`, `OFF`, `no` and `yes` are DEAD BOXES
# today, and they are what people actually type. The second line is the price: a typo
# stops being fatal and becomes a warning, so a user who does not read the log gets a
# running server on a value they did not choose. That trade was already made for the
# other 37 booleans on this surface — 21 BOOL, 14 SWITCH and the 2 ENVIRONMENT ones,
# counted from the tables rather than from a sibling document — and consistency
# governs; it is recorded here so nobody re-derives it as a defect.
#
# 🚨 PRECEDENCE OVER A NATIVE LINE, AND IT IS UPSTREAM'S OWN ORDERING, NOT OURS.
# common_params_parse_ex handles environment variables FIRST (arg.cpp:509-530) and
# then walks argv (:539+), each handler overwriting the same `params.fit_params`. So
# a flag we emit always beats a `LLAMA_ARG_FIT` line — llama even says so on stderr,
# `warn: … environment variable is set, but will be overwritten by command line
# argument` (:563-564). The contract, same shape as the ENVIRONMENT tables below:
#   DROSTE_LLAMA_FIT unset or blank  → we emit nothing. A native line an older box
#                                      carries stands; with neither, llama's own
#                                      default stands. Blank behaves exactly as absent.
#   DROSTE_LLAMA_FIT set             → OURS WINS, because argv is parsed last.
#   DROSTE_LLAMA_FIT set to garbage  → warn, emit nothing. Same as unset, so a typo
#                                      can never destroy a native line the user meant.
# ⚠️ AND OUR FLAG CANNOT RESCUE A BLANK NATIVE ONE, for exactly that ordering reason:
# `LLAMA_ARG_FIT=` throws inside the env loop, before argv is ever read. That is why
# the name keeps its entry in _fatal_on_clear below even though it has left the
# surface — see the row there.
LLAMA_ONOFF_FLAGS=(
    "FIT:--fit"
)
# Upstream takes ONE item per occurrence and expects the flag REPEATED; the user
# gives us a `;`-separated list and we do the repeating. "<SUFFIX>:<flag>"
# ⚠️ --dry-sequence-breaker clears llama's four built-in breakers on its FIRST
# invocation only, so one combined argument would install a single absurd breaker
# rather than the four the user wrote.
LLAMA_LIST_FLAGS=(
    "DRY_SEQ_BREAKERS:--dry-sequence-breaker"
    "LOGIT_BIAS:--logit-bias"
)
# comfyui's record shape: "<SUFFIX>|<value>=<flags>|…", FIRST pair is the default,
# an EMPTY right-hand side emits nothing at all.
# 🚨 NUMA IS HERE AND NOT IN THE VALUE TABLE, and that is the fix for a real trap:
# arg.cpp:2298 reads `value == "distribute" || value == ""`, so passing --numa with
# an EMPTY argument turns NUMA **on** in distribute mode. `off` has to mean "emit no
# flag", which a value row cannot express. Anything llama does not recognise throws
# and kills startup, so the menu is closed.
LLAMA_CHOICE_FLAGS=(
    "NUMA|off=|distribute=--numa distribute|isolate=--numa isolate|numactl=--numa numactl"
    "AUTO_MODEL|none=|embd-gemma=--embd-gemma-default|fim-qwen-1.5b=--fim-qwen-1.5b-default|fim-qwen-3b=--fim-qwen-3b-default|fim-qwen-7b=--fim-qwen-7b-default|fim-qwen-7b-spec=--fim-qwen-7b-spec|fim-qwen-14b-spec=--fim-qwen-14b-spec|fim-qwen-30b=--fim-qwen-30b-default|gpt-oss-20b=--gpt-oss-20b-default|gpt-oss-120b=--gpt-oss-120b-default|vision-gemma-4b=--vision-gemma-4b-default|vision-gemma-12b=--vision-gemma-12b-default"
)
# Settings that write the SAME field upstream, so more than one is a silent
# last-wins race. We say so instead of letting argument order decide.
LLAMA_EXCLUSIVE_GROUPS=(
    "GRAMMAR GRAMMAR_FILE JSON_SCHEMA JSON_SCHEMA_FILE"
    "SAMPLERS SAMPLING_SEQ"
)

# llama_argv — DROSTE_LLAMA_* → SERVICE. Its own function, comfyui-style, so it can
# be driven alone (source the spec, call it, print SERVICE) without the mkdir, the
# HF token read or the health-prefix write. With 69 settings that is the difference
# between a testable translator and one nobody can check.
# ⚠️ It REBUILDS SERVICE from constants rather than appending: serve::build_service
# can run PRE_LAUNCH a second time in the same process, and a doubled argv of this
# length would be very hard to read in a log.
llama_argv() {
    local dyn=() entry suffix var val flag onf offf rest pairs=() pair def flags ok list
    local -a items=()
    local g first seen

    # ── the droste-supplied defaults (N1a: a default belongs in the WIRING) ─────
    # ⭐ ONE, and it is here rather than as an active line in llama.cfg because that
    # file seeds `if_missing`: an uncommented line would reach NEW boxes only.
    # llama.cfg's Speculative Decoding block stars `on` in its `{on*, off}` menu AND
    # shows `DROSTE_LLAMA_BUILTIN_SPEC_DEFAULT=on`, so the file states this default
    # twice. It is a SWITCH (handler_void), so an unset variable emitted nothing at
    # all and the box came up with ngram speculative decoding OFF — the file
    # asserting a default the box did not deliver.
    # ⚠️ IT IS A REAL BEHAVIOUR CHANGE, not a no-op: --spec-default pushes
    # COMMON_SPECULATIVE_TYPE_NGRAM_MOD and sets ngram_mod n_match/n_min/n_max to
    # 24/48/64 (arg.cpp:4168-4181 at the pinned 337f08e8). That is what the file
    # asks for.
    # 🚨 `:=` NOT `=`, AND THIS REVERSED IN s58 — READ THE REASON BEFORE CHANGING IT
    # BACK. It was `=` so that a blank meant "don't", on the N1a reading that a blank is
    # always the user's opt-out. Jei's three-category rule narrows that: a blank is the
    # opt-out only for an UNBOUNDED string whose blank is a meaningful answer. This
    # setting is a two-member menu — llama.cfg prints `{on*, off}` above
    # `DROSTE_LLAMA_BUILTIN_SPEC_DEFAULT` in its Speculative Decoding block —
    # so it is CATEGORY 2, a finite set, and a finite set has default behaviour that a
    # blank must fall back to. What the user would reasonably expect from an emptied
    # line is our default, not a third state the file never offers.
    # ⭐ NOTHING IS LOST BY THE CHANGE: `off` is still the way to say off, it is one of
    # the two answers the file documents, and it still emits nothing. The blank simply
    # stops being an undocumented third answer that happened to mean `off`.
    : "${DROSTE_LLAMA_BUILTIN_SPEC_DEFAULT:=on}"

    for entry in "${LLAMA_VALUE_FLAGS[@]}"; do
        var="DROSTE_LLAMA_${entry%%:*}"; flag=${entry#*:}; val=${!var:-}
        [ -n "$val" ] && dyn+=( "$flag" "$val" )
    done

    for entry in "${LLAMA_BOOL_FLAGS[@]}"; do
        var="DROSTE_LLAMA_${entry%%:*}"; rest=${entry#*:}
        onf=${rest%%:*}; offf=${rest#*:}; val=${!var:-}
        # Unset/blank emits NEITHER flag — upstream's own default stands.
        [ -n "$val" ] || continue
        case "$(droste::bool "$val")" in
            on)  dyn+=( "$onf" ) ;;
            off) dyn+=( "$offf" ) ;;
            *)   serve::err "$var='$val' is not on/off — leaving $onf at llama's default. Use on or off. Fix it in $CFG_FILE and restart the box." ;;
        esac
    done

    for entry in "${LLAMA_SWITCH_FLAGS[@]}"; do
        var="DROSTE_LLAMA_${entry%%:*}"; flag=${entry#*:}; val=${!var:-}
        [ -n "$val" ] || continue
        case "$(droste::bool "$val")" in
            on)  dyn+=( "$flag" ) ;;
            off) ;;   # upstream has no negation; emitting nothing IS off
            *)   serve::err "$var='$val' is not on/off — leaving $flag off. Use on or off. Fix it in $CFG_FILE and restart the box." ;;
        esac
    done

    for entry in "${LLAMA_ONOFF_FLAGS[@]}"; do
        var="DROSTE_LLAMA_${entry%%:*}"; flag=${entry#*:}; val=${!var:-}
        # Unset/blank emits nothing — a native line, or llama's own default, stands.
        [ -n "$val" ] || continue
        # ⚠️ THE LITERAL IS OURS TO CHOOSE AND IT IS NOT THE USER'S WORD. `on` and `off`
        # are what is_truthy/is_falsey accept (arg.cpp:988-994); passing `$val` through
        # would hand `Off` or `yes` to a case-sensitive comparison that rejects both and
        # then throws, which is the whole reason this row is droste-named.
        case "$(droste::bool "$val")" in
            on)  dyn+=( "$flag" on ) ;;
            off) dyn+=( "$flag" off ) ;;
            *)   serve::err "$var='$val' is not on/off — leaving $flag at llama's default. Use on or off. Fix it in $CFG_FILE and restart the box." ;;
        esac
    done

    for entry in "${LLAMA_LIST_FLAGS[@]}"; do
        var="DROSTE_LLAMA_${entry%%:*}"; flag=${entry#*:}; val=${!var:-}
        [ -n "$val" ] || continue
        mapfile -d '' -t items < <(droste::split_list ';' "$val")
        for pair in ${items[@]+"${items[@]}"}; do dyn+=( "$flag" "$pair" ); done
    done

    for entry in "${LLAMA_CHOICE_FLAGS[@]}"; do
        suffix=${entry%%|*}; rest=${entry#*|}
        IFS='|' read -r -a pairs <<<"$rest"
        def=${pairs[0]%%=*}; flags=${pairs[0]#*=}
        var="DROSTE_LLAMA_$suffix"; val=${!var:-}
        if [ -n "$val" ]; then
            ok=0
            for pair in "${pairs[@]}"; do
                if [ "${pair%%=*}" = "$val" ]; then flags=${pair#*=}; ok=1; break; fi
            done
            if [ "$ok" -eq 0 ]; then
                list=""; for pair in "${pairs[@]}"; do list="$list ${pair%%=*}"; done
                serve::err "$var='$val' is not a valid value — using the default '$def'. Valid values:$list. Fix it in $CFG_FILE and restart the box."
            fi
        fi
        # Word-split ON PURPOSE: the right-hand side is a literal from the table
        # above, never user input, and one value may expand to a flag plus its value.
        # shellcheck disable=SC2206
        dyn+=( $flags )
    done

    # Two settings that write one upstream field are a silent last-wins race. Name it.
    for g in "${LLAMA_EXCLUSIVE_GROUPS[@]}"; do
        first=""; seen=""
        for suffix in $g; do
            var="DROSTE_LLAMA_$suffix"
            [ -n "${!var:-}" ] || continue
            [ -n "$first" ] && seen="$seen $var" || first=$var
        done
        [ -n "$seen" ] && serve::err "$first and$seen all set the same thing in llama, so the last one on the command line silently wins. Set ONE of them in $CFG_FILE."
    done

    # Ordering: droste's own flags FIRST, the user's catch-all LAST, because llama
    # parses argv left to right and a later occurrence wins — so the user beats us on
    # every conflict, deliberately. --slot-save-path rides here too (no env var).
    #
    # 🚨 `--host 0.0.0.0` IS A DROSTE DEFAULT, NOT A CONSTANT, AND IT IS THE ONE TOKEN
    # THAT CHANGES THIS BOX'S BEHAVIOUR (Jei, s59: "all should default to 0.0.0.0").
    # llama-server's own default is `params.hostname = "127.0.0.1"` (common/common.h:606),
    # so until this line existed the box bound LOOPBACK ONLY while every sibling bound all
    # interfaces — and ⭐ NOTHING COULD REPORT IT: the health probe asks 127.0.0.1, which a
    # loopback-only listener answers perfectly. An asymmetry that hides its own symptom is
    # exactly why this is a baked token rather than an absent flag.
    # ⭐ IT MAKES THIS BOX STRUCTURALLY IDENTICAL TO comfyui AND finetuning, which is the
    # point of putting it here rather than leaving the flag to the launcher alone:
    # serve::apply_host REPLACES the value after an existing flag and only APPENDS when
    # there is none, so all three now take the replace path and llama stops being the one
    # box whose address depends on an absence. The user's own value still wins — it
    # arrives through DROSTE_LLAMA_HOST and the launcher overwrites this token with it.
    # ⚠️ AND IT IS A FLAG, NEVER `LLAMA_ARG_HOST`. argv is parsed AFTER the environment
    # (arg.cpp:509-530 then :539+) so the flag wins outright, and a variable we never set
    # cannot be blank — which sidesteps the s57 box-killer (`LLAMA_ARG_HOST=""` binds ::1
    # only and restart-loops the box) instead of having to survive it.
    # ⚠️ It sits BEFORE the catch-all, like every other droste flag: a --host in
    # DROSTE_LLAMA_EXTRA_ARGS still wins here, and the launcher then rewrites the value
    # after EVERY occurrence, so the two copies cannot disagree.
    # shellcheck disable=SC2206
    mapfile -d '' -t _extra < <(droste::split_args "${DROSTE_LLAMA_EXTRA_ARGS:-}")
    SERVICE=( llama-server --slot-save-path /opt/program-cache/slots --host 0.0.0.0
              ${dyn[@]+"${dyn[@]}"} ${_extra[@]+"${_extra[@]}"} )
}

# ── The llama.cfg → ENVIRONMENT tables ───────────────────────────────────────
# ⭐ A SECOND DELIVERY MECHANISM, AND IT IS NOT THE ARGV ONE. Every table above turns
# a setting into a llama-server FLAG. The three settings here have no flag at all, at
# this pin or any other: they are read by getenv() deep inside ggml and
# llama_kv_cache, so the only way to reach them is an exported environment variable.
# That also means DROSTE_LLAMA_EXTRA_ARGS cannot reach them, which is why they need
# settings rather than a line in the catch-all list.
#
# 🚨 WHY ALL THREE ARE DROSTE-NAMED, AND IT IS THE `off` PROBLEM AGAIN. Each native is
# read by a hand-rolled getenv test that looks at ONE CHARACTER (pinned 337f08e8):
#   TURBO_AUTO_ASYMMETRIC  llama-kv-cache.cpp:153-154  disabled = env && env[0]=='0'
#   TURBO_LAYER_ADAPTIVE   llama-kv-cache.cpp:321-327  atoi(env) — a mode NUMBER
#   GGML_TQ_NATIVE         ggml-cuda.cu:722-723        native   = env && env[0]=='1'
# So a user writing the native `TURBO_AUTO_ASYMMETRIC=off` gets env[0]=='o', which is
# not '0', and the feature stays ON: a value that reads as off, is rejected by
# nothing, and does nothing. That is the fall-through this project forbids outright,
# and it is the same defect as llama's switch-type flags one level down.
# ⚠️ NOTE THE TWO POLARITIES — one native disables on '0', the other ENABLES on '1'.
# A user must not be asked to hold that in their head (One Surface, Five Servers); the
# wire columns below absorb it and the surface says on/off for both.
# ⚠️ ggml-cuda.cu IS COMPILED HERE. ggml/src/ggml-hip/CMakeLists.txt:63 globs
# `../ggml-cuda/*.cu`, so the HIP build gets it. "cuda" in the path is not a filter.
#
# 🚨 PRECEDENCE, AND IT IS A CONTRACT, NOT AN IMPLEMENTATION DETAIL. Templates seed
# `if_missing`, so a box created before these settings existed may already carry a
# hand-written native line, and it must go on working:
#   droste setting UNSET or BLANK  → we do not touch the native. Whatever the user
#                                    put there stands. This is also what makes blank
#                                    behave EXACTLY as absent, which is the rule.
#   droste setting SET to a value  → OURS WINS. We export the wire (or, for `auto`,
#                                    UNSET the native), so the answer the user gave on
#                                    our surface is the answer the engine gets.
#   droste setting SET to garbage  → warn, touch nothing. Same as unset, so a typo can
#                                    never destroy a native line the user meant.
# ⭐ The middle row is why `auto` UNSETS rather than skipping: `auto` is a real answer,
# and an answer that quietly loses to a stale native line is a fall-through value.
#
# ⚠️ BLANK GUARDS: exactly ONE of the three natives needs one, and it is measured
# rather than assumed (run the reader with the name absent, run it "", diff):
#   TURBO_AUTO_ASYMMETRIC=""  env[0]=='\0' != '0' ⇒ enabled ⇒ SAME as absent. No guard.
#   GGML_TQ_NATIVE=""         env[0]=='\0' != '1' ⇒ convert ⇒ SAME as absent. No guard.
#   TURBO_LAYER_ADAPTIVE=""   atoi("") == 0 ⇒ mode 0 ⇒ DIFFERENT from absent, because
#                             absent runs the auto-enable at :329-333. Guarded below.
# A longer guard list is not a better one; the two without an entry earn their absence.
#
# ❌ GGML_TURBO_MMA_FUSED IS DELIBERATELY NOT HERE, AND THIS IS THE STATED REASON SO
# NOBODY RE-ADDS IT. It is compiled into this build (fattn.cu:193) and it has exactly
# one consumer, fattn.cu:803, whose condition includes `turing_mma_available(cc)` —
# and that is `GGML_CUDA_CC_IS_NVIDIA(cc) && …` (common.cuh:348-350), i.e.
# `cc < 0x0100000`. gfx1151 is `GGML_CUDA_CC_OFFSET_AMD + 0x1151` = 0x1001151, so the
# test is false on every box this repo builds for. The setting would be a knob that
# is present, authoritative-looking, and inert — the exact thing a fall-through is.
# ⚠️ AND DO NOT HARVEST ITS DEFAULT FROM UPSTREAM'S OWN COMMENT: fattn.cu:181 says
# "DEFAULT OFF" and :190 says "opt-in via GGML_TURBO_MMA_FUSED=1", while :194 is
# `return !(s && s[0] == '0')` — default ON. The prose and the code disagree.
#
# ❌ TURBO_INNERQ AND TURBO_INNERQ_STRENGTH ARE ALSO DELIBERATELY NOT HERE, AND THE
# REASON IS THE OPPOSITE OF MMA_FUSED'S. MMA_FUSED is dead on this hardware. These two
# are LIVE: turbo-quant.cuh:164 and :172 read them, ggml/src/ggml-hip/CMakeLists.txt:63
# globs `../ggml-cuda/*.cu` so the HIP build compiles the path, and there is no
# architecture predicate anywhere in it — the only gate is `group_size < 128`
# (turbo-quant.cuh:265-268). With our own LLAMA_ARG_CACHE_TYPE_K/V=turbo3 default the
# code runs on every K and V cache write. So this is a Feature Exposure decision under
# the rule that hiding needs a STATED reason, not a report that the feature is absent.
# 🚨 THE REASON LIVES HERE ONLY, AND THAT IS JEI'S RULING (s61), NOT AN OMISSION.
# llama.cfg carried a prose half of this in its Misc block until s60's `129499f` removed
# it. Asked whether that deletion was intended, he ruled: "all correct and intended. All
# of them. And we should fix the buildspec to match." ⇒ THE SURFACE STAYS SILENT ABOUT
# THESE TWO NAMES. ❌ Do NOT "restore the other half" — the config file is his, the
# deletion was deliberate, and re-adding it would reverse a ruling on the strength of a
# comment. ⭐ Feature Exposure asks for a reason to be WRITTEN DOWN; it does not entitle
# an agent to put it back on a surface the owner cleared.
#
# 🚨 THE REASON IS THAT WE CANNOT DOCUMENT IT HONESTLY — NOT THAT IT DOES NOTHING:
#   · THE UNIT IS UNUSABLE, AND UPSTREAM'S OWN LOG LINE IS WRONG ABOUT IT.
#     turbo-quant.cuh:184-185 prints "target=%d tokens" and :284 compares the target
#     against a counter that set-rows.cu:292 increments ONCE PER 128-ELEMENT ROTATION
#     GROUP WRITE (`if (j == 0) atomicAdd(&d_innerq_count, 1)`), i.e. roughly
#     2 × n_layer × n_head_kv per token — about 576/token on a 36-layer, 8-KV-head
#     model. Any value a user would plausibly type is reached inside the FIRST ubatch
#     of the FIRST request. ⚠️ Do not repeat upstream's word "tokens": that is the
#     LLAMA_API_KEY=none failure mode, a printed word that is prose about the value.
#   · WHAT WAS WRITTEN BEFORE IT ACTIVATES STAYS MIS-SCALED FOR THE LIFE OF THE
#     PROCESS. Nothing clears the cache at finalisation (turbo-quant.cuh:189-250). In a
#     server that is the system prompt and the start of the first conversation.
#   · THE ACTIVATION POINT IS NOT DETERMINISTIC. The host reads the counter with a
#     BLOCKING cudaMemcpyFromSymbol on the legacy default stream (:283) while ggml's
#     compute streams are created cudaStreamNonBlocking, so activation can land between
#     two layers of one forward pass.
#   · CALIBRATION IS ONCE PER PROCESS and never persisted — a plain static latch
#     (`innerq_initialized`, :156/:161-162).
#   · TURBO_INNERQ_STRENGTH IS INERT UNLESS TURBO_INNERQ IS SET. Its getenv at :172
#     sits AFTER the early return at :165-168. A fall-through value in the s52 sense,
#     and one we would be publishing ourselves.
#   · ⚠️ IT IS NOT "CLAMPED TO (0,1]" — say rejected, not clamped. :174 is
#     `if (strength <= 0.0f || strength > 1.0f) strength = 0.5f`, so `2.0` becomes
#     0.5, NOT 1.0. (The genuine [0.5, 2.0] clamp is on the derived per-channel scale,
#     a different quantity.)
#   · AND THERE IS NOTHING TO SHOW FOR IT. It changes output quality only — no memory
#     saved, negligible speed cost — and the fork publishes no measurement, not even a
#     prose claim, unlike auto-asymmetric (PPL 2887 vs 7.4) or the MMA path (KLD).
#
# ⚠️ ONE OF THE REASONS IS OURS, NOT UPSTREAM'S, AND IT BELONGS IN OUR FILE. When
# DROSTE_LLAMA_KV_AUTO_ASYMMETRIC fires — which our own turbo3/turbo3 default arms by
# construction on any high-GQA model — K is upgraded to q8_0 and only V still goes
# through the turbo set_rows path. InnerQ would then silently become V-ONLY
# equalisation, which is not the thing it was written to do. That is our default
# interacting with the feature, so it is our defect to name.
#
# ⭐ THE DOOR BACK, because a hidden feature with no way back is worse than one with a
# stated condition: if InnerQ is ever benchmarked on gfx1151 with turbo3 caches, this
# decision should be REOPENED. The blocker is a missing measurement, and a measurement
# is a thing that can arrive.
# ⚠️ BOTH ARE BLANK-SAFE AND NEITHER NEEDS A GUARD — measured the usual way, absent vs
# "": `getenv("TURBO_INNERQ")` returns a non-NULL "" whose `atoi` is 0, which fails the
# `atoi(env) <= 0` test at :165 exactly as a NULL does; STRENGTH's `atof("")` is 0.0f,
# which :174 replaces with the same 0.5f default it would have kept. Do not add one.
#
# "<SUFFIX>:<native>:<on-wire>:<off-wire>" — the variable is DROSTE_LLAMA_<SUFFIX>.
LLAMA_ENV_BOOLS=(
    "KV_AUTO_ASYMMETRIC:TURBO_AUTO_ASYMMETRIC:1:0"
    "TQ_NATIVE_WEIGHTS:GGML_TQ_NATIVE:1:0"
)
# "<SUFFIX>|<native>|<value>=<wire>|…" — llama_argv's CHOICE shape, with the native's
# name in the second field and one extra convention: a wire of `-` means DO NOT SET
# THE VARIABLE AT ALL. That is the only spelling `auto` has, because the absence is
# what runs llama-kv-cache.cpp:329-333 — the auto-enable of mode 7 when V is turbo2
# and the model has 8+ layers. Exporting a number, ANY number, suppresses it.
# ⚠️ THE MODE NUMBERS ARE NOT CONTIGUOUS AND THAT IS WHY THIS IS A WHITELIST. Upstream
# branches on 1, 2, 5, 6 and 7 (:339-369); 3 and 4 parse fine through atoi and match
# no branch, so raw numbers on the surface would hand the user two silent no-ops.
LLAMA_ENV_CHOICES=(
    "KV_LAYER_ADAPTIVE|TURBO_LAYER_ADAPTIVE|auto=-|off=0|q8-ends=1|q8-last8=2|v-turbo4-ends=5|v-turbo4-last8=6|v-q8-ends=7"
)

# llama_env — DROSTE_LLAMA_* → the exported environment. Its own function for the same
# reason llama_argv is: it can be driven alone, and it is the half of PRE_LAUNCH that
# produces no argv at all, so a test written against SERVICE is blind to it.
# ⚠️ `export`, NEVER a bare assignment: `set +a` runs before PRE_LAUNCH (the s52
# lesson), so an unexported value would never cross the exec.
llama_env() {
    local entry suffix native var val rest onw offw wire ok list pair
    local -a pairs=()

    for entry in "${LLAMA_ENV_BOOLS[@]}"; do
        suffix=${entry%%:*}; rest=${entry#*:}
        native=${rest%%:*}; rest=${rest#*:}
        onw=${rest%%:*}; offw=${rest#*:}
        var="DROSTE_LLAMA_$suffix"; val=${!var:-}
        # Unset/blank leaves the native alone — see PRECEDENCE above.
        [ -n "$val" ] || continue
        case "$(droste::bool "$val")" in
            on)  export "$native=$onw" ;;
            off) export "$native=$offw" ;;
            *)   serve::err "$var='$val' is not on/off — leaving $native alone. Use on or off. Fix it in $CFG_FILE and restart the box." ;;
        esac
    done

    for entry in "${LLAMA_ENV_CHOICES[@]}"; do
        suffix=${entry%%|*}; rest=${entry#*|}
        native=${rest%%|*}; rest=${rest#*|}
        IFS='|' read -r -a pairs <<<"$rest"
        var="DROSTE_LLAMA_$suffix"; val=${!var:-}
        [ -n "$val" ] || continue
        wire=""; ok=0
        for pair in "${pairs[@]}"; do
            if [ "${pair%%=*}" = "$val" ]; then wire=${pair#*=}; ok=1; break; fi
        done
        if [ "$ok" -eq 0 ]; then
            list=""; for pair in "${pairs[@]}"; do list="$list ${pair%%=*}"; done
            serve::err "$var='$val' is not a valid value — leaving $native alone. Valid values:$list. Fix it in $CFG_FILE and restart the box."
            continue
        fi
        if [ "$wire" = "-" ]; then unset "$native"; else export "$native=$wire"; fi
    done
}

# ── PRE_LAUNCH ───────────────────────────────────────────────────────────────
PRE_LAUNCH="llama_pre_launch"
llama_pre_launch() {
    # ── a NATIVE line whose PRINTED value does not do what it is annotated to ──
    # 🚨 llama.cfg prints `LLAMA_ARG_THREADS=-1   # -t, --threads (-1: count
    # machine's math cores)` and its header promises the values shown ARE the defaults — but
    # uncommenting that line ROUGHLY DOUBLES the thread count on an SMT machine, the
    # classic llama.cpp oversubscription regression.
    # The handler normalises before the auto-detect can ever run: arg.cpp:1159-1163
    # (pinned 337f08e8) is `n_threads = value; if (n_threads <= 0) { n_threads =
    # std::thread::hardware_concurrency(); }` — ALL SMT THREADS — and an environment
    # variable goes through that very lambda (arg.cpp:511-518 calls handler_int with
    # std::stoi(value)). Leaving the variable UNSET instead leaves common.h:59's
    # `n_threads = -1` standing for postprocess_cpu_params (common.cpp:277-281), whose
    # `< 0` branch calls common_cpu_get_num_math() — PHYSICAL/math cores
    # (common.cpp:195-212). Because the handler has already turned -1 positive, that
    # branch never fires. So the file's annotation is true only while the line stays
    # commented, and the fix is to make the documented value an ABSENCE.
    #
    # ⚠️ ONLY THE EXACT STRING `-1`, AND THE NARROWNESS IS THE POINT. `0` and other
    # negatives reach the same `<= 0` branch, but they reach it IDENTICALLY whether
    # they arrive on the command line or through the environment — there is no
    # discrepancy there for us to fix, and swallowing them would invent a behaviour
    # upstream does not have and this file does not document. `-1` is the one value
    # the file prints, the one it annotates, and the only one whose printed meaning
    # the wiring fails to deliver.
    # ⚠️ AND IT MUST BE AN `unset`, NOT A BLANK. A blank is not "no value" to llama:
    # get_value_from_env (arg.cpp:120-135) returns true for an empty string, so the
    # empty value still reaches handler_int as std::stoi("") — which throws and is
    # rethrown as a fatal startup error (arg.cpp:526-528). Nothing would start.
    # ⭐ Placement is for READABILITY, not correctness: it sits with the other
    # LLAMA_ARG_* handling above the export loop, but `unset` drops the export mark
    # along with the variable (measured), so after the loop would work identically.
    # Do not read the position as load-bearing and do not "fix" it by exporting.
    if [ "${LLAMA_ARG_THREADS:-}" = "-1" ]; then
        unset LLAMA_ARG_THREADS
    fi

    # ── the NATIVE lines that KILL THE BOX when a user CLEARS them (s57) ───────
    # 🚨 A BLANK IS NOT "NO VALUE" TO llama-server. get_value_from_env (arg.cpp:120-137,
    # pinned 337f08e8) returns TRUE for an empty string, so a line the user uncommented
    # and then emptied hands the handler "" — and the env loop (arg.cpp:509-530) passes
    # it to the handler with NO guard of any kind:
    #     handler_int      opt.handler_int(params, std::stoi(value))        :516
    #     handler_bool     opt.handler_bool(params, parse_bool_value(value)) :519
    #     handler_string   opt.handler_string(params, value)                :522
    # `std::stoi("")` throws std::invalid_argument; `parse_bool_value("")` throws
    # (arg.cpp:422-430, since "" is neither truthy nor falsey); and a handler_string
    # body throws whenever it PARSES rather than assigns. Whatever is thrown is
    # rethrown as `error while handling environment variable "…"` (arg.cpp:526-528)
    # and llama-server never starts. Making the blank reach the wire as an ABSENCE is
    # what delivers what each line already claims, with NO template edit.
    # Same shape, and the same `unset`-not-blank reasoning, as the THREADS block above.
    #
    # 🚨 THE SELECTION CRITERION IS THE HANDLER, NOT THE DISPLAYED VALUE. This list
    # used to hold 13 names and the reason recorded here was "the lines llama.cfg shows
    # BLANK". That criterion selects the wrong set: measured against the pin, llama.cfg
    # carries 83 settable native lines, of which 13 were protected, 60 are fatal on a
    # clear and only 23 are genuinely harmless. It caught 12 blanks and missed EVERY
    # line that shows a value — even though `0`, `-1`, `256`, `4096` and `turbo3` all
    # behave identically once the user empties them. Jei's ruling (s57) replaces it:
    # ⭐ ANYTHING THAT COULD TAKE DOWN THE BOX ON AN EMPTY STRING, WE UNSET IF EMPTY.
    # All 60 are named below. The 23 left off only ASSIGN their value — model paths, HF
    # repo ids, --alias, --tags, --path, --log-file, the deprecated --defrag-thold — and
    # each was read to confirm the assignment is a real no-op (ALIAS and TAGS split on
    # `,` but skip empty items; STATIC_PATH's and UI_CONFIG's consumers are `.empty()`
    # gated; LOG_FILE's fopen("") returns NULL and every write is `if (file)` gated).
    #
    # ⚠️ THE OLD NOTE ON LLAMA_ARG_TOOLS WAS WRONG AND IS GONE. It called TOOLS "THE ONE
    # THAT DOES NOT THROW… The box comes up — silently wrong". The PARSE half is right:
    # parse_csv_row("") (arg.cpp:1004-1046) never enters its loop and unconditionally
    # pushes the accumulated field at :1042, so it yields {""} — one bogus tool named ""
    # — rather than the empty vector that is the default. But the CONCLUSION is wrong,
    # because {""} is NON-empty: server.cpp:258 enters, tools.setup() runs, the
    # validation loop at server-tools.cpp:756-763 throws `unknown tool ""`, and
    # server.cpp:259-263 logs it and `return 1`s out of llama_server(). ⭐ On this pin
    # there is NO native line that survives a clear into a running-but-silently-wrong
    # server: 59 of the 60 die in arg parsing and TOOLS dies at startup.
    #
    # ⚠️ TENSOR_SPLIT and FIT_TARGET were the one pair a read-only survey could not
    # settle, and they ARE fatal. Both split with
    # `std::sregex_token_iterator{begin, end, regex{"[,/]+"}, -1}` (arg.cpp:2404-2430,
    # :2469-2493). libstdc++'s regex_token_iterator::_M_init (bits/regex.tcc:644-664)
    # sets `_M_has_m1` for the -1 submatch and, when no match is found, makes the whole
    # input a single SUFFIX token with `matched = true` and a non-null `_M_result` —
    # so the split of "" is {""}, not zero tokens. std::stof("") / std::stoull("") then
    # throw. (No C++ compiler in this box; this is read from the header, not run.)
    #
    # ⚠️ THREADS IS ON THIS LIST *AND* KEEPS ITS `-1` BLOCK ABOVE — the two defects are
    # orthogonal. `-1` is SILENTLY WRONG (the documented math-core auto-detect never
    # runs); `""` is FATAL. Fixing either does not fix the other, so do not merge them.
    # THREADS_HTTP is the deliberate contrast: it needs the blank guard and must NEVER
    # get a `-1` guard, because its `-1` is honest — the handler is a plain assignment
    # (arg.cpp:3053-3057), the default is already -1 (common/common.h:598) and the
    # derivation happens downstream at server-http.cpp:290-293.
    #
    # ⚠️ A NAMED LIST, NOT A SWEEP — droste::blank_is_unset's own comment
    # (base/resolve/droste-common.sh:85-90) is the rule, and it forbids a blanket
    # policy. Every DROSTE_LLAMA_* keeps its blank, because there a blank is the
    # documented N1a opt-out (BUILTIN_SPEC_DEFAULT= means "don't", and must go on
    # meaning it). No DROSTE_-owned name appears below; that is a standing invariant,
    # not an accident of the current contents.
    # ⭐ PLACEMENT IS ORDERING, NOT LOCATION. Nothing between here and the exec reads
    # these names, and `unset` drops the export mark along with the variable, so before
    # or after the compgen loop below is identical — measured, exactly as for THREADS.
    # 🚨 What it MUST NOT do is run BEFORE a `${LLAMA_ARG_X=…}` droste default, and as
    # of s57 that is no longer hypothetical: CACHE_TYPE_K and CACHE_TYPE_V are on BOTH
    # lists. Running last is what makes a user's `LLAMA_ARG_CACHE_TYPE_K=` mean "give me
    # llama's own f16 back" instead of silently restoring our turbo3 — the `=` (not
    # `:=`) at :296-297 lets the blank through on purpose, and this call turns it into
    # the absence llama needs. Reverse the order and the opt-out disappears.
    #
    # An array rather than 60 backslash continuations, because a `\`-continued command
    # cannot carry the per-section comments — and without them a 60-name list is a wall.
    # Order is llama.cfg's own line order, section by section, which is the order the
    # original 13 were already in.
    local -a _fatal_on_clear=(
        # Model & security
        LLAMA_ARG_API_KEY_FILE              # ifstream("") ⇒ throw
        # Context & KV Cache
        LLAMA_ARG_CTX_SIZE                  # int
        LLAMA_ARG_CACHE_TYPE_K              # kv_cache_type_from_str ⇒ Unsupported cache type
        LLAMA_ARG_CACHE_TYPE_V              # kv_cache_type_from_str ⇒ Unsupported cache type
        LLAMA_ARG_N_PREDICT                 # int
        # GPU Setup
        LLAMA_ARG_DEVICE                    # parse_device_list("") ⇒ [""] ⇒ invalid device
        LLAMA_ARG_MAIN_GPU                  # int
        LLAMA_ARG_N_GPU_LAYERS              # not auto/all ⇒ stoi("")
        LLAMA_ARG_N_GPU_LAYERS_DRAFT        # int
        LLAMA_ARG_TENSOR_SPLIT              # regex split ⇒ [""] ⇒ stof("")
        LLAMA_ARG_SPLIT_MODE                # closed menu ⇒ else arm throws
        # Multi-Model Serving
        LLAMA_ARG_MODELS_MAX                # int
        # Web UI, tools & MCP
        LLAMA_ARG_UI_CONFIG_FILE            # read_file("") ⇒ throw
        LLAMA_ARG_TOOLS                     # [""] ⇒ unknown tool "" ⇒ server.cpp returns 1
        # Speculative Decoding (draft model)
        LLAMA_ARG_SPEC_DRAFT_N_MAX          # int
        LLAMA_ARG_SPEC_DRAFT_N_MIN          # int
        LLAMA_ARG_SPEC_DRAFT_P_MIN          # stof("")
        LLAMA_ARG_SPEC_DRAFT_P_SPLIT        # stof("")
        LLAMA_ARG_SPEC_TYPE                 # unknown speculative type
        LLAMA_ARG_SPEC_DRAFT_CACHE_TYPE_K   # kv_cache_type_from_str
        LLAMA_ARG_SPEC_DRAFT_CACHE_TYPE_V   # kv_cache_type_from_str
        # Attention & Context Reuse
        LLAMA_ARG_FLASH_ATTN                # on/off/auto menu ⇒ else arm throws
        LLAMA_ARG_CHECKPOINT_MIN_SPACING_NT # int
        LLAMA_ARG_CTX_CHECKPOINTS           # int
        LLAMA_ARG_CACHE_REUSE               # int
        LLAMA_ARG_CACHE_RAM                 # int
        # Chat Templates & Reasoning
        LLAMA_ARG_CHAT_TEMPLATE_FILE        # read_file("") ⇒ throw
        LLAMA_ARG_CHAT_TEMPLATE_KWARGS      # json::parse("") ⇒ throw
        LLAMA_ARG_THINK                     # Unknown reasoning format (chat.cpp:785-799)
        LLAMA_ARG_REASONING                 # on/off/auto menu ⇒ else arm throws
        LLAMA_ARG_THINK_BUDGET              # int
        # Endpoints, Slots, & Server Identity
        LLAMA_ARG_TIMEOUT                   # int
        LLAMA_ARG_SSE_PING_INTERVAL         # int
        LLAMA_ARG_POOLING                   # closed menu ⇒ else arm throws; the real
                                            # default (UNSPECIFIED) has no spelling in it
        # Multimodal
        LLAMA_ARG_IMAGE_MIN_TOKENS          # int
        LLAMA_ARG_IMAGE_MAX_TOKENS          # int
        LLAMA_ARG_MTMD_BATCH_MAX_TOKENS     # int
        # Batching & Parallelism
        LLAMA_ARG_BATCH                     # int
        LLAMA_ARG_UBATCH                    # int
        LLAMA_ARG_N_PARALLEL                # int (registered twice: arg.cpp:2161, :2172)
        LLAMA_ARG_THREADS_HTTP              # int — blank guard ONLY, never a -1 guard
        LLAMA_ARG_THREADS                   # int — this AND the -1 block above
        # Memory, Offload, & NUMA
        LLAMA_ARG_N_CPU_MOE                 # int
        # Fitting to available memory
        # ⚠️ LLAMA_ARG_FIT HAS LEFT THE SURFACE — it is a droste-named setting now,
        # see LLAMA_ONOFF_FLAGS above — AND THE GUARD STAYS ANYWAY, for the HOST
        # reason plus one of its own. The name still works — llama reads it
        # whatever we do — and templates
        # seed `if_missing`, so a box made before the rename still carries the old
        # line. More to the point, our `--fit` cannot save it: the env loop runs
        # BEFORE argv (arg.cpp:509-530 then :539+), so a blank throws at :2450 long
        # before any flag of ours is looked at. Dropping this row would make an
        # emptied line fatal again with nothing left to catch it.
        LLAMA_ARG_FIT                       # on/off menu ⇒ else arm throws
        LLAMA_ARG_FIT_TARGET                # regex split ⇒ [""] ⇒ stoull("")
        LLAMA_ARG_FIT_CTX                   # int
        # Numeric Tweaks
        LLAMA_ARG_TOP_K                     # int
        # RoPE & YaRN context scaling
        LLAMA_ARG_ROPE_SCALING_TYPE         # closed menu ⇒ else arm throws; ditto
                                            # UNSPECIFIED having no spelling
        LLAMA_ARG_ROPE_SCALE                # 1.0f/stof("")
        LLAMA_ARG_ROPE_FREQ_BASE            # stof("")
        LLAMA_ARG_ROPE_FREQ_SCALE           # stof("")
        LLAMA_ARG_YARN_ORIG_CTX             # int
        LLAMA_ARG_YARN_EXT_FACTOR           # stof("")
        LLAMA_ARG_YARN_ATTN_FACTOR          # stof("")
        LLAMA_ARG_YARN_BETA_FAST            # stof("")
        LLAMA_ARG_YARN_BETA_SLOW            # stof("")
        # Additional Advanced Flags
        LLAMA_ARG_OVERRIDE_TENSOR           # no `=` in the token ⇒ invalid value
        # Logging & diagnostics
        LLAMA_ARG_LOG_COLORS                # on/off/auto menu ⇒ else arm throws
        LLAMA_ARG_LOG_VERBOSITY             # int
        # RPC
        LLAMA_ARG_RPC                       # add_rpc_devices("") ⇒ [""] ⇒ throw / "" endpoint
    )

    # ── the blanks that do NOT throw and are still wrong (s58) ─────────────────
    # 🚨 "DOES IT THROW" WAS THE INSTRUMENT, NOT THE STANDARD. The 60 above were chosen
    # because they die in arg parsing, and the 23 left over were cleared as "only
    # ASSIGN their value". Under Jei's rule that is the wrong question to have asked.
    # ⭐ ASK WHAT THE USER WOULD REASONABLY EXPECT — and it is almost always A DEFAULT.
    # So a blank yields the default (we unset it) unless the setting is one of the
    # narrow exceptions. Three categories; 1 and 2 are unset, 3 is left alone:
    #   1) a blank crashes the server or leaves it UNHEALTHY.
    #   2) the value is NUMERIC or comes from a practically FINITE set (bool, enum,
    #      menu). Such a setting has default behaviour and must fall back to it —
    #      whether or not the blank crashes.
    #   3) an UNBOUNDED string whose blank is itself a MEANINGFUL answer: "no chat
    #      template", "no log file", "no TLS certificate", "no model". Erasing that
    #      would delete a real capability, so it stays.
    #
    # ⭐ RE-READ AT THE PIN, ALL 23, AND 22 OF THEM STAY — the earlier verdict survives
    # the wider standard, which is worth recording because it did NOT survive on the
    # vllm box. They are the model paths and repo ids (MODEL, MODEL_URL, HF_REPO,
    # HF_FILE, HF_REPO_V, HF_FILE_V, DOCKER_REPO, MMPROJ, MMPROJ_URL, MODELS_DIR,
    # MODELS_PRESET, SPEC_DRAFT_MODEL, SPEC_DRAFT_HF_REPO), the files (CHAT_TEMPLATE,
    # UI_CONFIG, STATIC_PATH, LOG_FILE, SSL_KEY_FILE, SSL_CERT_FILE), the two
    # comma-lists (ALIAS, TAGS) and THINK_BUDGET_MESSAGE. Every one is a
    # `std::string x = ""` in common.h (:279, :293-298, :606-646), so ""
    # IS the default and a blank is byte-identical to an absence; ALIAS and TAGS split
    # on `,` and skip empty items (arg.cpp:2584-2614); LOG_FILE's fopen("") returns NULL
    # and set_file stores nullptr, which is what it already held (log.cpp:308-322);
    # STATIC_PATH is `.empty()`-gated at server-http.cpp:314. HF_TOKEN and LLAMA_API_KEY
    # are both category 3, but ⚠️ NOT FOR THE SAME REASON — this entry said they were
    # until s59 and the shared citation was LLAMA_API_KEY's alone:
    #   LLAMA_API_KEY  `parse_csv_row("")` yields {""} and the `if (!key.empty())` at
    #                  arg.cpp:2985-2991 drops it, so a blank leaves auth OFF rather
    #                  than enabling it with an empty key.
    #   HF_TOKEN       has no parsing at all — arg.cpp:2664-2670 is `params.hf_token =
    #                  value`, common.h:484 already initialises it to "", and every
    #                  consumer is emptiness-gated: `if (!opts.bearer_token.empty())`
    #                  before the Authorization header (download.cpp:313-314) and
    #                  `is_valid_hf_token(token)` … `else if (!token.empty())` for the
    #                  API path (hf-cache.cpp:207-211). So "" IS the default here.
    # ⭐ Right conclusion, wrong mechanism, and it mattered: the API-key reasoning is
    # about a PARSER dropping an empty field, which is exactly the kind of thing that
    # changes upstream. Attaching HF_TOKEN to it would have made a live re-check of
    # arg.cpp:2985-2991 look like a re-check of both.
    # The five TURBO_* names llama.cfg's Misc block lists AS ASSIGNMENT LINES are
    # Metal-only and cannot be compiled into a ROCm build — TURBO_FLASH and
    # TURBO_FORCE_NONVEC in ggml/src/ggml-metal/ggml-metal-ops.cpp (:2744, :2711), and
    # TURBO_FORCE_4MAG, TURBO_SPARSE_V and TURBO_PROFILE_MODE in
    # ggml/src/ggml-metal/ggml-metal-device.m (:232, :245, :258).
    # ⚠️ This entry named ggml-metal-ops.cpp for all five until s59. It then said the Misc
    # block ALSO names TURBO_INNERQ and TURBO_INNERQ_STRENGTH in prose — TRUE when written,
    # FALSE since `129499f` removed that paragraph. ✅ Jei ruled that removal INTENDED
    # (s61), so the block lists exactly the five ASSIGNMENT LINES and says nothing about
    # the InnerQ pair; their reason lives in this file alone (see the ❌ block above).
    # ⚠️ AND "TURBO_* IS METAL-ONLY" IS NOT A RULE — TURBO_AUTO_ASYMMETRIC and
    # TURBO_LAYER_ADAPTIVE live in src/llama-kv-cache.cpp, are backend-independent, and
    # are settings on this box (see the ENVIRONMENT tables above).
    # 📐 THE WHOLE FAMILY IS ELEVEN NAMES at this pin, so no partial list may imply it is
    # the family: the five Metal ones above, GGML_TURBO_MMA_FUSED (compiled, dead on
    # gfx1151), the three we expose (TURBO_AUTO_ASYMMETRIC, TURBO_LAYER_ADAPTIVE,
    # GGML_TQ_NATIVE), and TURBO_INNERQ + TURBO_INNERQ_STRENGTH. Counted by grepping
    # getenv() across every file this spec cites plus the InnerQ path — an earlier sweep
    # said nine because it looked only at C/C++ extensions and missed the `.m` files.
    local -a _wrong_on_clear=(
        # ── category 1: a blank MOVES THE LISTENER and the healthcheck cannot find it ──
        # 🚨 THIS IS THE ONE THE READ-ONLY SWEEP COULD NOT HAVE FOUND, because nothing
        # throws anywhere. `params.hostname = "127.0.0.1"` (common/common.h:606) and the
        # handler is a plain assignment (arg.cpp:2848-2850), so a blank makes it "".
        # cpp-httplib then does `if (!host.empty()) { node = host.c_str(); }`
        # (httplib.cpp:2170-2176) — an empty host leaves node NULL — and llama calls
        # bind_to_port with NO socket flags, so AI_PASSIVE is not set. MEASURED HERE:
        # getaddrinfo(NULL, port, AF_UNSPEC, flags=0) returns ::1 FIRST and 127.0.0.1
        # second, and httplib binds the first that succeeds. So the server comes up on
        # IPv6 loopback ONLY, the health probe asks `serve::probe_addr` (which resolves
        # to 127.0.0.1 for a 0.0.0.0 bind), gets no response at all, and the box
        # restart-loops while looking, from inside, like a perfectly healthy server.
        # ⚠️ IT IS NOT A SETTABLE LINE — llama.cfg names it only in the "Reserved by
        # Droste (do not set these)" prose at :17. It is guarded anyway BECAUSE it is
        # named there: "do not set this" is exactly the instruction a careful user obeys
        # by writing `LLAMA_ARG_HOST=`, and that is the one spelling that breaks the box.
        # ⭐ SINCE s60 THE GUARD IS BELT-AND-BRACES RATHER THAN THE ONLY THING STANDING
        # THERE, AND IT STAYS FOR EXACTLY THAT REASON. llama_argv now bakes `--host
        # 0.0.0.0` and argv is parsed after the environment, so a blank native can no
        # longer move the listener. Dropping this row would make the box depend on that
        # ordering holding forever, and on nobody ever making the flag conditional —
        # neither is a thing to bet a box on, and the failure is invisible from inside.
        LLAMA_ARG_HOST
        # ── category 2: numeric, so it has a default and must fall back to it ──
        # The mildest member of either list, and included for the rule rather than for
        # the damage: the handler is `GGML_UNUSED(params); GGML_UNUSED(value);` plus a
        # deprecation LOG_WRN (arg.cpp:2151-2157), so a blank changes no parameter at
        # all — it just prints a DEPRECATED warning the user did not earn by setting
        # anything. Numeric value, therefore category 2, therefore unset.
        LLAMA_ARG_DEFRAG_THOLD
    )

    # ── the same rule, on a native that is NOT an LLAMA_ARG_ line (s59) ────────
    # 🚨 A SEPARATE ARRAY BECAUSE IT IS A SEPARATE CLAIM. Both lists above are about
    # llama.cfg's LLAMA_ARG_* settings and were audited as that set; this name is read
    # by llama_kv_cache, not by the argument parser, so it belongs to neither audit and
    # must not silently inflate either count.
    # TURBO_LAYER_ADAPTIVE is the ONE of the three ENVIRONMENT-table natives whose
    # blank differs from its absence, measured at the pin rather than assumed:
    # llama-kv-cache.cpp:321-327 does `if (env) { return atoi(env); }`, and atoi("")
    # is 0 — mode 0, uniform. An ABSENT variable instead falls through to :329-333,
    # which auto-enables mode 7 when V is turbo2 and the model has 8+ layers. So a
    # blank does not mean "leave it alone", it means "suppress the auto behaviour" —
    # category 2 (a finite set of modes), so the blank must give the default back.
    # ⚠️ The other two natives are deliberately absent: TURBO_AUTO_ASYMMETRIC tests
    # env[0]=='0' and GGML_TQ_NATIVE tests env[0]=='1', so "" is already identical to
    # unset for both and a guard would be dead weight that reads as coverage.
    # ⚠️ IT IS NAMED HERE RATHER THAN ON THE SURFACE, exactly like LLAMA_ARG_HOST: the
    # user's setting is DROSTE_LLAMA_KV_LAYER_ADAPTIVE, but the native is named in the
    # comments beside it, and "here is the variable it drives" is the one hint a
    # careful user needs to go and write `TURBO_LAYER_ADAPTIVE=` themselves.
    local -a _turbo_blank_is_unset=(
        TURBO_LAYER_ADAPTIVE                # atoi("") == 0 ⇒ suppresses the auto mode
    )

    # ── a third separate claim: the cache-directory chain's own native ─────────
    # 🚨 A SEPARATE ARRAY BECAUSE IT IS A SEPARATE CLAIM, exactly as above. LLAMA_CACHE
    # is read by neither the argument parser nor llama_kv_cache, so it belongs to none
    # of the three audits and must not silently inflate any of their counts.
    # 🚨 AND IT IS FATAL, MEASURED FROM THE PINNED SOURCE (337f08e8). There are TWO
    # cache-directory chains in this tree and they do NOT agree about blanks:
    #   common/hf-cache.cpp:51   `if (auto * p = std::getenv(entry.var); p && *p)` over
    #                            six rungs (LLAMA_CACHE, HF_HUB_CACHE,
    #                            HUGGINGFACE_HUB_CACHE, HF_HOME, XDG_CACHE_HOME, HOME)
    #                            ⇒ blank IS absent there. Nothing to fix.
    #   common/common.cpp:995    `if (getenv("LLAMA_CACHE"))`  — a BARE presence test
    #   common/common.cpp:1000   `if (std::getenv("XDG_CACHE_HOME"))` — likewise
    # In fs_get_cache_directory a blank is non-NULL, so cache_directory becomes "" and
    # reaches ensure_trailing_slash (:988-994), whose `p.back()` on an EMPTY std::string
    # is undefined behaviour. What it reads decides between two failures: "/llama.cpp/",
    # a path at the filesystem ROOT the box user cannot create — fs_get_cache_file
    # (:1032-1039) then throws "failed to create cache directory" and startup dies — or
    # "llama.cpp/", relative to the server's CWD, i.e. inside the container. Neither is
    # a cache behind a bind, and the blank LLAMA_CACHE arm skips the `+= "llama.cpp"`
    # line entirely, so it is worse still.
    # ⭐ THAT IS WHY THE XDG RULING BELOW IS THE RIGHT SHAPE AND A PER-VARIABLE SURVEY
    # WAS NOT: llama was previously excluded from the XDG guard on the ground that "the
    # C++ guards every rung with `p && *p`" — TRUE of chain A and FALSE of chain B, in
    # the same repository, for the same variable.
    # ⚠️ LLAMA_CACHE IS NOT AN XDG NAME, so it is fixed HERE, by this box's own
    # convention, rather than being smuggled into a family the ruling defined.
    local -a _cache_blank_is_unset=(
        LLAMA_CACHE                         # common.cpp:995 is a bare getenv() test
    )
    droste::blank_is_unset "${_fatal_on_clear[@]}" "${_wrong_on_clear[@]}" \
                           "${_turbo_blank_is_unset[@]}" \
                           "${_cache_blank_is_unset[@]}"

    # ── the XDG bases llama.cfg never names, whose blank breaks the cache dir ──
    # 🚨 THE GUARD COVERS THE WHOLE XDG BASE-DIRECTORY FAMILY, NOT ONLY THE NAME WITH A
    # MEASURED CONSUMER — RULED BY JEI: "overruled. All XDG variables should be treated
    # the same; it's too confusing to have varying implementation." That DELIBERATELY
    # OVERRIDES "each entry earns its place by a MEASURED difference" FOR THIS FAMILY,
    # and it is "One Surface, Five Servers" pointed inward: a user must not have to
    # learn which box guards which XDG name. It is the second application of the same
    # instinct — s58 ruled the identical widening for the `loud` treatment.
    # ⭐ ON THIS BOX ONE RUNG IS A REAL FIX AND THE REST ARE NO-OPS, WHICH IS THE
    # RULING'S POINT RATHER THAN AN ARGUMENT AGAINST IT. XDG_CACHE_HOME is the fix —
    # common.cpp:1000, the bare presence test described above. In hf-cache.cpp's chain
    # the same name already skips blanks, so there the loop changes nothing.
    # ⭐ THE FAMILY IS THE FREEDESKTOP BASE DIRECTORY SPECIFICATION'S SEVEN VARIABLES,
    # IN SPEC ORDER: the four user directories, the runtime directory, and the two
    # search LISTS. The boundary is a document rather than a judgement, which is what
    # makes "all of them" an answerable claim. XDG_BIN_HOME is NOT in the spec (which
    # defines only the ~/.local/bin convention, with no variable) and is excluded; so
    # are the session names (XDG_SESSION_TYPE, XDG_CURRENT_DESKTOP, XDG_SEAT, XDG_VTNR,
    # …), which are not directory settings at all and belong to a display stack this
    # image does not run.
    # ⚠️ THE LOOP BELOW IS BYTE-IDENTICAL IN ALL FIVE BUILD-SPECS. If the list changes,
    # it changes in all five in the same commit: a family that differs by box is the
    # exact confusion this ruling removed.
    # ⚠️ AND IT IS NOT FOLDED INTO THE CALL ABOVE — that helper's callers are audited
    # against what each box's .cfg EXPOSES, and vllm's suite asserts exactly that
    # ("every guarded name is exposed by vllm.cfg"). A separate loop is how the family
    # stays identical on all five without making that check false on one. LLAMA_CACHE
    # goes through the call because it is llama's own native and has no such family.
    # ⚠️ IT SITS AFTER droste::blank_is_unset AND BEFORE THE DEFAULTS BELOW, for the
    # same reason every other normalisation here does: blanks become absences FIRST,
    # our defaults apply SECOND. Nothing below reads an XDG name today, so this is
    # placement for uniformity with the other four boxes, not for correctness.
    # ⚠️ SILENT, like every other blank guard: the blank IS the request for the default.
    local _xdg
    for _xdg in XDG_DATA_HOME XDG_CONFIG_HOME XDG_STATE_HOME XDG_CACHE_HOME \
                XDG_RUNTIME_DIR XDG_DATA_DIRS XDG_CONFIG_DIRS; do
        if [ -n "${!_xdg+set}" ] && [ -z "${!_xdg}" ]; then
            unset "$_xdg"
        fi
    done

    # ── a droste-supplied default on a NATIVE name (N9, ruled by Jei s56) ──────
    # llama.cfg shows LLAMA_ARG_CACHE_TYPE_K/V=turbo3. When this was written its menu
    # starred f16 while the shown value said turbo3, and the file header promises the
    # shown value IS the default — the file contradicting ITSELF, which no rule could
    # settle. Jei ruled: "our default should be turbo3." ✅ HE THEN MADE THE FILE AGREE:
    # the menu now reads `{f32, f16, …, turbo3*, turbo4}`. The contradiction is gone, so
    # do not go looking for it; this comment records why the default is ours to set.
    # ⭐ turbo3 is a real member of that menu, so this is a choice between two legal
    # values, not a value the parser would reject.
    # ⚠️ REAL BEHAVIOUR CHANGE, and unmeasured on hardware: KV quantisation buys
    # cache footprint at some quality cost. Both K and V, because the file shows both.
    # ✅ `=` not `:=`, and set before the compgen loop below so it is exported with
    # every other LLAMA_*: llama-server reads these from its ENVIRONMENT, not argv,
    # so the default has to cross the exec like a user's own value would.
    #
    # 🚨 IT MUST RUN *AFTER* blank_is_unset, AND THAT ORDER IS THE WHOLE POINT (s57,
    # Jei: "blank should give *our* default, not the *engine* default. It sounds like
    # the unset is not happening before it gets to the server?" — exactly right).
    # `=` does not substitute for a variable that is SET BUT BLANK, so with these two
    # lines ABOVE the unset, a user who cleared the line got: default line declines to
    # fire (the name is set) → blank_is_unset deletes it → nothing re-applies ours →
    # llama's own f16. Blank and absent gave DIFFERENT answers, which is the one thing
    # the rule forbids. Normalising blanks to absences FIRST and applying our defaults
    # SECOND makes them identical by construction.
    # ⭐ GENERALISES: any future droste default on a native name works automatically
    # if it sits below this line, and is silently wrong if it sits above it.
    # ⚠️ This REVERSES the s56 ordering note that put the defaults first. That note
    # was written to protect a blank as the user's opt-out; Jei's s57 rule replaced
    # that reading for anything from a finite set, and a KV cache type is one.
    : "${LLAMA_ARG_CACHE_TYPE_K=turbo3}"
    : "${LLAMA_ARG_CACHE_TYPE_V=turbo3}"

    # ── the settings that reach the engine as ENVIRONMENT, not as argv ─────────
    # 🚨 IT MUST RUN AFTER droste::blank_is_unset ABOVE, for the same reason the two
    # cache-type defaults do: a user's blank native TURBO_LAYER_ADAPTIVE has to be an
    # absence before anything else looks at it. Nothing here reads the cache types, so
    # its position relative to the two lines above is free; its position relative to
    # the unset is not.
    # ⭐ It is also why these three are NOT droste defaults in the N1a sense: llama.cfg
    # shows on / auto / off for them, and those are upstream's own defaults, delivered
    # by not setting anything. "File states a default; wiring delivers it ⇒ nothing."
    llama_env

    # Both resolvers hand CFG_FILE to droste::cfg_apply, which EXPORTS every name
    # the file introduced (see droste-cfgapply.sh), so its assignments already survive
    # the exec. This loop is belt-and-braces for a LLAMA_* the user exported into the
    # container's create-time env instead, and for any future caller that applies the
    # file some other way. llama-server reads LLAMA_ARG_* from its ENVIRONMENT, so they
    # have to survive the exec either way.
    # ⭐ IT DELIBERATELY DOES NOT COVER DROSTE_LLAMA_*, and that is not an oversight of
    # the s54 rename: those names are OURS, llama-server has never heard of them, and
    # llama_argv reads them out of this shell by indirect expansion whether they are
    # exported or not. Nothing droste-named needs to cross the exec.
    local v
    for v in $(compgen -v LLAMA_ || true); do
        export "${v?}"
    done

    # Pre-create the slot save dir (fixed default path). Saved slots are CACHE
    # class — regenerable session state — so the dir lives on
    # /opt/program-cache, outside compute/ because it is deliberately per-box
    # (see CACHES above). Harmless if the user re-points --slot-save-path via
    # DROSTE_LLAMA_EXTRA_ARGS.
    mkdir -p /opt/program-cache/slots

    # Rebuild SERVICE now that DROSTE_LLAMA_EXTRA_ARGS is known. The pinned fork's
    # --slot-save-path carries no env annotation, so it rides the command line —
    # OUR flag FIRST so a user's own --slot-save-path inside
    # DROSTE_LLAMA_EXTRA_ARGS (parsed later) wins.
    # Quote-aware split (droste::split_args): a value MAY contain spaces, so
    # --grammar, -j/--json-schema, -r/--reverse-prompt, --override-kv and paths
    # with spaces are reachable through the catch-all. It also does not glob.
    # A token FILE has no upstream flag — llama-server reads the token from HF_TOKEN
    # or --hf-token and nowhere else (arg.cpp:2665; download.cpp consumes only
    # opts.bearer_token), and it does NOT read huggingface-cli's login cache. So this
    # setting is ours to implement, and exporting beats emitting --hf-token "$(cat …)"
    # because the flag form would put the secret in the process command line where
    # any `ps` in the box can read it.
    if [ -n "${DROSTE_LLAMA_HF_TOKEN_FILE:-}" ]; then
        if [ -r "$DROSTE_LLAMA_HF_TOKEN_FILE" ]; then
            HF_TOKEN=$(head -n1 "$DROSTE_LLAMA_HF_TOKEN_FILE" 2>/dev/null | tr -d '\r\n')
            if [ -n "$HF_TOKEN" ]; then
                export HF_TOKEN
            else
                serve::err "DROSTE_LLAMA_HF_TOKEN_FILE=$DROSTE_LLAMA_HF_TOKEN_FILE is empty — no Hugging Face token set. Gated repositories will fail to download."
            fi
        else
            serve::err "DROSTE_LLAMA_HF_TOKEN_FILE=$DROSTE_LLAMA_HF_TOKEN_FILE cannot be read — no Hugging Face token set. Gated repositories will fail to download."
        fi
    fi

    # Build the argv. Everything above is a side effect; this is the product.
    llama_argv

    # --api-prefix moves EVERY route, /health included (server-http.cpp:529 registers
    # `api_prefix + path` for all of them), so HEALTH_PATH above would 404 and the box
    # would restart-loop. Tell the probe where the routes went.
    # ⭐ OBSERVED, NOT OWNED: llama reads LLAMA_ARG_API_PREFIX itself and CFG_FILE was
    # sourced under `set -a` before this hook ran, so the value is simply here to be
    # read. We pass it through unprocessed and only watch it — which is why it keeps
    # llama's own name rather than becoming a DROSTE_LLAMA_* setting.
    # Command line beats environment in llama (env is applied first, argv second), and
    # _extra lands on the command line, so a prefix there wins the same way it does for
    # the server.
    local _prefix
    _prefix=$(droste::arg_value --api-prefix ${_extra[@]+"${_extra[@]}"})
    [ -n "$_prefix" ] || _prefix=${LLAMA_ARG_API_PREFIX:-}
    droste::set_health_prefix "$_prefix"
}
