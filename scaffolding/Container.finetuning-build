# droste-finetuning-build: builds LLM-Finetuning tools (various repositories) against pinned SDK

# Overrideable Arguments - General Build (override with '--build-arg <ARG_NAME>=<VALUE>'
ARG SERIES_NAME=droste
ARG ARCH_NAME=halo
ARG TARGET_NAME=finetuning-build
ARG BUILDER_DESC="builder image for bitsandbytes & custom RCCL"


ARG DESCRIPTION="compiled outputs for finetuning image"

# Image Names
ARG BASE_IMAGE=localhost/${SERIES_NAME}-build-base-${ARCH_NAME}

# Build image
FROM ${BASE_IMAGE} AS builder
ARG SERIES_NAME TARGET_NAME ARCH_NAME BUILDER_DESC
LABEL description="${SERIES_NAME}-${TARGET_NAME}-${ARCH_NAME}: ${BUILDER_DESC}"

# ROCm Pin: inherited from the build base as /etc/droste/rocm-version.env; every RUN
# below that needs a version or the gfx target sources it (no ARG, no --build-arg).

# Pinned dependencies
ARG BITSANDBYTES_REPO=https://github.com/bitsandbytes-foundation/bitsandbytes.git
ARG BITSANDBYTES_REF=8ab26f751931610043f34938720d423bc80f5896
ARG RCCL_REPO=https://github.com/kyuz0/rocm-systems.git
ARG RCCL_REF=a2686c9f41e44a75459e4771b7f380358432b294

# Install torch & upgraded dependencies
# uv (staged migration, s45 — BUILD-ONLY image, never shipped; same measured shape as
# Container.vllm-build's torch line).
# The wheel step further down is `uv build --wheel`, NOT `pip wheel` — the same operation
# under a different VERB. ("uv has no `pip wheel` equivalent" was retracted s45; it came
# from reading `uv pip --help`, which is not `uv --help`.) MEASURED against uv 0.12.5
# before the swap, worst risk first:
#   * the build backend runs under $VIRTUAL_ENV's interpreter (an image ENV from the
#     runtime base) even with that venv off PATH ⇒ it compiles against the SAME torch the
#     RUN above installs;
#   * uv and pip emit the SAME wheel filename — both delegate naming to the backend — so
#     the `bitsandbytes-*.whl` glob the next stage installs by still matches;
#   * `--no-build-isolation` means the same thing and is equally lax in both: neither
#     enforces build-system.requires when it is passed.
# `--no-deps` has no counterpart and needs none: `uv build` builds this project only.
# → notebook/plans/uv-migration-completion-s45.md item 1.
RUN . /etc/droste/rocm-version.env && \
      uv pip install --index-url ${ROCM_INDEX_URL} "torch==${TORCH_VERSION}" && \
      uv pip install --upgrade scikit-build-core setuptools wheel

RUN apt-get -qq update && apt-get -qq install -y --no-install-recommends \
      libdrm-dev && rm -rf /var/lib/apt/lists/* && apt-get clean

# bitsandbytes
RUN mkdir -p /artifacts/wheels /artifacts/lib64
WORKDIR /opt
RUN . /etc/droste/rocm-version.env \
    && git clone "${BITSANDBYTES_REPO}" bitsandbytes \
    && cd bitsandbytes \
    && git checkout "${BITSANDBYTES_REF}" \
    && cmake -S . -DGPU_TARGETS="${GFX_TARGET}" \
              -DBNB_ROCM_ARCH="${GFX_TARGET}" \
              -DCOMPUTE_BACKEND=hip \
    && make -j"$(nproc)" \
    && uv build --wheel --no-build-isolation -o /artifacts/wheels .

# Custom RCCL
WORKDIR /opt
RUN . /etc/droste/rocm-version.env \
    && mkdir -p rocm-systems && cd rocm-systems \
    && git init -q && git remote add origin "${RCCL_REPO}" \
    && git fetch --depth 1 origin "${RCCL_REF}" && git checkout -q FETCH_HEAD \
    && cd projects/rccl \
    && mkdir -p "build_${GFX_TARGET}" && cd "build_${GFX_TARGET}" \
    && HIPCC="$(command -v hipcc)" \
    && CXX="${HIPCC}" cmake .. \
        -DCMAKE_CXX_COMPILER="${HIPCC}" \
        -DDEFAULT_GPUS="${GFX_TARGET}" \
        -DGPU_TARGETS="${GFX_TARGET}" \
        -DAMDGPU_TARGETS="${GFX_TARGET}" \
        -DCMAKE_INSTALL_PREFIX=./install \
        -DBUILD_TESTS=OFF \
        -DGENERATE_SYM_KERNELS=OFF \
        -DENABLE_AMDSMI=OFF \
        -DCMAKE_BUILD_TYPE=Release \
    && make -j"$(nproc)" \
    && cp -Lv librccl.so.1 /artifacts/lib64/librccl.so.1

# Copy artifacts
FROM scratch
ARG SERIES_NAME TARGET_NAME ARCH_NAME DESCRIPTION
LABEL description="${SERIES_NAME}-${TARGET_NAME}-${ARCH_NAME}: ${DESCRIPTION}"
COPY --from=builder /artifacts /artifacts
