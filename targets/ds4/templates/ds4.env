# ds4.env -- ds4-server configuration (this file IS the config surface).
#
# Most settings ship commented out; default values are shown in the commented
# configuration example line and marked with "*" in the list. Uncomment a line
# to override it. The braced list holds supported values; hidden values are
# those which are unusable, unstable, or unhelpful on this build.
#
# DS4 has no native per-flag environment variables, so Droste translates the
# DROSTE_DS4_* settings below into command-line flags. Droste and DS4 defaults
# can differ due to optimizations Droste incorporates. Variables read by the
# binary ITSELF are in a section near the end; the pass through untranslated.
#
# Mutually exclusive options share one variable so an illegal pair cannot be
# written. Descriptions follow "--help" at the pinned commit with additional
# notes for clarity when practical; they are not identical to documentation.
#
# Reserved by Droste (do not set these)
# -------------------------------------
# Droste needs these arguments to remain unchanged for setup & teardown;
# changes are likely to break the box boot, services, and/or functionality.
#
# {address}, 
# DROSTE_DS4_HOST=0.0.0.0   --host, 
#   --port      server's network port.


# Extra Arguments (options this file does not cover)
# --------------------------------------------------
# A "catch-all" setting for user-elected parameters. "Mix and match" with other
# settings may cause boot failure due to exclusions, so users should confirm
# the absence of argument conflicts in advance.
#
# Entry should be one quoted value; it is then split on whitespace into separate
# arguments, so an individual argument cannot itself contain spaces. Unused and
# tuning-only arguments are listed at the end of this file.
#
# DROSTE_DS4_EXTRA_ARGS="--warm-weights --debug" # exmaple only


# Model (the weights to serve)
# ----------------------------
# {<absolute path>}
#
# Covers: --model
#
# DROSTE_DS4_MODEL=/opt/models/ds4flash.gguf    # Change if path is different!


# Backend (where engine runs)
# ---------------------------
# {rocm*, cpu}
#
# Covers: --backend (and --rocm / --cpu shorthand variants)
#
# DROSTE_DS4_BACKEND=rocm


# Context Size (tokens the model can attend to)
# ---------------------------------------------
# {<number of tokens>}
#
# Covers: --ctx
#
# DROSTE_DS4_CTX=65536    # 64K. **Think Max requires 393216 (384K) or more.


# Response Length (default cap on tokens generated per response)
# --------------------------------------------------------------
# {<number of tokens>}
#
# Covers: --tokens
#
# DROSTE_DS4_TOKENS=393216    # API client may override this.


# Prefill Chunk (prompt tokens processed per batch)
# -------------------------------------------------
# {<number of tokens>}
#
# Covers: --prefill-chunk
#
# DROSTE_DS4_PREFILL_CHUNK=8192    # Prompt size if smaller than 8192


# Power (percentage of available compute to use)
# ----------------------------------------------
# {<1..100>, 100*}
#
# Covers: --power
#
# DROSTE_DS4_POWER=100


# Speculative Decoding (MTP -- multi-token prediction)
# ----------------------------------------------------
# {<path>}, {<count>} / {<margin>}
#
# Covers: --mtp, --mtp-draft, --mtp-margin
#
# DROSTE_DS4_MTP=              # path to optional MTP speculative-decoding GGUF
# DROSTE_DS4_MTP_DRAFT=1       # draft tokens/step (max 16; if 1, doesn't run.)
# DROSTE_DS4_MTP_MARGIN=3.0    # acceptance margin. (clamped to range 0..1000)


# Quality Mode (strict speculative acceptance)
# --------------------------------------------
# {on, off*}
#
# Covers: --quality
#
# DROSTE_DS4_QUALITY=off


# Warm Weights (touch all weights at load)
# ----------------------------------------
# {on, off*}
#
# Covers: --warm-weights
#
# DROSTE_DS4_WARM_WEIGHTS=off


# KV Cache (in memory)
# --------------------
# {<tokens>} (defaults vary)
#
# Covers: --kv-cache-min-tokens, --kv-cache-cold-max-tokens,
#         --kv-cache-continued-interval-tokens, --kv-cache-boundary-trim-tokens,
#         --kv-cache-boundary-align-tokens
#
# DROSTE_DS4_KV_CACHE_MIN_TOKENS=512
# DROSTE_DS4_KV_CACHE_COLD_MAX_TOKENS=30000    # 0 -> unlimited (>= MIN_TOKENS)
# DROSTE_DS4_KV_CACHE_CONTINUED_INTERVAL_TOKENS=10000
# DROSTE_DS4_KV_CACHE_BOUNDARY_TRIM_TOKENS=32
# DROSTE_DS4_KV_CACHE_BOUNDARY_ALIGN_TOKENS=2048
#
#
# {on, off*}
#
# Covers: --kv-cache-reject-different-quant
#
# DROSTE_DS4_KV_CACHE_REJECT_DIFFERENT_QUANT=off # ignore other quant caches


# KV Disk Cache (session cache on disk)
# -------------------------------------
# {<path>} and {<MiB>}
#
# Covers: --kv-disk-dir, --kv-disk-space-mb
#
# DROSTE_DS4_KV_DISK_DIR=/opt/program-cache/kv-disk
# DROSTE_DS4_KV_DISK_SPACE_MB=4096


# Tool Calling & Reasoning Replay
# -------------------------------
# {<count>} and {on*, off}
#
# Covers: --tool-memory-max-ids, --disable-exact-dsml-tool-replay
#
# DROSTE_DS4_TOOL_MEMORY_MAX_IDS=100000       # tool-call ids retained/session
# DROSTE_DS4_ENABLE_EXACT_DSML_TOOL_REPLAY=on


# Server API (how the HTTP surface behaves)
# -----------------------------------------
# {on, off*}, {<path>}
#
# Covers: --cors, --trace
#
# DROSTE_DS4_CORS=off    # CORS headers for browser clients
# DROSTE_DS4_TRACE=      # path to write request trace file to


# Directional Steering (activation steering at inference)
# -------------------------------------------------------
# {<path>}, {-100..100}
#
# Covers: --dir-steering-file, --dir-steering-ffn, --dir-steering-attn
#
# DROSTE_DS4_DIR_STEERING_FILE=     # Vector file (required if FFN or ATTN set)
# DROSTE_DS4_DIR_STEERING_FFN=1.0   # Setting without file results in exit
# DROSTE_DS4_DIR_STEERING_ATTN=     # Setting without	 file results in exit


# Working Directory (chdir before serving)
# ----------------------------------------
# {<path>}
#
# Covers: --chdir
#
# DROSTE_DS4_CHDIR=


# Memory Simulation (pretend some memory is in use; for rehearsing behavior)
# --------------------------------------------------------------------------
# {GiB value, e.g. 64GB}
#
# Covers: --simulate-used-memory
#
# DROSTE_DS4_SIMULATE_USED_MEMORY=


# Native ds4 variables (read by the binary itself, not translated)
# ----------------------------------------------------------------
# Pased through untouched; only useful variables are listed here.
#
# Covers: --threads
#
# DS4_THREADS=                               # min(12, available CPUs)
# DS4_LOCK_FILE=/tmp/ds4.lock                # Yep, that's the file.
# DS4_METAL_PREFILL_CHUNK=                   # Default: min(prompt_size, 8192)
# DS4_SERVER_DISABLE_THINK_TOOL_RECOVERY=    # if 1, recovery is disabled***
# DS4_MTP_SPEC_DISABLE=                      # if 1, spec. path is disabled***


# Options for Debugging & Development
# -----------------------------------
# Arguments
#   --debug (coordinator route/debug logs)
#
# Env.Variables
#   DS4_METAL_GRAPH_DUMP_PREFIX=    # compute-graph dumps; read by ROCm runtime


# Unused Arguments (inapplicable / unsupported in build)
# -----------------------------------------------------------
# Metal-Only
#   --ssd-streaming, --ssd-streaming-cold, --ssd-streaming-cache-experts,
#   --ssd-streaming-preload-experts, --metal (Metal backend)
#
# Distributed service (out of scope for build)
#   --role, --layers, --listen, --coordinator, --dist-prefill-chunk,
#   --dist-prefill-window, --dist-activation-bits, --dist-replay-check
