# finetuning.env -- JupyterLab configuration (this file IS the config surface).
#
# This box serves JupyterLab.  All settings ship commented out; default values
# are shown in the commented example line & marked with "*" in the list.
# Uncomment a line to override it. The settings reach the server three ways:
#   
#   ENVIRONMENT VARIABLES  (/opt/data/finetuning.env, this file)
#   This is the only way to assing settings before Jupyter reads any config.
#
#   TRAITS  (/opt/data/jupyter_server_config.py)
#   ServerApp/LabApp settings are in the Python config file. JUPYTER_CONFIG_DIR
#   alerts Jupyter to search the file's path.
#
#     **Misspelled traits / variables yield WARNINGs, not errors; server starts
#     anyway. Check config on boot: server_restart && jupyter lab --show-config
#
#   COMMAND-LINE FLAGS
#   A Jupyter command-line flag overrides all config files.
#
# Reserved by Droste (do not set these)
# -------------------------------------
# Droste needs these arguments to be unchanged for setup & teardown; changes
# are likely to break the box boot, services, and/or functionality.
#
#   --port, --allow-root, --no-browser, --notebook-dir, --ip 127.0.0.1
##### JUPYTER_PORT, JUPYTER_PORT_RETRIES -- the launcher appends --port from
###   server.env, and a command-line flag beats the variable.
#
# Extra Arguments (options this file does not cover)
# --------------------------------------------------
# A "catch-all" setting for user-elected parameters. "Mix and match" with other
# settings may cause boot failure due to exclusions, so users should confirm
# absence of argument conflicts in advance. Entry should be one quoted value.
# Additional arguments reachable only through this settings are listed toward
# the end of this file.
#
# DROSTE_JUPYTER_EXTRA_ARGS="--ServerApp.iopub_data_rate_limit=1e10"



# ===============
#  MAIN SETTINGS
# ===============

# Authentication
# --------------
# JupyterLab generates a token at server start. Since the server can relaunch,
# existing tokens can stop working; this setting is persistent across restarts.
# To read the current token, run this from inside the box:
#
#   jupyter server list
#   grep -o 'token=[0-9a-f]*' /opt/data/.droste-serve.log | tail -1
#
# **The service's output goes to that log file, NOT to `podman logs`. Container
# logs only carry what Droste itself says about the launch. Also, a password is
# trait, not a variable; see /opt/data/jupyter_server_config.py.
#
# {token string} or {path to a file containing one}
# JUPYTER_TOKEN=
# JUPYTER_TOKEN_FILE=
#
# {yes, no}
# DROSTE_JUPYTER_ALLOW_UNAUTH_ACCESS=yes
# DROSTE_JUPYTER_ALLOW_INSECURE_WRITES=no


# Storage Locations
# -----------------
# {yes, no*}
# DROSTE_JUPYTER_SEARCH_VENV_FIRST=no
# JUPYTER_CONFIG_DIR=/opt/data
#
# JUPYTER_PATH=                # extra directories to search for data
# JUPYTERLAB_DIR=              # Lab's application dir (extensions, build)
# JUPYTER_DATA_DIR=            # kernelspecs, extensions, and other data
# JUPYTER_CONFIG_PATH=         # extra config dirs ( : separated), read first
# JUPYTER_RUNTIME_DIR=         # connection files & server's runtime state
# JUPYTERLAB_SETTINGS_DIR=     # UI settings (themes, keybindings, layout)
# JUPYTERLAB_WORKSPACES_DIR=   # saved Lab workspaces
# IPYTHONDIR=                  # IPython profiles; unset: ~/.ipython
# XDG_DATA_HOME=               # base for user data; unset: ~/.local/share


# Notebook Behavior
# -----------------
# NBFORMAT_VALIDATOR=fastjsonschema  # notebook schema validator or jsonschema
# MPLBACKEND=                        # unset: matplotlib_inline.backend_inline
#
# {PyQt6, PySide6, PyQt5, PySide2}
# QT_API=                            # unset: first importable (Qt binding UI)


# Debugging & Development
# -----------------------
# {yes, no*}
# DROSTE_JUPYTER_SKIP_CONFIG=no
# DROSTE_JUPYTER_PLATFORM_DIRS=no
# DROSTE_JUPYTER_ALL_DEPRECATIONS=no    # repeat every deprecation, not per
# DROSTE_JUPYTER_RAISE_CONFIG_ERROR=no  # abort on bad config file, don't warn



# =================
#  NOT USEFUL HERE
# =================
# Variables the installed packages read that cannot pay off on this box. Listed
# so a reader who met them upstream can see they were considered, not missed.
#
# Kernel Gateway
# --------------
# JUPYTER_GATEWAY_* makes this server a proxy that runs no kernels of its own,
# handing them to a remote Enterprise/Kernel Gateway. This box runs its kernels
# locally, so the whole family is inert unless JUPYTER_GATEWAY_URL is set -- and
# setting it moves execution off the GPU this box exists to use.
#
#   URL, WS_URL, HEADERS, ACCEPT_COOKIES, CONNECT_TIMEOUT, MAX_REQUEST_RETRIES,
#   RETRY_INTERVAL,       RETRY_INTERVAL_MAX,   RETRY_MAX, TOKEN_RENEWER_CLASS,
#   AUTH_HEADER_KEY,      AUTH_SCHEME,         AUTH_TOKEN, HTTP_USER, HTTP_PWD,
#   ALLOWED_ENVS,         ENV_WHITELIST,      CLIENT_CERT, CLIENT_KEY,CA_CERTS,
#   VALIDATE_CERT,                     LAUNCH_TIMEOUT_PAD, REQUEST_TIMEOUT,                 
#   KERNELS_ENDPOINT,               KERNEL_LAUNCH_TIMEOUT, KERNEL_USERNAME,
#   GATEWAY_WS_PING_INTERVAL_SECS,     KERNEL_WORKING_DIR, KERNELSPECS_ENDPOINT, 
#   KERNELSPECS_RESOURCE_ENDPOINT.
#
#
# Set BY Server (not FOR it)
# --------------------------
# The server writes these into each kernel's environment as it launches one.
# Setting them yourself misinforms a kernel about its own process.
#
#   JPY_PARENT_PID, JPY_INTERRUPT_EVENT, JPY_SESSION_NAME, IPYKERNEL_CELL_NAME
#
#
# Wrong Platform / Wrong Host
# ---------------------------
# JUPYTER_USE_PROGRAMDATA=           # Windows; C:\ProgramData for system paths
# JUPYTERHUB_SINGLEUSER_APP=         # picks app JupyterHub spawns; no Hub here
# JUPYTER_DEFAULT_PROVISIONER_NAME=  # alternate kernel provisioner
#
#
# Upstream Test Harnesses
# -----------------------
# JLAB_BROWSER_TYPE is read by `jupyter lab browser-check`, a CI smoke test, and
# never by the running server. JUPYTERLAB_GALATA_ROOT_DIR (UI tests) and
# JUPYTER_CLIENT_TEST_RECORD_STARTUP_PRIVATE are likewise test-only.
