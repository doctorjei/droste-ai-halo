# DROSTE_LLAMA_MIN_P=0.05                      # --min-p
# DROSTE_LLAMA_TOP_N_SIGMA=-1.00               # --top-nsigma, --top-n-sigma
#
# XTC (exclude top count)
# DROSTE_LLAMA_XTC_PROBABILITY=0.00            # --xtc-probability
# DROSTE_LLAMA_XTC_THRESHOLD=0.10              # --xtc-threshold
# DROSTE_LLAMA_TYPICAL_P=1.00                  # --typical, --typical-p
#
# Repetition Control
# DROSTE_LLAMA_REPEAT_LAST_N=64                # --repeat-last-n
#
# Penalties
# DROSTE_LLAMA_REPEAT_PENALTY=1.00             # --repeat-penalty
# DROSTE_LLAMA_PRESENCE_PENALTY=0.00           # --presence-penalty
# DROSTE_LLAMA_FREQUENCY_PENALTY=0.00          # --frequency-penalty
#
# DRY Sampler 
# DROSTE_LLAMA_DRY_MULTIPLIER=0.00             # --dry-multiplier
# DROSTE_LLAMA_DRY_BASE=1.75                   # --dry-base
# DROSTE_LLAMA_DRY_ALLOWED_LENGTH=2            # --dry-allowed-length
# DROSTE_LLAMA_DRY_PENALTY_LAST_N=-1           # --dry-penalty-last-n
# DROSTE_LLAMA_DRY_SEQ_BREAKERS="\n;:;\";*"    # --dry-sequence-breaker
#
# Dynamic Temperature
# DROSTE_LLAMA_DYNATEMP_RANGE=0.00             # --dynatemp-range
# DROSTE_LLAMA_DYNATEMP_EXP=1.00               # --dynatemp-exp
#
# Adaptive Boundaries
# DROSTE_LLAMA_ADAPTIVE_TARGET=-1.00   # [0,1] # --adaptive-target (negative = disabled)
# DROSTE_LLAMA_ADAPTIVE_DECAY=0.90  # [0,0.99] # --adaptive-decay
#
# Mirostat Sampler
# DROSTE_LLAMA_MIROSTAT=0                      # --mirostat
# DROSTE_LLAMA_MIROSTAT_LR=0.10                # --mirostat-lr
# DROSTE_LLAMA_MIROSTAT_ENT=5.00               # --mirostat-ent


