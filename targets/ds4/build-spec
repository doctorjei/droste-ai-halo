# this container's mounts + service, both lanes
#
# build-spec — ds4 port. Sourced bash consumed by the shared resolver
# (/opt/resources/resolve/droste-resolve.sh) via the shared entrypoint.
# Contract + row semantics: base/resolve/build-spec.example.

# ── SERVICE ──────────────────────────────────────────────────────────────────
# Placeholder argv; ds4_pre_launch REBUILDS it after ENV_FILE is sourced,
# translating the DROSTE_DS4_* vars (ds4 has no native per-flag env) into flags.
SERVICE=( ds4-server )

# ── HEALTH — probe endpoint for droste-healthcheck.sh ────────────────────────
# ds4-server has NO /health and NO / route. Source-verified against the pinned
# kyuz0/ds4 @00e64ea (ds4_server.c, client_main): the complete route table is
# GET /v1/models, GET /v1/models/<alias>, POST /v1/{messages,chat/completions,
# responses,completions}, OPTIONS -> 204; everything else returns 404 "unknown
# endpoint". GET /v1/models is the only unauthenticated 200 GET, so it is the
# health endpoint. (A / probe would 404 forever and restart-loop the box.)
HEALTH_PATH="/v1/models"
HEALTH_ACCEPT="ok"

# ── ENV_FILE ─────────────────────────────────────────────────────────────────
# Seeded from templates/ds4.cfg (templates.yaml if_missing); carries active
# DROSTE_DS4_* values + the commented full flag list + native DS4_* passthroughs.
ENV_FILE="/opt/data/ds4.cfg"

# ── SERVE — the row droste-serve.sh reads out of this spec ───────────────────
# The SERVE settings live in the same ENV_FILE as everything else, under the prefix
# below: DROSTE_DS4_STARTUP_ENABLED / _HOST / _PORT. serve::read_config PARSES them with
# droste::cfg_get and never sources the file — that read also runs inside the
# healthcheck every 30s under --health-on-failure=restart, where an abort is a restart
# loop that ejects every shell in the box.
# 🚨 SERVE_CFG_PREFIX IS REQUIRED, and its absence is not a quiet degradation: a spec
# that names ENV_FILE and no prefix makes read_config refuse to serve and report the
# IMAGE as broken, because otherwise every setting would read as absent and the box
# would silently stop serving.
SERVE_CFG_PREFIX="DROSTE_DS4_"
# 🚨 NO SERVE_TLS_*_FLAG ROWS, AND THAT IS THE ANSWER, NOT AN OVERSIGHT (ruled s60):
# ds4 ships NO TLS settings at all — verified at the pin, zero ssl/tls matches in
# ds4_server.c — so ds4.cfg offers neither name and serve::apply_tls has nothing to
# apply. ⚠️ Do not "complete the set" by inventing a pair here; a flag ds4-server does
# not know is not a wrong value, it is an argv the binary rejects at startup.
# ⚠️ No SERVE_HOST_FLAG row either: ds4-server spells it --host, which is
# serve::apply_host's own default, and --port is the default for all five.

# ── OVERLAYS ─────────────────────────────────────────────────────────────────
# venv overlay is universal (per design). ds4-server is a compiled HIP binary;
# the overlay serves cockpit/hf-CLI/user pip installs (whole venv, so console
# scripts in bin/ persist too). The upper is CACHE class (a pip install is
# re-runnable) → /opt/program-cache, which the installer may empty.
OVERLAYS=(
    "/opt/program-cache/venv:/opt/venv"
)

# ── SURFACES ─────────────────────────────────────────────────────────────────
# Whole ~/.ds4 from /opt/data/internal (saved sessions kvcache/ + browser/
# profile + anything future). On the DATA root, not the program-cache one —
# sessions are user WORK, and this dir is never in the installer's wipe.
#
# ⭐ NAMED `internal`, NOT `ds4` (Jei, s47). The source is named for the app's
# dot-dir everywhere else in this file, but on THIS box that collides with the
# box's own name: /opt/data is <data base>/<box>/program, so a source called
# `ds4` reads `~/droste/data/ds4/program/ds4` on the host — and on a pre-s41
# box, where /opt/data IS <data base>/<box>, it reads `~/droste/data/ds4/ds4`
# and looks like something created the directory twice. The dest (~/.ds4) is
# what the app dictates; the source name is ours, so it is the one that moves.
# ⚠️ EXISTING BOXES: sessions are at /opt/data/ds4 and this row no longer looks
# there. Same volume, same filesystem, so the fix is one in-place rename on the
# host — `mv <data path>/ds4 <data path>/internal` with the box stopped.
SURFACES=(
    "/opt/data/internal:$HOME/.ds4"
)

# ── CACHES ───────────────────────────────────────────────────────────────────
# None. The KV disk cache is CONSUMED in place: DROSTE_DS4_KV_DISK_DIR points
# INTO /opt/program-cache directly (dir pre-created in ds4_pre_launch). It stays
# OUT of this array on purpose — a CACHES row is what offers a src to the
# cross-box shared store, and one box's KV cache means nothing to another: cache
# CLASS, but never SHARED. No Triton/MIOpen (hipBLASLt-only compiled engine).
CACHES=()

# ── CRITICAL ─────────────────────────────────────────────────────────────────
# Shared HF cache: download_model.sh fetches the 80-430 GB quants here — the
# unbound-means-silent-re-download rule bites hardest on this port.
CRITICAL=(
    "hf-cache:$HOME/.cache/huggingface"
)

# ── OPTIONAL ─────────────────────────────────────────────────────────────────
# Read-only bind point for a local GGUF collection (DROSTE_DS4_MODEL can point
# here). Tell-once marker body: templates/mount_shared_models_here.
OPTIONAL=(
    "models:/opt/models:/opt/models/mount_shared_models_here"
)

# ── PRE_LAUNCH ───────────────────────────────────────────────────────────────
# DROSTE_DS4_<SUFFIX> → flag maps. Source-verified against pinned kyuz0/ds4
# @00e64ea.
# ⭐ THESE TABLES ARE THE ONLY MAPPING. ds4.cfg used to document a flag→variable
# derivation rule and no longer does (Jei, s51): once ENABLE_EXACT_DSML_TOOL_REPLAY
# inverted its sense, the rule had an exception, and a rule with an exception is
# worse than none — a reader who derives a name gets a variable nothing reads.
# So the file names every variable explicitly and these arrays decide what each
# one emits. Adding a setting means editing BOTH; there is nothing to fall back on.
DS4_VALUE_FLAGS=(
    "MODEL:--model"
    "MTP:--mtp"
    "MTP_DRAFT:--mtp-draft"
    "MTP_MARGIN:--mtp-margin"
    "CTX:--ctx"
    "TOKENS:--tokens"
    "CHDIR:--chdir"
    "HOST:--host"
    "PORT:--port"
    "TRACE:--trace"
    "KV_DISK_DIR:--kv-disk-dir"
    "KV_DISK_SPACE_MB:--kv-disk-space-mb"
    "KV_CACHE_MIN_TOKENS:--kv-cache-min-tokens"
    "KV_CACHE_COLD_MAX_TOKENS:--kv-cache-cold-max-tokens"
    "KV_CACHE_CONTINUED_INTERVAL_TOKENS:--kv-cache-continued-interval-tokens"
    "KV_CACHE_BOUNDARY_TRIM_TOKENS:--kv-cache-boundary-trim-tokens"
    "KV_CACHE_BOUNDARY_ALIGN_TOKENS:--kv-cache-boundary-align-tokens"
    "TOOL_MEMORY_MAX_IDS:--tool-memory-max-ids"
    "SSD_STREAMING_CACHE_EXPERTS:--ssd-streaming-cache-experts"
    "SSD_STREAMING_PRELOAD_EXPERTS:--ssd-streaming-preload-experts"
    "SIMULATE_USED_MEMORY:--simulate-used-memory"
    "PREFILL_CHUNK:--prefill-chunk"
    "POWER:--power"
    "DIR_STEERING_FILE:--dir-steering-file"
    "DIR_STEERING_FFN:--dir-steering-ffn"
    "DIR_STEERING_ATTN:--dir-steering-attn"
    "BACKEND:--backend"
)
DS4_BOOL_FLAGS=(
    "CORS:--cors"
    "KV_CACHE_REJECT_DIFFERENT_QUANT:--kv-cache-reject-different-quant"
    "QUALITY:--quality"
    "SSD_STREAMING:--ssd-streaming"
    "SSD_STREAMING_COLD:--ssd-streaming-cold"
    "WARM_WEIGHTS:--warm-weights"
)
# INVERTED bools — the VARIABLE reads positively, the FLAG is a negation, and the
# engine's default is the positive state. `on` emits nothing (the feature is
# already on); `off` emits the disabling flag.
#
# ⭐ THE NAME IS NOT DERIVED FROM THE FLAG, and that is the point (Jei):
# `DROSTE_DS4_DISABLE_EXACT_DSML_TOOL_REPLAY=off` is a double negative, and nobody
# should have to work out that "false" means the feature is running. This row is
# why ds4.cfg no longer documents a derivation rule at all.
# ⚠️ The name here and the name in ds4.cfg must therefore be changed TOGETHER. A
# mismatch is a silently inert setting, which is exactly how this row was found.
DS4_BOOL_FLAGS_INVERTED=(
    "ENABLE_EXACT_DSML_TOOL_REPLAY:--disable-exact-dsml-tool-replay"
)

# ── <SUFFIX>:<the negative NATIVE it controls> ───────────────────────────────
# Same positive-name / negative-native shape as the row above, with one decisive
# difference: the native is an ENVIRONMENT VARIABLE and ds4-server PRESENCE-tests
# it — `getenv("DS4_SERVER_DISABLE_THINK_TOOL_RECOVERY") == NULL`
# (ds4_server.c:10371-10372) and `getenv("DS4_MTP_SPEC_DISABLE") == NULL` (:10407).
# 🚨 SO `on` MUST *UNSET* THE NATIVE, NOT SET IT TO A FALSE-LOOKING VALUE. `0`,
# `no` and `""` all DISABLE the feature, because the test is presence, not value.
# That is the same trap droste::blank_is_unset above exists for, seen from the
# other side: there a blank arrives by accident, here we would create one.
# ⚠️ THE WORD ORDER OF THE TWO NATIVES DIFFERS — `_DISABLE_` as an infix in the
# first, `_DISABLE` as a suffix in the second. Neither is derivable from the
# other or from the droste name; both were read out of the pinned source, and a
# name guessed from its sibling would be silently inert.
# ⚠️ The name here and the name in ds4.cfg must be changed TOGETHER, for the same
# reason the inverted-flag row says so: a mismatch is a silently inert setting.
DS4_BOOL_ENV_INVERTED=(
    "SERVER_THINK_TOOL_RECOVERY:DS4_SERVER_DISABLE_THINK_TOOL_RECOVERY"
    "MTP_SPEC:DS4_MTP_SPEC_DISABLE"
)

# ── <SUFFIX>:<why a blank is wrong here> ─────────────────────────────────────
# The names where an EMPTY value must be read as "give me the default" rather than as
# an opt-out. See the three-category rule in ds4_pre_launch, which is what decides
# membership; the right-hand side is the sentence the user gets, so it must say what
# an empty value would have DONE, not merely that it was empty.
# ⚠️ EVERY ENTRY HERE MUST ALSO HAVE A `${VAR=default}` LINE in ds4_pre_launch: the loop
# only unsets, and the default is what fills the hole afterwards. An entry without one
# would delete the user's blank and put nothing in its place — the flag would simply
# vanish, which is the failure this table exists to stop.
DS4_BLANK_IS_DEFAULT=(
    "MODEL:there is no 'serve no model'. With no --model, ds4-server falls back to the RELATIVE path 'ds4flash.gguf' (ds4_server.c:11503), which resolves to /ds4flash.gguf on the read-only container root, so the server exits at startup and this box restart-loops."
    "CTX:a context size is a number, and an empty one is not a smaller context — it is ds4's own 32768 in place of the 65536 this box documents."
    "HOST:a bind address has no 'none'. With no --host, ds4-server binds 127.0.0.1 (ds4_server.c:11508), so the box is silently unreachable from the LAN while the health probe, which asks 127.0.0.1, still reports it healthy."
)

# ds4_bool — parse one on/off value. Prints "on", "off", or "" for unrecognised.
# ⚠️ Case-folded and space-stripped ON PURPOSE: ds4.cfg's documented vocabulary is
# `on`/`off`, so `Off`, `OFF` and a stray trailing space are what a user will
# actually type. Every boolean in this file goes through here — both tables and the
# SSD guard — so there is exactly one answer to "what counts as off".
# ⭐ PROMOTED TO droste::bool (s53) so every box answers "what counts as off" the
# same way — One Surface, Five Servers. This wrapper stays because ds4's tables and
# its SSD guard call it by name in a dozen places, and because a spec-level
# definition is required: serve::build_service re-sources this file from scratch.
ds4_bool() { droste::bool "${1:-}"; }

PRE_LAUNCH="ds4_pre_launch"
ds4_pre_launch() {
    # Both resolvers source ENV_FILE under `set -a`, so its assignments are already
    # exported. This loop is belt-and-braces for a NATIVE DS4_* (DS4_THREADS, …) that
    # the USER exported into the container's create-time env instead, and for any
    # future caller that sources the spec without `set -a`.
    # ⚠️ It deliberately does NOT reach the droste settings any more: they are spelled
    # DROSTE_DS4_* since s54, so `compgen -v DS4_` no longer matches them. That is
    # correct — the binary never reads them, this hook does, and `${!var}` reads a
    # plain shell variable as happily as an exported one.
    local v var
    for v in $(compgen -v DS4_ || true); do
        export "${v?}"
    done

    # ── the three natives where a BLANK is not "unset" ──────────────────────────
    # 🚨 ds4.cfg SHOWS these blank, and its comments say "if 1, recovery is
    # disabled" / "if 1, spec. path is disabled". THE BINARY DOES NOT ASK FOR 1 —
    # it asks whether the variable EXISTS: `getenv(...) == NULL`
    # (ds4_server.c:10372 and :10407, ds4.c:11230). So uncommenting either line
    # exactly as the file prints it DISABLES the feature, which is the opposite of
    # a no-op and the opposite of what the comment beside it promises.
    # The file states the default ("unset"); this is the wiring that delivers it.
    # ⚠️ A NAMED LIST, not a sweep — see droste::blank_is_unset. Every DROSTE_DS4_*
    # setting keeps its blank, because there a blank IS the documented opt-out
    # (KV_DISK_DIR= means "no disk cache", and must go on meaning that).
    droste::blank_is_unset DS4_SERVER_DISABLE_THINK_TOOL_RECOVERY \
                           DS4_MTP_SPEC_DISABLE \
                           DS4_METAL_GRAPH_DUMP_PREFIX

    # ── the positive wrappers over those presence-tested negative natives ────
    # 🚨 IT MUST RUN *AFTER* droste::blank_is_unset ABOVE, and the order is the
    # whole point: that call deletes an EMPTY native, this one states the user's
    # intent. Reversed, the guard would delete what we had just applied — the
    # same ordering trap recorded for llama's turbo block.
    # ⭐ AN ABSENT OR BLANK DROSTE_ SETTING LEAVES THE NATIVE EXACTLY AS IT IS, so
    # a user who exports the native by hand keeps it; an explicit on/off wins,
    # because it is the documented surface and they typed it here.
    # An unrecognised value changes nothing and says so: turning a typo into a
    # silent feature change is the failure the inverted-flag row came from.
    local entry native val
    for entry in "${DS4_BOOL_ENV_INVERTED[@]}"; do
        var="DROSTE_DS4_${entry%%:*}"
        native=${entry#*:}
        val=${!var:-}
        case "$(ds4_bool "$val")" in
            on)  unset "$native" ;;
            off) export "$native=1" ;;
            *)   [ -z "$val" ] || serve::err "$var='$val' is not on/off — leaving ds4's default in place. Fix it in $ENV_FILE and restart the box." ;;
        esac
    done

    # ── refuse the two settings that make ds4-server EXIT AT STARTUP ─────────
    # Both are values a user can reach by following upstream's help, and both kill
    # the box AFTER the model has been opened — the worst moment to fail. ds4.cfg no
    # longer offers either, but it is seeded `if_missing`, so a box created before
    # this change still has the old lines. Warn loudly and drop the flag: a box that
    # starts and says why beats a box that restart-loops. Same stance as comfyui's
    # invalid-value handling.
    #
    # 1) SSD expert streaming is Metal-only (`ds4.c:24549`: "--ssd-streaming is
    #    currently supported only with --metal"). The three companions feed only
    #    that path, so they go with it.
    if [ "${DROSTE_DS4_BACKEND:-rocm}" != metal ]; then
        for v in SSD_STREAMING SSD_STREAMING_COLD SSD_STREAMING_CACHE_EXPERTS \
                 SSD_STREAMING_PRELOAD_EXPERTS; do
            var="DROSTE_DS4_$v"
            # ⚠️ Two of these four are VALUE flags (…CACHE_EXPERTS, …PRELOAD_EXPERTS),
            # so "is it on" is "is it non-empty" for those and a real on/off read for
            # the other two. ds4_bool returns "" for a count like `8`, hence the
            # second test. Using ds4_bool here rather than a second blacklist is what
            # keeps `SSD_STREAMING=Off` from warning here while reading as off below.
            case "$(ds4_bool "${!var:-}")" in
                on) ;;
                off) continue ;;
                *) [ -n "${!var:-}" ] || continue ;;
            esac
            serve::err "$var is set, but SSD expert streaming is Metal-only — ds4-server would exit at startup on the ${DROSTE_DS4_BACKEND:-rocm} backend. Ignoring it; remove the line from $ENV_FILE."
            unset "$var"
        done
    fi
    # 2) A steering SCALE with no steering FILE is fatal, not ignored
    #    (`ds4.c:24504`: "directional steering needs --dir-steering-file").
    if [ -z "${DROSTE_DS4_DIR_STEERING_FILE:-}" ] \
       && { [ -n "${DROSTE_DS4_DIR_STEERING_FFN:-}" ] || [ -n "${DROSTE_DS4_DIR_STEERING_ATTN:-}" ]; }; then
        serve::err "DROSTE_DS4_DIR_STEERING_FFN/_ATTN are set without DROSTE_DS4_DIR_STEERING_FILE — ds4-server would exit at startup. Ignoring the scales; set a steering file in $ENV_FILE or remove them."
        unset DROSTE_DS4_DIR_STEERING_FFN DROSTE_DS4_DIR_STEERING_ATTN
    fi

    # ── settings where a BLANK MEANS "GIVE ME THE DEFAULT", not "off" ───────────
    # 🚨 THE GOVERNING QUESTION IS WHAT THE USER WOULD REASONABLY EXPECT, and usually
    # that is a default value. Jei's three-category rule, which decides every row of the
    # audit below and replaces the older "does it have a coherent off state" test:
    #
    #   1. A blank CRASHES the server or makes it unhealthy.        ⇒ treat as unset
    #   2. The value is NUMERIC, or comes from a practically FINITE
    #      set (a boolean, an enum, a menu). Such a setting has —
    #      and must have — default behaviour, and it does not matter
    #      whether the blank crashes; merely behaving differently
    #      from the default is enough.                              ⇒ treat as unset
    #   3. The value is NOT from a practically finite set (an unbounded
    #      string), AND a blank is NOT the default, AND a blank could
    #      itself MEAN something useful — "no KV disk cache", "no trace
    #      file", "no steering vector".                             ⇒ KEEP the blank
    #
    # ⚠️ ALL THREE CONDITIONS ARE REQUIRED FOR 3. An unbounded string whose blank is
    # merely useless or harmful is not category 3; it falls to 1 or 2 and gets the
    # default.
    #
    # 🚨 THE OTHER 27 SETTINGS ON THIS BOX NEED NO ENTRY HERE, and that is measured
    # rather than assumed (g1lab/ds4wire.sh drives every name in ds4.cfg blank and
    # compares the whole argv): only the four droste defaults below behave differently
    # blank than unset, because every other name reaches the argv through a
    # `[ -n "$val" ]` test that already treats "" exactly as absent. So this table is
    # three rows, not thirty, and adding a droste default means asking the three
    # questions again — a default is precisely what creates the divergence.
    #
    # ⚠️ droste::blank_is_unset IS THE WRONG TOOL and must not be widened to reach these:
    # its contract (base/resolve/droste-common.sh:85-90) forbids covering DROSTE_-owned
    # names, because for a CATEGORY 3 name a blank really is the user's opt-out and
    # erasing it would turn "I don't want one" into "here, have one". This is the
    # targeted list the contract asks for, and DROSTE_DS4_KV_DISK_DIR is deliberately
    # NOT in it.
    #
    # ⭐ WHY IT SUPPLIES THE DEFAULT RATHER THAN DECLINING TO LAUNCH. Declining means
    # clearing the serve intent flag (state/.IS_ACTIVE) — the only thing the healthcheck
    # reads before it decides a box is healthy — and serve::set_active lives in
    # droste-serve.sh, which droste-common.sh does NOT provide a fallback for. A
    # PRE_LAUNCH that calls it in a lane which sourced only the resolver gets `command
    # not found` (127) under `set -euo pipefail` and THE BOX DOES NOT START: exactly the
    # s52 failure that droste-common.sh was written to end. A guard that can take the box
    # down is a worse answer to "do not take the box down" than the default it replaces.
    # So this follows the shape of the SSD and steering guards above — name the value,
    # say what happens instead, carry on. Every arm returns 0.
    # ⚠️ IT RUNS BEFORE THE DEFAULTS, DELIBERATELY: unsetting the name is what lets the
    # `${VAR=default}` lines below fire, so a blank lands on exactly the argv an absent
    # line lands on rather than on a second, hand-copied spelling of the same value.
    local entry
    for entry in "${DS4_BLANK_IS_DEFAULT[@]}"; do
        var="DROSTE_DS4_${entry%%:*}"
        if [ -n "${!var+set}" ] && [ -z "${!var}" ]; then
            serve::err "$var is set but empty — ${entry#*:} Using droste's default instead; put a value in $ENV_FILE, or remove the line to say the same thing quietly."
            unset "$var"
        fi
    done

    # ── droste defaults, delivered by the WIRING rather than by an active line ──
    # ⭐ Jei's ruling: a value we want every box to have belongs here, not as an
    # uncommented line in ds4.cfg — the file seeds `if_missing`, so an active line
    # only ever reaches boxes created after it was written, while this reaches every
    # box on its next start. The line in ds4.cfg becomes an OVERRIDE.
    #
    # 🚨 `=` NOT `:=`, and the difference is the whole design. `${VAR=default}`
    # substitutes only when the variable is UNSET, so:
    #     line absent/commented  -> unset -> our default
    #     VAR=/some/path         -> their path
    #     VAR=          (blank)  -> stays blank -> NO flag emitted
    # That last state is the CATEGORY 3 opt-out, and `:=` would silently overwrite it
    # with our default — turning "I don't want a disk cache" into "here, have one".
    # ⚠️ For the three CATEGORY 1/2 names the loop above has already unset the blank, so
    # `=` fires for them too. The two mechanisms are complementary: `=` protects a
    # category 3 blank, the table protects everything else FROM one.
    #
    # ✅ KV_DISK_DIR IS THE CATEGORY 3 ROW, and it satisfies all three conditions: a
    # filesystem path is an unbounded string, blank is not the default (the default is
    # the path below), and blank MEANS something — ds4-server opens the disk cache only
    # `if (cfg.kv_disk_dir)` (ds4_server.c:11730), so an empty value is "no disk cache
    # at all", which is a real thing a user may want and the only way to say it.
    : "${DROSTE_DS4_KV_DISK_DIR=/opt/program-cache/kv-disk}"
    # The model path is a droste default for the same reason, and here the engine's
    # own fallback is not merely different — it is unusable. ds4-server defaults to
    # the RELATIVE "ds4flash.gguf" (ds4_server.c:11503, parse_options), no Containerfile
    # sets WORKDIR and nothing in the entrypoint chain cd's, so the service runs with
    # cwd `/` and that resolves to /ds4flash.gguf: a path on the read-only container
    # root that can never exist. /opt/models is the bind point this image advertises
    # for a local GGUF collection, and the filename is upstream's own.
    # ⚠️ CATEGORY 1 — a blank here is the one that KILLS THE PROCESS, so it is in the
    # table above. The path itself is an unbounded string, but the other two category 3
    # conditions both fail: there is no "serve no model", so a blank cannot mean anything
    # useful, and what it actually produces is a crash.
    : "${DROSTE_DS4_MODEL=/opt/models/ds4flash.gguf}"
    # Context: 64K, against ds4's own 32768. Unlike the two above, the engine's
    # default here works fine — this is droste deliberately overriding a usable
    # value. Jei's reasoning (s51): everyone wants a larger context, but it has to
    # work out of the box, and 64K is the middle ground. The cost is paid up front,
    # not per request — cpu_decode_scratch_init sizes its buffers from ctx_size at
    # startup — which is exactly why the number has to be chosen conservatively.
    # ⚠️ NOT a step toward Think Max. That gate is a cliff at 393216
    # (DS4_THINK_MAX_MIN_CONTEXT): below it, ds4_think_mode_for_context silently
    # returns HIGH for every request asking for max. 64K and 32K are identical there.
    # ⚠️ CATEGORY 2 — a context size is a NUMBER, so it is in the table above and a blank
    # gets 65536. It used to fall through to ds4's own 32768, which is the shape the rule
    # exists to remove: "" is not a smaller context and nobody typing it means "halve my
    # context". This one never crashed anything, and that is precisely why it needed the
    # rule rather than the old crash-based test to catch it.
    : "${DROSTE_DS4_CTX=65536}"
    # 🚨 THE BIND ADDRESS, AND IT WAS THE ONE DEFAULT NOTHING DELIVERED.
    # ds4.cfg's "Reserved by Droste" block shows DROSTE_DS4_HOST=0.0.0.0, and every
    # sibling box hard-codes the same thing in its argv (comfyui `--listen 0.0.0.0`,
    # finetuning `--ip 0.0.0.0`). ds4-server's own default is the OPPOSITE —
    # `.host = "127.0.0.1"` (ds4_server.c:11508) — so with no line in the file and
    # no default here the box came up reachable only from the host itself, on a
    # port the installer had just published to the LAN.
    # ⚠️ INVISIBLE TO THE HEALTHCHECK BY CONSTRUCTION: serve::probe asks
    # 127.0.0.1, which a loopback-only listener answers perfectly. Nothing in the
    # box could have reported this; only reading the file against the source does.
    # ⚠️ CATEGORY 2, AND THIS ROW WAS RE-DECIDED. It used to read "a user who writes
    # DROSTE_DS4_HOST= (blank) emits no --host and gets ds4's loopback default back,
    # which is a real answer." Under the three-category rule it is not: a BIND ADDRESS
    # comes from a practically finite set — the two wildcards and the machine's own
    # interface addresses — and, decisively, the third category 3 condition fails, since
    # a blank cannot mean "bind to nothing". The server binds either way; an empty value
    # just silently picks a DIFFERENT address. And it picks the worst one to pick
    # silently: the box becomes unreachable from the LAN while the healthcheck, which
    # probes 127.0.0.1, goes on reporting HEALTHY. So a blank now gets 0.0.0.0 and says
    # so, and a user who genuinely wants loopback writes DROSTE_DS4_HOST=127.0.0.1 —
    # which is the honest way to ask for it and was always available.
    : "${DROSTE_DS4_HOST=0.0.0.0}"

    # Pre-create the KV disk dir. ⚠️ NOT tidiness: ds4-server opens the disk cache
    # only `if (cfg.kv_disk_dir)` (ds4_server.c:11730), so no directory means no disk
    # cache AT ALL — not a cache somewhere else. CACHE class, regenerable session
    # state, and outside compute/ because it is deliberately per-box (see CACHES).
    if [ -n "${DROSTE_DS4_KV_DISK_DIR:-}" ]; then
        mkdir -p "$DROSTE_DS4_KV_DISK_DIR"
    fi

    # Cockpit state: ~/.ds4-cockpit.conf is a FILE (not a dir) → persist it at
    # /opt/data/cockpit/ via a symlink (writes through the link land there).
    # SERVER lane only: under distrobox $HOME is the REAL host home — cockpit
    # state rides it natively there, and the link would dangle on the host.
    if [ "${DROSTE_LANE:-server}" = server ]; then
        mkdir -p /opt/data/cockpit
        ln -sf /opt/data/cockpit/ds4-cockpit.conf "$HOME/.ds4-cockpit.conf"
    fi

    # Translate DROSTE_DS4_* → argv. Native DS4_* untouched (binary reads them).
    local argv=( ds4-server ) entry flag val
    for entry in "${DS4_VALUE_FLAGS[@]}"; do
        var="DROSTE_DS4_${entry%%:*}"
        flag=${entry#*:}
        val=${!var:-}
        if [ -n "$val" ]; then
            argv+=( "$flag" "$val" )
        fi
    done
    # Positive bools: `on` emits the flag, `off` or unset emits nothing (which for
    # every one of these IS ds4's default — none of them has a --no-X form).
    # ⚠️ THIS USED TO BE A BLACKLIST — anything outside ""|0|false|no|off emitted the
    # flag — so `Off`, `FALSE` and `disabled` all turned a setting ON, which is the
    # dangerous direction: a user trying to disable something enabled it. Measured,
    # not theorised. Now a whitelist, case-folded, matching ds4.cfg's own on/off
    # vocabulary; an unrecognised value warns and leaves the flag off.
    for entry in "${DS4_BOOL_FLAGS[@]}"; do
        var="DROSTE_DS4_${entry%%:*}"
        flag=${entry#*:}
        val=${!var:-}
        case "$(ds4_bool "$val")" in
            on)  argv+=( "$flag" ) ;;
            off) ;;
            *)   [ -z "$val" ] || serve::err "$var='$val' is not on/off — leaving $flag off. Use on or off." ;;
        esac
    done
    # Inverted bools: emit the negating flag only for an explicit `off`. An
    # unrecognised value keeps the engine's default and says so — turning a typo
    # into a silent feature change is the failure this whole row came from.
    for entry in "${DS4_BOOL_FLAGS_INVERTED[@]}"; do
        var="DROSTE_DS4_${entry%%:*}"
        flag=${entry#*:}
        val=${!var:-}
        case "$(ds4_bool "$val")" in
            off) argv+=( "$flag" ) ;;
            on)  ;;
            *)   [ -z "$val" ] || serve::err "$var='$val' is not on/off — leaving it on (ds4's default). Fix it in $ENV_FILE and restart the box." ;;
        esac
    done
    # Raw catch-all, appended last. Quote-aware, unset-safe; quoting
    # inside the value IS honoured since s52 (droste::split_args).
    # shellcheck disable=SC2206
    mapfile -d '' -t _extra < <(droste::split_args "${DROSTE_DS4_EXTRA_ARGS:-}")
    argv+=( ${_extra[@]+"${_extra[@]}"} )

    # ── IS THE MODEL ACTUALLY THERE? ────────────────────────────────────────────
    # 🚨 THE COMMON CASE, AND THE SILENT ONE. /opt/models is an OPTIONAL bind, so a box
    # created without one starts with NOTHING at droste's default model path. ds4-server
    # opens the file at startup and exits when it cannot (`open()` fails ⇒ ds4_die_errno
    # "cannot open model", ds4.c:1928-1929, reached from ds4.c:24545), serve::launch
    # stamps the record `failed`, the health probe fails gate 1, and
    # --health-on-failure=restart bounces the container — repeatedly, and INVISIBLY for
    # the first ninety minutes, because this box's --health-start-period is 90m
    # (droste-setup.sh:219-221). Nothing in that sequence ever says "the file is missing".
    # ⭐ ONE LINE IN `podman logs` IS THE WHOLE POINT. Someone reading the container log
    # must be able to act without knowing any of the above.
    #
    # ⚠️ DIAGNOSTIC ONLY — it does not refuse the launch, substitute a path or go looking
    # for a model. The wiring's job here is to make the failure legible, not to guess. If
    # the file appears later (a bind added, a download finished) the next start simply
    # works, and nothing has to be undone.
    #
    # ⭐ IT CHECKS THE RESOLVED PATH — what is about to be handed to the server, read back
    # out of the finished argv — not DROSTE_DS4_MODEL. That distinction is load-bearing:
    # DROSTE_DS4_EXTRA_ARGS is appended AFTER our flags and ds4's parser takes the LAST
    # occurrence (ds4_server.c:11542-11543 assigns on every match), so a user who supplies
    # their own --model there would otherwise be told a file they are not using is
    # missing — a false alarm, which is worse than the silence this replaces.
    # ⚠️ THE TWO SPELLINGS ARE `-m` AND `--model`, SPACE-SEPARATED, AND THAT IS EXHAUSTIVE.
    # The parser is `strcmp`, so `--model=/path` is not an accepted form at all: it falls
    # through to "unknown option" and exit(2) (ds4_server.c:11655-11657). Matching the `=`
    # form here would mean reading a value the server never will.
    local mpath='' mtake=0 a
    for a in "${argv[@]}"; do
        if [ "$mtake" = 1 ]; then mpath=$a; mtake=0; continue; fi
        case $a in -m|--model) mtake=1 ;; esac
    done
    # `-e`, not `-f`: a symlink to a GGUF on another volume is a normal way to hold one,
    # and the check is deliberately narrow — it fires only for "there is nothing there at
    # all". A directory or an unreadable file also kills the server, but those are the
    # cases where a confident message could be wrong, and a FALSE alarm costs more than a
    # missed one for a diagnostic nobody can switch off.
    # ⚠️ Every arm returns 0. An `if` with a false condition is 0, serve::err is 0, and
    # this is not the function's last statement in any case — PRE_LAUNCH runs unguarded
    # under `set -euo pipefail` in the resolver lane, so a diagnostic that could fail
    # would take the box down harder than the silence it replaces (the s52 shape).
    if [ -n "$mpath" ] && [ ! -e "$mpath" ]; then
        serve::err "the model file $mpath does not exist. ds4-server opens it at startup and exits when it cannot, so nothing will serve and the container will restart, over and over — for the first 90 minutes without ever reporting unhealthy, because that is this box's health start period. Bind a directory holding your GGUF to /opt/models, or point DROSTE_DS4_MODEL in $ENV_FILE at a file that is inside the box."
    fi

    SERVICE=( "${argv[@]}" )
}
