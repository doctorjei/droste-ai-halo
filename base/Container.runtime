# droste-runtime-base-halo: TheRock gfx1151 ROCm RUNTIME kernels

# Overrideable Arguments - General Build (override with '--build-arg <ARG_NAME>=<VALUE>'
ARG SERIES_NAME=droste
ARG ARCH_NAME=halo
ARG TARGET_NAME=runtime-base
ARG DESCRIPTION="TheRock gfx1151 ROCm runtime kernels"
ARG BASE_IMAGE=ghcr.io/doctorjei/gemet/canopy:1.7.3

FROM ${BASE_IMAGE}
ARG SERIES_NAME TARGET_NAME ARCH_NAME DESCRIPTION
LABEL description="${SERIES_NAME}-${TARGET_NAME}-${ARCH_NAME}: ${DESCRIPTION}"

# Remove the .distrib diversions, then rehydrate GNU coreutils before any other installations
RUN while IFS= read -r orig && IFS= read -r div && IFS= read -r owner; do \
        case "$div" in \
            *.distrib) dpkg-divert --quiet --no-rename --remove "$orig" ;; \
        esac; \
    done < /var/lib/dpkg/diversions

RUN apt-get -qq update \
    && apt-get -qq install -y --no-install-recommends \
       coreutils grep sed findutils gzip diffutils \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Re-add exactly what canopy purges, plus the venv toolchain and the resolver's
# userspace-overlay fallback (fuse-overlayfs).
RUN apt-get -qq update \
    && apt-get -qq install -y --no-install-recommends \
       sudo procps libnss-myhostname radeontop fuse-overlayfs \
       python3-venv python3-pip \
       curl wget gnupg less bc pinentry-curses util-linux passwd findutils \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Shared 'droste' group (fixed gid, within the rootless userns gid map) so the
# distrobox-lane box user (uid 1000, added to this group) can pip-install into the
# baked venv. The group-writable venv pass below relies on this group existing.
# `-f`: never fail the build — no-op if the group already exists, and auto-pick a
# free gid if 1024 is ever taken on a future base (membership is by name, not gid).
RUN groupadd -f -g 1024 droste

# The unified ROCm/torch pin, baked at the ROOT of the FROM tree. This is the ONE
# place the version truth lives: every downstream image (build-base, torch-base,
# the carriers, the ports) inherits this exact file through FROM, so a port can
# never outrun its base's pin. Every version-consuming RUN — here and downstream —
# opens with `. /etc/droste/rocm-version.env` and reads the values from the shell,
# so there are no version ARGs and no --build-arg plumbing to keep in sync.
# Placed BELOW the apt layers on purpose: a pin bump then rebuilds only from the
# ROCm install down. It also ships in every runtime image, where the resolver /
# banners can read the pin the image was actually built from.
COPY rocm-version.env /etc/droste/rocm-version.env

# Python venv with the TheRock gfx1151 RUNTIME kernels, with venv
RUN python3 -m venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:$PATH PIP_NO_CACHE_DIR=1
# uv is bootstrapped HERE, in the same breath as pip/setuptools/wheel, rather than further
# down beside the constraints block where it first landed (s44). Reason is pure ordering:
# `uv pip install` cannot be used by any line ABOVE the line that installs uv, so with the
# old placement this ROCm-libraries install — one of the risky `${ROCM_INDEX_URL}` lines —
# was structurally unmigratable. It still installs with pip itself, obviously.
# The constraints file does not exist yet at this point, so this install runs unconstrained
# exactly as it did under pip; nothing here can move the torch stack (it installs none of it).
RUN . /etc/droste/rocm-version.env \
    && pip install --upgrade pip setuptools wheel uv \
    && uv pip install --index-url ${ROCM_INDEX_URL} \
       "rocm[libraries]==${ROCM_SDK_LIBRARIES_VERSION}"

# ── The ROCm stack guard ─────────────────────────────────────────────────────
# NOTHING may move torch/torchvision/torchaudio, by any installer, at build time
# or afterwards. A generic PyPI torch silently replacing the ROCm build is the
# single worst failure this project has: the image still builds, still starts,
# and simply has no GPU.
#
# GENERATED from rocm-version.env, never hand-written — that file is the one
# place the version truth lives, so a constraints file transcribed by hand could
# drift from it, which is the whole class of bug the pin file exists to prevent.
#
# uv lives at the root of the FROM tree because it is the single common ancestor of every
# target AND every build stage — one install covers all of them. ComfyUI-Manager also
# installs with uv at RUNTIME, so a pip-only guard would be bypassed by the node-install
# path entirely. (s45: the install itself moved UP to the venv bootstrap above, so that the
# ROCm-libraries line can use it too; only the constraints wiring stays here.)
#
# ⚠️ ALL THREE VARIABLES ARE REQUIRED, and they are not redundant:
#   PIP_CONSTRAINT       pip. Also covers build dependencies.
#   UV_CONSTRAINT        uv does NOT read PIP_CONSTRAINT — refused upstream
#                        (astral-sh/uv#10686), deliberately, to avoid bug-for-bug
#                        compatibility with another tool's config.
#   UV_BUILD_CONSTRAINT  uv does NOT apply --constraint to source builds; that is
#                        a separate setting. (pip does, via PIP_CONSTRAINT.)
# Ports APPEND their own bounds to this file (comfyui: transformers).
RUN . /etc/droste/rocm-version.env \
    && printf 'torch==%s\ntorchvision==%s\ntorchaudio==%s\n' \
         "${TORCH_VERSION}" "${TORCHVISION_VERSION}" "${TORCHAUDIO_VERSION}" \
         > /etc/droste/rocm-constraints.txt
ENV PIP_CONSTRAINT=/etc/droste/rocm-constraints.txt \
    UV_CONSTRAINT=/etc/droste/rocm-constraints.txt \
    UV_BUILD_CONSTRAINT=/etc/droste/rocm-constraints.txt \
    UV_NO_CACHE=1
# UV_NO_CACHE is the twin of the PIP_NO_CACHE_DIR set above, and it exists for the same
# reason: a package cache written during a RUN is BAKED INTO THAT LAYER. uv keeps its own
# cache (~/.cache/uv) and does not read pip's variable, so without this the staged uv
# migration would quietly re-add the image weight PIP_NO_CACHE_DIR was added to remove.

# Group-writable venv pass: make /opt/venv DIRECTORIES group-owned by droste,
# group-writable, and setgid. Dirs carry no data payload, so overlay copy-up of a
# g+w+setgid dir is metadata-only (cheap) even without metacopy; pip add/remove/replace
# are directory-entry ops, so this covers new installs AND baked-package upgrades in the
# distrobox lane. Copy-up preserves group+mode -> copied-up dirs stay group=droste, g+w,
# setgid. Ports RE-APPLY this same pass after their own pip installs. Recursive on a plain
# build-time dir here (no overlay yet), so no payload is duplicated.
RUN chgrp -R droste /opt/venv \
    && chmod -R g+rwX /opt/venv \
    && find /opt/venv -type d -exec chmod g+s {} +

# Pin a stable /opt/rocm -> the ROCm core tree. NOTE: `rocm-sdk path --root` CANNOT be used here
RUN ln -sfn "$(python3 -c "import sysconfig,os; print(os.path.join(sysconfig.get_paths()['purelib'],'_rocm_sdk_core'))")" /opt/rocm \
    && printf '/opt/rocm/lib\n/opt/rocm/lib64\n' > /etc/ld.so.conf.d/rocm.conf \
    && python3 -c "import sysconfig,glob,os; sp=sysconfig.get_paths()['purelib']; print('\n'.join(glob.glob(os.path.join(sp,'_rocm_sdk_*','lib'))))" >> /etc/ld.so.conf.d/rocm.conf \
    && ldconfig

ENV ROCM_PATH=/opt/rocm HIP_PATH=/opt/rocm \
    LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/lib64 \
    PATH=/opt/venv/bin:/opt/rocm/bin:$PATH

# /etc/profile.d/rocm.sh; activates venv and exports ROCM_PATH, HIP/PATH/LD env for interactive shells.
RUN printf '%s\n' \
    'source /opt/venv/bin/activate' \
    'ROCM_PATH=/opt/rocm' \
    'export ROCM_PATH HIP_PATH="$ROCM_PATH"' \
    'export PATH="/opt/resources/scripts:$ROCM_PATH/bin:/opt/venv/bin:$PATH"' \
    'export LD_LIBRARY_PATH="$ROCM_PATH/lib:$ROCM_PATH/lib64:$LD_LIBRARY_PATH"' \
    'export PIP_CONSTRAINT=/etc/droste/rocm-constraints.txt' \
    'export UV_CONSTRAINT=/etc/droste/rocm-constraints.txt' \
    'export UV_BUILD_CONSTRAINT=/etc/droste/rocm-constraints.txt' \
    > /etc/profile.d/rocm.sh

# Shared runtime resolver + entrypoint + launch library + healthcheck + template
# applier. Baked under the /opt/resources umbrella (with build-spec/templates/scripts)
# so all 5 ports inherit ONE copy; the dir is on PATH so `droste-entrypoint.sh` is
# invocable bare (ports set their own ENTRYPOINT). Base sets no ENTRYPOINT (ports opt
# in) and deliberately NO `HEALTHCHECK`: the probe is opt-in per DEPLOYMENT
# (droste-setup.sh passes --health-cmd/--health-on-failure at create time), so the
# existing server-lane containers keep their current, health-less `podman ps` shape.
COPY resolve/droste-common.sh resolve/droste-cfg.sh \
     resolve/droste-envfile.sh resolve/droste-resolve.sh \
     resolve/droste-entrypoint.sh \
     resolve/droste-init-hook.sh resolve/droste-serve.sh \
     resolve/droste-healthcheck.sh resolve/apply_templates.py \
     resolve/assert-rocm-pins.sh resolve/droste-server.sh \
     /opt/resources/resolve/
RUN chmod +x /opt/resources/resolve/assert-rocm-pins.sh \
             /opt/resources/resolve/droste-entrypoint.sh \
             /opt/resources/resolve/droste-init-hook.sh \
             /opt/resources/resolve/droste-healthcheck.sh \
             /opt/resources/resolve/droste-server.sh \
             /opt/resources/resolve/apply_templates.py
# The SERVER VERBS, uniform across all five boxes (Jei ruled the scope: "all five,
# uniform" — the version that is a feature rather than a patch). SYMLINKS rather than
# shell functions in each banner, deliberately: a function only exists in a login shell
# that sourced the banner, while a real command on PATH also works from
# `distrobox enter <box> -- server_status`, from a script, and from the host unit's
# ExecStop. droste-server.sh dispatches on its own $0.
#
# 🚨 AND THEY GO IN /usr/local/bin TOO, WHICH IS THE HALF THAT ACTUALLY WORKS IN A BOX.
# Found on hardware (s47): `server_stop` in a `distrobox enter` shell was `command not
# found`. The ENV below is real, but Debian's /etc/profile REBUILDS PATH from scratch
# before it runs profile.d/, and `distrobox enter` gives you a LOGIN shell — so the one
# directory these symlinks lived in was gone by the time the user got a prompt. This
# project already carries two scars from the same wall, both in comfyui's profile.d
# (01-rocm-envs.sh explains it; zz-venv-last.sh exists solely to re-prepend
# /opt/venv/bin after the rebuild), and the s45 note below chose symlinks over shell
# functions precisely so the verbs would be reachable from a plain PATH lookup.
# /usr/local/bin is FIRST on the PATH /etc/profile rebuilds, so it survives login shells,
# non-login shells, scripts and the host unit's ExecStop alike — no profile.d snippet to
# source, no ordering to get right. The ENV line stays: it is what serves a `podman exec`
# that never reads a profile at all.
RUN for v in server_start server_stop server_restart server_status; do \
        ln -sfn /opt/resources/resolve/droste-server.sh "/opt/resources/resolve/$v"; \
        ln -sfn /opt/resources/resolve/droste-server.sh "/usr/local/bin/$v"; \
    done
ENV PATH=/opt/resources/resolve:$PATH

# The one container-specific volume, shared by all ports: auto-anonymous-volume when
# unbound (entrypoint warns), user binds -v <host>:/opt/data to persist.
VOLUME /opt/data
