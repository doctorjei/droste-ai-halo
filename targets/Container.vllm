# droste-vllm-halo: vLLM toolbox (TheRock torch + prebuilt wheels) on halo.
# Ported from github.com/kyuz0/amd-strix-halo-toolboxes

# Overrideable Arguments - General Build (override with '--build-arg <ARG_NAME>=<VALUE>'
ARG SERIES_NAME=droste
ARG ARCH_NAME=halo
ARG TARGET_NAME=vllm
ARG DESCRIPTION="vLLM toolbox (TheRock torch & prebuilt wheels)"

# Image Names
ARG BASE_IMAGE=localhost/${SERIES_NAME}-torch-base-${ARCH_NAME}
ARG ARTIFACTS_IMAGE=localhost/${SERIES_NAME}-${TARGET_NAME}-build-${ARCH_NAME}

# Build image
FROM ${ARTIFACTS_IMAGE} AS artifacts
FROM ${BASE_IMAGE}
ARG SERIES_NAME TARGET_NAME ARCH_NAME DESCRIPTION
LABEL description="${SERIES_NAME}-${TARGET_NAME}-${ARCH_NAME}: ${DESCRIPTION}"

# ROCM / Torch Pin
ARG GFX_TARGET=gfx1151
ARG ROCM_INDEX_URL=https://rocm.nightlies.amd.com/v2/${GFX_TARGET}/
ARG TORCH_VERSION=2.9.1+rocm7.13.0a20260501

# Runtime libraries
RUN apt-get -qq update && apt-get -qq install -y --no-install-recommends \
      libnuma1 numactl libgomp1 && rm -rf /var/lib/apt/lists/* && apt-get clean

# Copy artifacts. patch_aiter_headers.py is parked under /opt/resources/scripts/ (it is
# used at BUILD to re-patch the installed aiter; it need not sit at /opt root forever).
COPY --from=artifacts /artifacts/wheels /tmp/wheels
COPY --from=artifacts /artifacts/fp8    /opt/fp8
COPY scripts/patch_aiter_headers.py /opt/resources/scripts/patch_aiter_headers.py

# Install order matters:
#  1. aiter + flash-attn wheels (--no-deps: their deps are torch/triton, already present).
#  2. re-apply patch_aiter_headers.py to the freshly-installed aiter — its ck_tile headers are
#     used by aiter's RUNTIME JIT on gfx1151 (the artifacts stage patched its own copy; the
#     shipped wheel is pre-patch, so patch it again here).
#  3. vLLM wheel WITH deps so pip resolves transformers/etc. from PyPI (torch already satisfied).
#     Use the legacy resolver for this RUN: vLLM pins `torch==2.9.1` while the installed wheel is
#     `2.9.1+rocm7.13.0a20260501`, and the new resolvelib backtracker explores an exploding search
#     space over that (+ the large dep graph) and dies with RecursionError in _has_route_to_root
#     (survives even a 100k recursion limit — it's pathological backtracking, not mere depth). The
#     legacy resolver takes the first satisfying candidate (our torch satisfies ==2.9.1) and skips
#     the backtracking entirely. Scoped to this RUN via the env export.
#  4. ray (upstream installs it explicitly; used by the cluster launcher paths).
#  5. REPAIR the one constraint the legacy resolver is known to drop, then VERIFY the whole
#     environment. The legacy resolver's "first satisfying candidate" rule (step 3) has no
#     backtracking, so an upper bound belonging to a package resolved EARLIER is silently
#     violated when a later candidate outruns it. Observed on hardware 2026-08-12: transformers
#     declares `tokenizers>=0.22.0,<=0.23.0`, PyPI had shipped 0.23.1, and the built image got
#     0.23.1 — pip reported success and `vllm` then died at IMPORT with
#     `ImportError: tokenizers... is required ... but found tokenizers==0.23.1`, i.e. the server
#     could not start at all. Build success is NOT import success, and nothing in CI imports vllm,
#     so this shipped green. The explicit install re-pins tokenizers into transformers' range.
#     The allowlisted `pip check` gate (next RUN) is the durable half: it fails the BUILD on any
#     NEW inconsistent dependency set, so the next such drift cannot reach an image. If the gate
#     ever fails, do not delete it — read what it names and pin that too (this hardcoded bound is
#     expected to need updating whenever transformers moves its range; the gate is precisely what
#     makes that loud).
#     NB torch is fine by PEP 440: a local version (`2.9.1+rocm...`) satisfies `==2.9.1`.
#     pybind11: the amd-aiter nightly began declaring it as a RUNTIME dep (AITER JIT-compiles
#     kernels at run time) between 2026-08-12 and -13 — the gate caught the drift (run
#     31654555755); installed rather than allowlisted because it is satisfiable.
#  6. trim /opt/fp8 to the RUNTIME import surface: keep top-level *.py + LICENSE/NOTICE +
#     licenses/ (the live Triton JIT kernels imported via PYTHONPATH=/opt/fp8); drop the
#     non-runtime baggage (bench/ docs/ serve_*.sh README.md .gitignore) from the checkout.
RUN export PIP_USE_DEPRECATED=legacy-resolver \
    && pip install --no-deps /tmp/wheels/amd_aiter*.whl /tmp/wheels/flash_attn*.whl \
    && python /opt/resources/scripts/patch_aiter_headers.py \
    && pip install /tmp/wheels/vllm*.whl \
    && pip install ray \
    && pip install 'tokenizers>=0.22.0,<=0.23.0' \
    && pip install pybind11 \
    && rm -rf /tmp/wheels /root/.cache/pip \
    && rm -rf /opt/fp8/bench /opt/fp8/docs /opt/fp8/README.md /opt/fp8/serve_*.sh /opt/fp8/.gitignore

# Dependency-consistency gate — the durable half of step 5 above. `pip check` audits the WHOLE
# environment and exits nonzero on ANY conflict, but this env carries six KNOWN pre-existing
# conflicts, one of them unsatisfiable by construction (no PyPI torchvision declares
# compatibility with a ROCm-nightly torch), so a bare `pip check` is a permanent build break
# (CI run 31644372153). Instead: print the FULL raw output first (so debugging never needs a
# rebuild), filter out ONLY the six known conflict lines, and fail iff anything else survives —
# a NEW conflict of the tokenizers kind still kills the build. Each allowlist pattern anchors
# the offending package, the requirement subject, and the DIRECTION of the bound, never the
# installed versions (those drift every rebuild); a new conflict between the same two packages
# in the other direction is NOT silently eaten. NB: quoted heredoc delimiter is load-bearing —
# it stops BuildKit expanding the $vars below; the body runs verbatim under the image's default
# /bin/sh (dash), so the script is strictly POSIX (no arrays, no pipefail).
RUN <<'PIP_CHECK_GATE'
set -eu
rc=0
PIP_DISABLE_PIP_VERSION_CHECK=1 pip check >/tmp/pip-check-raw.txt 2>&1 || rc=$?
echo "=== pip check: full raw output (exit ${rc}) ==="
cat /tmp/pip-check-raw.txt
echo "=== pip check: end of raw output ==="

# Known-conflict allowlist. pip check line shapes covered (both wordings pip has used):
#   "<pkg> <ver> has requirement <req>, but you have <pkg> <ver>."
#   "<pkg> <ver> requires <req>, but you have <pkg> <ver>."
# ("<req>, which is not installed." lines are deliberately NOT allowlisted: none of the six
# is a missing package, and a formerly-present package going missing must fail the build.)
#
# torchvision pins torch==<exact stable>; we ship the pinned ROCm-nightly torch and no PyPI
# torchvision ever declares compatibility with a +rocm local version — unsatisfiable by
# construction, the reason this gate cannot be a bare `pip check`.
ALLOW_TORCHVISION_TORCH='^torchvision [0-9][^ ]* (has requirement|requires) torch==.*, but you have torch '
# vllm pins grpcio==<exact>; the wheel set resolves a newer grpcio — pre-existing skew.
ALLOW_VLLM_GRPCIO='^vllm [0-9][^ ]* (has requirement|requires) grpcio==.*, but you have grpcio '
# vllm pins grpcio-reflection==<exact>; same newer-than-pinned skew as grpcio above.
# (The s32 notes miscast this line as grpcio-reflection pinning grpcio; the CI raw
# output shows vllm as the offender, and grpcio-reflection 1.83 is content with
# grpcio 1.83 — corrected from run 31653533467.)
ALLOW_VLLM_GRPCIO_REFLECTION='^vllm [0-9][^ ]* (has requirement|requires) grpcio-reflection==.*, but you have grpcio-reflection '
# grpcio-tools caps protobuf<7; we have protobuf 7.x. Pattern requires the '<' upper bound.
ALLOW_GRPCIO_TOOLS_PROTOBUF='^grpcio-tools [0-9][^ ]* (has requirement|requires) protobuf[^ ]*<.*, but you have protobuf '
# numba caps numpy<2.3; we have numpy 2.5.x. Pattern requires the '<' upper bound.
ALLOW_NUMBA_NUMPY='^numba [0-9][^ ]* (has requirement|requires) numpy[^ ]*<.*, but you have numpy '
# vllm caps setuptools<80; we have setuptools 80.x. Pattern requires the '<' upper bound.
ALLOW_VLLM_SETUPTOOLS='^vllm [0-9][^ ]* (has requirement|requires) setuptools[^ ]*<.*, but you have setuptools '

# grep -v keeps only UNfiltered (i.e. new) lines; it exits 1 when everything was filtered,
# which is the GOOD case — hence the || true.
grep -v -E \
    -e '^[[:space:]]*$' \
    -e '^No broken requirements found' \
    -e "$ALLOW_TORCHVISION_TORCH" \
    -e "$ALLOW_VLLM_GRPCIO" \
    -e "$ALLOW_VLLM_GRPCIO_REFLECTION" \
    -e "$ALLOW_GRPCIO_TOOLS_PROTOBUF" \
    -e "$ALLOW_NUMBA_NUMPY" \
    -e "$ALLOW_VLLM_SETUPTOOLS" \
    /tmp/pip-check-raw.txt >/tmp/pip-check-new.txt || true

if [ -s /tmp/pip-check-new.txt ]; then
    echo "=== pip check gate: NEW conflicts (not on the known-conflict allowlist) ==="
    cat /tmp/pip-check-new.txt
    echo "FAIL: pin the named package (see step 5 above) or, ONLY if the conflict is"
    echo "pre-existing and unsatisfiable by construction, allowlist it with a rationale."
    exit 1
fi
if [ "${rc}" -ne 0 ] && ! [ -s /tmp/pip-check-raw.txt ]; then
    echo "FAIL: pip check exited ${rc} with no output - failing closed."
    exit 1
fi
echo "pip check gate: OK (only known allowlisted conflicts present)."
rm -f /tmp/pip-check-raw.txt /tmp/pip-check-new.txt
PIP_CHECK_GATE

# Runtime shell env + banner
COPY profile.d/01-rocm-env-for-triton.sh /etc/profile.d/01-rocm-env-for-triton.sh
COPY profile.d/99-toolbox-banner.sh      /etc/profile.d/99-toolbox-banner.sh
COPY profile.d/zz-venv-last.sh           /etc/profile.d/zz-venv-last.sh
RUN chmod 0644 /etc/profile.d/01-rocm-env-for-triton.sh \
      /etc/profile.d/99-toolbox-banner.sh /etc/profile.d/zz-venv-last.sh

# FP8 shim + runtime env. VLLM_NO_USAGE_STATS=1 opts out of vLLM usage/do-not-track
# reporting (baked, per the hidden-state disposition — we do NOT persist ~/.config/vllm).
ENV PYTHONPATH=/opt/fp8 \
    FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE \
    VLLM_TARGET_DEVICE=rocm \
    VLLM_USE_TRITON_AWQ=1 \
    TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1 \
    MIOPEN_FIND_MODE=FAST \
    VLLM_DISABLE_COMPILE_CACHE=1 \
    VLLM_NO_USAGE_STATS=1 \
    PYTHONNOUSERSITE=1

# Droste runtime contract: per-port build-spec + config template + shared entrypoint.
# gen_vllm_config.py runs at BUILD, harvesting the pinned upstream MODEL_TABLE (vendored,
# hermetic) into the config template that templates.yaml seeds to /opt/data on first run.
COPY build-spec                 /opt/resources/build-spec
COPY templates/                 /opt/resources/templates/
COPY scripts/gen_vllm_config.py /opt/resources/scripts/gen_vllm_config.py
COPY upstream/models.py         /opt/resources/scripts/vllm_models_pinned.py
RUN python3 /opt/resources/scripts/gen_vllm_config.py \
      --models /opt/resources/scripts/vllm_models_pinned.py \
      --out    /opt/resources/templates/vllm_config.yaml

# Group-writable venv so the distrobox-lane box user (in group `droste`) can
# pip-install into the baked venv after overlay copy-up (dirs setgid → copy-up
# is metadata-only; new files inherit the group). Re-applied here AFTER this
# port's pip installs (runtime-base did it for its own venv content).
RUN chgrp -R droste /opt/venv \
    && chmod -R g+rwX /opt/venv \
    && find /opt/venv -type d -exec chmod g+s {} +

ENTRYPOINT ["/opt/resources/resolve/droste-entrypoint.sh"]
