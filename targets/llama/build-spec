#
#   common/arg.cpp     4206 -> 4729 lines, 1131 changed lines
#   common/common.cpp  2148 -> 2296 lines,  304 changed lines
#   common/common.h    1101 -> 1191 lines,  186 changed lines
#   common/hf-cache.cpp 498 ->  513 lines,   15 changed lines
