# this container's mounts + service, both lanes
#
# build-spec — finetuning runtime declaration, sourced by the shared resolver
# (/opt/resources/resolve/droste-resolve.sh). Baked at /opt/resources/build-spec.
# See base/resolve/build-spec.example for the full contract.

# ── SERVICE ──────────────────────────────────────────────────────────────────
# JupyterLab, rooted at the user workspace so relative output-*/ dirs from
# train.py land on the persistent workspace mount. --notebook-dir is a live
# jupyter-server alias for ServerApp.root_dir. Default token auth stays ON — the
# token rerolls every start and `jupyter server list` is how you read it;
# JUPYTER_TOKEN in ENV_FILE fixes one (which only became reachable when this box
# got an ENV_FILE at all).
#
# ONE array, used twice. SERVICE is a usable argv on its own AND
# finetuning_pre_launch REBUILDS it FROM THIS ARRAY once ENV_FILE has been
# sourced, so DROSTE_JUPYTER_EXTRA_ARGS can join the command line. Rebuilding
# from the array rather than appending to SERVICE means calling PRE_LAUNCH twice
# cannot grow the argv, and it retires the old "keep the two copies in step"
# hazard — there is only one copy now. (comfyui's HEAD/TAIL split is the same
# idea; this box needs no TAIL because nothing here is nargs-greedy.)
JUPYTER_ARGV_BASE=(
    jupyter lab --ip 0.0.0.0 --port 8888 --notebook-dir=/opt/workspace
    --no-browser --allow-root
)
SERVICE=( "${JUPYTER_ARGV_BASE[@]}" )

# ── HEALTH — probe endpoint for droste-healthcheck.sh ────────────────────────
# JupyterLab has no unauthenticated health route: / redirects to /login (302) and
# the API paths answer 403 without the token. ANY HTTP response therefore proves
# the server is up, which is exactly what HEALTH_ACCEPT="any" means.
HEALTH_PATH="/"
HEALTH_ACCEPT="any"

# ── ENV_FILE ─────────────────────────────────────────────────────────────────
# Seeded from templates/finetuning.env (templates.yaml if_missing). Both resolvers
# source it under `set -a`, so every assignment reaches the JupyterLab process —
# and that is the ONLY mechanism that can act before Jupyter reads any config,
# which is what makes JUPYTER_CONFIG_DIR (and therefore the seeded trait file)
# work at all. server.env cannot do this: it is read in a subshell whose output is
# discarded except for three keys.
#
# ⭐ `set -a` is also why a NATIVE spelling never needs wiring to keep working: a
# user's own JUPYTER_*/TRAITLETS_* line is already exported by the time PRE_LAUNCH
# runs. What the wiring below adds is the droste-named surface on top of it, plus
# the defaults that cannot live in a seeded file (jupyter_env, N1a).
#
# ⚠️ Until this existed, JUPYTER_TOKEN was advertised in two places and honoured
# in neither — a knob present but inert, which is worse than an absent one.
ENV_FILE="/opt/data/finetuning.env"

# ── OVERLAYS — <upper>:<lower> ───────────────────────────────────────────────
# venv overlay (universal): user pip installs land on /opt/program-cache (CACHE
# class — a pip install is re-runnable, so the installer may empty that root),
# the baked torch/unsloth/flash-attn stack stays pristine underneath. This (plus
# the workspace user bind) is what retires the old `chmod -R a+rwX /opt` hack.
OVERLAYS=(
    "/opt/program-cache/venv:/opt/venv"
)

# ── SURFACES — <src>:<dest> ──────────────────────────────────────────────────
# None: the workspace is the USER'S bind (CRITICAL below), not container state
# surfaced from /opt/data.
SURFACES=()

# ── CACHES — <src>:<dest> ────────────────────────────────────────────────────
# Compute/kernel caches at the tools' DEFAULT paths, zero env vars, sourced from
# /opt/program-cache/compute/ — THE compute/ PREFIX IS LOAD-BEARING: it is what
# the resolver rewrites to the shared /opt/caches store when that volume is
# bound. Triton is the hot one here (flash-attn Triton backend + unsloth kernels;
# default ~/.triton/cache — 01-rocm-env-for-triton.sh sets toolchain paths only,
# no cache dir). MIOpen keeps both its cache and its .config db side.
CACHES=(
    "/opt/program-cache/compute/miopen:$HOME/.cache/miopen"
    "/opt/program-cache/compute/miopen-db:$HOME/.config/miopen"
    "/opt/program-cache/compute/triton:$HOME/.triton/cache"
    "/opt/program-cache/compute/torch:$HOME/.cache/torch"
)

# ── CRITICAL — <label>:<path> ────────────────────────────────────────────────
# workspace holds edited notebooks AND trained adapters (relative output-*/) =
# irreplaceable work; HF cache unbound = silent 20GB+ model/dataset re-download.
# Both hard-error unless bound (ALLOW_EPHEMERAL escapes).
CRITICAL=(
    "workspace:/opt/workspace"
    "hf-cache:$HOME/.cache/huggingface"
)

# ── OPTIONAL ─────────────────────────────────────────────────────────────────
# None: finetuning pulls models/datasets from the HF hub — no /opt/models role.
OPTIONAL=()

# ── DROSTE_JUPYTER_* → the native variables ──────────────────────────────────
# This box's droste-owned settings are named for the APP, not the box (Jei's call
# when he reviewed finetuning.env: the box is `finetuning`, the server is
# Jupyter), so the prefix is DROSTE_JUPYTER_ and not DROSTE_FINETUNING_.
#
# 🚨 FIVE READERS, FIVE DIALECTS, IN ONE BOX. Read at the pinned versions
# (Container.finetuning: jupyter_core 5.8.1, jupyter_server 2.21.0, traitlets
# 5.14.3), which is why the table carries a true-wire AND a false-wire column per
# row instead of one shared "1"/"0" — no single pair of values works everywhere:
#
#   envset()                          jupyter_core/paths.py:49-60 — TRUE unless
#     the value is one of {no,n,false,off,0,0.0}; a BLANK therefore reads TRUE
#   .lower() in ("true","1")          jupyter_core/paths.py:1031
#   .lower() in ["true","yes"]        jupyter_server/serverapp.py:1348-1350
#     🚨 `1` reads as FALSE here — the true-wire MUST be the word `true`. A BLANK
#     is falsy to the getenv guard on :1348, so it falls through to Bool(True)
#   env_flag and env_flag != "0"      traitlets/utils/warnings.py:55-57 — any
#     non-empty value except "0" is TRUE
#   strict {0,1,true,false,""}        traitlets/config/application.py:85-93 —
#     anything else raises ValueError AT IMPORT, i.e. the server does not start
#
#     "<SUFFIX>:<native var>:<true-wire>:<false-wire>"
JUPYTER_BOOL_VARS=(
    # .lower() in ["true","yes"] — see the trap above; `1` would mean "no"
    "ALLOW_UNAUTH_ACCESS:JUPYTER_SERVER_ALLOW_UNAUTHENTICATED_ACCESS:true:false"
    # .lower() in ("true","1")
    "ALLOW_INSECURE_WRITES:JUPYTER_ALLOW_INSECURE_WRITES:1:0"
    # envset() — "0" is in its false list, so this pair is safe
    "PLATFORM_DIRS:JUPYTER_PLATFORM_DIRS:1:0"
    # anything but "0" is TRUE
    "ALL_DEPRECATIONS:TRAITLETS_ALL_DEPRECATIONS:1:0"
    # strict whitelist; "1" and "0" are two of the five values it accepts
    "RAISE_CONFIG_ERROR:TRAITLETS_APPLICATION_RAISE_CONFIG_FILE_ERROR:1:0"
)

# jupyter_env — DROSTE_JUPYTER_* → the native environment, exported for the served
# process. Its own function so it can be driven alone (source the spec, call it,
# print the environment) without the mounts or the profile.d source.
#
# ⚠️ EXPORT IS REQUIRED. resolve::apply_spec runs `set +a` before PRE_LAUNCH, so a
# bare assignment here would never reach the Jupyter process — a silent no-op.
# ⚠️ `${VAR=default}`, never `:=`: absent ⇒ ours, set ⇒ theirs, and a BLANK is a
# value the user typed, passed through verbatim rather than replaced.
# 🚨 A BAD VALUE IS LOUD BUT NEVER FATAL, as in every other port: PRE_LAUNCH runs
# under `set -e` in BOTH lanes, so a non-zero return here would kill the server
# entrypoint and fail the distrobox init hook — taking away the easiest way to fix
# the typo. Every rejected value is named on stderr together with what happens
# instead, and the box comes up in its DOCUMENTED state.
jupyter_env() {
    local entry suffix rest var on off val

    # ── the natives where a BLANK is not "unset" ────────────────────────────────
    # 🚨 THE SELECTION CRITERION IS WHAT THE READER DOES WITH "", NOT WHAT THE LINE
    # DISPLAYS. This list used to hold three names, and the reason recorded here was
    # "the lines finetuning.env prints BLANK with an annotation that says unset". That
    # criterion is display-based, so by construction it cannot see a line that SHOWS a
    # value and still dies once the user clears it — NBFORMAT_VALIDATOR ships as
    # `NBFORMAT_VALIDATOR=fastjsonschema`, a real constant, and was missed by exactly
    # that blindness. The same flaw understated llama (13 names → 60) and vllm (1 →
    # 89). Jei's ruling (s57) replaces it:
    # ⭐ ANYTHING THAT COULD TAKE DOWN THE BOX ON AN EMPTY STRING, WE UNSET IF EMPTY.
    #
    # ENV_FILE is sourced under `set -a`, so uncommenting ANY line hands the server an
    # EMPTY STRING rather than an absence. All 18 natives finetuning.env exposes were
    # MEASURED at the pins — each reader executed twice in isolated subprocesses, once
    # with the name absent and once with it "", and the outputs compared. Four differ:
    #
    #   IPYTHONDIR                        IPython/paths.py:36 `env.get("IPYTHONDIR",
    #     None)` then `if ipdir is None` ⇒ "" survives; measured, get_ipython_dir()
    #     returns "." instead of ~/.ipython, so profiles are written into whatever
    #     directory the server happens to be in. ⚠️ THE ONE ENTRY THAT RAISES NOTHING
    #     — it is silently wrong, and only comparing OUTPUTS finds it. Watching for an
    #     exception would have called this row harmless.
    #   QT_API                            qtpy/__init__.py:172
    #     `os.environ.get(QT_API, "pyqt5").lower()`, then a membership check against
    #     API_NAMES at :174 ⇒ "" is no binding and :175 raises PythonQtValueError,
    #     killing the import for any cell that reaches a Qt UI.
    #   JUPYTER_DEFAULT_PROVISIONER_NAME  jupyter_client/provisioning/factory.py:45
    #     `getenv(..., "local-provisioner")` — the fallback fires ONLY when the name is
    #     ABSENT, so "" becomes the provisioner NAME. ipykernel's kernelspec carries no
    #     kernel_provisioner stanza, so factory.py:150 falls through to that trait for
    #     EVERY kernel and factory.py:89 raises `ModuleNotFoundError: Kernel
    #     provisioner '' has not been registered.` (driven end to end, not read).
    #   NBFORMAT_VALIDATOR                nbformat/json_compat.py:122
    #     `os.environ.get("NBFORMAT_VALIDATOR", "fastjsonschema")` — an ABSENCE
    #     fallback again — then _validator_for_name (:105-108) raises `ValueError:
    #     Invalid validator '' value!`. validator.py:68 sits on the path of every
    #     notebook read AND every save: measured against jupyter_server's own
    #     FileContentsManager, opening a notebook answers `HTTP 400: Unreadable
    #     Notebook` and saving one raises. NEW IN THIS LIST, and the reason the sweep
    #     was redone.
    #
    # 🚨 ALL FOUR START THE SERVER. Nothing here fails the launch or the health probe;
    # the box comes up green and a feature is broken — kernels, notebook I/O, Qt
    # imports, IPython profile location. That is the WORST shape of this defect, not a
    # milder one, which is why the ruling is read as "could take down what the box is
    # FOR" and not merely "could stop the process".
    #
    # The other fourteen measured BYTE-IDENTICAL between absent and "" and are left
    # alone: the jupyter_core path variables are truthiness tests (paths.py:156, :175,
    # :207, :298, :397) and XDG_DATA_HOME is `env.get(...)` then `if not xdg`
    # (paths.py:191-192); JUPYTERLAB_DIR is a truthiness test (jupyterlab/commands.py
    # :158) while JUPYTERLAB_SETTINGS_DIR and JUPYTERLAB_WORKSPACES_DIR use
    # `x or <default>` (commands.py:143, :150); JUPYTER_TOKEN and JUPYTER_TOKEN_FILE
    # are `os.getenv` truthiness (jupyter_server/auth/identity.py:211, :214), so a
    # blank still gets a fresh random token; MPLBACKEND is `if os.environ.get(...)`
    # (matplotlib/__init__.py:1288) and ipykernel's own `if not os.environ.get(...)`
    # (kernelapp.py:583) still installs the inline backend.
    # ⚠️ JUPYTERHUB_SINGLEUSER_APP reads a blank as absent (jupyterlab/labhubapp.py:14,
    # `if not os.environ.get`) AND that module cannot import here at all — no
    # jupyterhub is installed — so it is inert twice over.
    # ⚠️ JUPYTER_USE_PROGRAMDATA DOES read a blank as TRUE (envset(), paths.py:214,
    # whose false list {no,n,false,off,0,0.0} does not contain the empty string), but
    # every consumer is `os.name == "nt"`-gated (paths.py:216, :221, :237, :343).
    # MEASURED on Linux: SYSTEM_JUPYTER_PATH and SYSTEM_CONFIG_PATH come out identical
    # with the variable absent and blank, so it is inert here rather than guarded —
    # the template already files it under Wrong Platform.
    #
    # ⚠️ ONLY jupyter_core 5.8.1, jupyter_server 2.21.0, jupyterlab 4.6.3,
    # jupyterlab_server 2.28.0 and traitlets 5.14.3 are PINNED in Container.finetuning.
    # The readers for IPYTHONDIR, QT_API, JUPYTER_DEFAULT_PROVISIONER_NAME,
    # NBFORMAT_VALIDATOR and MPLBACKEND live in UNPINNED transitive deps and were
    # measured at IPython 9.17.0, QtPy 2.4.3, jupyter_client 8.10.0, nbformat 5.11.1
    # and matplotlib 3.11.1 — their line numbers move on a bump, so re-read them rather
    # than trusting these citations.
    #
    # ⚠️ A NAMED LIST, NOT A SWEEP — droste::blank_is_unset's own comment
    # (base/resolve/droste-common.sh:85-90) is the rule, and it forbids a blanket
    # policy. Every DROSTE_JUPYTER_* keeps its blank: there a blank is the documented
    # N1a opt-out, and the loops below already treat it as "leave the native alone".
    # No DROSTE_-owned name appears here; that is a standing invariant, not an accident
    # of the current contents.
    # ⭐ PLACEMENT IS ORDERING, NOT LOCATION, and here the two sets are DISJOINT.
    # Everything this function assigns or unsets below names a different native —
    # JUPYTER_CONFIG_DIR, JUPYTER_SERVER_ALLOW_UNAUTHENTICATED_ACCESS,
    # JUPYTER_ALLOW_INSECURE_WRITES, JUPYTER_PLATFORM_DIRS, TRAITLETS_ALL_DEPRECATIONS,
    # TRAITLETS_APPLICATION_RAISE_CONFIG_FILE_ERROR, JUPYTER_PREFER_ENV_PATH and
    # JUPYTER_NO_CONFIG — and each of those handles its own blank deliberately, so this
    # call neither undoes nor is undone by any of them.
    # 🚨 What it MUST NOT do is run BEFORE a `${VAR=…}` droste default for a name it
    # also unsets: that would turn a user's deliberate blank opt-out back into our
    # value. No such overlap exists today, and adding a name to BOTH lists means moving
    # this call below the defaults, exactly as llama's build-spec had to.
    droste::blank_is_unset \
        IPYTHONDIR QT_API JUPYTER_DEFAULT_PROVISIONER_NAME NBFORMAT_VALIDATOR

    # ── the droste-supplied defaults (N1a: a default belongs in the WIRING) ─────
    # Two of them HERE. A third — JUPYTER_PREFER_ENV_PATH — supplies its default
    # from the droste-named block further down instead, because it needs an
    # off-state that a bare `${VAR=…}` cannot express (a blank reads TRUE upstream).
    # Every other setting on this box agrees with its package's own default, so the
    # wiring says nothing at all unless the user does.
    # 🚨 WITHOUT THE FIRST OF THESE THE WHOLE TRAIT FILE IS INERT, SILENTLY.
    # templates.yaml seeds jupyter_server_config.py to /opt/data/, beside this box's
    # ENV_FILE, and that directory is on Jupyter's config search path ONLY because
    # JUPYTER_CONFIG_DIR names it (jupyter_core/paths.py:156-157).
    # ⭐ FLAT ON PURPOSE (Jei, s56): the two halves of the config surface sit
    # together where a user looks for them. /opt/data holds nothing else but
    # droste's own .droste-serve.log — /opt/workspace is a separate bind and
    # OPTIONAL is empty — so what Jupyter itself writes into a config dir
    # (jupyter_server_config.json from `jupyter server password`,
    # jupyter_server_config.d/, the frontend config dir) lands among config,
    # not among the user's data. An active line in finetuning.env
    # cannot supply this: the file is seeded if_missing, so it would reach NEW
    # boxes only and every existing box would start with ~130 traits sitting at
    # their defaults, no warning, server healthy.
    # ✅ Blank is a real off-state, not a broken one: paths.py:156 tests
    # truthiness, so JUPYTER_CONFIG_DIR= falls through to Jupyter's own location.
    : "${JUPYTER_CONFIG_DIR=/opt/data}"
    export JUPYTER_CONFIG_DIR
    # ⚠️ SECOND DEFAULT, AND IT IS PINNED ON PURPOSE RATHER THAN INHERITED.
    # finetuning.env:62-63 documents `{yes, no}` and SHOWS
    # DROSTE_JUPYTER_ALLOW_UNAUTH_ACCESS=yes, so droste's default is YES and the
    # wiring's job is to deliver exactly that (the config file is the
    # specification). jupyter_server's own default agrees today —
    # allow_unauthenticated_access = Bool(True), serverapp.py:1327 — but we state
    # the default in a file the user reads, so we pin it instead of inheriting it:
    # an upstream flip (the trait's own help text says "subject to change in the
    # future") must not silently change what this box does.
    # 🚨 DIALECT TRAP: the reader is `.lower() in ["true","yes"]`
    # (serverapp.py:1348-1350), so the true-wire MUST be a word — `1` reads FALSE.
    # ✅ Blank is still the user's own off-state: getenv on :1348 is falsy for an
    # empty string, which falls through to Bool(True)… i.e. blank ALSO means yes
    # here. That is upstream's rule, and it happens to agree with our default.
    : "${JUPYTER_SERVER_ALLOW_UNAUTHENTICATED_ACCESS=true}"
    export JUPYTER_SERVER_ALLOW_UNAUTHENTICATED_ACCESS

    # ── the tabulated booleans ──────────────────────────────────────────────────
    for entry in "${JUPYTER_BOOL_VARS[@]}"; do
        suffix=${entry%%:*}; rest=${entry#*:}
        var=${rest%%:*};     rest=${rest#*:}
        on=${rest%%:*};      off=${rest#*:}
        val="DROSTE_JUPYTER_$suffix"; val=${!val:-}
        # Unset or blank leaves the native variable exactly as it is: the user's
        # own native line, or a default set above, or the package's own.
        [ -n "$val" ] || continue
        case "$(droste::bool "$val")" in
            on)  export "$var=$on" ;;
            off) export "$var=$off" ;;
            *)   serve::err "DROSTE_JUPYTER_$suffix='$val' is not a yes/no value — leaving $var as it is. Use yes or no. Fix it in $ENV_FILE and restart the box." ;;
        esac
    done

    # ── PREFER_ENV_PATH: a row that carries a default AND cannot be tabulated ───
    # 🚨 WHAT IT DECIDES, PRECISELY — this is NOT covered by JUPYTER_CONFIG_DIR.
    # jupyter_core assembles its search paths as [env…, user…] or [user…, env…]
    # depending on this one flag: paths.py:322 for the DATA path, paths.py:421 for
    # the CONFIG path. "env" is the VENV — /opt/venv/etc/jupyter and
    # /opt/venv/share/jupyter (paths.py:340, :249, both str(Path(sys.prefix, …))).
    # "user" is jupyter_config_dir() / jupyter_data_dir(), i.e. /opt/data here,
    # plus the per-user site dirs. Traitlets loads that list REVERSED
    # (application.py:904), so the FIRST entry is the one that wins.
    #   JUPYTER_CONFIG_DIR names WHICH directory the user level IS.
    #   This names WHERE that level SITS relative to the venv's.
    # And it has no CONFIG_DIR analogue on the other half at all: jupyter_path()
    # — the DATA SEARCH path, i.e. kernelspecs and labextensions — is ordered by
    # this flag alone. So the setting is REAL, not cosmetic — with it on, a
    # stray /opt/venv/etc/jupyter file would outrank the user's own /opt/data.
    # ⭐ DROSTE'S DEFAULT IS `no` (wire `0`) — prefer the USER's dirs. /opt/venv is a
    # baked overlay LOWER; the user's answer is the one that should win. It is
    # PINNED rather than inherited, and this is the whole reason the row exists:
    # ⚠️ ABSENT IS NOT THE SAME ANSWER AS `0`. With the variable gone, paths.py:117
    # returns True whenever sys.prefix is a virtualenv the process owns — and this
    # box IS one — so the order would be decided by an OWNERSHIP TEST on
    # /opt/venv (paths.py:83-107, and that directory is an overlay merge) rather
    # than by a decision. Unsetting it is a different behaviour, not a tidier
    # spelling of the same one.
    # 🚨 A BLANK CANNOT BE PASSED THROUGH — this is the defect this row fixes.
    # envset() (paths.py:49-60) is TRUE for every value except
    # {no,n,false,off,0,0.0}, so `JUPYTER_PREFER_ENV_PATH=` reads TRUE: a user who
    # uncommented the old native line and cleared it turned the setting ON. Since
    # paths.py:113 tests PRESENCE before value, the only way to say "let Jupyter
    # decide" is for the variable not to exist — so blank UNSETS it here, the same
    # shape as SKIP_CONFIG below and for the same upstream reason.
    # ⚠️ Every arm returns 0: PRE_LAUNCH runs unguarded under `set -euo pipefail`.
    val=${DROSTE_JUPYTER_SEARCH_VENV_FIRST-}
    if [ -z "${DROSTE_JUPYTER_SEARCH_VENV_FIRST+set}" ]; then
        # Absent ⇒ droste's default. `${VAR=0}` rather than a bare assignment so a
        # user's own NATIVE JUPYTER_PREFER_ENV_PATH line still wins — `set -a` has
        # already exported it by the time PRE_LAUNCH runs.
        : "${JUPYTER_PREFER_ENV_PATH=0}"
        export JUPYTER_PREFER_ENV_PATH
    elif [ -z "$val" ]; then
        # The documented N1a opt-out: hand Jupyter's own detection back the row.
        unset JUPYTER_PREFER_ENV_PATH
    else
        case "$(droste::bool "$val")" in
            on)  export JUPYTER_PREFER_ENV_PATH=1 ;;
            off) export JUPYTER_PREFER_ENV_PATH=0 ;;
            # Never leave the user's string on the wire: envset() would read
            # almost any typo as TRUE, which is the dangerous direction.
            *)   serve::err "DROSTE_JUPYTER_SEARCH_VENV_FIRST='$val' is not a yes/no value — using droste's default (no: your own config and data dirs are searched before /opt/venv's). Use yes or no. Fix it in $ENV_FILE and restart the box."
                 : "${JUPYTER_PREFER_ENV_PATH=0}"
                 export JUPYTER_PREFER_ENV_PATH ;;
        esac
    fi

    # ── SKIP_CONFIG, the other row that cannot be tabulated ─────────────────────
    # JUPYTER_NO_CONFIG is read as BARE TRUTHINESS (jupyter_core/paths.py:153 and
    # :390 — `if env.get(...)`), so THERE IS NO FALSE-WIRE: `0`, `no` and `false`
    # all turn it ON. The only way to say no is for the variable not to exist, so
    # `off` UNSETS it — which also overrides a native JUPYTER_NO_CONFIG the user
    # set in the same file, because the droste answer is the later word.
    # ⚠️ What a true value does here is worse than the name suggests: it makes
    # jupyter_config_dir() return a throwaway temp dir, so the seeded trait file is
    # silently ignored along with every other config file.
    val=${DROSTE_JUPYTER_SKIP_CONFIG:-}
    if [ -n "$val" ]; then
        case "$(droste::bool "$val")" in
            on)  export JUPYTER_NO_CONFIG=1 ;;
            off) unset JUPYTER_NO_CONFIG ;;
            *)   serve::err "DROSTE_JUPYTER_SKIP_CONFIG='$val' is not a yes/no value — leaving config files loading normally. Use yes or no. Fix it in $ENV_FILE and restart the box." ;;
        esac
    fi
}

# ── PRE_LAUNCH ───────────────────────────────────────────────────────────────
# The server lane never sources /etc/profile.d (no login shell), but the Triton
# HIP toolchain env (TRITON_HIP_LLD_PATH/_CLANG_PATH + SDK LD_LIBRARY_PATH) it
# provides is needed for flash-attn/unsloth kernel compiles under Jupyter too.
# Source the exact script the interactive lane uses so both lanes match.
PRE_LAUNCH="finetuning_pre_launch"
finetuning_pre_launch() {
    # shellcheck source=/dev/null
    source /etc/profile.d/01-rocm-env-for-triton.sh

    # After ENV_FILE has been sourced: turn the user's finetuning.env into the
    # environment the server will actually see.
    jupyter_env

    # Rebuild SERVICE now that DROSTE_JUPYTER_EXTRA_ARGS is known. It goes LAST
    # deliberately: a Jupyter command-line flag beats every config file AND a
    # repeated flag resolves to the later one, so appending is what makes the
    # catch-all able to override an argument droste sets (--ip is the one users
    # ask for). Quote-aware split (droste::split_args), matching the other ports:
    # a value MAY contain spaces, and it is not glob-expanded.
    mapfile -d '' -t _extra < <(droste::split_args "${DROSTE_JUPYTER_EXTRA_ARGS:-}")
    SERVICE=( "${JUPYTER_ARGV_BASE[@]}" ${_extra[@]+"${_extra[@]}"} )
}
