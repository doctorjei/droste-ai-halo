# this container's mounts + service, both lanes
#
# build-spec — finetuning runtime declaration, sourced by the shared resolver
# (/opt/resources/resolve/droste-resolve.sh). Baked at /opt/resources/build-spec.
# See base/resolve/build-spec.example for the full contract.

# ── SERVICE ──────────────────────────────────────────────────────────────────
# JupyterLab, rooted at the user workspace so relative output-*/ dirs from
# train.py land on the persistent workspace mount. --notebook-dir is a live
# jupyter-server alias for ServerApp.root_dir. Default token auth stays ON — the
# token rerolls every start and `jupyter server list` is how you read it;
# JUPYTER_TOKEN in CFG_FILE fixes one (which only became reachable when this box
# got an CFG_FILE at all).
#
# ONE array, used twice. SERVICE is a usable argv on its own AND
# finetuning_pre_launch REBUILDS it FROM THIS ARRAY once CFG_FILE has been
# sourced, so DROSTE_JUPYTER_EXTRA_ARGS can join the command line. Rebuilding
# from the array rather than appending to SERVICE means calling PRE_LAUNCH twice
# cannot grow the argv, and it retires the old "keep the two copies in step"
# hazard — there is only one copy now. (comfyui's HEAD/TAIL split is the same
# idea; this box needs no TAIL because nothing here is nargs-greedy.)
# ⭐ THE ADDRESS AND THE PORT ARE DROSTE DEFAULTS HERE, NOT CONSTANTS (s60). They used
# to be owned by server.env; they are DROSTE_JUPYTER_HOST and DROSTE_JUPYTER_PORT now,
# in finetuning.cfg, and serve::apply_host / serve::apply_port REWRITE the token after
# --ip and after --port before the service is launched. So what these two literals are
# is the answer a box gets when its user set neither — and the argv a direct
# `podman run` of this image gets, where no launcher runs at all.
# ⚠️ DO NOT TRANSLATE EITHER OF THEM IN PRE_LAUNCH. The launcher reads the same two cfg
# keys through droste::cfg_get and is the only place that validates them (an IPv4
# literal, one message on all five boxes); a second reader here would be a second
# mechanism that agrees with it only until one of the two changes.
JUPYTER_ARGV_BASE=(
    jupyter lab --ip 0.0.0.0 --port 8888 --notebook-dir=/opt/workspace
    --no-browser --allow-root
)
SERVICE=( "${JUPYTER_ARGV_BASE[@]}" )

# ── HEALTH — probe endpoint for droste-healthcheck.sh ────────────────────────
# `ok` means healthy on 2xx/3xx and unhealthy on anything else
# (droste-healthcheck.sh:145). It is a STATUS-ONLY verdict — the probe asks curl
# for `%{http_code}` with the body thrown away (serve::probe,
# droste-serve.sh:441-462), so there is no body expectation here and none is
# available; llama's HEALTH_ACCEPT="ok" carries none either.
#
# ⭐ WHAT `ok` PROVES HERE. GET <base_url> is Jupyter's own root redirect
# (base_url + default_url, then /login), and it answers 302 whether or not a token
# is required: MEASURED at the pins across allow_unauthenticated_access true/false
# × JUPYTER_TOKEN set/unset — all four 302. So a 2xx/3xx says the tornado
# application is BUILT AND ROUTING, which is exactly what a 404 would deny.
# ⚠️ WHAT IT DELIBERATELY DOES NOT PROVE: that a kernel can start, that
# /opt/workspace is writable, or that any extension loaded. This is a LIVENESS
# probe, not a readiness one — an unauthenticated route that could say more does
# not exist, and inventing one by shipping a token to the probe would put a
# credential where the healthcheck can leak it.
#
# ⚠️ THIS ROW SAID "any" UNTIL s58, AND THE REASON WAS HONEST BUT COSTLY. A
# non-default c.ServerApp.base_url moves EVERY route, so GET / becomes a 404
# (measured: base_url "/deep/lab" ⇒ 404 at /, 302 at /deep/lab/) and `any` — which
# exits 0 on any status that is not empty/000 — kept such a box healthy. The price
# was that it could not tell a serving Jupyter from one 404-ing its entire site.
# ⭐ THE FIX IS TO STOP ADDRESSING THE SERVER AT A PATH THE USER MOVED, not to
# widen what counts as healthy: jupyter_health_prefix (below) reads the effective
# base_url and hands it to droste::set_health_prefix, exactly as llama's
# PRE_LAUNCH does with --api-prefix. Only once the probe knocks in the right place
# is `ok` affordable.
HEALTH_PATH="/"
HEALTH_ACCEPT="ok"

# ── CFG_FILE ─────────────────────────────────────────────────────────────────
# Seeded from templates/finetuning.cfg (templates.yaml if_missing). Both resolvers
# source it under `set -a`, so every assignment reaches the JupyterLab process —
# and that is the ONLY mechanism that can act before Jupyter reads any config,
# which is what makes JUPYTER_CONFIG_DIR (and therefore the seeded trait file)
# work at all. server.env cannot do this: it is read in a subshell whose output is
# discarded except for three keys.
#
# ⭐ `set -a` is also why a NATIVE spelling never needs wiring to keep working: a
# user's own JUPYTER_*/TRAITLETS_* line is already exported by the time PRE_LAUNCH
# runs. What the wiring below adds is the droste-named surface on top of it, plus
# the defaults that cannot live in a seeded file (jupyter_env, N1a).
#
# ⚠️ Until this existed, JUPYTER_TOKEN was advertised in two places and honoured
# in neither — a knob present but inert, which is worse than an absent one.
CFG_FILE="/opt/data/finetuning.cfg"

# ── SERVE — the four rows droste-serve.sh reads out of this spec ─────────────
# The five SERVE settings live in the same CFG_FILE as everything else, under the
# prefix below: DROSTE_JUPYTER_STARTUP_ENABLED / _HOST / _PORT / _TLS_CERT / _TLS_KEY.
# serve::read_config PARSES them with droste::cfg_get and never sources the file — that
# read also runs inside the healthcheck every 30s under --health-on-failure=restart,
# where an abort is a restart loop that ejects every shell in the box.
# 🚨 SERVE_CFG_PREFIX IS REQUIRED, and its absence is not a quiet degradation: a spec
# that names CFG_FILE and no prefix makes read_config refuse to serve and report the
# IMAGE as broken, because otherwise all five settings would read as absent and the box
# would silently stop serving.
# ⭐ THIS IS THE BOX WHERE THE PREFIX RULE IS OBSERVABLE. It names the APPLICATION, not
# the box: the box is `finetuning`, the server is Jupyter, and every droste-owned
# setting here is DROSTE_JUPYTER_* — there is no DROSTE_FINETUNING_ anything. On the
# other four the two names coincide, which is why the rule reads as obvious there.
SERVE_CFG_PREFIX="DROSTE_JUPYTER_"
# The flags this box spells differently from the library's defaults. serve::apply_host
# defaults to --host; Jupyter says --ip, and without the row the launcher would APPEND
# a --host — traitlets exits 2 on an unrecognised flag rather than ignoring it, so the
# server would never start. --port needs no row (all five agree).
SERVE_HOST_FLAG=--ip
# The port a user gets when they set none — Jupyter's own, and the value finetuning.cfg
# already shows on its commented DROSTE_JUPYTER_PORT line. 🚨 THE ROW IS WHAT MAKES THAT
# LINE TRUE (§7a, ruled s60): the address has a library-wide default and the port had
# none, so before this row an absent port did not mean "use 8888" — it meant the box
# refused to serve. It must stay equal to the literal after --port in JUPYTER_ARGV_BASE;
# that copy is what a direct `podman run` gets, where no launcher runs at all.
SERVE_PORT_DEFAULT=8888
# ⚠️ THE TLS PAIR HAS NO LIBRARY DEFAULT, deliberately: there is no majority spelling,
# and a wrong flag is not a wrong value — the server rejects the argv and never starts.
# 🚨 THE NAMES ARE --certfile / --keyfile, NOT the --tls-* pair finetuning.cfg's
# "Covers:" line prints — that is comfyui's spelling. Read at the pin: jupyter_server
# 2.21.0's ServerApp.aliases maps "certfile" → ServerApp.certfile and "keyfile" →
# ServerApp.keyfile (serverapp.py:854-855).
# ⭐ THE FLAGS ARE DECLARED HERE; WHETHER THEY ARE EMITTED IS THE LAUNCHER'S CALL —
# serve::apply_tls emits them ONLY when the user set both, because a flag we emit
# outranks a c.ServerApp.certfile in this box's own jupyter_server_config.py, and a
# default would destroy the choice that file grants.
SERVE_TLS_CERT_FLAG=--certfile
SERVE_TLS_KEY_FLAG=--keyfile

# ── OVERLAYS — <upper>:<lower> ───────────────────────────────────────────────
# venv overlay (universal): user pip installs land on /opt/program-cache (CACHE
# class — a pip install is re-runnable, so the installer may empty that root),
# the baked torch/unsloth/flash-attn stack stays pristine underneath. This (plus
# the workspace user bind) is what retires the old `chmod -R a+rwX /opt` hack.
OVERLAYS=(
    "/opt/program-cache/venv:/opt/venv"
)

# ── SURFACES — <src>:<dest> ──────────────────────────────────────────────────
# None: the workspace is the USER'S bind (CRITICAL below), not container state
# surfaced from /opt/data.
SURFACES=()

# ── CACHES — <src>:<dest> ────────────────────────────────────────────────────
# Compute/kernel caches at the tools' DEFAULT paths, zero env vars, sourced from
# /opt/program-cache/compute/ — THE compute/ PREFIX IS LOAD-BEARING: it is what
# the resolver rewrites to the shared /opt/caches store when that volume is
# bound. Triton is the hot one here (flash-attn Triton backend + unsloth kernels;
# default ~/.triton/cache — 01-rocm-env-for-triton.sh sets toolchain paths only,
# no cache dir). MIOpen keeps both its cache and its .config db side.
CACHES=(
    "/opt/program-cache/compute/miopen:$HOME/.cache/miopen"
    "/opt/program-cache/compute/miopen-db:$HOME/.config/miopen"
    "/opt/program-cache/compute/triton:$HOME/.triton/cache"
    "/opt/program-cache/compute/torch:$HOME/.cache/torch"
)

# ── CRITICAL — <label>:<path> ────────────────────────────────────────────────
# workspace holds edited notebooks AND trained adapters (relative output-*/) =
# irreplaceable work; HF cache unbound = silent 20GB+ model/dataset re-download.
# Both hard-error unless bound (ALLOW_EPHEMERAL escapes).
CRITICAL=(
    "workspace:/opt/workspace"
    "hf-cache:$HOME/.cache/huggingface"
)

# ── OPTIONAL ─────────────────────────────────────────────────────────────────
# None: finetuning pulls models/datasets from the HF hub — no /opt/models role.
OPTIONAL=()

# ── DROSTE_JUPYTER_* → the native variables ──────────────────────────────────
# This box's droste-owned settings are named for the APP, not the box (Jei's call
# when he reviewed finetuning.cfg: the box is `finetuning`, the server is
# Jupyter), so the prefix is DROSTE_JUPYTER_ and not DROSTE_FINETUNING_.
#
# 🚨 FIVE READERS, FIVE DIALECTS, IN ONE BOX. Read at the pinned versions
# (Container.finetuning: jupyter_core 5.8.1, jupyter_server 2.21.0, traitlets
# 5.14.3), which is why the table carries a true-wire AND a false-wire column per
# row instead of one shared "1"/"0" — no single pair of values works everywhere:
#
#   envset()                          jupyter_core/paths.py:49-60 — TRUE unless
#     the value is one of {no,n,false,off,0,0.0}; a BLANK therefore reads TRUE
#   .lower() in ("true","1")          jupyter_core/paths.py:1031
#   .lower() in ["true","yes"]        jupyter_server/serverapp.py:1348-1350
#     🚨 `1` reads as FALSE here — the true-wire MUST be the word `true`. A BLANK
#     is falsy to the getenv guard on :1348, so it falls through to Bool(True)
#   env_flag and env_flag != "0"      traitlets/utils/warnings.py:55-57 — any
#     non-empty value except "0" is TRUE
#   strict {0,1,true,false,""}        traitlets/config/application.py:85-93 —
#     anything else raises ValueError AT IMPORT, i.e. the server does not start
#
#     "<SUFFIX>:<native var>:<true-wire>:<false-wire>"
JUPYTER_BOOL_VARS=(
    # .lower() in ["true","yes"] — see the trap above; `1` would mean "no"
    "ALLOW_UNAUTH_ACCESS:JUPYTER_SERVER_ALLOW_UNAUTHENTICATED_ACCESS:true:false"
    # .lower() in ("true","1")
    "ALLOW_INSECURE_WRITES:JUPYTER_ALLOW_INSECURE_WRITES:1:0"
    # envset() — "0" is in its false list, so this pair is safe
    "PLATFORM_DIRS:JUPYTER_PLATFORM_DIRS:1:0"
    # anything but "0" is TRUE
    "ALL_DEPRECATIONS:TRAITLETS_ALL_DEPRECATIONS:1:0"
    # strict whitelist; "1" and "0" are two of the five values it accepts
    "RAISE_CONFIG_ERROR:TRAITLETS_APPLICATION_RAISE_CONFIG_FILE_ERROR:1:0"
)

# jupyter_env — DROSTE_JUPYTER_* → the native environment, exported for the served
# process. Its own function so it can be driven alone (source the spec, call it,
# print the environment) without the mounts or the profile.d source.
#
# ⚠️ EXPORT IS REQUIRED. resolve::apply_spec runs `set +a` before PRE_LAUNCH, so a
# bare assignment here would never reach the Jupyter process — a silent no-op.
# ⚠️ `${VAR=default}`, never `:=`: absent ⇒ ours, set ⇒ theirs, and a BLANK is a
# value the user typed, passed through verbatim rather than replaced.
# 🚨 A BAD VALUE IS LOUD BUT NEVER FATAL, as in every other port: PRE_LAUNCH runs
# under `set -e` in BOTH lanes, so a non-zero return here would kill the server
# entrypoint and fail the distrobox init hook — taking away the easiest way to fix
# the typo. Every rejected value is named on stderr together with what happens
# instead, and the box comes up in its DOCUMENTED state.
jupyter_env() {
    local entry suffix rest var on off val

    # ── the natives where a BLANK is not "unset" ────────────────────────────────
    # 🚨 THE SELECTION CRITERION IS WHAT THE READER DOES WITH "", NOT WHAT THE LINE
    # DISPLAYS. This list used to hold three names, and the reason recorded here was
    # "the lines finetuning.cfg prints BLANK with an annotation that says unset". That
    # criterion is display-based, so by construction it cannot see a line that SHOWS a
    # value and still dies once the user clears it — NBFORMAT_VALIDATOR ships as
    # `NBFORMAT_VALIDATOR=fastjsonschema`, a real constant, and was missed by exactly
    # that blindness. The same flaw understated llama (13 names → 60) and vllm (1 →
    # 89). Jei's ruling (s57) replaces it:
    # ⭐ ANYTHING THAT COULD TAKE DOWN THE BOX ON AN EMPTY STRING, WE UNSET IF EMPTY.
    #
    # CFG_FILE is sourced under `set -a`, so uncommenting ANY line hands the server an
    # EMPTY STRING rather than an absence. All 18 natives finetuning.cfg exposes were
    # MEASURED at the pins — each reader executed twice in isolated subprocesses, once
    # with the name absent and once with it "", and the outputs compared. Four differ:
    #
    #   IPYTHONDIR                        IPython/paths.py:36 `env.get("IPYTHONDIR",
    #     None)` then `if ipdir is None` ⇒ "" survives; measured, get_ipython_dir()
    #     returns "." instead of ~/.ipython, so profiles are written into whatever
    #     directory the server happens to be in. ⚠️ THE ONE ENTRY THAT RAISES NOTHING
    #     — it is silently wrong, and only comparing OUTPUTS finds it. Watching for an
    #     exception would have called this row harmless.
    #   QT_API                            matplotlib backends/qt_compat.py:60-63
    #     ⇒ "" is not a binding name and the import raises RuntimeError, killing any
    #     cell that reaches a Qt UI.
    #     ⚠️ CORRECTED s58: this cited qtpy/__init__.py:172, and QTPY IS NOT IN THIS
    #     IMAGE — nothing installs it and no Jupyter or matplotlib package pulls it in.
    #     The UNSET behaviour differs too: :56-57 gives None, then :117-128 tries
    #     PyQt6, PySide6, PyQt5, PySide2 and takes the first that imports — NOT a
    #     hardcoded "pyqt5". The guard is right either way; only the citation was wrong.
    #     ⭐ Second site of one misattribution: droste-common.sh carried it too and was
    #     fixed in s57. A wrong citation propagates by being copied, so fix every copy.
    #   JUPYTER_DEFAULT_PROVISIONER_NAME  jupyter_client/provisioning/factory.py:45
    #     `getenv(..., "local-provisioner")` — the fallback fires ONLY when the name is
    #     ABSENT, so "" becomes the provisioner NAME. ipykernel's kernelspec carries no
    #     kernel_provisioner stanza, so factory.py:150 falls through to that trait for
    #     EVERY kernel and factory.py:89 raises `ModuleNotFoundError: Kernel
    #     provisioner '' has not been registered.` (driven end to end, not read).
    #   NBFORMAT_VALIDATOR                nbformat/json_compat.py:122
    #     `os.environ.get("NBFORMAT_VALIDATOR", "fastjsonschema")` — an ABSENCE
    #     fallback again — then _validator_for_name (:105-108) raises `ValueError:
    #     Invalid validator '' value!`. validator.py:68 sits on the path of every
    #     notebook read AND every save: measured against jupyter_server's own
    #     FileContentsManager, opening a notebook answers `HTTP 400: Unreadable
    #     Notebook` and saving one raises. NEW IN THIS LIST, and the reason the sweep
    #     was redone.
    #
    # 🚨 ALL FOUR START THE SERVER. Nothing here fails the launch or the health probe;
    # the box comes up green and a feature is broken — kernels, notebook I/O, Qt
    # imports, IPython profile location. That is the WORST shape of this defect, not a
    # milder one, which is why the ruling is read as "could take down what the box is
    # FOR" and not merely "could stop the process".
    #
    # The other fourteen measured BYTE-IDENTICAL between absent and "" and are left
    # alone: the jupyter_core path variables are truthiness tests (paths.py:156, :175,
    # :207, :298, :397) and XDG_DATA_HOME is `env.get(...)` then `if not xdg`
    # (paths.py:191-192); JUPYTERLAB_DIR is a truthiness test (jupyterlab/commands.py
    # :158) while JUPYTERLAB_SETTINGS_DIR and JUPYTERLAB_WORKSPACES_DIR use
    # `x or <default>` (commands.py:143, :150); JUPYTER_TOKEN and JUPYTER_TOKEN_FILE
    # are `os.getenv` truthiness (jupyter_server/auth/identity.py:211, :214), so a
    # blank still gets a fresh random token; MPLBACKEND is `if os.environ.get(...)`
    # (matplotlib/__init__.py:1288) and ipykernel's own `if not os.environ.get(...)`
    # (kernelapp.py:583) still installs the inline backend.
    # ⚠️ JUPYTERHUB_SINGLEUSER_APP reads a blank as absent (jupyterlab/labhubapp.py:14,
    # `if not os.environ.get`) AND that module cannot import here at all — no
    # jupyterhub is installed — so it is inert twice over.
    # ⚠️ JUPYTER_USE_PROGRAMDATA DOES read a blank as TRUE (envset(), paths.py:214,
    # whose false list {no,n,false,off,0,0.0} does not contain the empty string), but
    # every consumer is `os.name == "nt"`-gated (paths.py:216, :221, :237, :343).
    # MEASURED on Linux: SYSTEM_JUPYTER_PATH and SYSTEM_CONFIG_PATH come out identical
    # with the variable absent and blank, so it is inert here rather than guarded —
    # the template already files it under Wrong Platform.
    #
    # ⚠️ ONLY jupyter_core 5.8.1, jupyter_server 2.21.0, jupyterlab 4.6.3,
    # jupyterlab_server 2.28.0 and traitlets 5.14.3 are PINNED in Container.finetuning.
    # The readers for IPYTHONDIR, QT_API, JUPYTER_DEFAULT_PROVISIONER_NAME,
    # NBFORMAT_VALIDATOR and MPLBACKEND live in UNPINNED transitive deps and were
    # measured at IPython 9.17.0, QtPy 2.4.3, jupyter_client 8.10.0, nbformat 5.11.1
    # and matplotlib 3.11.1 — their line numbers move on a bump, so re-read them rather
    # than trusting these citations.
    #
    # ⚠️ A NAMED LIST, NOT A SWEEP — droste::blank_is_unset's own comment
    # (base/resolve/droste-common.sh:85-90) is the rule, and it forbids a blanket
    # policy. Every DROSTE_JUPYTER_* keeps its blank: there a blank is the documented
    # N1a opt-out, and the loops below already treat it as "leave the native alone".
    # No DROSTE_-owned name appears here; that is a standing invariant, not an accident
    # of the current contents.
    # ⭐ PLACEMENT IS ORDERING, NOT LOCATION, and here the two sets are DISJOINT.
    # Everything this function assigns or unsets below names a different native —
    # JUPYTER_CONFIG_DIR, JUPYTER_SERVER_ALLOW_UNAUTHENTICATED_ACCESS,
    # JUPYTER_ALLOW_INSECURE_WRITES, JUPYTER_PLATFORM_DIRS, TRAITLETS_ALL_DEPRECATIONS,
    # TRAITLETS_APPLICATION_RAISE_CONFIG_FILE_ERROR, JUPYTER_PREFER_ENV_PATH and
    # JUPYTER_NO_CONFIG — and each of those handles its own blank deliberately, so this
    # call neither undoes nor is undone by any of them.
    # 🚨 THE ORDERING RULE CHANGED SIDES IN s58, AND THE OVERLAP IS NOW DELIBERATE.
    # This block used to warn that the call must never run BEFORE a `${VAR=…}` droste
    # default for a name it also unsets, "because that would turn a user's deliberate
    # blank opt-out back into our value". Under Jei's rule — A BLANK MUST BEHAVE EXACTLY
    # AS IF THE SETTING WERE ABSENT, except for an unbounded string whose blank cancels a
    # file or directory that would otherwise load — turning a blank back into our value
    # is the CORRECT outcome for every name that is not that exception. So the call runs
    # FIRST on purpose, and the one overlapping name is JUPYTER_PREFER_ENV_PATH, whose
    # `${JUPYTER_PREFER_ENV_PATH=0}` further down then supplies droste's `no`.
    # ⚠️ THAT NAME IS THE FIFTH, AND IT IS HERE RATHER THAN IN THE PREFER_ENV_PATH BLOCK
    # BECAUSE IT IS A NATIVE. envset() (jupyter_core/paths.py:49-60) is TRUE for every
    # value except {no,n,false,off,0,0.0}, so a bare `JUPYTER_PREFER_ENV_PATH=` reads
    # TRUE — absent and "" are opposite answers, which is exactly this helper's criterion.
    # It is no longer on the template's surface (s57 replaced it with the droste name), so
    # this closes the last way to type the s57 defect by hand.
    # ⚠️ NO DROSTE_-OWNED NAME APPEARS HERE, and that is still a standing invariant: for a
    # DROSTE_ name the equivalent guard is targeted and lives beside its own default
    # (ds4's DS4_BLANK_IS_DEFAULT, and the SEARCH_VENV_FIRST block below), because
    # droste-common.sh:85-90 reserves this helper for natives.
    droste::blank_is_unset \
        IPYTHONDIR QT_API JUPYTER_DEFAULT_PROVISIONER_NAME NBFORMAT_VALIDATOR \
        JUPYTER_PREFER_ENV_PATH

    # ── the XDG bases, one of which finetuning.cfg offers; blanks strand caches ─
    # 🚨 A BLANK XDG_CACHE_HOME MOVES THE HF CACHE OUT FROM BEHIND THE CRITICAL BIND,
    # SILENTLY, AND TAKES THE TORCH CACHE WITH IT. Two readers on this box, both with an
    # ABSENT-ONLY default, so a blank base yields a RELATIVE path from each:
    #   huggingface_hub  os.getenv("HF_HOME", os.path.join(
    #                      os.getenv("XDG_CACHE_HOME", "~/.cache"), "huggingface"))
    #                                                        (constants.py, ~:158-166)
    #   torch            os.getenv(ENV_TORCH_HOME, os.path.join(
    #                      os.getenv(ENV_XDG_CACHE_HOME, "~/.cache"), "torch"))
    #                                            (torch/hub.py:139-146, READ AT THE PIN
    #                                             v2.9.1 — base/rocm-version.env)
    # MEASURED at hub 1.29.0 in an isolated interpreter, HOME=/home/boxuser, HF_HOME
    # unset:
    #                     absent                                 ""
    #   HF_HOME           /home/boxuser/.cache/huggingface       huggingface
    #   HF_HUB_CACHE      /home/boxuser/.cache/huggingface/hub   huggingface/hub
    # ⇒ both resolve against the process's CWD instead of $HOME/.cache/huggingface (the
    # hf-cache CRITICAL row) and $HOME/.cache/torch (a CACHES row). The binds still mount
    # and still pass their own checks — those test the PATH, not where the library later
    # decided to write — so the box comes up green, Jupyter serves, and a multi-GB
    # download lands inside the container and dies at the next recreate.
    # ⭐ THAT IS THE WORST SHAPE OF THIS DEFECT, not a milder one: same reasoning as the
    # four names above, which also all start the server.
    # ⚠️ huggingface_hub is UNPINNED here (Container.finetuning installs
    # `huggingface-hub` unversioned) and the reader was measured identical across
    # 0.35.3 → 1.1.0 and again at 1.29.0 — a property of the library, not of one release.
    # ⚠️ `${XDG_CACHE_HOME-~/.cache}` IS NOT THE SAME FIX — a shell with an empty base
    # yields `/huggingface` where python yields `huggingface`. A third wrong answer.
    # ⚠️ NOT ADDED TO THE CALL ABOVE, AND IT MUST NOT BE: that helper is reserved for
    # natives this box's config file EXPOSES (droste-common.sh:85-90), and XDG_CACHE_HOME
    # is on nobody's surface — finetuning.cfg offers XDG_DATA_HOME and not this one.
    # Placed beside the consumers instead, in the shape approved for vllm in `e4028f2`.
    # One mechanism, not two.
    # ⭐ AND THIS COVERS ROUTES droste::cfg_apply CANNOT SEE — a create-time `--env`, or
    # an `export XDG_CACHE_HOME=` typed in a notebook cell or inside `distrobox enter` —
    # because it reads the environment the server is about to get, not the file.
    # ⚠️ SILENT, like every other blank guard: the blank IS the request for the default.
    #
    # 🚨 THE GUARD COVERS THE WHOLE XDG BASE-DIRECTORY FAMILY, NOT ONLY THE NAME WITH A
    # MEASURED CONSUMER — RULED BY JEI: "overruled. All XDG variables should be treated
    # the same; it's too confusing to have varying implementation." That DELIBERATELY
    # OVERRIDES "each entry earns its place by a MEASURED difference" FOR THIS FAMILY,
    # and it is "One Surface, Five Servers" pointed inward: a user must not have to
    # learn which box guards which XDG name. It is the second application of the same
    # instinct — s58 ruled the identical widening for the `loud` treatment.
    # ⭐ THE FAMILY IS THE FREEDESKTOP BASE DIRECTORY SPECIFICATION'S SEVEN VARIABLES,
    # IN SPEC ORDER: the four user directories, the runtime directory, and the two
    # search LISTS. The boundary is a document rather than a judgement, which is what
    # makes "all of them" an answerable claim. XDG_BIN_HOME is NOT in the spec (which
    # defines only the ~/.local/bin convention, with no variable) and is excluded; so
    # are the session names (XDG_SESSION_TYPE, XDG_CURRENT_DESKTOP, XDG_SEAT, XDG_VTNR,
    # …), which are not directory settings at all and belong to a display stack this
    # image does not run.
    # ⚠️ THIS IS THE ONE BOX WHERE THE WIDENING TOUCHES A NAME ON THE SURFACE.
    # finetuning.cfg shows `# XDG_DATA_HOME=   # base for user data; unset:
    # ~/.local/share`, and jupyter_core already reads it as `env.get(...)` then
    # `if not xdg` (paths.py:191-192) — so blank and absent ALREADY agreed there and the
    # loop changes no behaviour, only the variable's presence. The file's sentence stays
    # true, and becomes true by construction rather than by upstream's goodwill.
    # ⚠️ IT DOES MOVE A HARNESS REQUIREMENT: XDG_DATA_HOME sits in ftguard.sh's
    # FT_HARMLESS list, whose row asserts a blank is KEPT. That row now states the
    # opposite of the ruling and needs re-aiming — the red is the requirement moving,
    # not a regression.
    # ⚠️ THE LOOP BELOW IS BYTE-IDENTICAL IN ALL FIVE BUILD-SPECS. If the list changes,
    # it changes in all five in the same commit: a family that differs by box is the
    # exact confusion this ruling removed.
    # ⚠️ AND IT STILL MAY NOT BE FOLDED INTO THE CALL ABOVE — that helper's callers are
    # audited against what each box's .cfg EXPOSES, and vllm's suite asserts exactly
    # that ("every guarded name is exposed by vllm.cfg"). A separate loop is how the
    # family stays identical on all five without making that check false on one.
    local _xdg
    for _xdg in XDG_DATA_HOME XDG_CONFIG_HOME XDG_STATE_HOME XDG_CACHE_HOME \
                XDG_RUNTIME_DIR XDG_DATA_DIRS XDG_CONFIG_DIRS; do
        if [ -n "${!_xdg+set}" ] && [ -z "${!_xdg}" ]; then
            unset "$_xdg"
        fi
    done

    # ── the droste-supplied defaults (N1a: a default belongs in the WIRING) ─────
    # Two of them HERE. A third — JUPYTER_PREFER_ENV_PATH — supplies its default
    # from the droste-named block further down instead, because it needs an
    # off-state that a bare `${VAR=…}` cannot express (a blank reads TRUE upstream).
    # Every other setting on this box agrees with its package's own default, so the
    # wiring says nothing at all unless the user does.
    # 🚨 WITHOUT THE FIRST OF THESE THE WHOLE TRAIT FILE IS INERT, SILENTLY.
    # templates.yaml seeds jupyter_server_config.py to /opt/data/, beside this box's
    # CFG_FILE, and that directory is on Jupyter's config search path ONLY because
    # JUPYTER_CONFIG_DIR names it (jupyter_core/paths.py:156-157).
    # ⭐ FLAT ON PURPOSE (Jei, s56): the two halves of the config surface sit
    # together where a user looks for them. /opt/data holds nothing else but
    # droste's own .droste-serve.log — /opt/workspace is a separate bind and
    # OPTIONAL is empty — so what Jupyter itself writes into a config dir
    # (jupyter_server_config.json from `jupyter server password`,
    # jupyter_server_config.d/, the frontend config dir) lands among config,
    # not among the user's data. An active line in finetuning.cfg
    # cannot supply this: the file is seeded if_missing, so it would reach NEW
    # boxes only and every existing box would start with ~130 traits sitting at
    # their defaults, no warning, server healthy.
    # ✅ Blank is a real off-state, not a broken one: paths.py:156 tests
    # truthiness, so JUPYTER_CONFIG_DIR= falls through to Jupyter's own location.
    : "${JUPYTER_CONFIG_DIR=/opt/data}"
    export JUPYTER_CONFIG_DIR
    # ⚠️ SECOND DEFAULT, AND IT IS PINNED ON PURPOSE RATHER THAN INHERITED.
    # finetuning.cfg documents `{yes, no}` and SHOWS
    # DROSTE_JUPYTER_ALLOW_UNAUTH_ACCESS=yes, so droste's default is YES and the
    # wiring's job is to deliver exactly that (the config file is the
    # specification). jupyter_server's own default agrees today —
    # allow_unauthenticated_access = Bool(True), serverapp.py:1327 — but we state
    # the default in a file the user reads, so we pin it instead of inheriting it:
    # an upstream flip (the trait's own help text says "subject to change in the
    # future") must not silently change what this box does.
    # 🚨 DIALECT TRAP: the reader is `.lower() in ["true","yes"]`
    # (serverapp.py:1348-1350), so the true-wire MUST be a word — `1` reads FALSE.
    # ✅ Blank is still the user's own off-state: getenv on :1348 is falsy for an
    # empty string, which falls through to Bool(True)… i.e. blank ALSO means yes
    # here. That is upstream's rule, and it happens to agree with our default.
    : "${JUPYTER_SERVER_ALLOW_UNAUTHENTICATED_ACCESS=true}"
    export JUPYTER_SERVER_ALLOW_UNAUTHENTICATED_ACCESS

    # ── the tabulated booleans ──────────────────────────────────────────────────
    for entry in "${JUPYTER_BOOL_VARS[@]}"; do
        suffix=${entry%%:*}; rest=${entry#*:}
        var=${rest%%:*};     rest=${rest#*:}
        on=${rest%%:*};      off=${rest#*:}
        val="DROSTE_JUPYTER_$suffix"; val=${!val:-}
        # Unset or blank leaves the native variable exactly as it is: the user's
        # own native line, or a default set above, or the package's own.
        [ -n "$val" ] || continue
        case "$(droste::bool "$val")" in
            on)  export "$var=$on" ;;
            off) export "$var=$off" ;;
            *)   serve::err "DROSTE_JUPYTER_$suffix='$val' is not a yes/no value — leaving $var as it is. Use yes or no. Fix it in $CFG_FILE and restart the box." ;;
        esac
    done

    # ── PREFER_ENV_PATH: a row that carries a default AND cannot be tabulated ───
    # 🚨 WHAT IT DECIDES, PRECISELY — this is NOT covered by JUPYTER_CONFIG_DIR.
    # jupyter_core assembles its search paths as [env…, user…] or [user…, env…]
    # depending on this one flag: paths.py:322 for the DATA path, paths.py:421 for
    # the CONFIG path. "env" is the VENV — /opt/venv/etc/jupyter and
    # /opt/venv/share/jupyter (paths.py:340, :249, both str(Path(sys.prefix, …))).
    # "user" is jupyter_config_dir() / jupyter_data_dir(), i.e. /opt/data here,
    # plus the per-user site dirs. Traitlets loads that list REVERSED
    # (application.py:904), so the FIRST entry is the one that wins.
    #   JUPYTER_CONFIG_DIR names WHICH directory the user level IS.
    #   This names WHERE that level SITS relative to the venv's.
    # And it has no CONFIG_DIR analogue on the other half at all: jupyter_path()
    # — the DATA SEARCH path, i.e. kernelspecs and labextensions — is ordered by
    # this flag alone. So the setting is REAL, not cosmetic — with it on, a
    # stray /opt/venv/etc/jupyter file would outrank the user's own /opt/data.
    # ⭐ DROSTE'S DEFAULT IS `no` (wire `0`) — prefer the USER's dirs. /opt/venv is a
    # baked overlay LOWER; the user's answer is the one that should win. It is
    # PINNED rather than inherited, and this is the whole reason the row exists:
    # ⚠️ ABSENT IS NOT THE SAME ANSWER AS `0`. With the variable gone, paths.py:117
    # returns True whenever sys.prefix is a virtualenv the process owns — and this
    # box IS one — so the order would be decided by an OWNERSHIP TEST on
    # /opt/venv (paths.py:83-107, and that directory is an overlay merge) rather
    # than by a decision. Unsetting it is a different behaviour, not a tidier
    # spelling of the same one.
    # 🚨 A BLANK CANNOT BE PASSED THROUGH — this is the defect this row fixes.
    # envset() (paths.py:49-60) is TRUE for every value except
    # {no,n,false,off,0,0.0}, so `JUPYTER_PREFER_ENV_PATH=` reads TRUE: a user who
    # uncommented the old native line and cleared it turned the setting ON. Since
    # paths.py:113 tests PRESENCE before value, the only way to say "let Jupyter
    # decide" is for the variable not to exist.
    #
    # 🚨 A BLANK ON THE DROSTE NAME NOW MEANS "AS IF ABSENT", AND THIS ROW WAS RE-DECIDED
    # (s58). It used to UNSET JUPYTER_PREFER_ENV_PATH and call that the documented N1a
    # opt-out. Jei's rule for an empty value is that A BLANK MUST BEHAVE EXACTLY AS IF THE
    # SETTING WERE ABSENT, with ONE exception: an unbounded string whose blank cancels a
    # file or directory that would otherwise load ("no config file", "no KV disk cache").
    # This setting is a BOOLEAN — finetuning.cfg's DROSTE_JUPYTER_SEARCH_VENV_FIRST line
    # documents it as `{yes, no*}` — so the exception cannot apply, and its blank was
    # producing a THIRD behaviour that is in neither the file's vocabulary nor the
    # wiring's default: Jupyter's ownership test on /opt/venv (paths.py:83-107, :117). A
    # user clearing a `no` line got neither `no` nor nothing; they got a coin toss
    # decided by the permissions of an overlay merge.
    # ⚠️ THE s57 PROTECTION IS NOT LOST WITH IT. What s57 established is that a blank must
    # never be left ON THE WIRE, because envset() reads "" as TRUE. Both answers satisfy
    # that; this one also satisfies the newer rule. The native spelling's own blank is
    # covered by the droste::blank_is_unset call above, which is where a NATIVE name
    # belongs.
    # ⚠️ Every arm returns 0: PRE_LAUNCH runs unguarded under `set -euo pipefail`.
    if [ -n "${DROSTE_JUPYTER_SEARCH_VENV_FIRST+set}" ] && [ -z "$DROSTE_JUPYTER_SEARCH_VENV_FIRST" ]; then
        serve::err "DROSTE_JUPYTER_SEARCH_VENV_FIRST is set but empty — it is a yes/no setting, so an empty value cannot mean anything, and leaving it empty would hand the search order to a permission test on /opt/venv instead of to a decision. Using droste's default (no: your own config and data dirs are searched before /opt/venv's); put yes or no in $CFG_FILE, or remove the line to say the same thing quietly."
        unset DROSTE_JUPYTER_SEARCH_VENV_FIRST
    fi
    val=${DROSTE_JUPYTER_SEARCH_VENV_FIRST-}
    if [ -z "${DROSTE_JUPYTER_SEARCH_VENV_FIRST+set}" ]; then
        # Absent ⇒ droste's default. `${VAR=0}` rather than a bare assignment so a
        # user's own NATIVE JUPYTER_PREFER_ENV_PATH line still wins — `set -a` has
        # already exported it by the time PRE_LAUNCH runs.
        : "${JUPYTER_PREFER_ENV_PATH=0}"
        export JUPYTER_PREFER_ENV_PATH
    else
        case "$(droste::bool "$val")" in
            on)  export JUPYTER_PREFER_ENV_PATH=1 ;;
            off) export JUPYTER_PREFER_ENV_PATH=0 ;;
            # Never leave the user's string on the wire: envset() would read
            # almost any typo as TRUE, which is the dangerous direction.
            *)   serve::err "DROSTE_JUPYTER_SEARCH_VENV_FIRST='$val' is not a yes/no value — using droste's default (no: your own config and data dirs are searched before /opt/venv's). Use yes or no. Fix it in $CFG_FILE and restart the box."
                 : "${JUPYTER_PREFER_ENV_PATH=0}"
                 export JUPYTER_PREFER_ENV_PATH ;;
        esac
    fi

    # ── SKIP_CONFIG, the other row that cannot be tabulated ─────────────────────
    # JUPYTER_NO_CONFIG is read as BARE TRUTHINESS (jupyter_core/paths.py:153 and
    # :390 — `if env.get(...)`), so THERE IS NO FALSE-WIRE: `0`, `no` and `false`
    # all turn it ON. The only way to say no is for the variable not to exist, so
    # `off` UNSETS it — which also overrides a native JUPYTER_NO_CONFIG the user
    # set in the same file, because the droste answer is the later word.
    # ⚠️ What a true value does here is worse than the name suggests: it makes
    # jupyter_config_dir() return a throwaway temp dir, so the seeded trait file is
    # silently ignored along with every other config file.
    val=${DROSTE_JUPYTER_SKIP_CONFIG:-}
    if [ -n "$val" ]; then
        case "$(droste::bool "$val")" in
            on)  export JUPYTER_NO_CONFIG=1 ;;
            off) unset JUPYTER_NO_CONFIG ;;
            *)   serve::err "DROSTE_JUPYTER_SKIP_CONFIG='$val' is not a yes/no value — leaving config files loading normally. Use yes or no. Fix it in $CFG_FILE and restart the box." ;;
        esac
    fi
}

# ── jupyter_health_prefix — where base_url moved the routes ──────────────────
#
# 🚨 WHY WE ASK JUPYTER INSTEAD OF READING A FILE. base_url can be set in three
# places that outrank each other in a fixed order — the baked
# /etc/jupyter/jupyter_server_config.py (droste's copy, which ships
# `c.ServerApp.base_url = "/"`), the user's own jupyter_server_config.py in
# JUPYTER_CONFIG_DIR (/opt/data), and a --ServerApp.base_url on the command line,
# which beats both. Only Jupyter knows which one won, and `--show-config-json`
# dumps the MERGED config, so we run the app and read its answer. That is the same
# "declare, do not detect" bargain droste::set_health_prefix documents: a prefix is
# an arbitrary string with nothing to probe for, so the side that has seen the
# config has to say.
#
# ⭐ THE ARGV IS REPLAYED, NOT REBUILT. "${SERVICE[@]}" is the command line the
# server is about to be launched with, DROSTE_JUPYTER_EXTRA_ARGS included, so a
# --ServerApp.base_url a user put in the catch-all is seen here exactly as the
# server will see it. Called last in PRE_LAUNCH for that reason: SERVICE is rebuilt
# above, and jupyter_env has already exported JUPYTER_CONFIG_DIR — a resolver run
# before either would read a different configuration than the server does.
#
# ⚠️ `jupyter lab`, NOT `jupyter server`, AND THE 2s IS NOT WHY. ServerApp.base_url
# is the same trait and both report the same value — MEASURED at the pins across
# the user file (with and without a trailing slash, and with no leading slash),
# the baked file alone, and --ServerApp.base_url in both = and space spellings:
# identical every time, and identically ABSENT when no file sets it. They are also
# the same speed here (3.0-3.2s vs 2.8-3.3s over three runs each), so the cheap-run
# argument does not survive measurement either. What decides it is that `jupyter
# server` REJECTS lab's own aliases: --app-dir=… exits 2 with a usage message,
# while `jupyter lab` takes it. Replaying the argv means replaying it to the
# program that accepts it — anything else turns a legitimate catch-all argument
# into a resolution failure, and the fallback for that is the no-prefix path below.
#
# 🚨 THE RESOLVER RUNS AS ROOT AND THE SERVER MAY NOT — SO IT WRITES INTO A
# SANDBOX. PRE_LAUNCH runs as root from both doors (droste-serve.sh:202) while
# serve::launch setprivs the service to the box user, and `--show-config-json`
# still initializes far enough to create ServerApp.cookie_secret_file, MODE 0600.
# A root-owned 0600 cookie secret sitting where the box user's server expects to
# read one is a server that does not start — this probe would have caused the exact
# failure class it exists to prevent. Both halves below are needed and neither
# subsumes the other: JUPYTER_RUNTIME_DIR moves the default location, and the
# explicit --ServerApp.cookie_secret_file (last on the line, so it beats a config
# file AND the catch-all) catches an absolute path a user set by hand, which the
# env var cannot reach. MEASURED: with them, the real runtime dir stays empty.
# ⚠️ ONE ARTEFACT IS LEFT BEHIND ON PURPOSE, because removing it is not worth a
# second mechanism: jupyter_core writes a `migrated` marker into the config dir,
# mode 0644. It is existence-checked only, and JupyterApp.migrate_config opens it
# "r+" and RETURNS on PermissionError, so a root-owned one is read, not tripped
# over. (This box has no IPython 3 tree to migrate in the first place.)
#
# ⚠️ FAILING TO RESOLVE MUST NEVER FAIL THE LAUNCH. Every arm returns 0 and every
# arm ends at droste::set_health_prefix — with "" on failure, which DELETES a stale
# .PREFIX rather than leaving one behind. That matters on the relaunch path, where
# the healthcheck re-runs PRE_LAUNCH inside a container whose state dir already has
# one.
# ⭐ AND THE FALLBACK IS SAFE WHERE IT MATTERS: no prefix means the probe knocks at
# "/", which is exactly right for the default base_url — the overwhelmingly common
# case — so a resolver that cannot run costs a box with a base_url its correct
# probe, and costs every other box nothing. Note also that almost everything that
# can make this command fail (a bad flag in the catch-all, a config file that does
# not parse) fails the REAL launch too, so the box is unhealthy for a better reason.
# ⚠️ The internal escape hatch is DROSTE_JUPYTER_CONFIG_TIMEOUT, in the same spirit
# as DROSTE_HEALTH_TIMEOUT and DROSTE_SERVE_RELAUNCH_COOLDOWN: not a config-surface
# setting, just a number that can be moved without a rebuild. 45s is ~15x the
# measured cost and stays well inside finetuning's 2m --health-timeout, which is
# what bounds PRE_LAUNCH when serve::relaunch calls it from inside a probe.
: "${DROSTE_JUPYTER_CONFIG_TIMEOUT:=45}"
jupyter_health_prefix() {
    local sandbox="" json="" base="" prefix="" rc=0
    local runner=()

    if ! command -v python3 >/dev/null 2>&1; then
        serve::err "python3 is not on PATH, so Jupyter's effective base_url cannot be read — the health probe will knock at '/'. That is correct unless you set c.ServerApp.base_url; with one set, '/' answers 404 and this box will be restarted."
        droste::set_health_prefix ""
        return 0
    fi
    sandbox=$(mktemp -d "${TMPDIR:-/tmp}/droste-jupyter-config.XXXXXX" 2>/dev/null) || sandbox=""
    if [ -z "$sandbox" ]; then
        serve::err "cannot create a temporary directory, so Jupyter's effective base_url cannot be read safely — the health probe will knock at '/'. That is correct unless you set c.ServerApp.base_url; with one set, '/' answers 404 and this box will be restarted."
        droste::set_health_prefix ""
        return 0
    fi
    # ⚠️ AN `if`, NOT `cmd && runner=(…)`, AND THE REASON IS POSITION-INDEPENDENCE
    # RATHER THAN A BUG I FOUND. MEASURED: errexit does NOT fire for the left side of
    # an `&&` list, so the terse form is safe exactly where it stands — but it becomes
    # a box-killer the moment it ends up LAST in a function, because then the list's
    # non-zero status is the function's, and PRE_LAUNCH runs unguarded under
    # `set -euo pipefail` in the resolver lane. The `if` costs two lines and cannot be
    # broken by moving it. (ftguard's M9 mutation restores the `&&` form and correctly
    # stays GREEN — recorded so nobody re-adds it thinking the suite is blind.)
    if command -v timeout >/dev/null 2>&1; then
        runner=(timeout "$DROSTE_JUPYTER_CONFIG_TIMEOUT")
    fi

    json=$(JUPYTER_RUNTIME_DIR="$sandbox" \
        ${runner[@]+"${runner[@]}"} "${SERVICE[@]}" \
        --ServerApp.cookie_secret_file="$sandbox/cookie_secret" \
        --show-config-json 2>/dev/null) || rc=$?
    rm -rf "$sandbox" 2>/dev/null || true

    if [ "$rc" -ne 0 ] || [ -z "$json" ]; then
        serve::err "could not read Jupyter's configuration (\`--show-config-json\` exited $rc) — the health probe will knock at '/'. That is correct unless you set c.ServerApp.base_url in this box's jupyter_server_config.py or in DROSTE_JUPYTER_EXTRA_ARGS; with one set, '/' answers 404 and this box will be restarted every few minutes. Whatever broke the command above will very likely stop the server starting too — see the container log."
        droste::set_health_prefix ""
        return 0
    fi

    # `--show-config-json` reports the value AS CONFIGURED, not as ServerApp's
    # validator will normalise it (measured: "/deep/lab/", "deep/lab" and "/" all
    # come back verbatim), and the key is ABSENT when nothing set it. Both of those
    # are handled below, so no reader here may assume a shape.
    base=$(printf '%s' "$json" | python3 -c '
import json, sys
try:
    cfg = json.load(sys.stdin)
except Exception:
    raise SystemExit(1)
value = cfg.get("ServerApp", {}).get("base_url", "/")
if not isinstance(value, str):
    raise SystemExit(1)
sys.stdout.write(value)
' 2>/dev/null) || rc=$?
    if [ "$rc" -ne 0 ]; then
        serve::err "Jupyter's configuration came back in a shape this box could not read — the health probe will knock at '/'. That is correct unless you set c.ServerApp.base_url; with one set, '/' answers 404 and this box will be restarted."
        droste::set_health_prefix ""
        return 0
    fi

    # ── normalise EXACTLY as ServerApp does, then strip back to a prefix ────────
    # ServerApp's @validate("base_url") adds a leading slash if missing and a
    # trailing one if missing (so "deep/lab" is served at "/deep/lab/"), and
    # HEALTH_PATH above is "/" — read_health_spec prepends the prefix VERBATIM, so
    # what the probe requests is <prefix> + "/". Adding the leading slash and
    # stripping every trailing one therefore rebuilds precisely the URL Jupyter
    # answers: MEASURED against a live server, "/deep/lab", "/deep/lab/" and
    # "deep/lab" all give 404 at / and 302 at /deep/lab/.
    # 🚨 THE DEFAULT MUST PRODUCE NO PREFIX AT ALL, and that is what the stripping
    # buys. base_url "/" reduces to the empty string, droste::set_health_prefix
    # REMOVES .PREFIX for an empty value, and the probe path stays exactly "/" —
    # byte-for-byte what this box did before this function existed. A prefix of "/"
    # would have made it "//". The same reduction covers the degenerate spellings:
    # "" (which ServerApp turns into "/") and "//" (measured: still 302 at "/").
    case "$base" in
        /*) ;;
        *)  base="/$base" ;;
    esac
    prefix=$base
    while [ "$prefix" != "${prefix%/}" ]; do prefix=${prefix%/}; done
    droste::set_health_prefix "$prefix"
    return 0
}

# ── PRE_LAUNCH ───────────────────────────────────────────────────────────────
# The server lane never sources /etc/profile.d (no login shell), but the Triton
# HIP toolchain env (TRITON_HIP_LLD_PATH/_CLANG_PATH + SDK LD_LIBRARY_PATH) it
# provides is needed for flash-attn/unsloth kernel compiles under Jupyter too.
# Source the exact script the interactive lane uses so both lanes match.
PRE_LAUNCH="finetuning_pre_launch"
finetuning_pre_launch() {
    # shellcheck source=/dev/null
    source /etc/profile.d/01-rocm-env-for-triton.sh

    # After CFG_FILE has been sourced: turn the user's finetuning.cfg into the
    # environment the server will actually see.
    jupyter_env

    # Rebuild SERVICE now that DROSTE_JUPYTER_EXTRA_ARGS is known. It goes LAST
    # deliberately: a Jupyter command-line flag beats every config file AND a
    # repeated flag resolves to the later one, so appending is what makes the
    # catch-all able to override an argument droste sets. ⚠️ --ip AND --port ARE THE
    # TWO EXCEPTIONS SINCE s60: they are reserved settings, and serve::apply_host /
    # serve::apply_port rewrite the value after EVERY occurrence of their flag — the
    # catch-all's copy included. A user asking for a different address writes
    # DROSTE_JUPYTER_HOST in $CFG_FILE, which is the surface that owns it.
    # Quote-aware split (droste::split_args), matching the other ports:
    # a value MAY contain spaces, and it is not glob-expanded.
    mapfile -d '' -t _extra < <(droste::split_args "${DROSTE_JUPYTER_EXTRA_ARGS:-}")
    SERVICE=( "${JUPYTER_ARGV_BASE[@]}" ${_extra[@]+"${_extra[@]}"} )

    # LAST, and both halves of that matter: it replays "${SERVICE[@]}" (so the
    # catch-all is in the argv it reads) in the environment jupyter_env has already
    # exported (so JUPYTER_CONFIG_DIR points where the server's will).
    jupyter_health_prefix
}
