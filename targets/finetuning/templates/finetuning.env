# finetuning.env -- JupyterLab configuration (this file IS the config surface).
#
# Seeded to /opt/data/finetuning.env on first start and NEVER overwritten -- your
# edits here win. Most settings ship commented out; default values are shown in
# the commented example line and marked with "*" in a braced list. Uncomment a
# line to override it.
#
# This box serves JupyterLab, so the settings here are Jupyter's. They reach the
# server two ways, and the difference matters:
#
#   ENVIRONMENT VARIABLES -- everything assigned in this file is exported to the
#   JupyterLab process. This is the only mechanism that can act BEFORE Jupyter
#   reads any config, which is why the config directory itself is set here.
#
#   TRAITS -- the ~220 ServerApp/LabApp settings live in a Python config file,
#   /opt/data/jupyter/jupyter_server_config.py, seeded beside this one and
#   commented throughout. JUPYTER_CONFIG_DIR below is what puts that directory
#   on Jupyter's search path at all.
#
#   COMMAND-LINE FLAGS -- the catch-all below. **A Jupyter command-line flag
#   beats every config file, always, so a flag here overrides both mechanisms.
#
# **A misspelled trait or variable is a WARNING, not an error, and the server
# starts anyway. After editing, check what actually took effect:
#   server_restart && jupyter lab --show-config
#
# **THIS FILE IS READ FOR THE SERVED JupyterLab, not for your interactive shell.
# If you stop the server and run one by hand instead, load it yourself first:
#   set -a; . /opt/data/finetuning.env; set +a
#
# Reserved by droste (do not set these)
# -------------------------------------
# Droste needs these arguments to remain unchanged for its setup & teardown of
# boxes; any additions or changes are likely to break the box boot, services,
# and/or functionality.
#
#   --port      owned by PORT in /opt/data/server.env. Change it there, then
#               restart the box. JUPYTER_PORT is likewise overridden.
#   --allow-root, --no-browser
#               the server lane runs headless; a browser launch has nowhere to
#               go and the lane's user is chosen by droste, not by Jupyter.
#   --notebook-dir  /opt/workspace, which is YOUR bind mount. The helper scripts
#               write their output-*/ directories relative to it, so moving the
#               root moves where trained adapters land.


# Extra Arguments (options this file does not cover)
# --------------------------------------------------
# A "catch-all" setting for user-elected parameters, appended to the JupyterLab
# command line. "Mix and match" with other settings may cause boot failure due
# to exclusions, so users should confirm the absence of argument conflicts in
# advance.
#
# Entry should be one quoted value; it is then split on whitespace into separate
# arguments, so an individual argument cannot itself contain spaces. Because
# these land LAST, and because a Jupyter flag beats every config file, this is
# also the only way to override an argument droste sets -- including the listen
# address, e.g. --ip 127.0.0.1 to stop serving the LAN.
#
# It extends the JUPYTERLAB command line specifically, which is why it carries
# Jupyter's name rather than the box's: the other programs in this box
# (train.py and friends) are not affected by it.
#
# JUPYTER_DROSTE_EXTRA_ARGS="--ServerApp.iopub_data_rate_limit=1e10"


# Authentication (who may use the notebook server)
# ------------------------------------------------
# {token string} or {path to a file containing one}
#
# **JupyterLab generates a NEW RANDOM TOKEN EVERY TIME THE SERVER STARTS. Since
# the healthcheck may relaunch the server, a token you copied can stop working
# without you doing anything. Setting one here fixes it across restarts.
#
# To read the current one, from inside the box:
#
#   jupyter server list                       # server and token, authoritative
#   grep -o 'token=[0-9a-f]*' /opt/data/.droste-serve.log | tail -1
#
# **The service's output goes to that log file, NOT to `podman logs`. The
# container log only carries what droste itself says about the launch.
#
# **This box binds 0.0.0.0, so anything that can route to it can reach the
# notebook server, and a notebook is a shell. Do not set an empty token to
# "make it easier" -- that is an unauthenticated remote shell. To restrict the
# server to in-box clients instead, put --ip 127.0.0.1 in the catch-all above.
#
# A password is a trait, not a variable: see IdentityProvider in
# /opt/data/jupyter/jupyter_server_config.py.
#
# JUPYTER_TOKEN=
# JUPYTER_TOKEN_FILE=


# Config Directory (where Jupyter looks for your settings)
# --------------------------------------------------------
# {path}
#
# Jupyter's own user config directory is ~/.jupyter, which does not work well on
# either lane here: under distrobox it is the HOST's home, shared with every
# other droste box and with any Jupyter you installed on the host, and in the
# server lane it is /root/.jupyter, which is lost when the container is
# recreated. **Neither is /opt/data, the per-box persistent volume this file
# lives on -- so droste points the config directory at it.
#
# Comment this out to go back to ~/.jupyter with all of the above in mind.
#
# Covers: the search-path slot Jupyter calls the "user" config directory
#
JUPYTER_CONFIG_DIR=/opt/data/jupyter

# **AND THE ORDER HAS TO BE FIXED TOO. Jupyter ranks the Python environment's
# own config directory ABOVE the user one whenever the process owns that
# environment -- which it does in both lanes here. That directory is
# /opt/venv/etc/jupyter, which sits on the program cache: CACHE class, the one
# root the installer may empty on your say-so. Left alone, the highest-priority
# config location on this box would be the one designed to be deletable, and it
# would quietly outrank the file we tell you to edit.
#
# Setting this to 0 puts your config directory back on top. Both directories are
# still read either way; this only decides who wins a collision.
#
JUPYTER_PREFER_ENV_PATH=0


# Storage Locations (where Jupyter's own state is kept)
# -----------------------------------------------------
# {path} for each
#
#   JUPYTER_DATA_DIR            kernelspecs, extensions, and other data
#   JUPYTER_RUNTIME_DIR         connection files and the server's runtime state
#   JUPYTERLAB_SETTINGS_DIR     your UI settings (themes, keybindings, layout)
#   JUPYTERLAB_WORKSPACES_DIR   saved Lab workspaces
#   JUPYTER_PATH                extra directories to search for data
#
# Unset, these follow JUPYTER_CONFIG_DIR's neighbours in the same home. Point
# any of them under /opt/data to persist it per-box, or under
# /opt/program-cache to declare it regenerable.
#
# JUPYTER_DATA_DIR=
# JUPYTER_RUNTIME_DIR=
# JUPYTERLAB_SETTINGS_DIR=
# JUPYTERLAB_WORKSPACES_DIR=
# JUPYTER_PATH=


# Access Control (endpoints reachable without a token)
# -----------------------------------------------------
# {true, yes} to allow -- **and ANY other non-empty value to LOCK DOWN
#
# The semantics are inverted and easy to get wrong: only "true" or "yes" opens
# the unauthenticated endpoints. Writing 0, false or no does NOT restore the
# default -- it locks endpoints down harder than leaving the line commented.
#
# JUPYTER_SERVER_ALLOW_UNAUTHENTICATED_ACCESS=


# Secure Writes (the 0600 check on Jupyter's secret files)
# ---------------------------------------------------------
# {boolean}
#
# Jupyter refuses to write its cookie secret unless it can set 0600 on the file.
# The secret lands in a bind-mounted directory here, so on a filesystem that
# cannot represent those permissions the server fails to start with a
# permission error rather than a wrong-mode warning. Set this if you hit it.
#
# JUPYTER_ALLOW_INSECURE_WRITES=


# Options for Debugging & Development
# -----------------------------------
# Diagnostic
#   jupyter lab --show-config (what actually took effect, after every edit),
#   jupyter --paths (the search path and its order),
#   jupyter server list (running servers and their tokens)
#
# Variables
#   JUPYTER_NO_CONFIG=1     ignore EVERY config file -- the clean room for
#                           "is my config the problem?"
#   JUPYTER_PLATFORM_DIRS=1 use the XDG layout (~/.config/jupyter) instead of
#                           the legacy paths. Changes where everything above
#                           resolves; set it before you write any config, not
#                           after.


# Unused Arguments (inapplicable / unsupported in this build)
# -----------------------------------------------------------
# Serving
#   JUPYTER_PORT, JUPYTER_PORT_RETRIES -- the launcher appends --port from
#   server.env, and a command-line flag beats the variable.
#
# Trait files
#   jupyter_lab_config.py is READ but is the WEAKER file: JupyterLab loads it,
#   then the ServerApp's config lands on top, so jupyter_server_config.py wins
#   every collision -- even for LabApp traits. **The file named after the app is
#   the one that loses. Put your settings in jupyter_server_config.py.
#   A .json config in the same directory also beats a .py one.
