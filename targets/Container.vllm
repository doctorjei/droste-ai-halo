# droste-vllm-halo: vLLM toolbox (TheRock torch + prebuilt wheels) on halo.
# Ported from github.com/kyuz0/amd-strix-halo-toolboxes

# Overrideable Arguments - General Build (override with '--build-arg <ARG_NAME>=<VALUE>'
ARG SERIES_NAME=droste
ARG ARCH_NAME=halo
ARG TARGET_NAME=vllm
ARG DESCRIPTION="vLLM toolbox (TheRock torch & prebuilt wheels)"

# Image Names
ARG BASE_IMAGE=localhost/${SERIES_NAME}-torch-base-${ARCH_NAME}
ARG ARTIFACTS_IMAGE=localhost/${SERIES_NAME}-${TARGET_NAME}-build-${ARCH_NAME}

# Build image
FROM ${ARTIFACTS_IMAGE} AS artifacts
FROM ${BASE_IMAGE}
ARG SERIES_NAME TARGET_NAME ARCH_NAME DESCRIPTION
LABEL description="${SERIES_NAME}-${TARGET_NAME}-${ARCH_NAME}: ${DESCRIPTION}"

# ROCM / Torch Pin: inherited from the torch base as /etc/droste/rocm-version.env. The
# torchvision re-pin RUN below sources it, so this image cannot ask for a torchvision
# date its own torch layer was not built from.

# Runtime libraries. `git` is not a build tool here: aiter shells out to
# `git rev-parse --short HEAD` at MODULE level in csrc/cpp_itfs/utils.py, on EVERY
# `import aiter` (not just when it JIT-builds), and it catches only CalledProcessError —
# so a missing binary is a hard FileNotFoundError at import, while git-present-but-no-repo
# (our case: site-packages is not a checkout) is handled. Kept in this port alone: no other
# droste-*-halo image installs aiter.
#
# A C compiler + `Python.h` are NOT listed here: `gcc` + `python3.13-dev` now come from the
# torch base (see base/Container.torch), added there for triton's GPU-init-time `hip_utils`
# compile, which bites this port and finetuning alike. `g++` is still deliberately absent all
# the way down, so aiter's `shutil.which("c++")` probe finds nothing and the prebuilt
# module_aiter_enum.so of step 2 below stays load-bearing.
RUN apt-get -qq update && apt-get -qq install -y --no-install-recommends \
      libnuma1 numactl libgomp1 git && rm -rf /var/lib/apt/lists/* && apt-get clean

# Copy artifacts. patch_aiter_headers.py is parked under /opt/resources/scripts/ (it is
# used at BUILD to re-patch the installed aiter; it need not sit at /opt root forever).
COPY --from=artifacts /artifacts/wheels    /tmp/wheels
COPY --from=artifacts /artifacts/fp8       /opt/fp8
COPY --from=artifacts /artifacts/aiter-jit /tmp/aiter-jit
COPY scripts/patch_aiter_headers.py /opt/resources/scripts/patch_aiter_headers.py

# N24 P4 download-percentage shim (R4): a .pth the venv runs at every startup. See
# Container.ds4 for why a .pth and not sitecustomize (the SYSTEM copy shadows the venv's).
COPY scripts/droste_dlwatch_shim.py scripts/zz_droste_dlwatch.pth /opt/resources/scripts/
RUN set -e; sp=$(echo /opt/venv/lib/python*/site-packages) \
    && cp /opt/resources/scripts/droste_dlwatch_shim.py /opt/resources/scripts/zz_droste_dlwatch.pth "$sp/"

# Install order matters:
#  1. aiter + flash-attn wheels (--no-deps: their deps are torch/triton, already present).
#  2. re-apply patch_aiter_headers.py to the freshly-installed aiter — its ck_tile headers are
#     used by aiter's RUNTIME JIT on gfx1151 (the artifacts stage patched its own copy; the
#     shipped wheel is pre-patch, so patch it again here) — then drop the aiter JIT module
#     PREBUILT in the artifacts stage into the same package dir. `import aiter` JIT-compiles
#     module_aiter_enum at module scope, and vLLM does exactly that while inspecting a model's
#     architecture (registry -> flash_attn -> aiter). This image ships no compiler, so the lazy
#     build died on `shutil.which("c++")` -> None -> TypeError -> `RuntimeError: [aiter] build
#     [module_aiter_enum] ... failed` -> "Model architectures ['Qwen2ForCausalLM'] failed to be
#     inspected" and `vllm serve` exited (hardware 2026-08-14). With the .so already in
#     site-packages/aiter/jit/, aiter's get_module imports it and never reaches the compiler
#     probe. It lands in the BAKED venv, i.e. the overlay lower layer, so a user's venv
#     copy-up cannot shadow it away. The destination is resolved by the venv's OWN python
#     (sysconfig purelib) rather than a `lib*/python*` glob: the venv carries both `lib/` and
#     a `lib64 -> lib` symlink, so that glob expands to TWO paths and cp reads the first as a
#     source directory -> "omitting directory" -> exit 1, killing this && chain (CI run
#     31850892660). A glob is harmless as a cp SOURCE (build stage, line ~91: cp merely warns
#     "specified more than once"), never as its destination. sysconfig, not `import aiter`:
#     importing aiter here would fire the very JIT this copy exists to avoid. The `test -f`
#     then proves module_aiter_enum.so actually landed, so a silent misplacement cannot go
#     green (same idiom as the build stage's staging check).
#  2a. AND THE HEADER REWRITE ITSELF IS GUARDED, because patch_aiter_headers.py CANNOT FAIL.
#     It OVERWRITES two upstream aiter headers wholesale and returns 0 whether or not it
#     wrote anything: a missing include dir prints a note and returns, and a renamed header
#     is skipped with NO MESSAGE AT ALL. Measured: with the include dir moved, the bare
#     invocation exits 0 and rewrites nothing. Since it is a whole-file overwrite there is
#     no context for patch(1) to fail against, so the checks have to be ours — the include
#     dir and both headers must EXIST before, and both must carry their droste marker
#     after. The two grep-for-includers checks are the REACHABILITY half: a header nothing
#     includes could be rewritten perfectly and still mean nothing, which is the same
#     failure the llama guards call "raising a constant nobody reads".
#     🚨 AND A REACHABILITY GREP OVER A TREE THAT CONTAINS THE TARGET CAN MATCH THE TARGET
#     ITSELF, which turns the check into a bare existence test that CANNOT FAIL. So each
#     one (a) requires an actual `#include` DIRECTIVE, not a bare mention -- a comment or a
#     doc line naming the header proves nothing about who reads it -- and (b) subtracts the
#     header being rewritten from the match list, by the SAME path string the `-f` test
#     above asserts. Measured at aiter 428e8e76 (the submodule of FLASH_ATTENTION_REF
#     3f94643f): vec_convert.h is included by aiter_opus_plus.h and quant_utils.cuh,
#     hip_reduce.h by aiter_opus_plus.h, and NEITHER header mentions its own name -- so the
#     old bare `grep -rlF` was not vacuous YET. It would have gone vacuous the day upstream
#     added a self-referencing header comment, silently and with the counts still green.
#     ⚠️ The failure is invisible here by construction: without the RDNA3 fallbacks gfx1151
#     has no scalar substitute for the CDNA-only packed ISA, and that surfaces in a
#     JIT-compiled kernel at RUN time, long after this build is green.
#  2b. UNSET THE CONSTRAINT for this RUN ONLY, and rely on the assertion at the end. Since
#     s46 moved this RUN to uv that is all THREE variables — `PIP_CONSTRAINT UV_CONSTRAINT
#     UV_BUILD_CONSTRAINT` — because uv does not read pip's variable and applies a separate
#     one to source builds. Unsetting fewer than three is silently wrong.
#     The runtime base exports it globally so nothing can move the ROCm stack, but this
#     step is INCOMPATIBLE with it by design, and the reason is step 3 below: the vLLM
#     wheel is installed WITH deps on purpose, torchvision is one of them, and it is not
#     installed yet at that moment. The intended sequence lets a PyPI torchvision arrive
#     as a dependency and then REPLACES it from the ROCm index (the --reinstall-package
#     line further down) -- so a constraint demanding `torchvision==<ver>+rocm...` fails
#     resolution against PyPI before the replacement can ever happen. Measured, CI run
#     32592572365: `Could not find a version that satisfies torchvision==0.24.0+rocm...
#     (from -c rocm-constraints.txt line 2) (from versions: 0.1.6 ... 0.28.0)` -- that
#     candidate list is PyPI's, with no +rocm builds in it.
#     ⚠️ torch is NOT affected and that asymmetry is not luck: vLLM pins `torch==2.9.1`,
#     which our local version satisfies by PEP 440 (see the NB in step 5), so torch is
#     already installed and never re-resolved. torchvision has no such head start.
#     ⚠️ DO NOT "fix" this by re-adding the constraint or by adding the ROCm index to the
#     PyPI-facing installs: the first breaks the build, the second widens every package
#     in this step to an index that should only ever serve the torch stack.
#     The guard's CATCHING half is untouched -- assert-rocm-pins.sh runs at the end of
#     this same chain and fails the build if torch or torchvision is not exactly the pin.
#  3. vLLM wheel WITH deps so the resolver pulls transformers/etc. from PyPI (torch already
#     satisfied).
#     📜 HISTORY, kept because it explains a line that is no longer here: under pip this step
#     needed `PIP_USE_DEPRECATED=legacy-resolver`. vLLM pins `torch==2.9.1` while the installed
#     wheel is `2.9.1+rocm7.13.0a20260501`, and pip's resolvelib backtracker explored an
#     exploding search space over that (+ the large dep graph) and died with RecursionError in
#     _has_route_to_root — surviving even a 100k recursion limit, i.e. pathological
#     backtracking, not mere depth. The legacy resolver took the first satisfying candidate and
#     skipped the backtracking entirely.
#     ⚠️ ALL OF THAT DESCRIBES pip AND IS STILL TRUE OF pip. It was never a statement about uv,
#     and s46 deleted the line when this RUN moved to uv (see the block above the RUN). If this
#     step is ever moved BACK to pip, the export has to come back with it.
#  4. ray (upstream installs it explicitly; used by the cluster launcher paths).
#  5. REPAIR one constraint that a resolver was observed to drop, then VERIFY the whole
#     environment. ⚠️ The CAUSE recorded here is pip's: the legacy resolver's "first satisfying
#     candidate" rule (step 3) has no backtracking, so an upper bound belonging to a package
#     resolved EARLIER is silently violated when a later candidate outruns it. That resolver is
#     gone as of s46 (this RUN drives uv), so the explicit re-pin is now belt-and-braces rather
#     than a fix for a known defect — KEEP IT ANYWAY: it costs one line, it states the bound
#     that must hold, and it is not the durable half of this step. The gate below is.
#     Observed on hardware 2026-08-12: transformers
#     declares `tokenizers>=0.22.0,<=0.23.0`, PyPI had shipped 0.23.1, and the built image got
#     0.23.1 — pip reported success and `vllm` then died at IMPORT with
#     `ImportError: tokenizers... is required ... but found tokenizers==0.23.1`, i.e. the server
#     could not start at all. Build success is NOT import success, and nothing in CI imports vllm,
#     so this shipped green. The explicit install re-pins tokenizers into transformers' range.
#     The allowlisted `pip check` gate (next RUN) is the durable half: it fails the BUILD on any
#     NEW inconsistent dependency set, so the next such drift cannot reach an image. If the gate
#     ever fails, do not delete it — read what it names and pin that too (this hardcoded bound is
#     expected to need updating whenever transformers moves its range; the gate is precisely what
#     makes that loud).
#     NB torch is fine by PEP 440: a local version (`2.9.1+rocm...`) satisfies `==2.9.1`.
#     pybind11: the amd-aiter nightly began declaring it as a RUNTIME dep (AITER JIT-compiles
#     kernels at run time) between 2026-08-12 and -13 — the gate caught the drift (run
#     31654555755); installed rather than allowlisted because it is satisfiable.
#     pycountry: mistral_common's transcription path imports pydantic-extra-types'
#     `language_code`, which imports pycountry unconditionally — but upstream ships it only as
#     an extra, so no resolver pulls it (pip did not; uv does not either — an extra nobody
#     requests is not a dependency) and `vllm serve` died with `RuntimeError: The
#     language_code module requires "pycountry"` (hardware 2026-08-14). Chain: vllm ->
#     gguf_utils -> gguf -> mistral_common. Satisfiable, so installed, not allowlisted — the
#     same disposition as pybind11 (a missing package is never allowlist material anyway).
#  6. RE-PIN torchvision to the ROCm-nightly wheel off the SAME index + date as torch. Nothing
#     here asks for torchvision by name: vLLM's rocm.txt pulls `timm`, whose dep is a bare
#     `torchvision`, so step 3 satisfies it from PyPI — and a PyPI torchvision is compiled
#     against a PyPI torch (0.28.0 → torch 2.13.0), so its C++ ops never register against our
#     2.9.1+rocm and `vllm serve` dies at startup with `RuntimeError: operator torchvision::nms
#     does not exist` (hardware 2026-08-14 — another build-green, import-broken image, exactly
#     the step-5 lesson). Must run AFTER every install that can resolve torchvision. --no-deps
#     keeps the reinstall off torch/numpy/pillow; --force-reinstall evicts whatever step 3 left.
#  7. trim /opt/fp8 to the RUNTIME import surface: keep top-level *.py + LICENSE/NOTICE +
#     licenses/ (the live Triton JIT kernels imported via PYTHONPATH=/opt/fp8); drop the
#     non-runtime baggage (bench/ docs/ serve_*.sh README.md .gitignore) from the checkout.
# THIS RUN MOVED TO uv IN s46 (plan item 3), and it landed ALONE so a red job has one
# suspect. Two things went with it — read both before touching this block.
# 1. `PIP_USE_DEPRECATED=legacy-resolver` is DELETED, not carried. ❌ The claim that kept it
#    ("uv has ONE resolver, and whether its PubGrub shares pip's pathology CANNOT BE
#    MEASURED WITHOUT BUILDING") was retracted s45 — it was measurable in two minutes:
#      * `uv pip install --dry-run vllm==0.16.0` resolved the FULL graph in ~2.4s. That is
#        the graph pip's modern resolver dies on with RecursionError even at a 100k
#        recursion limit. No sign of the same pathology.
#      * The interaction that actually broke pip: with a local-version torch
#        (`2.9.1+rocm…`) installed, `uv pip install --dry-run "torch==2.9.1"` reports
#        "Would make no changes" — uv honours PEP 440 local-version satisfaction and does
#        not re-resolve torch.
#    ⚠️ That measurement used the PyPI vllm wheel, not our locally built ROCm one, and this
#    step installs local .whl FILES rather than resolving a name. It was strong evidence,
#    never a receipt; CI on this commit is the receipt. If it goes red for a RESOLVER
#    reason, restore this line and the `pip` verbs — do NOT iterate in CI.
# 2. 🚨 THE CONSTRAINT UNSET IS THE TRAP, and it is why this is three names, not one:
#    `unset PIP_CONSTRAINT` does NOTHING for uv (uv deliberately does not read pip's
#    variable — astral-sh/uv#10686), and UV_CONSTRAINT alone would leave source builds
#    constrained via UV_BUILD_CONSTRAINT. All three go, or this reproduces the s44 failure
#    that cost a ~57 min cascade. PIP_CONSTRAINT stays in the list because a source build
#    can still shell out to pip underneath.
#    The exemption itself is UNCHANGED and still deliberate (step 3 lets a PyPI torchvision
#    arrive so vLLM's own deps resolve; step 6 evicts it), and `assert-rocm-pins.sh` at the
#    end is what makes any of this safe to attempt — a resolver that behaves differently
#    produces a RED JOB, not a GPU-less image.
# ⚠️ Step 6 is `--reinstall-package torchvision`, NOT `--force-reinstall`: uv's flag names
# ONE distribution where pip's applies to the whole install set, which is the narrower and
# more honest spelling of what step 6 means. Measured caveat: a MISNAMED
# `--reinstall-package` is a SILENT no-op, not an error — the name must be exact.
RUN . /etc/droste/rocm-version.env \
    && unset PIP_CONSTRAINT UV_CONSTRAINT UV_BUILD_CONSTRAINT \
    && uv pip install --no-deps /tmp/wheels/amd_aiter*.whl /tmp/wheels/flash_attn*.whl \
    && AITER_INC="$(python -c 'import sysconfig,os; print(os.path.join(sysconfig.get_path("purelib"),"aiter_meta","csrc","include"))')" \
    && sh -c ' \
        die() { echo "aiter-headers: FATAL: $*" >&2; \
                echo "aiter-headers: patch_aiter_headers.py OVERWRITES two upstream aiter headers" >&2; \
                echo "aiter-headers: WHOLESALE and RETURNS 0 WHETHER OR NOT IT WROTE ANYTHING -- a" >&2; \
                echo "aiter-headers: missing include dir or a renamed header makes it a silent no-op." >&2; \
                echo "aiter-headers: Without those RDNA3 fallbacks, gfx1151 has no scalar substitutes" >&2; \
                echo "aiter-headers: for the CDNA-only packed ISA aiter emits, and the failure appears" >&2; \
                echo "aiter-headers: at RUNTIME in a JIT-compiled kernel, not in this build." >&2; \
                echo "aiter-headers: READ the aiter tree at the pinned flash-attention submodule and" >&2; \
                echo "aiter-headers: re-derive the paths/markers in patch_aiter_headers.py. Do NOT" >&2; \
                echo "aiter-headers: delete this check to go green." >&2; \
                exit 1; }; \
        [ -d "$1" ] || die "$1 is not a directory -- aiter did not install, or its wheel layout moved"; \
        [ -f "$1/ck_tile/vec_convert.h" ] || die "$1/ck_tile/vec_convert.h is gone -- the header was renamed or moved"; \
        [ -f "$1/hip_reduce.h" ] || die "$1/hip_reduce.h is gone -- the header was renamed or moved"; \
        nv=$(grep -rlE "^[[:space:]]*#[[:space:]]*include.*vec_convert\.h" "$1" | grep -vxF "$1/ck_tile/vec_convert.h" | wc -l); \
        [ "$nv" -ge 1 ] || die "no file under $1 OTHER THAN $1/ck_tile/vec_convert.h itself has an #include of vec_convert.h -- nothing reads the header, so rewriting it would be a silent no-op. The pinned aiter MOVED: re-derive the include graph under csrc/include at the aiter submodule of the CURRENT FLASH_ATTENTION_REF, then update patch_aiter_headers.py AND this check together"; \
        nh=$(grep -rlE "^[[:space:]]*#[[:space:]]*include.*hip_reduce\.h" "$1" | grep -vxF "$1/hip_reduce.h" | wc -l); \
        [ "$nh" -ge 1 ] || die "no file under $1 OTHER THAN $1/hip_reduce.h itself has an #include of hip_reduce.h -- nothing reads the header, so rewriting it would be a silent no-op. The pinned aiter MOVED: re-derive the include graph under csrc/include at the aiter submodule of the CURRENT FLASH_ATTENTION_REF, then update patch_aiter_headers.py AND this check together"; \
        echo "aiter-headers: reachable -- vec_convert.h #included by ${nv} other file(s), hip_reduce.h by ${nh}"; \
        python /opt/resources/scripts/patch_aiter_headers.py || die "patch_aiter_headers.py exited nonzero"; \
        grep -qF "CK_TILE_RDNA3_NO_PK_FP8" "$1/ck_tile/vec_convert.h" \
          || die "vec_convert.h carries no CK_TILE_RDNA3_NO_PK_FP8 after patching -- it was NOT rewritten"; \
        grep -qF "AITER_RDNA_NO_DPP_BCAST" "$1/hip_reduce.h" \
          || die "hip_reduce.h carries no AITER_RDNA_NO_DPP_BCAST after patching -- it was NOT rewritten"; \
        echo "aiter-headers: both RDNA3 fallback headers rewritten and verified"; \
       ' _ "${AITER_INC}" \
    && AITER_JIT_DIR="$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')/aiter/jit" \
    && cp /tmp/aiter-jit/*.so "${AITER_JIT_DIR}/" \
    && test -f "${AITER_JIT_DIR}/module_aiter_enum.so" \
    && uv pip install /tmp/wheels/vllm*.whl \
    && uv pip install ray \
    && uv pip install 'tokenizers>=0.22.0,<=0.23.0' \
    && uv pip install pybind11 pycountry \
    && uv pip install --no-deps --reinstall-package torchvision --index-url ${ROCM_INDEX_URL} \
         "torchvision==${TORCHVISION_VERSION}" \
    && /opt/resources/resolve/assert-rocm-pins.sh torch torchvision \
    && rm -rf /tmp/wheels /tmp/aiter-jit /root/.cache/pip \
    && rm -rf /opt/fp8/bench /opt/fp8/docs /opt/fp8/README.md /opt/fp8/serve_*.sh /opt/fp8/.gitignore

# Import smoke test — the compiler-free half of step 2. Nothing else in CI imports any of
# this, which is precisely how two build-green/import-broken images shipped. `import aiter`
# is the exact call vLLM makes during model inspection: it succeeds ONLY if the prebuilt
# module_aiter_enum.so is importable, since this image has no compiler to fall back on. Runs
# GPU-less on purpose (aiter degrades to arch "cpu" when rocminfo is absent) — it proves the
# import path, not the kernels.
RUN python -c "import aiter; print('aiter import OK:', aiter.ActivationType)"

# Dependency-consistency gate — the durable half of step 5 above. `pip check` audits the WHOLE
# environment and exits nonzero on ANY conflict, but this env carries five KNOWN pre-existing
# conflicts (upstream pins the wheel set outruns; none of them ours to fix), so a bare
# `pip check` is a permanent build break (CI run 31644372153). Instead: print the FULL raw
# output first (so debugging never needs a rebuild), filter out ONLY the five known conflict
# lines, and fail iff anything else survives — a NEW conflict of the tokenizers kind (or of
# the torchvision kind, see below) still kills the build. Each allowlist pattern anchors
# the offending package, the requirement subject, and the DIRECTION of the bound, never the
# installed versions (those drift every rebuild); a new conflict between the same two packages
# in the other direction is NOT silently eaten. NB: quoted heredoc delimiter is load-bearing —
# it stops BuildKit expanding the $vars below; the body runs verbatim under the image's default
# /bin/sh (dash), so the script is strictly POSIX (no arrays, no pipefail).
RUN <<'PIP_CHECK_GATE'
set -eu
rc=0
PIP_DISABLE_PIP_VERSION_CHECK=1 pip check >/tmp/pip-check-raw.txt 2>&1 || rc=$?
echo "=== pip check: full raw output (exit ${rc}) ==="
cat /tmp/pip-check-raw.txt
echo "=== pip check: end of raw output ==="

# Known-conflict allowlist. pip check line shapes covered (both wordings pip has used):
#   "<pkg> <ver> has requirement <req>, but you have <pkg> <ver>."
#   "<pkg> <ver> requires <req>, but you have <pkg> <ver>."
# ("<req>, which is not installed." lines are deliberately NOT allowlisted: none of the five
# is a missing package, and a formerly-present package going missing must fail the build.)
#
# NO torchvision entry, deliberately. It used to carry one (a PyPI torchvision pins
# torch==<exact stable>, which our +rocm local version can never satisfy); step 6 above now
# installs the ROCm-nightly torchvision instead, whose metadata asks only for a bare `torch`,
# and nothing in the wheel set bounds torchvision from below (timm/peft/transformers all
# depend on it unpinned). So torchvision is expected to be SILENT here: any torchvision line
# means the re-pin regressed to a PyPI wheel — fail, do not re-add a pattern.
# vllm pins grpcio==<exact>; the wheel set resolves a newer grpcio — pre-existing skew.
ALLOW_VLLM_GRPCIO='^vllm [0-9][^ ]* (has requirement|requires) grpcio==.*, but you have grpcio '
# vllm pins grpcio-reflection==<exact>; same newer-than-pinned skew as grpcio above.
# (The s32 notes miscast this line as grpcio-reflection pinning grpcio; the CI raw
# output shows vllm as the offender, and grpcio-reflection 1.83 is content with
# grpcio 1.83 — corrected from run 31653533467.)
ALLOW_VLLM_GRPCIO_REFLECTION='^vllm [0-9][^ ]* (has requirement|requires) grpcio-reflection==.*, but you have grpcio-reflection '
# grpcio-tools caps protobuf<7; we have protobuf 7.x. Pattern requires the '<' upper bound.
ALLOW_GRPCIO_TOOLS_PROTOBUF='^grpcio-tools [0-9][^ ]* (has requirement|requires) protobuf[^ ]*<.*, but you have protobuf '
# numba caps numpy<2.3; we have numpy 2.5.x. Pattern requires the '<' upper bound.
ALLOW_NUMBA_NUMPY='^numba [0-9][^ ]* (has requirement|requires) numpy[^ ]*<.*, but you have numpy '
# vllm caps setuptools<80; we have setuptools 80.x. Pattern requires the '<' upper bound.
ALLOW_VLLM_SETUPTOOLS='^vllm [0-9][^ ]* (has requirement|requires) setuptools[^ ]*<.*, but you have setuptools '

# grep -v keeps only UNfiltered (i.e. new) lines; it exits 1 when everything was filtered,
# which is the GOOD case — hence the || true.
grep -v -E \
    -e '^[[:space:]]*$' \
    -e '^No broken requirements found' \
    -e "$ALLOW_VLLM_GRPCIO" \
    -e "$ALLOW_VLLM_GRPCIO_REFLECTION" \
    -e "$ALLOW_GRPCIO_TOOLS_PROTOBUF" \
    -e "$ALLOW_NUMBA_NUMPY" \
    -e "$ALLOW_VLLM_SETUPTOOLS" \
    /tmp/pip-check-raw.txt >/tmp/pip-check-new.txt || true

if [ -s /tmp/pip-check-new.txt ]; then
    echo "=== pip check gate: NEW conflicts (not on the known-conflict allowlist) ==="
    cat /tmp/pip-check-new.txt
    echo "FAIL: pin the named package (see step 5 above) or, ONLY if the conflict is"
    echo "pre-existing and unsatisfiable by construction, allowlist it with a rationale."
    exit 1
fi
if [ "${rc}" -ne 0 ] && ! [ -s /tmp/pip-check-raw.txt ]; then
    echo "FAIL: pip check exited ${rc} with no output - failing closed."
    exit 1
fi
echo "pip check gate: OK (only known allowlisted conflicts present)."
rm -f /tmp/pip-check-raw.txt /tmp/pip-check-new.txt
PIP_CHECK_GATE

# Runtime shell env + banner
COPY profile.d/01-rocm-env-for-triton.sh /etc/profile.d/01-rocm-env-for-triton.sh
COPY profile.d/99-toolbox-banner.sh      /etc/profile.d/99-toolbox-banner.sh
COPY profile.d/zz-venv-last.sh           /etc/profile.d/zz-venv-last.sh
RUN chmod 0644 /etc/profile.d/01-rocm-env-for-triton.sh \
      /etc/profile.d/99-toolbox-banner.sh /etc/profile.d/zz-venv-last.sh

# FP8 shim + runtime env. VLLM_NO_USAGE_STATS=1 opts out of vLLM usage/do-not-track
# reporting (baked, per the hidden-state disposition — we do NOT persist ~/.config/vllm).
ENV PYTHONPATH=/opt/fp8 \
    FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE \
    VLLM_TARGET_DEVICE=rocm \
    VLLM_USE_TRITON_AWQ=1 \
    TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1 \
    MIOPEN_FIND_MODE=FAST \
    VLLM_DISABLE_COMPILE_CACHE=1 \
    VLLM_NO_USAGE_STATS=1 \
    PYTHONNOUSERSITE=1

# Droste runtime contract: per-port build-spec + config templates + shared entrypoint.
#
# 🚨 vllm_config.yaml IS A TEMPLATE NOW, NOT BUILD-TIME OUTPUT. It used to be written
# here by gen_vllm_config.py, which harvested the vendored upstream MODEL_TABLE into a
# generated file. That generation is RETIRED: its one structural benefit — stanzas that
# follow upstream/models.py automatically — never fired (that file has a single commit),
# while the cost was that the shipped config was 126 out.append() calls of prose nobody
# could edit by hand. The file the box seeds is now an authored, reviewed template and it
# arrives with every other template on the COPY below.
# ⚠️ SO DO NOT RE-ADD A GENERATOR STEP HERE. Re-adding one silently overwrites the
# authored file with generated output and the template goes inert again — which is
# exactly the state this line replaced.
# ▶ THE GENERATOR IS NOW scripts/vllm-models.py, A DEV-TIME REPORT (same move as
#   gen_llama_env.sh -> scripts/llama-options.sh). It renders the stanza each entry in
#   the vendored upstream/models.py implies and diffs it against the authored YAML, so
#   the link between the two survives without anything writing that file. Run it when
#   models.py is re-fetched at a new toolbox pin. upstream/models.py therefore stays in
#   the TREE as the record of where the stanzas came from; neither file is COPYed, and
#   the IMAGE carries neither.
COPY build-spec                 /opt/resources/build-spec
COPY templates/                 /opt/resources/templates/

# Group-writable venv so the distrobox-lane box user (in group `droste`) can
# pip-install into the baked venv after overlay copy-up (dirs setgid → copy-up
# is metadata-only; new files inherit the group). Re-applied here AFTER this
# port's pip installs (runtime-base did it for its own venv content).
RUN chgrp -R droste /opt/venv \
    && chmod -R g+rwX /opt/venv \
    && find /opt/venv -type d -exec chmod g+s {} +

ENTRYPOINT ["/opt/resources/resolve/droste-entrypoint.sh"]
