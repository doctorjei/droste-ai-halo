# droste-vllm-build: builds vLLM (flash-attention, aiter, vLLM wheels) against pinned TheRock SDK

# Overrideable Arguments - General Build (override with '--build-arg <ARG_NAME>=<VALUE>'
ARG SERIES_NAME=droste
ARG ARCH_NAME=halo
ARG TARGET_NAME=vllm-build
ARG BUILDER_DESC="builder image for vLLM (flash-attention, aiter, vLLM wheels)"
ARG DESCRIPTION="compiled outputs for vLLM image"

# Image Names
ARG BASE_IMAGE=localhost/${SERIES_NAME}-build-base-${ARCH_NAME}

# Build image
FROM ${BASE_IMAGE} AS builder
ARG SERIES_NAME TARGET_NAME ARCH_NAME BUILDER_DESC
LABEL description="${SERIES_NAME}-${TARGET_NAME}-${ARCH_NAME}: ${BUILDER_DESC}"

# ROCm Pin: inherited from the build base as /etc/droste/rocm-version.env; every RUN
# below that needs a version or the gfx target sources it (no ARG, no --build-arg).

# Pinned Dependencies
ARG FLASH_ATTENTION_REPO=https://github.com/ROCm/flash-attention.git
ARG FLASH_ATTENTION_BRANCH=main_perf
ARG FLASH_ATTENTION_REF=3f94643fb41bcedded28c85185a8e11d42ef1592
ARG VLLM_REPO=https://github.com/vllm-project/vllm.git
ARG VLLM_REF=v0.16.0
ARG FP8_KERNELS_REPO=https://github.com/leonyurko/vllm-fp8-strix-halo-kernel-support.git
ARG FP8_KERNELS_REF=50424f5525b8382353551e3301d0da56eca0be2b

# Install Torch
# uv (staged migration, s45 — this is a BUILD-ONLY image, never shipped). ✅ MEASURED
# against the real index before changing: uv resolves `torch==<pin>+rocm…` to the same
# 14 packages pip does, including triton+rocm and rocm-sdk-libraries — the LOCAL VERSION
# IDENTIFIER is handled identically, and no `--pre` is required (2.9.1 is a final release;
# the `+rocm…` part is local metadata, not a prerelease).
RUN . /etc/droste/rocm-version.env \
    && uv pip install --index-url ${ROCM_INDEX_URL} "torch==${TORCH_VERSION}"

# Python build backends. These are what the `pip wheel --no-build-isolation` steps below
# compile against, so they must land in the SAME venv — they do: uv finds /opt/venv via
# VIRTUAL_ENV (an image ENV from the runtime base), it does not follow PATH.
RUN uv pip install --upgrade \
      cmake ninja packaging wheel numpy "setuptools-scm>=8" "setuptools<80.0.0" \
      scikit-build-core pybind11 numba scipy

# Flash attention
ENV FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE \
    LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/lib64:$LD_LIBRARY_PATH

COPY patch_aiter_headers.py /opt/patch_aiter_headers.py

# ⚠️ THE pip LINES IN THE RUN BELOW ARE STILL pip — but read WHY before assuming.
# ❌ THE ORIGINAL REASONING HERE WAS WRONG ON BOTH COUNTS — RETRACTED s45, and the
# retraction is left in place so nobody re-derives the same mistake:
#   * "uv has NO `pip wheel` equivalent, so these are permanently pip" — FALSE. I ran
#     `uv pip --help`, saw no `wheel` subcommand, and generalised. Wheel-building lives
#     under a DIFFERENT VERB: `uv build --wheel --no-build-isolation -o <dir> <src>`,
#     measured working. `uv pip --help` is not `uv --help`.
#   * "`--force-reinstall` maps to uv's broader `--reinstall`" — true but beside the
#     point: `--reinstall-package <NAME>` exists and is NARROWER than pip's flag.
# These lines stay pip ONLY because the migration has not been done and CI has not
# proven it, NOT because it is impossible.
# ▶ PLAN: notebook/plans/uv-migration-completion-s45.md (items 1 and 2).
# ⚠️ The real risk when it happens is the wheel FILENAME: the next step installs by
# glob, so a name uv spells differently breaks the chain. Check, do not assume.
RUN mkdir -p /artifacts/wheels \
    && git clone "${FLASH_ATTENTION_REPO}" /opt/flash-attention \
    && cd /opt/flash-attention \
    && if [ -n "${FLASH_ATTENTION_REF}" ]; then git checkout "${FLASH_ATTENTION_REF}"; \
       else git checkout "${FLASH_ATTENTION_BRANCH}"; fi \
    && git submodule update --init third_party/aiter \
    && cd third_party/aiter \
    && git submodule update --init 3rdparty/composable_kernel \
    && export CK_DIR="$(pwd)/3rdparty/composable_kernel" \
    && python -m pip wheel --no-build-isolation --no-deps -w /artifacts/wheels -v . \
    && python -m pip install --force-reinstall /artifacts/wheels/amd_aiter*.whl \
    && python /opt/patch_aiter_headers.py \
    && cd /opt/flash-attention \
    && python -c "import re; f=open('setup.py','r'); t=f.read(); f.close(); t=re.sub(r'subprocess\.run\([\s\S]*?third_party/aiter[\s\S]*?check=True,\s*\)', 'pass # patched', t); f=open('setup.py','w'); f.write(t)" \
    && python -m pip wheel --no-build-isolation --no-deps -w /artifacts/wheels -v .

# vLLM
RUN apt-get -qq update && apt-get -qq install -y --no-install-recommends \
      rustc cargo python3.13-dev libdrm-dev && rm -rf /var/lib/apt/lists/* && apt-get clean \
      && uv pip install "setuptools-rust>=1.9.0"

# Prebuild aiter's import-time JIT module for the RUNTIME image. `import aiter` evaluates
# aiter/ops/enum.py at module scope, which JIT-compiles module_aiter_enum (a single CPU-only
# pybind11 .cu) — and the runtime image ships NO compiler by design, so it must arrive
# prebuilt. Only this module builds on a bare import (every other op is lazy, built on first
# call), so the import IS the narrowest possible trigger: aiter's official PREBUILD_KERNELS
# hook is coarser — even its smallest mode (3) also codegens module_fmha_v3* for gfx1151.
# Deliberately placed BELOW the vLLM apt layer, not up with aiter: it is the first thing in
# this stage that compiles a pybind11 module, so it is the first to need `Python.h`, and
# python3.13-dev arrives in that layer (nothing above it compiles against Python — aiter's
# wheel is pure packaging and flash-attn skips its C++ extension under Triton). CI run
# 31849687656 is the receipt: hipcc -isystem /usr/include/python3.13 -> file not found.
# The other two compilers it needs are already here: g++ (aiter's cpp_extension probes `c++`)
# and hipcc (the source is a .cu, so device bitcode is demanded even though the module is
# host-only). GPU_ARCHS is pinned because aiter's "native" default shells out to rocminfo,
# and no CI runner has a GPU. The .so is staged into /artifacts for the runtime to drop in.
# NB `find -L`: /opt/rocm is a SYMLINK to the SDK root, and find(1) does not descend into a
# symlinked start point unless told to — the bare `find` in the vLLM step below therefore
# yields "" (harmless there: it compiles with /opt/rocm/lib/llvm/bin/clang, which self-locates
# its bitcode). Plain `hipcc` does not, so here the path must actually resolve; `test -n`
# keeps an empty result from silently reaching hipcc as the ROCm-device-library error.
RUN . /etc/droste/rocm-version.env \
    && export HIP_DEVICE_LIB_PATH="$(find -L /opt/rocm -type d -name bitcode -print -quit)" \
    && test -n "${HIP_DEVICE_LIB_PATH}" \
    && GPU_ARCHS="${GFX_TARGET}" python -c "import aiter" \
    && mkdir -p /artifacts/aiter-jit \
    && cp /opt/venv/lib*/python*/site-packages/aiter/jit/*.so /artifacts/aiter-jit/ \
    && test -f /artifacts/aiter-jit/module_aiter_enum.so \
    && ls -l /artifacts/aiter-jit

COPY patch_strix.py       /opt/patch_strix.py
COPY patch_fp8_kernels.py /opt/patch_fp8_kernels.py
RUN git clone "${VLLM_REPO}" /opt/vllm \
    && cd /opt/vllm \
    && if [ -n "${VLLM_REF}" ]; then git checkout "${VLLM_REF}"; fi \
    && cp /opt/patch_strix.py /opt/patch_fp8_kernels.py . \
    && python patch_strix.py \
    && python patch_fp8_kernels.py

# Build the vLLM wheel
ENV ROCM_HOME=/opt/rocm \
    HIP_PATH=/opt/rocm \
    HIP_PLATFORM=amd \
    VLLM_TARGET_DEVICE=rocm \
    MAX_JOBS=4 \
    CC=/opt/rocm/lib/llvm/bin/clang \
    CXX=/opt/rocm/lib/llvm/bin/clang++
# The THREE ARCH VARIABLES ARE DELIBERATELY NOT `ENV`. `ENV` cannot source a file, so a
# literal gfx1151 up here would be a second source of truth beside GFX_TARGET in
# /etc/droste/rocm-version.env — exactly what base/Container.build refuses to create by
# not re-exporting GFX_TARGET as an image ENV. They are exported inside the build RUN
# instead, which is the idiom the other four builder files already use. Safe: nothing
# after this stage reads them (the final carrier is FROM scratch, and the aiter step
# above passes GPU_ARCHS itself).
RUN . /etc/droste/rocm-version.env \
    && export PYTORCH_ROCM_ARCH="${GFX_TARGET}" \
              HIP_ARCHITECTURES="${GFX_TARGET}" \
              AMDGPU_TARGETS="${GFX_TARGET}" \
    && cd /opt/vllm \
    && export HIP_DEVICE_LIB_PATH="$(find /opt/rocm -type d -name bitcode -print -quit)" \
    && echo "Compiling vLLM for ${GFX_TARGET} with bitcode: ${HIP_DEVICE_LIB_PATH}, clang: ${CC}" \
    && export CMAKE_ARGS="-DROCM_PATH=/opt/rocm -DHIP_PATH=/opt/rocm -DAMDGPU_TARGETS=${GFX_TARGET} -DHIP_ARCHITECTURES=${GFX_TARGET}" \
    && python -m pip wheel --no-build-isolation --no-deps -w /artifacts/wheels -v .

# Pure-python FP8 Triton kernels (leonyurko)
RUN git clone "${FP8_KERNELS_REPO}" /artifacts/fp8 \
    && cd /artifacts/fp8 && git checkout "${FP8_KERNELS_REF}" \
    && rm -rf /artifacts/fp8/.git

RUN echo "=== /artifacts/wheels ===" && ls -1 /artifacts/wheels

# --- Final carrier: ONLY the wheels + FP8 kernel tree
FROM scratch
ARG SERIES_NAME TARGET_NAME ARCH_NAME DESCRIPTION
LABEL description="${SERIES_NAME}-${TARGET_NAME}-${ARCH_NAME}: ${DESCRIPTION}"
COPY --from=builder /artifacts /artifacts
