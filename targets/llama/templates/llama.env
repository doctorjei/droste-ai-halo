# Chat Templates & Reasoning
# --------------------------
# {<template>}, {<template file>}, {<json}>
# LLAMA_ARG_CHAT_TEMPLATE=         # --chat-template (default: from model)
# LLAMA_ARG_CHAT_TEMPLATE_FILE=    # --chat-template-file (default: from model)
# LLAMA_ARG_CHAT_TEMPLATE_KWARGS=  # --chat-template-kwargs (default: none)
#
# {none, auto, deepseek*, deepseek-legacy}
# LLAMA_ARG_THINK=deepseek         # --reasoning-format
#
# {on, off, auto*},
# LLAMA_ARG_REASONING=auto         # -rea / --reasoning
#
# {<tokens>}, {<message string>}
# LLAMA_ARG_THINK_BUDGET=-1        # --reasoning-budget (-1: any, 0: end now)
# LLAMA_ARG_THINK_BUDGET_MESSAGE=  # --reasoning-budget-message (default: none)
#
# {on, off}
# DROSTE_LLAMA_JINJA=on                 # --jinja
# DROSTE_LLAMA_PREFILL_ASSISTANT=on     # --prefill-assistant
# DROSTE_LLAMA_SKIP_CHAT_PARSING=off    # --skip-chat-parsing


# Endpoints, Slots, & Server Identity
# -----------------------------------
# Published endpoints, naming, serving modes.
#
# {<various>}
# LLAMA_ARG_ALIAS=                     # -a, --alias (default: model's name)
# LLAMA_ARG_TIMEOUT=3600               # -to, --timeout (seconds; read, write) 
# LLAMA_ARG_SSE_PING_INTERVAL=30       #  --sse-ping-interval
#
# {none*, mean, cls, last, rank}
# LLAMA_ARG_POOLING=                   # --pooling (default: model's choice)
#
# {on, off}
# DROSTE_LLAMA_ENDPOINT_METRICS=off    # --metrics
# DROSTE_LLAMA_ENDPOINT_PROPS=off      # --props
# DROSTE_LLAMA_ENDPOINT_SLOTS=on       # --slots
# DROSTE_LLAMA_EMBEDDINGS=off          # --embedding, --embeddings
# DROSTE_LLAMA_RERANKING=off           # --rerank, --reranking
# DROSTE_LLAMA_REUSE_PORT=off          # --reuse-port
# DROSTE_LLAMA_OFFLINE=off             # --offline (never seek network model)
# DROSTE_LLAMA_PERF=on                 # --perf


# Multimodal
# ----------
# Vision and audio need a projector file beside the model.
#
# {<source>}
# LLAMA_ARG_MMPROJ=                     # -mm / --mmproj (default: unused)
# LLAMA_ARG_MMPROJ_URL=                 # -mmu / --mmproj-url (default: unused)
#
# {<tokens>}
# LLAMA_ARG_IMAGE_MIN_TOKENS=-1         # --image-min-tokens (-1: model's min)
# LLAMA_ARG_IMAGE_MAX_TOKENS=-1         # --image-max-tokens (-1: model's max)
# LLAMA_ARG_MTMD_BATCH_MAX_TOKENS=1024  # --mtmd-batch-max-tokens
#
# {on, off}
# DROSTE_LLAMA_MMPROJ_AUTO=on           # --mmproj-auto
# DROSTE_LLAMA_MMPROJ_OFFLOAD=on        # --mmproj-offload (off = run on CPU)


# Batching & Parallelism
# ----------------------
# Server workload - maximum per decode call; batch = logical, ubatch = physical
# Slots are concurrent conversations (context divided between them)
#
# {<number>}
# LLAMA_ARG_BATCH=2048         # -b, --batch-size
# LLAMA_ARG_UBATCH=512         # -ub, --ubatch-size
# LLAMA_ARG_N_PARALLEL=1       # -np, --parallel
# LLAMA_ARG_THREADS_HTTP=-1    # --threads-http (-1 = derived from slot count)
# LLAMA_ARG_THREADS=-1         # -t, --threads (-1: count machine's math cores)
#
# {on*, off}
# DROSTE_LLAMA_CONT_BATCHING=on # -cb, --cont-batching


# Memory, Offload, & NUMA
# -----------------------
# {on, off}
#
# Where the weights and the KV cache live, and how they get there. On this box
# system RAM *is* VRAM, so these settings trade against each other rather than
# moving data between two separate pools.
#
# DROSTE_LLAMA_MMAP=on                 # --mmap
# DROSTE_LLAMA_MLOCK=off               # --mlock
# DROSTE_LLAMA_DIRECT_IO=off           # -dio, --direct-io
# DROSTE_LLAMA_KV_OFFLOAD=on           # -kvo, --kv-offload
# DROSTE_LLAMA_REPACK=on               # --repack
# DROSTE_LLAMA_CPU_MOE=off             # -cmoe, --cpu-moe
# DROSTE_LLAMA_NO_HOST=off             # --no-host
# DROSTE_LLAMA_BACKEND_SAMPLING=off    # --backend-sampling
#
# {off*, distribute, isolate, numactl}
# DROSTE_LLAMA_NUMA=off                # --numa
#
# {<number>}
# LLAMA_ARG_N_CPU_MOE=0                # -ncmoe, --n-cpu-moe (MoE layers to keep on the CPU


# Fitting to available memory
# ---------------------------
# {on*, off}, {<MiB per device>}, {<size>}
