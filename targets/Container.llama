# droste-llama-halo: llama.cpp toolbox on halo.
# Ported from github.com/kyuz0/amd-strix-halo-toolboxes

# Overrideable Arguments - General Build (override with '--build-arg <ARG_NAME>=<VALUE>'
ARG SERIES_NAME=droste
ARG ARCH_NAME=halo
ARG TARGET_NAME=llama
ARG DESCRIPTION="llama.cpp toolbox (turboquant)"

# Image Names
ARG BASE_IMAGE=localhost/${SERIES_NAME}-runtime-base-${ARCH_NAME}
ARG ARTIFACTS_IMAGE=localhost/${SERIES_NAME}-${TARGET_NAME}-build-${ARCH_NAME}

# Build image
FROM ${ARTIFACTS_IMAGE} AS artifacts
FROM ${BASE_IMAGE}
ARG SERIES_NAME TARGET_NAME ARCH_NAME DESCRIPTION
LABEL description="${SERIES_NAME}-${TARGET_NAME}-${ARCH_NAME}: ${DESCRIPTION}"

# Install libgomp1
RUN apt-get -qq update && apt-get -qq install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* && apt-get clean

# Copy artifacts
COPY --from=artifacts /artifacts/bin/   /usr/local/bin/
COPY --from=artifacts /artifacts/lib64/ /usr/local/lib64/
COPY --from=artifacts /artifacts/share/gguf-vram-estimator.py /usr/local/bin/gguf-vram-estimator.py

RUN chmod +x /usr/local/bin/gguf-vram-estimator.py && \
      printf '%s\n' /usr/local/lib /usr/local/lib64 > /etc/ld.so.conf.d/local.conf && ldconfig

# Shared-resolver runtime assets: per-port build-spec + seed templates + helper scripts
# (baked RO under /opt/resources; the resolver/entrypoint live in the runtime base).
COPY build-spec  /opt/resources/build-spec
COPY templates/  /opt/resources/templates/

# llama.cfg is a HAND-AUTHORED template (templates/llama.cfg), copied above with
# the rest. It used to be generated here from the pinned binary's own --help;
# that is now a DEV-TIME step (scripts/llama-options.sh, run at a pin bump on a
# machine with a GPU) whose output is DIFFED against the template by a human.
# ⭐ Two reasons, and the second is why it changed: presentation has to be ours to
# control, and `llama-server --help` CANNOT RUN on a GPU-less CI runner — it dies
# with SIGILL after "no ROCm-capable device", so the generated file shipped
# degraded on every build that mattered.
#
# What that costs, and what replaces it: generating here also VERIFIED that the
# LLAMA_ARG_* names we depend on still exist, failing the build on an upstream
# rename. The check below keeps that guarantee without running the binary — the
# arg table stores env names as plain string literals, so a scan finds them on
# any runner, GPU or not.
#
# 🚨 SCAN THE SHIPPED SET, NOT `command -v llama-server` — that spelling FAILED CI on
# its first real run (33269833780, LLAMA_ARG_HOST "missing" in 0.043s). This fork
# links TWO objects: a thin `llama-server` executable from main.cpp, and
# `libllama-server-impl.so` which is where arg.cpp's string literals actually live.
# Grepping the executable alone can never find them, so the gate could only ever
# report a false rename. Both land in /usr/local/bin AND /usr/local/lib64
# (Container.llama-build:86-88 copies build/bin wholesale and then every lib*.so*),
# hence the recursive scan over both rather than a named .so — the library's name is
# upstream's to change, and this gate exists precisely to survive that.
RUN for v in LLAMA_ARG_HOST LLAMA_ARG_PORT LLAMA_ARG_MODEL; do \
        grep -qar "$v" /usr/local/bin /usr/local/lib64 \
        || { echo "gen-drift: $v is NOT in the pinned llama-server — upstream rename? Fix targets/llama/templates/llama.cfg and the launch flags before shipping."; exit 1; }; \
    done \
    && echo "llama drift gate: LLAMA_ARG_HOST/PORT/MODEL present in the pinned binary"

# Runtime shell banner (interactive/toolbox lane)
COPY profile.d/99-toolbox-banner.sh /etc/profile.d/99-toolbox-banner.sh
RUN chmod 0644 /etc/profile.d/99-toolbox-banner.sh

# Helper scripts on PATH (per /opt/resources design)
ENV PATH=/opt/resources/scripts:$PATH

# Group-writable venv so the distrobox-lane box user (in group `droste`) can
# pip-install into the baked venv after overlay copy-up (dirs setgid → copy-up
# is metadata-only; new files inherit the group). Re-applied here AFTER this
# port's installs (runtime-base did it for its own venv content).
RUN chgrp -R droste /opt/venv \
    && chmod -R g+rwX /opt/venv \
    && find /opt/venv -type d -exec chmod g+s {} +

# Server by default (distrobox/toolbx override the entrypoint → same image is both);
# `podman run IMAGE <cmd>` still wins over SERVICE inside the entrypoint.
ENTRYPOINT ["/opt/resources/resolve/droste-entrypoint.sh"]
