# comfyui.env -- ComfyUI configuration (this file IS the config surface).
#
# Most settings ship commented out; default values indicated in the  commented
# configuration example line and marked with "*" in the list. Uncomment a line
# to override it. The braced list holds supported values; the hidden values are
# those which are unusable, unstable, or unhelpful on this build.
#
# Droste defaults & ComfyUI defaults are not identical, as Droste defaults are
# tweaked for this build. Additionally, a setting of  "auto" means ComfyUI
# decides the value at runtime; this is diferent from a default value. As such,
# settings may resolve differently on other hardware or after image update.
#
# Mutually exclusive options share one variable so an illegal pair cannot be
# written. Descriptions follow "--help" at the pinned commit with additional
# notes for clarity when practical; they are not identical to documentation.
#
# Reserved by droste (do not set these)
# -------------------------------------
# Droste needs these arguments to remain unchanged for its setup & teardown of
# boxes; any additions or changes are likely to break the box boot, services,
# and/or functionality.
#
#   --extra-model-paths-config, --base-directory, --input-directory, 
#   --models-directory, --output-directory, --temp-directory, --user-directory


# Extra Arguments (options this file does not cover)
# --------------------------------------------------
# A "catch-all" setting for user-elected parameters. "Mix and match" with other
# settings may cause boot failure due to exclusions, so users should confirm
# that absernce of argument conflicts in advance.
#
# Entry should be one quoted value; unused arguments are listed at end of file.
#
# COMFYUI_DROSTE_EXTRA_ARGS="--deterministic --preview-size 512"


# VRAM & GPU Handling (where model weights are kept)
# --------------------------------------------------
# {gpu-only*, highvram, normal, lowvram, novram, cpu}
#
#   gpu-only    all models remain in VRAM, even when idle
#   highvram    models in VRAM for run; diffusion models VRAM even when idle
#   normal      most models in VRAM for run (text encoders are conditional)
#   lowvram     all text encoders in the CPU; other models on GPU for run
#   novram      minimal VRAM; typically small portions of models in memory
#   cpu         everything on the CPU; very slow.
#
# For the build target (Strix Halo), "gpu-only" yields the best performance;
# other options are included for debugging, development, and related.
#
# Covers:  --gpu-only, --highvram, --lowvram, --novram, --cpu
#
# COMFYUI_DROSTE_VRAM=gpu-only


# Dynamic VRAM (adaptive model loading)
# -------------------------------------
# {auto*, on, off}
#
# ComfyUI enables only on NVIDIA; "auto" & "off" are the same for "gpu-only",
# but "on" turns it on anyway. "off" uses estimate-based model loading instead.
#
# Covers: --enable-dynamic-vram, --disable-dynamic-vram
#
# COMFYUI_DROSTE_DYNAMIC_VRAM=auto


# VRAM Reserve (in GiB kept free for non-ComfyUI processes)
# ---------------------------------------------------------
# {GiB}
#
# Covers: --reserve-vram, --vram-headroom
#
# COMFYUI_DROSTE_RESERVE_VRAM=0.390625 # Linux's default (400 MiB); others vary


# Caching (node-results between runs)
# ---------------------------------------
# {ram*, ram:GiB, ram:GiB,GiB_2, lru:N, classic, high-ram**, none}
#
#   ram             Active threshold: 2 GiB / 10% / 10 GiB; Inactive: 100%
#   ram:GiB         "ram", but keep minimuim of GiB RAM free
#   ram:GiB,GiB_2   "ram:GiB", + after active weights, keep min. of GiB_2 free
#   lru:N           Keep the most recent N nodes in memory (approximately)
#   classic         Only cache current workflow
#   high-ram        classic, but no limits on models (may stay in memory)**
#   none            reload and execute every node on every run.
#
# **"high-ram" is it a variant of the "classic" memory model & is NOT related
# to the "ram" or "lru" options. Also, on Strix, system and VRAM are the same.
#
# Covers: --cache-ram, --cache-lru, --cache-classic, --high-ram,
#         --cache-none
#
# COMFYUI_DROSTE_CACHE=ram


# Weight Loading (when model weights are read)
# --------------------------------------------
# {eager*, lazy}
#
#   eager   read tensors into memory on load (longer load, faster execution)
#   lazy    read weights from the file as needed (short load, longer execution)
#
#   **NOTE: This has no effect while Dynamic VRAM is on.
#
# Covers: --disable-mmap (safetensors), --mmap-torch-files (.ckpt/.pt)
#
# COMFYUI_DROSTE_WEIGHT_LOADING=eager


# Model Residency (models between runs)
# -------------------------------------
# {evict, cache*}
#
#   evict   all models are unloaded when a run finishes
#   cache   models stay in memory, partial/full eviction when necessary
#
# Covers: --disable-smart-memory
#
# COMFYUI_DROSTE_MODEL_RESIDENCY=cache


# Attention (cross-attention implementation)
# ------------------------------------------
# {auto*, ck, pytorch, quad, split}
#
#   auto      ComfyUI decides from the platform and model
#   ck        Comfy Kitchen attention
#   pytorch   PyTorch 2.0 cross attention
#   quad      sub-quadratic cross attention
#   split     split cross attention
#
# Covers: --use-ck-attention, --use-pytorch-cross-attention,
#         --use-quad-cross-attention, --use-split-cross-attention
#
# COMFYUI_DROSTE_ATTENTION=auto


# Compute Precision (where possible)
# ----------------------------------
# {auto*, fp16, fp32}
#
# Determines the precision of computations, except in a few edge cases that
# require something else (such as with fp64 models). It can also influience
# how models are stored in memory, though model storage is large overridden
# by the model precision settings (see model precision below).
#
# Covers: --force-fp16, --force-fp32
#
# COMFYUI_DROSTE_COMPUTE_PRECISION=auto


# VAE Precision (weights in memory & computation)
# -----------------------------------------------
# {auto, bf16*, fp16**, fp32}
#
# **Warning: using fp16 precision may result in black images.
#
# Covers: --bf16-vae, --fp16-vae, --fp32-vae
#
# COMFYUI_DROSTE_VAE_PRECISION=bf16


# Diffusion Model Precision (in memory)
# -------------------------------------
# {auto*, bf16, fp8_e4m3fn, fp8_e5m2, fp8_e8m0fnu, fp16, fp32, fp64}
#
# Covers: --bf16-unet, --fp8_e4m3fn-unet, --fp8_e5m2-unet,
#         --fp8_e8m0fnu-unet, --fp16-unet, --fp32-unet, --fp64-unet
#
# COMFYUI_DROSTE_UNET_PRECISION=auto


# Text Encoder Precision (in memory)
# ----------------------------------
# {auto*, bf16, fp8_e4m3fn, fp8_e5m2, fp16, fp32}
#
# Covers: --bf16-text-enc, --fp8_e4m3fn-text-enc,
#         --fp8_e5m2-text-enc, --fp16-text-enc, --fp32-text-enc
#
# COMFYUI_DROSTE_TEXT_ENCODER_PRECISION=auto


# Attention Upcasting (cast to wider type)
# ----------------------------------------
# {auto*, on, off}
#
# Covers: --force-upcast-attention, --dont-upcast-attention
#
# COMFYUI_DROSTE_UPCAST=auto


# Sampler Previews (image shown while generating)
# -----------------------------------------------
# {taesd*, auto, latent2rgb, none}
#
#   taesd       small decoder, closest to the final image (baked into the image)
#   auto        identical to latent2rgb; ComfyUI never selects taesd here
#   latent2rgb  a colour approximation of the latent; very cheap
#   none        no preview at all
#
# Covers: --preview-method
#
# COMFYUI_DROSTE_PREVIEW=taesd


# Enable Custom Nodes (load user-installed nodes)
# -----------------------------------------------
# {yes*, no}
#
# Covers: --disable-all-custom-nodes
#
# COMFYUI_DROSTE_CUSTOM_NODES=yes


# ComfyUI-Manager UI
# ------------------
# {modern*, legacy, no_ui}
#
#   modern    Full integrated modern manager & services
#   legacy    Legacy UI & services
#   no_ui     Background services only (no UI)
#
# Covers: --enable-manager, --enable-manager-legacy-ui,
#         --disable-manager-ui
#
# COMFYUI_DROSTE_MANAGER=modern


# CUDA Malloc (actually the torch async allocator)
# ------------------------------------------------
# {auto*, on, off}
#
# **On Strix Halo, the "auto" setting acts as "off" at this time.
# Setting to "on" activates hipMallocAsync; otherwise, "native" is used.
#
# Covers: --cuda-malloc, --disable-cuda-malloc
#
# COMFYUI_DROSTE_CUDA_MALLOC=auto

 
# Additional Options (use with EXTRA_ARGS) - Tuning
# -------------------------------------------------
# UI & Data
#   --whitelist-custom-nodes, --disable-api-nodes --preview-size (default: 512)
#   --enable-assets, --enable-asset-hashing, --default-hashing-function,
#   --disable-metadata, --database-url
#
# Compute & Memory
#   --force-channels-last, --cpu-vae, --force-non-blocking (for non-NVIDIA),
#   --disable-pinned-memory, --fast-disk (prefer disk vs unpinned RAM),
#   --async-offload, --disable-async-offload (default: enabled),
#   --vram-headroom (default: 0), --disable-cuda-graphs,
#   --enable-triton-backend, --disable-triton-backend (Triton backend)
#
# Networking
#   --tls-keyfile, --tls-certfile, --enable-cors-header,--multi-user,
#   --enable-compress-response-body, --max-upload-size (default: 100MiB)


# Options for Debugging & Development
# -----------------------------------
# Diagnostic
#   --verbose, --log-stdout, --debug-hang, --deterministic, --fast (untested),
#   --dont-print-server, --feature-flag, --list-feature-flags,
#   --quick-test-for-ci
#
# Compute
#   --fp16-intermediates (experimental), --supports-fp8-compute (force fp8)


# Unused Arguments (inapplicable / unsupported in this build)
# -----------------------------------------------------------
# UI / OS
#   --windows-standalone-build --auto-launch, --disable-auto-launch (browser)
#
# VRAM / GPU
#   --disable-nvml-pressure (NVIDIA) --cuda-device, --default-device,
#   --directml, --oneapi-device-selector
#
# Attention
#   --use-flash-attention, --use-sage-attention, --disable-xformers (absent)
