# ── Status dashboard ─────────────────────────────────────────────────────────
box_lanes_disp() {  # box → server|distrobox|both from config or detection
  local box=$1
  if [[ -n "${CFG_LANE[$box]:-}" ]]; then
    printf '%s' "${CFG_LANE[$box]}"
  else
    printf '%s' "${EXD_LANE[$box]:-none}"
  fi
}
box_port_disp() {
  local box=$1
  printf '%s' "${CFG_PORT[$box]:-${EXD_PORT[$box]:--}}"
}
box_as() {
  local box=$1
  if [[ -n "${CFG_LANE[$box]:-}" ]]; then
    printf '%s' "${CFG_AS[$box]:-}"
  else
    printf '%s' "${EXD_AS[$box]:-}"
  fi
}

box_state() {  # box → ACTIVE|STOPPED|none|UNKNOWN
  local box=$1 state="" asked=0
  if [[ -n $RUNTIME ]]; then
    # Distinguish "asked, nothing there" from "could not ask": with no runtime, or
    # a query that errored, `none` would claim the box does not exist when the
    # truth is we have no way to tell. Only a successful query earns `none`.
    if state=$("$RUNTIME" ps -a --filter "name=^$(server_name "$box")\$" \
               --format '{{.State}}' 2>/dev/null | head -n1); then
      asked=1
    else
      state=""
    fi
  fi
  if [[ -z $state ]]; then
    if [[ -n "${SESSION_STATE[$box]:-}" ]]; then
      printf '%s' "${SESSION_STATE[$box]}"
    elif [[ -n "${EX_CTR[$box]:-}" ]]; then
      [[ ${EX_CTR[$box]} == running ]] && printf 'ACTIVE' || printf 'STOPPED'
    elif [[ -n "${EX_DBX[$box]:-}" ]]; then
      printf 'STOPPED'
    elif [[ $asked -eq 1 ]]; then
      printf 'none'
    else
      printf 'UNKNOWN'
    fi
  else
    [[ $state == running ]] && printf 'ACTIVE' || printf 'STOPPED'
  fi
}

# The table geometry, verified against Jei's hand-tuned mockup:
#
#   Service      On   Srv  Box  Auto  Port  Important Notes
#   col 0        <--- four glyphs, pitch 5 --->  32    38
#
# The four glyph cells are RIGHT-aligned to end at column 29, which is why the
# 2-cell emoji starts one column right of the 3-cell ASCII glyph. Only the Notes
# column is responsive; everything left of it is fixed so the columns line up
# between runs. The header labels sit at 16/21/26 with `On` pulled left onto the
# first glyph column — Jei's spacing, kept as drawn.
dashboard() {
  local box lane st stg g note data row port budget oncol gap tokl tokr ind gp
  budget=$(( $(term_width) - 38 ))
  oncol=$(( 14 - W_STATE ))     # first glyph column: 12 emoji, 11 ASCII
  gap=$(( 3 - W_STATE ))        # lead from the Service cell into that column
  tokl=$GB_L$C_GLYPH tokr=$C_TEXT$GB_R
  ind=$(( 12 - 5 - W_STATE - ${#GB_L} - ${#GB_R} ))   # "Value" → glyph, right-aligned
  gp=$(( 4 - W_STATE - ${#GB_L} - ${#GB_R} ))         # ASCII glyph is a cell narrower
  say ""
  hdr "Legend"
  printf '%sKey     [%s%s%s] Running?   [%s%s%s] Server   [%s%s%s] Distrobox     [%s%s%s] Auto-Start%s%s\n' \
    "$C_TEXT" "$C_SUBJ" "On" "$C_TEXT" "$C_SUBJ" "Srv" "$C_TEXT" \
    "$C_SUBJ" "Box" "$C_TEXT" "$C_SUBJ" "Auto" "$C_TEXT" "$LEG_PAD" "$RESET"
  printf '%sValue%*s%s%s%s yes%*s%s%s%s%*s no%*s%s%s%s%*s NA / unknown %s\n' \
    "$C_TEXT" "$ind" "" "$tokl" "$GS_YES" "$tokr" \
    9 "" "$tokl" "$GS_NO" "$tokr" "$gp" "" \
    8 "" "$tokl" "$GS_NA" "$tokr" "$gp" "" "$RESET"
  say ""
  # Underline the WORDS only — the column padding stays plain.
  printf '%s%s%s%s%s%s%s%s%s\n' \
    "$(pad_cell_u "Service" 7 "$oncol")" "$(pad_cell_u "On" 2 $(( 16 - oncol )))" \
    "$(pad_cell_u "Srv" 3 5)" "$(pad_cell_u "Box" 3 5)" \
    "$(pad_cell_u "Auto" 4 6)" "$(pad_cell_u "Port" 4 6)" \
    "$C_HDR" "Important Notes" "$RESET"
  for box in "${SELECTED[@]}"; do
    lane=$(box_lanes_disp "$box")
    st=$(box_state "$box")
    case "$st" in
      ACTIVE)  stg=$GS_YES ;;
      STOPPED) stg=$GS_NO ;;
      # `none` and UNKNOWN both render ⚫: "not there" and "could not ask" look
      # the same to the reader, and box_state keeps the distinction internally.
      *)       stg=$GS_NA ;;
    esac
    row=$C_SVC$(pad_cell "$box" ${#box} 11)$C_GLYPH
    row+=$(printf '%*s' "$gap" "")
    row+=$(pad_cell "$stg" "$W_STATE" 5)
    [[ $lane == server || $lane == both ]] && g=$GS_YES || g=$GS_NO
    row+=$(pad_cell "$g" "$W_STATE" 5)
    [[ $lane == distrobox || $lane == both ]] && g=$GS_YES || g=$GS_NO
    row+=$(pad_cell "$g" "$W_STATE" 5)
    [[ -n "$(box_as "$box")" ]] && g=$GS_YES || g=$GS_NO
    row+=$(pad_cell "$g" "$W_STATE" $(( W_STATE + 3 )))
    port=$(box_port_disp "$box")
    row+=$C_PORT$(pad_cell "$port" ${#port} 6)
    data="${PATHS["$box:data"]:-${EXD_PATH["$box:data"]:-}}"
    note=${BOX_NOTE[$box]//@DATA@/$(home_disp "${data:-~/droste/$box/data}")}
    [[ -n $note ]] && row+=$C_TEXT$(fit_note "$note" "$budget")
    printf '%s%s\n' "$row" "$RESET"
  done
  say ""
  hdr "Shortcuts"
  # Label in body text; the command is decorated executable / verb / target, with
  # the <box> you substitute picked out in blue.
  printf '%s%s%-20s%s%s%s%s%s%s%s%s%s%s%s\n' "$C_TEXT" "$BULLET" "Enter box:" \
    "$C_EXE" "distrobox " "$C_CMD" "enter " \
    "$C_TGT" "droste-" "$C_PH" "<box>" "$C_TGT" "-halo-box" "$RESET"
  printf '%s%s%-20s%s%s%s%s%s%s%s%s%s%s%s  (%s%s%s%s%s)\n' "$C_TEXT" "$BULLET" \
    "Start/stop server:" "$C_EXE" "podman " "$C_CMD" "start " \
    "$C_TGT" "droste-" "$C_PH" "<box>" "$C_TGT" "-halo-server" "$RESET" \
    "$C_SUBJ" "stop " "$C_SVC" "to stop" "$RESET"
  say ""
  # Same shape as the Shortcuts block above.
  printf '%s%s%s\n' "$C_SUB" "Recreate (files in $(home_disp "$EMIT_DIR"))" "$RESET"
  printf '%s%s%-12s%s%s%s%s%s%s%s%s%s%s%s\n' "$C_TEXT" "$BULLET" "server:" \
    "$C_EXE" "podman " "$C_CMD" "compose " \
    "$C_TGT" "-f " "$C_PH" "<box>" "$C_TGT" \
    "-halo-srv.cmp.yaml up -d" "$RESET"
  printf '%s%s%-12s%s%s%s%s%s%s%s%s%s%s%s\n' "$C_TEXT" "$BULLET" "distrobox:" \
    "$C_EXE" "distrobox " "$C_CMD" "assemble create " \
    "$C_TGT" "--file " "$C_PH" "<box>" "$C_TGT" "-halo-dbox.ini" "$RESET"
  say ""
  printf '%s%s%s\n' "$C_STAR" \
    "*ComfyUI models scanned at start; to add more run: hf download <shared cache>" "$RESET"
  printf '%s%s%s%s%s\n' "$C_ARROW" "$ARROW_G" "$C_TEXT" \
    "Definitions + full guide: $(home_disp "$EMIT_DIR") (compose.yaml, ini, NOTES.md)" \
    "$RESET"
  say ""
  return 0
}

# ── Main flow ────────────────────────────────────────────────────────────────
main() {
  init_input
  banner "Droste Installer for Halo Architectures"
  preflight

  section "Resource Path" intro
  sub "Re-creation (compose.yaml/distrobox ini), logs, & program data" intro
  # A typo here fans out into every emitted file — ask_path_as confirms before
  # creating (and re-asks if the user declines or the create fails).
  ask_path_as "Please Identify a path to use for droste resources" "$HOME/droste"
  EMIT_DIR=$ANS_PATH
  DEFAULT_ROOT=$EMIT_DIR

  detect_existing
  select_boxes
  resolve_actions

  if [[ ${#CONFIGURE[@]} -gt 0 || ${#KEEP[@]} -gt 0 ]]; then
    local i n box
    if [[ ${#CONFIGURE[@]} -gt 0 ]]; then
      shared_questions
      n=${#CONFIGURE[@]}
      for (( i = 0; i < n; i = i + 1 )); do
        box=${CONFIGURE[$i]}
        configure_box "$box" $(( n - i - 1 ))
      done
    fi
    # Kept boxes: reuse their recorded config so the ladder can pull/create/
    # start them (e.g. a prior "write only" run) without rewriting anything.
    for box in "${KEEP[@]}"; do hydrate_keep "$box"; done
    if [[ ${#CONFIGURE[@]} -eq 0 ]]; then
      say ""
      printf '%sAll selected boxes kept as-is — definitions unchanged.%s\n' "$C_TEXT" "$RESET"
      printf '%sYou can still pull images / create / start them below.%s\n' "$C_TEXT" "$RESET"
    fi
    ask_ladder
    execute
    write_notes
    # (The per-box "To enter, run:" lines lived here; they duplicated the
    # Shortcuts block in the dashboard below, so they were dropped.)
  else
    say ""
    printf '%sNo boxes selected.%s\n' "$C_TEXT" "$RESET"
  fi

  dashboard
  return 0
}

main
