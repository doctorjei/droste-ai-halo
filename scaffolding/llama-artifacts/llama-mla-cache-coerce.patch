+        LLAMA_LOG_WARN("%s: model has no separate V cache (V is a view of K) - coercing V cache type %s to match K (%s)\n", __func__, ggml_type_name(params.type_v), ggml_type_name(params.type_k));
+        params.type_v = params.type_k;
