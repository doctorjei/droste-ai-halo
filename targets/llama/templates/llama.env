# LLAMA_ARG_RPC=  # --rpc


# Misc
# ----
# TURBO_FLASH=   # no effect on this build
# TURBO_FORCE_NONVEC=   # no effect on this build
# TURBO_FORCE_4MAG=   # no effect on this build
# TURBO_SPARSE_V=   # no effect on this build
# TURBO_PROFILE_MODE=   # no effect on this build


# Reachable only through LLAMA_EXTRA_ARGS
# ----------------------------------------
# Every option below is real, is accepted by this build, and has no setting
# of its own anywhere above -- so the catch-all at the top of this file is how
# you reach it. They are listed here as FLAG NAMES, the way you would type them
# on a command line:
#
#   LLAMA_EXTRA_ARGS="--cpu-strict --prio 2"
#
# **These are not settings and there is nothing to uncomment. A bare flag name
# is not an assignment, and this file is read as shell -- putting one on a line
# of its own stops the server from starting. Copy the name into the quoted
# LLAMA_EXTRA_ARGS value instead.
#
# Options left out of this list are not missing: they are the ones already
# named in NOT USEFUL HERE above (exit immediately, removed upstream, or need
# a vocoder), the ones Droste reserves, and the deprecated --webui* spellings
# of the --ui* settings.
#
#   CPU threads & affinity
#   ----------------------
#     -C / --cpu-mask
#     -Cb / --cpu-mask-batch
#     -Cr / --cpu-range
