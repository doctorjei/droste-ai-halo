# llama.env -- llama-server configuration (this file IS the config surface).
#
# Most settings ship commented out; values shown are defaults. Uncomment to
# override, & quote any value containing spaces. LLAMA_ARG_*  variables are
# native to llama; DROSTE_LLAMA ones are Droste specific & processed. The
# descriptions follow "--help" at the pinned commit with notes for clarity
# where practical; they are not identical to upstream documentation.
#
# **IMPORTANT: Command-line flags override environment variable counterparts
# silently. As such, a flag in LLAMA_EXTRA_ARGS takes precedence.
#
# Reserved by Droste (do not set these)
# -------------------------------------
# Droste needs these arguments to remain unchanged for setup & teardown;
# changes are likely to break the box boot, services, and/or functionality.
#
# LLAMA_ARG_HOST={address}, --host, --port --slot-save-path
# --api-prefix?
#
#
# Extra Arguments (options this file does not cover)
# --------------------------------------------------
# "Catch-all" setting for user-elected parameters. "Mix and match" with other
# settings may cause boot failure due to exclusions, so users should confirm
# absence of argument conflicts in advance. Entry should be one quoted value.
# Additional arguments reachable only through this settings are listed toward
# the end of this file.
#
# LLAMA_EXTRA_ARGS="-hf org/repo:Q4_K_M --jinja --temp 0.7"   # example only


# ================
#  MAIN SETTINGS
# ================

# Caches / Repositories (HuggingFace)
#------------------------------------------
# {<repository>}
# LLAMA_ARG_HF_REPO=               # -hf, -hfr, --hf-repo (regular repo)
# LLAMA_ARG_HF_REPO_V=             # -hfv, -hfrv, --hf-repo-v (vocoder repo)
# LLAMA_ARG_SPEC_DRAFT_HF_REPO=    # --spec-draft-hf / -hfd / -hfrd / --hf-repo-draft (speculative decoding repo)
#
#
# {<token_source>}
# HF_TOKEN=                        # -hft / --hf-token (default: none)
# DROSTE_LLAMA_HF_TOKEN_FILE=      # default: none


# Automatic Model Download & Startup (convenience flags)
#-------------------------------------------------------
# Automatically downloads, configures, and loads the model arrangement.

# { none*,       embd-gemma,       fim-qwen-1.5b,     fim-qwen-3b,
#   fim-qwen-7b, fim-qwen-7b-spec, fim-qwen-14b-spec, fim-qwen-30b,
#   gpt-oss-20b, gpt-oss-120b,     vision-gemma-4b,   vision-gemma-12b }
#  
#   Covers:
#     --embd-gemma-default, --fim-qwen-1.5b-default, --fim-qwen-3b-default,
#     --fim-qwen-7b-default, --fim-qwen-7b-spec, --fim-qwen-14b-spec,
#     --fim-qwen-30b-default, --gpt-oss-20b-default, --gpt-oss-120b-default,
#     --vision-gemma-4b-default, --vision-gemma-12b-default
#
# DROSTE_LLAMA_AUTO_MODEL=none    # Anything except "none" overrides settings


# Set Model
#----------
# If LLAMA_ARG_MDOEL is not set, the server will search for local repositories
# in router mode & offer the first it finds (e.g., from a HuggingFace cache).
# In router mode, the server loads models from cache on-demand as requested.
# To load a specific model, pin it with LLAMA_ARM_MDOEL; you can also point the
# model directory at a collection to offer alongside the cache.
#
# {<model file or URL>}
# LLAMA_ARG_MODEL=        # m / --model       (model file)
# LLAMA_ARG_MODEL_URL=    # -mu / --model-url (model URL)
# LLAMA_ARG_HF_FILE=      # -hff / --hf-file  (HF model file reference)


# Access & Authentication (key(s) and/or file with key(s))
# --------------------------------------------------------
# LLAMA_API_KEY=             # --api-key; comma-separated list (default: none)
# LLAMA_ARG_API_KEY_FILE=    # --api-key-file; one key per line (default: none)
#
# LLAMA_ARG_SSL_CERT_FILE=   # --ssl-cert-file (default: none)
# LLAMA_ARG_SSL_KEY_FILE=    # --ssl-key-file (default: none)


# Context & KV Cache
# ------------------
# {<size>}
# LLAMA_ARG_CTX_SIZE=0             # -c, --ctx-size; 0 = loaded from model
#
# {f32, f16, q8_0, q5_1, q5_0, q4_1, q4_0, turbo2, turbo3*, turbo4}
# LLAMA_ARG_CACHE_TYPE_K=turbo3    # -ctk, --cache-type-k
# LLAMA_ARG_CACHE_TYPE_V=turbo3    # -ctv, --cache-type-v
#
# LLAMA_ARG_N_PREDICT=-1   # -n, --predict, --n-predict (-1: until model stops)


# GPU Setup
# ---------
# {<number>}
# LLAMA_ARG_DEVICE=                # -dev, --device (runtime)
# LLAMA_ARG_MAIN_GPU=0             # -mg, --main-gpu (first GPU)
# LLAMA_ARG_N_GPU_LAYERS=-1        # -ngl, --gpu-layers, --n-gpu-layers (runtime)
# LLAMA_ARG_N_GPU_LAYERS_DRAFT=-1  # -ngld, --gpu-layers-draft, --n-gpu-layers-draft, --spec-draft-ngl (runtime)
# LLAMA_ARG_TENSOR_SPLIT=          # -ts / --tensor-split (runtime)
#
# {none, layer*, row, tensor}
# LLAMA_ARG_SPLIT_MODE=layer    # -sm / --split-mode


# ================
#  FINE TUNING
# ================

# Server Path
# -----------
# {<path>}
# LLAMA_ARG_STATIC_PATH=    # --path (default: path of UI built into server)


# Multi-Model Serving
# -------------------
# {<various>}
# LLAMA_ARG_DOCKER_REPO=             # -dr, --docker-repo (default: unused)
# LLAMA_ARG_HF_FILE_V=               # -hffv, --hf-file-v (vocoder file; default: unused)
# LLAMA_ARG_MODELS_DIR=              # --models-dir (default: disabled)
# LLAMA_ARG_MODELS_MAX=4             # --models-max (0 = unlimited)
# LLAMA_ARG_MODELS_PRESET=           # --models-preset (default: disabled)
# LLAMA_ARG_TAGS=                    # --tags (default: none)
# DROSTE_LLAMA_MODELS_AUTOLOAD=on    # --models-autoload


# Web UI, tools & MCP
# -------------------
# LLAMA_ARG_UI_CONFIG=             # --ui-config, --webui-config (def: Std.)
# LLAMA_ARG_UI_CONFIG_FILE=        # -ui-config-file, --webui-config-file
# LLAMA_ARG_TOOLS=                 # --tools (experimental; default: no tools)
# DROSTE_LLAMA_UI=on               # --ui / --webui
# DROSTE_LLAMA_UI_MCP_PROXY=off    # --ui-mcp-proxy, --webui-mcp-proxy


# Speculative Decoding (draft model)
# ----------------------------------
# {on*, off}
# DROSTE_LLAMA_BUILTIN_SPEC_DEFAULT=on    # --spec-default
#
# {<number>}
# LLAMA_ARG_SPEC_DRAFT_N_MAX=3       # --spec-draft-n-max
# LLAMA_ARG_SPEC_DRAFT_N_MIN=0       # --spec-draft-n-min
# LLAMA_ARG_SPEC_DRAFT_P_MIN=0.0     # --spec-draft-p-min, --draft-p-min
# LLAMA_ARG_SPEC_DRAFT_P_SPLIT=0.1   # --spec-draft-p-split, --draft-p-split
#
# {<model>}, {<spec type>}
# LLAMA_ARG_SPEC_DRAFT_MODEL=        # --spec-draft-model, -md, --model-draft
# LLAMA_ARG_SPEC_TYPE=               # --spec-type (default: from draft model)
#
# {f32, f16*, q8_0, q5_1, q5_0, q4_1, q4_0,  turbo2, turbo3, turbo4}
# LLAMA_ARG_SPEC_DRAFT_CACHE_TYPE_K=f16 # --spec-draft-type-k, -ctkd, --cache-type-k-draft
# LLAMA_ARG_SPEC_DRAFT_CACHE_TYPE_V=f16 # --spec-draft-type-v, -ctvd, --cache-type-v-draft
#
# {on, off*}
# DROSTE_LLAMA_SPEC_DRAFT_CPU_MOE=off   # --spec-draft-cpu-moe, -cmoed, --cpu-moe-draft


# Attention & Context Reuse
# -------------------------
# {auto*, on, off}
# LLAMA_ARG_FLASH_ATTN=auto          # -fa, --flash-attn
#
# {<size>}
# LLAMA_ARG_CHECKPOINT_MIN_SPACING_NT=256 # -cms, --checkpoint-min-step (0:unlimited)
