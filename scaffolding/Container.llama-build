# droste-llama-build: builds llama.cpp (TheTom/llama-cpp-turboquant) against pinned SDK

# Overrideable Arguments - General Build (override with '--build-arg <ARG_NAME>=<VALUE>'
ARG SERIES_NAME=droste
ARG ARCH_NAME=halo
ARG TARGET_NAME=llama-build
ARG BUILDER_DESC="builder image for llama.cpp (turboquant)"
ARG DESCRIPTION="compiled outputs for llama image"

# Image Names
ARG BASE_IMAGE=localhost/${SERIES_NAME}-build-base-${ARCH_NAME}

# Build image
FROM ${BASE_IMAGE} AS builder
ARG SERIES_NAME TARGET_NAME ARCH_NAME BUILDER_DESC
LABEL description="${SERIES_NAME}-${TARGET_NAME}-${ARCH_NAME}: ${BUILDER_DESC}"

# ROCm Pin: inherited from the build base as /etc/droste/rocm-version.env; the HIP
# build RUN below sources it for GFX_TARGET (no ARG, no --build-arg).

# llama pin
ARG LLAMA_REPO=https://github.com/TheTom/llama-cpp-turboquant.git
ARG LLAMA_REF=337f08e82a861194fd5fc93121205c7c6bc81ddf

# Re-add if needed
COPY llama-grammar.patch /tmp/
COPY llama-api-prefix-auth.patch /tmp/

# Fetch the pinned commit by sha, then materialize submodules.
# NOT a clone: `git clone --single-branch` retrieves only the fork's default
# branch, so when upstream rewrote that branch (2026-08-08) the pinned LLAMA_REF
# stopped being reachable and the build died with "unable to read tree".
# GitHub still serves the object by sha, so fetching it directly keeps the pin
# exact and is immune to any future branch rewrite.
WORKDIR /opt/llama.cpp
RUN git init -q . \
    && git remote add origin "${LLAMA_REPO}" \
    && if [ -n "${LLAMA_REF}" ]; then \
         git fetch --depth 1 origin "${LLAMA_REF}"; \
       else \
         git fetch --depth 1 origin HEAD; \
       fi \
    && git checkout -q FETCH_HEAD \
    && git submodule update --init --recursive

# ── The grammar repetition-threshold raise ───────────────────────────────────
#
# WHAT IT FIXES: src/llama-grammar.cpp caps grammar repetition expansion at a
# compile-time MAX_REPETITION_THRESHOLD of 2000, and both gates that read it
# THROW. At 2000 that rejects the GBNF json-schema-to-grammar emits for any
# realistic OpenAI-style tool list -- a single 47-parameter tool already expands
# to ~500 rules. The failure lands at REQUEST time, not at startup: the image
# builds, the server starts, /health answers 200, our healthcheck is green, and
# every tool-calling request comes back "failed to parse grammar". Full
# rationale and the measured facts live in llama-grammar.patch.
#
# 🚨 PERMANENT, NOT A STOPGAP. This was never filed with llama.cpp at all --
# kyuz0/amd-strix-halo-toolboxes#70 asked a THIRD-PARTY IMAGE PROJECT to raise
# the constant, and its `completed` status means he rebuilt his images, not that
# upstream changed anything. ggml-org master and this fork's own default branch
# both still say 2000 (verified 2026-09-01), the two upstream PRs that would make
# the constant configurable are open and unmerged, and we are not pursuing it.
# NOBODY IS WATCHING FOR THIS TO BECOME UNNECESSARY, so the guard below is the
# ONLY thing that will ever tell us the patch stopped applying.
#
# 🚨 WHY A GUARD AND NOT A BARE `patch`, cf. the api-prefix guard below. This
# region has ALREADY drifted on the fork's own default branch -- the second gate
# is one `if` at our pin and two on its current head -- and the branch itself has
# been rewritten once (see the fetch note above). Default fuzz would let the hunk
# land somewhere plausible, and a rename of the macro would let it apply and mean
# nothing. Every one of those failure modes looks identical from outside: the
# image builds, the server starts, and tool calling is still broken. So: exact
# WHOLE-LINE counts before AND after, `-F0` so patch may not improvise, and a
# refusal to patch twice.
#
# ⚠️ ONE COUNT IS A FLOOR, DELIBERATELY. How many LINES use the macro is a
# refactoring detail (2 at our pin, 3 on the fork's head), so pinning it exactly
# would go red on a bump that changes nothing this patch depends on. What is
# load-bearing is that the macro is read AT ALL -- a constant nobody reads is the
# silent no-op this guard exists to catch. Every other count here is exact and IS
# the contract; if one of those moves, re-derive rather than adjust it.
RUN set -e; \
    f=src/llama-grammar.cpp; \
    die() { echo "llama-grammar: FATAL: $*" >&2; \
            echo "llama-grammar: the pinned source no longer matches what this patch assumes." >&2; \
            echo "llama-grammar: READ ${f} at the CURRENT LLAMA_REF before touching anything." >&2; \
            echo "llama-grammar: Either upstream raised, removed or renamed the threshold (delete" >&2; \
            echo "llama-grammar: the patch and this guard), or the fork moved and the hunk must be" >&2; \
            echo "llama-grammar: RE-DERIVED at the new sha, with the counts here updated to match" >&2; \
            echo "llama-grammar: what you actually found in the new source." >&2; \
            echo "llama-grammar: Do NOT drop -F0 or raise the fuzz to make this pass. A hunk that" >&2; \
            echo "llama-grammar: lands with fuzz can raise a constant nothing reads, and THAT failure" >&2; \
            echo "llama-grammar: is invisible: the image builds, the server starts, /health answers" >&2; \
            echo "llama-grammar: 200, and every tool-calling request still fails to parse its grammar." >&2; \
            exit 1; }; \
    nx() { grep -Fxc -- "$1" "$f" || true; }; \
    ns() { grep -Fc  -- "$1" "$f" || true; }; \
    [ -f "$f" ] \
      || die "$f does not exist at this LLAMA_REF -- the grammar parser has moved or been renamed"; \
    [ "$(nx '#define MAX_REPETITION_THRESHOLD 100000')" = 0 ] \
      || die "$f already carries the RAISED threshold -- refusing to patch twice"; \
    [ "$(nx '#define MAX_REPETITION_THRESHOLD 2000')" = 1 ] \
      || die "expected exactly 1 stock threshold definition (2000) in $f"; \
    [ "$(ns 'MAX_REPETITION_THRESHOLD')" -ge 2 ] \
      || die "the threshold is DEFINED but never READ in $f -- raising it would be a silent no-op"; \
    patch -p1 -F0 < /tmp/llama-grammar.patch \
      || die "the hunk did not apply at fuzz 0 -- see the .rej above for what drifted"; \
    [ "$(nx '#define MAX_REPETITION_THRESHOLD 2000')" = 0 ] \
      || die "the stock 2000 definition SURVIVED the patch"; \
    [ "$(nx '#define MAX_REPETITION_THRESHOLD 100000')" = 1 ] \
      || die "expected exactly 1 raised threshold definition after applying"; \
    echo "llama-grammar: applied; MAX_REPETITION_THRESHOLD raised 2000 -> 100000"

# ── The --api-prefix x --api-key auth fix (upstream #22474) ──────────────────
#
# WHAT IT FIXES: llama-server exempts /health, /v1/health, /models, /v1/models, /
# and every embedded UI asset from --api-key, but builds that exempt set from BARE
# literals while registering the routes at `path_prefix + path`. The check is an
# exact match on the raw wire path in a PRE-ROUTING handler, so with --api-prefix
# set every one of them 401s: our healthcheck reads that as unhealthy, podman
# restarts the container, and the box restart-loops out of every interactive shell.
# The user's Web UI is dead in the same stroke. Full rationale, the measured facts
# and the hunks live in llama-api-prefix-auth.patch.
#
# 🚨 PERMANENT, NOT A STOPGAP. Upstream #22474 was closed `not_planned` by a stale
# bot with no maintainer response and is still present on master; we are not
# pursuing it. NOBODY IS WATCHING FOR THIS TO BECOME UNNECESSARY, so the guard
# below is the ONLY thing that will ever tell us the patch stopped applying.
#
# 🚨 WHY A GUARD AND NOT A BARE `patch`, cf. patch-jupyter-no-config.sh. This fork's
# branch has already been rewritten once (see the fetch note above). A rebase that
# reflows this region would let `patch` land it with fuzz somewhere plausible, or a
# rename would let it become a silent no-op — and every failure mode here is "the
# image builds, the server starts, and auth is wrong". So: exact WHOLE-LINE counts
# before AND after, `-F0` so patch may not improvise, and a refusal to patch twice.
# The counts are the contract; if one moves, re-derive rather than adjust it.
RUN set -e; \
    f=tools/server/server-http.cpp; \
    die() { echo "llama-api-prefix-auth: FATAL: $*" >&2; \
            echo "llama-api-prefix-auth: the pinned source no longer matches what this patch assumes." >&2; \
            echo "llama-api-prefix-auth: READ ${f} at the CURRENT LLAMA_REF before touching anything." >&2; \
            echo "llama-api-prefix-auth: Either upstream fixed this (delete the patch and this guard), or" >&2; \
            echo "llama-api-prefix-auth: the fork moved and the hunks must be RE-DERIVED at the new sha," >&2; \
            echo "llama-api-prefix-auth: with the counts in this guard updated to match what you found." >&2; \
            echo "llama-api-prefix-auth: Do NOT copy ggml-org master's list -- master has dropped /models," >&2; \
            echo "llama-api-prefix-auth: /v1/models and / from the exempt set, which would silently change" >&2; \
            echo "llama-api-prefix-auth: WHICH endpoints are public on our pin." >&2; \
            exit 1; }; \
    nx() { grep -Fxc -- "$1" "$f" || true; }; \
    ns() { grep -Fc  -- "$1" "$f" || true; }; \
    [ "$(nx '    const std::unordered_set<std::string> get_public_endpoints = [this]() {')" = 0 ] \
      || die "$f already carries the PATCHED declaration -- refusing to patch twice"; \
    [ "$(nx '    static const std::unordered_set<std::string> get_public_endpoints = []() {')" = 1 ] \
      || die "expected exactly 1 bare-literal public-endpoint declaration in $f"; \
    [ "$(nx '            endpoints.insert("/" + a.name);')" = 1 ] \
      || die "expected exactly 1 unprefixed UI-asset insert in $f"; \
    [ "$(nx '    auto middleware_validate_api_key = [api_keys = params.api_keys](const httplib::Request & req, httplib::Response & res) {')" = 1 ] \
      || die "expected exactly 1 api-key middleware declaration in $f"; \
    [ "$(nx '    path_prefix = params.api_prefix;')" = 1 ] \
      || die "path_prefix is no longer assigned from params.api_prefix -- the patch would prefix with the wrong value"; \
    [ "$(ns 'path_prefix + path')" = 2 ] \
      || die "routes are no longer registered as path_prefix + path (expected 2 sites: ::get and ::post)"; \
    [ "$(ns 'path_prefix + "/')" = 0 ] \
      || die "$f already prefixes public endpoints -- upstream may have fixed this; read the source and consider dropping the patch"; \
    patch -p1 -F0 < /tmp/llama-api-prefix-auth.patch \
      || die "the hunks did not apply at fuzz 0 -- see the .rej above; re-derive them at the new sha rather than relaxing -F0, since a fuzzed hunk can put the api-key exemption somewhere plausible and WRONG"; \
    [ "$(nx '    static const std::unordered_set<std::string> get_public_endpoints = []() {')" = 0 ] \
      || die "the bare-literal declaration SURVIVED the patch"; \
    [ "$(nx '            endpoints.insert("/" + a.name);')" = 0 ] \
      || die "the unprefixed UI-asset insert SURVIVED the patch"; \
    [ "$(nx '    const std::unordered_set<std::string> get_public_endpoints = [this]() {')" = 1 ] \
      || die "expected exactly 1 patched declaration after applying"; \
    [ "$(nx '    auto middleware_validate_api_key = [api_keys = params.api_keys, get_public_endpoints](const httplib::Request & req, httplib::Response & res) {')" = 1 ] \
      || die "the middleware does not capture the endpoint set BY VALUE after applying -- it would reference a dangling local"; \
    [ "$(ns 'path_prefix + "/')" = 6 ] \
      || die "expected exactly 6 prefixed public paths after applying (5 API routes + the UI asset loop)"; \
    echo "llama-api-prefix-auth: applied; 6 public paths now built from path_prefix"

# Node toolchain for the embedded Web UI. Builder stage only -- the runtime image
# COPYs /artifacts and never sees it. Trixie ships node 20.19 / npm 9.2, which is
# what tools/ui's pins want (vite 7 needs ^20.19 || >=22.12).
RUN apt-get -qq update && apt-get -qq install -y --no-install-recommends \
      nodejs npm \
    && rm -rf /var/lib/apt/lists/* && apt-get clean

# HIP build
#
# LLAMA_USE_PREBUILT_UI=OFF is load-bearing, not tidying. scripts/ui-assets.cmake
# provisions the Web UI from the first of three sources that works: a pre-built
# tools/ui/dist, an npm build, then a download from the ggml-org llama-ui HF bucket.
# With no npm in the image the first two were unavailable, so it silently took the
# third -- and because the version-tagged bucket path 404s, its fallback fetched
# `latest`. That ships a UI built from a DIFFERENT llama.cpp revision than LLAMA_REF,
# which llama-ui-embed (compiled from the pinned source) then rejects:
# "missing required asset(s): loading.html". Green on 2026-07-17 and red on 08-09
# with identical sources, because `latest` moved and we did not.
#
# So: install npm above to build the UI from the pinned tree, and turn the bucket
# off so an unpinned `latest` can never be substituted again. If the UI build ever
# breaks, this now fails loudly instead of shipping a mismatched UI.
RUN . /etc/droste/rocm-version.env \
    && cmake -S . -B build \
       -DGGML_HIP=ON \
       -DAMDGPU_TARGETS=${GFX_TARGET} \
       -DCMAKE_BUILD_TYPE=Release \
       -DGGML_RPC=ON \
       -DLLAMA_HIP_UMA=ON \
       -DGGML_CUDA_ENABLE_UNIFIED_MEMORY=ON \
       -DLLAMA_BUILD_UI=ON \
       -DLLAMA_USE_PREBUILT_UI=OFF \
       -DROCM_PATH=/opt/rocm \
       -DHIP_PATH=/opt/rocm \
       -DHIP_PLATFORM=amd \
    && cmake --build build --config Release -- -j"$(nproc)"

# Collect llama.cpp's outputs
RUN mkdir -p /artifacts/bin /artifacts/lib64 /artifacts/share \
    && cp -a build/bin/. /artifacts/bin/ \
    && find build -type f -name 'lib*.so*' -exec cp -a {} /artifacts/lib64/ \;

# VRAM helper
COPY gguf-vram-estimator.py /artifacts/share/gguf-vram-estimator.py
RUN chmod +x /artifacts/share/gguf-vram-estimator.py

FROM scratch
ARG SERIES_NAME TARGET_NAME ARCH_NAME DESCRIPTION
LABEL description="${SERIES_NAME}-${TARGET_NAME}-${ARCH_NAME}: ${DESCRIPTION}"
COPY --from=builder /artifacts /artifacts
