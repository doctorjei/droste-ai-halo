# droste-comfyui-halo: ComfyUI server on the unified ROCm base
# Ported from https://github.com/kyuz0/amd-strix-halo-comfyui-toolboxes

# Overrideable Arguments - General Build (override with '--build-arg <ARG_NAME>=<VALUE>'
ARG SERIES_NAME=droste
ARG ARCH_NAME=halo
ARG TARGET_NAME=comfyui
ARG DESCRIPTION="ComfyUI (server, Triton JIT)"
ARG BASE_IMAGE=localhost/${SERIES_NAME}-torch-base-${ARCH_NAME}

# Overrideable Arguemnts - non-ROCm pins. The ROCm/torch versions are NOT ARGs: they
# come from /etc/droste/rocm-version.env, inherited from the torch base.
# ⚠️ TRANSFORMERS: a ComfyUI NODE requires >=4.57.0,<=5.8.1 (Jei, 2026-08-22), which
# EXCLUDES the 4.56.2 this was pinned to. Pinned to the range FLOOR deliberately:
# 4.56.2 is the version verified with 0.33.3 on gfx1151, nothing in the 5.x range has
# been tested here, and the upper bound reads as a safety ceiling rather than a
# preference for newest. The RANGE (not this exact number) is what gets appended to
# the constraints file below, so a later in-box install may move within it.
# ⚠️ finetuning has its OWN unpinned transformers and is deliberately NOT changed —
# this bound comes from a comfyui node.
ARG TRANSFORMERS_VERSION=4.57.0
ARG TRANSFORMERS_BOUND=">=4.57.0,<=5.8.1"
ARG ACCELERATE_VERSION=1.14.0

## ComfyUI & Custom Nodes (ComfyUI repinned 2026-08-22; nodes still 2026-07-05)
#### COMFYUI_REF: comfyanonymous/ComfyUI        ESSENTIALS_REF: cubiq/ComfyUI_essentials
#### GGUF_REF: city96/ComfyUI-GGUF              AMDGPUMONITOR_REF: kyuz0/ComfyUI-AMDGPUMonitor
# COMFYUI_REF is the commit tagged v0.33.3 (was 985fb9d6 = v0.27.0). Upstream moved to
# Comfy-Org/ComfyUI; the comfyanonymous URL below still redirects, so it is left alone.
# ⚠️ gfx1151 NOTE: 0.33 keeps gfx1151 in the enable-pytorch-attention list unchanged, but
# probes aotriton differently — a runtime can_use_flash_attention() call instead of listing
# torch/lib/aotriton.images. Both are inside try/except, so a miss degrades to non-flash
# attention rather than failing; it can still FLIP our attention backend. Check the
# "AMD arch:" / attention lines at startup after any bump.
# ⚠️ NEVER install comfy-kitchen[cublas] — nvidia-cublas is CUDA-only and useless here
# (rocBLAS/hipBLASLt come from rocm-sdk-libraries-gfx1151). requirements.txt asks for the
# plain package, which is why the extra stays uninstalled.
ARG COMFYUI_REF=4da9e2dbead52fc1e68beae33fe3d7ad63b63241
ARG ESSENTIALS_REF=9d9f4bedfc9f0321c19faf71855e228c93bd0dc9
ARG AMDGPUMONITOR_REF=0c584ed28ed3678d96f631a6eff91be397c0baa4
ARG GGUF_REF=6ea2651e7df66d7585f6ffee804b20e92fb38b8a
# ComfyUI-Manager. ⚠️ PIN BY COMMIT, NOT BY TAG: the repo's git tags (4.2.x) are NOT
# the node's version — main declares `version = "3.41"` in pyproject.toml and reports
# V3.41 at load. Canonical repo is Comfy-Org/ComfyUI-Manager (ltdrdata redirects).
ARG MANAGER_REF=f39cbd56fecae0b27a446c0cd450cd591f3a8bea

# --- IMAGE BUILD BEGINS HERE ---
FROM ${BASE_IMAGE}
ARG SERIES_NAME TARGET_NAME ARCH_NAME DESCRIPTION
ARG TRANSFORMERS_VERSION
ARG COMFYUI_REF ESSENTIALS_REF AMDGPUMONITOR_REF GGUF_REF MANAGER_REF
ARG TRANSFORMERS_BOUND ACCELERATE_VERSION
LABEL description="${SERIES_NAME}-${TARGET_NAME}-${ARCH_NAME}: ${DESCRIPTION}"

## Dependencies: General / Media & Triton JIT (required at runtime)
# NB the torch base now ships `gcc` + `python3.13-dev` of its own (triton's GPU-init-time
# hip_utils compile — see base/Container.torch), so `gcc`/`python3-dev` here are partly a
# duplicate of the base. Kept verbatim on purpose: this port needs the FULL toolchain
# (g++/make/binutils) for ComfyUI's runtime Triton JIT, apt is a no-op on what is already
# installed, and this list is the self-contained statement of what comfyui requires.
RUN apt-get -qq update && apt-get -qq install -y --no-install-recommends \
            ffmpeg dialog git curl rsync libdrm2 pkg-config python3-pip \
            gcc g++ make binutils python3-dev && \
    rm -rf /var/lib/apt/lists/* && apt-get clean

## PIP: Torch Stack, GGUF, & Transformers (pinned if set)
RUN . /etc/droste/rocm-version.env && \
    pip install --pre --index-url ${ROCM_INDEX_URL} \
       "torchvision${TORCHVISION_VERSION:+==${TORCHVISION_VERSION}}" \
       "torchaudio${TORCHAUDIO_VERSION:+==${TORCHAUDIO_VERSION}}" && \
    pip install gguf "transformers==${TRANSFORMERS_VERSION}" \
       "accelerate==${ACCELERATE_VERSION}" && \
    printf 'transformers%s\n' "${TRANSFORMERS_BOUND}" >> /etc/droste/rocm-constraints.txt && \
    /opt/resources/resolve/assert-rocm-pins.sh torch torchvision torchaudio
# ^ accelerate DECLARES a torch dependency, which is exactly why the constraints file
# exists: it was harmless here only because torch was already satisfied. The
# transformers BOUND (not the exact pin) is appended to the shared constraints file so
# the node's requirement is enforced against later in-box installs too, by pip AND uv.

# ComfyUI (core)
RUN git clone --depth=1 https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
    && if [ -n "${COMFYUI_REF}" ]; then \
         git -C /opt/ComfyUI fetch --depth=1 origin "${COMFYUI_REF}" \
         && git -C /opt/ComfyUI checkout "${COMFYUI_REF}"; \
       fi \
    && git config --system --add safe.directory /opt/ComfyUI
# ^ The repo stays ROOT-owned on purpose (writes belong in the overlay uppers), but
# the service runs as the box user via setpriv — so git's dubious-ownership guard
# refuses every command against it. Observed on Loaf 2026-08-22: ComfyUI-Manager
# reported "ComfyUI Revision: UNKNOWN (The currently installed ComfyUI is not a Git
# repository)" and lost the version it uses for node-compatibility checks. --system
# (i.e. /etc/gitconfig) rather than --global: the box user's HOME varies by lane.
# Safe here in the sense the guard intends — the path is baked by us, not shared.
WORKDIR /opt/ComfyUI
RUN pip install -r requirements.txt \
    && pip install --prefer-binary \
       pillow opencv-python-headless imageio imageio-ffmpeg scipy \
       "huggingface_hub[hf_transfer]" pyyaml websocket-client

# ComfyUI Custom Nodes
WORKDIR /opt/ComfyUI/custom_nodes
RUN git clone --depth=1 https://github.com/cubiq/ComfyUI_essentials /opt/ComfyUI/custom_nodes/ComfyUI_essentials \
    && if [ -n "${ESSENTIALS_REF}" ]; then \
         git -C /opt/ComfyUI/custom_nodes/ComfyUI_essentials fetch --depth=1 origin "${ESSENTIALS_REF}" \
         && git -C /opt/ComfyUI/custom_nodes/ComfyUI_essentials checkout "${ESSENTIALS_REF}"; \
       fi
RUN git clone --depth=1 https://github.com/kyuz0/ComfyUI-AMDGPUMonitor /opt/ComfyUI/custom_nodes/ComfyUI-AMDGPUMonitor \
    && if [ -n "${AMDGPUMONITOR_REF}" ]; then \
         git -C /opt/ComfyUI/custom_nodes/ComfyUI-AMDGPUMonitor fetch --depth=1 origin "${AMDGPUMONITOR_REF}" \
         && git -C /opt/ComfyUI/custom_nodes/ComfyUI-AMDGPUMonitor checkout "${AMDGPUMONITOR_REF}"; \
       fi
RUN git clone --depth=1 https://github.com/city96/ComfyUI-GGUF /opt/ComfyUI/custom_nodes/ComfyUI-GGUF \
    && if [ -n "${GGUF_REF}" ]; then \
         git -C /opt/ComfyUI/custom_nodes/ComfyUI-GGUF fetch --depth=1 origin "${GGUF_REF}" \
         && git -C /opt/ComfyUI/custom_nodes/ComfyUI-GGUF checkout "${GGUF_REF}"; \
       fi
# ComfyUI-Manager. Requirements are torch-free (GitPython, pygit2, PyGithub,
# transformers, huggingface-hub, typer, rich, typing-extensions, toml, uv, chardet) —
# `transformers` and `huggingface-hub` are unpinned there and would otherwise be free to
# move ours, which the constraints file now prevents.
# ⚠️ Manager installs custom nodes with **uv**, not pip. That is the whole reason
# UV_CONSTRAINT/UV_BUILD_CONSTRAINT are set beside PIP_CONSTRAINT in the runtime base:
# a pip-only guard would be bypassed by every node a user installs through the UI.
RUN git clone --depth=1 https://github.com/Comfy-Org/ComfyUI-Manager /opt/ComfyUI/custom_nodes/comfyui-manager \
    && if [ -n "${MANAGER_REF}" ]; then \
         git -C /opt/ComfyUI/custom_nodes/comfyui-manager fetch --depth=1 origin "${MANAGER_REF}" \
         && git -C /opt/ComfyUI/custom_nodes/comfyui-manager checkout "${MANAGER_REF}"; \
       fi \
    && pip install -r /opt/ComfyUI/custom_nodes/comfyui-manager/requirements.txt

# Relocate the 11 baked SD/SD2 config yamls OUT of the models tree (the runtime
# model-tree bind replaces models/); they register back via the seeded
# /opt/program-cache/extra_model_paths.yaml -> /opt/resources/model_configs.
# models/configs/ stays (empty): users may drop their own .yaml into their
# models bind.
RUN mkdir -p /opt/resources/model_configs \
    && mv /opt/ComfyUI/models/configs/*.yaml /opt/resources/model_configs/

# --- Assets (copied into build context from upstream/comfyui) ---
# Helper scripts: baked RO on PATH/PYTHONPATH, never seeded. One directory, one COPY:
# model_scanner.py, the two adopt tools and model_formats.py are one toolset -- they
# classify the same files from the same evidence, and model_formats.py is the shared
# execution-free reader module the other three IMPORT (hence PYTHONPATH, which is what
# makes the sibling import resolve wherever they are invoked from).
# name-api-blacklist.yaml is DATA the scanner reads at `rename` time (files whose name a
# library hardcodes); it ships beside the scanner so it can be edited as data.
COPY scripts/get_wan22.sh scripts/get_qwen_image.sh scripts/get_hunyuan15.sh \
     scripts/get_ltx2.sh scripts/benchmark_workflows.py scripts/collect_perf_logs.py \
     scripts/model_manager.py scripts/model_scanner.py scripts/model_formats.py \
     scripts/droste-hf-adopt.sh scripts/droste-civitai-adopt.sh \
     scripts/name-api-blacklist.yaml /opt/resources/scripts/
ENV PATH=/opt/resources/scripts:$PATH PYTHONPATH=/opt/resources/scripts

# API-format workflow definitions (baked RO reference; 1:1 with the get_*.sh models).
COPY api_workflows /opt/resources/api_workflows

# Runtime contract: per-port spec for the shared resolver + seed templates
# (demo inputs, UI workflow set, extra_model_paths.yaml, /opt/models marker body).
COPY build-spec /opt/resources/build-spec
COPY templates /opt/resources/templates

# Permissions & trims (keep compilers/headers for Triton JIT at runtime).
# (+x on the executables only: the script dir now also holds DATA -- name-api-blacklist.yaml
# -- and a table of filenames has no business being executable.)
RUN chmod +x /opt/resources/scripts/*.py /opt/resources/scripts/*.sh \
    && find /opt/venv -type f -name "*.so" -exec strip -s {} + 2>/dev/null || true \
    && find /opt/venv -type d -name "__pycache__" -prune -exec rm -rf {} + \
    && pip cache purge || true \
    && rm -rf /root/.cache/pip || true

# Group-writable venv + custom_nodes so the distrobox-lane box user (in group
# `droste`) can pip-install / add nodes into the baked trees after overlay
# copy-up (dirs setgid → copy-up is metadata-only; new files inherit the group).
# Re-applied here AFTER this port's pip installs + node clones (runtime-base did
# it for its own venv content).
RUN chgrp -R droste /opt/venv /opt/ComfyUI/custom_nodes \
    && chmod -R g+rwX /opt/venv /opt/ComfyUI/custom_nodes \
    && find /opt/venv /opt/ComfyUI/custom_nodes -type d -exec chmod g+s {} +

# Interactive login shell wiring (torch/AOTriton env, login banner, guards, core-dump suppression)
COPY profile.d/01-rocm-envs.sh /etc/profile.d/01-rocm-envs.sh
COPY profile.d/99-toolbox-banner.sh /etc/profile.d/99-toolbox-banner.sh
COPY profile.d/zz-venv-last.sh /etc/profile.d/zz-venv-last.sh
RUN chmod 0644 /etc/profile.d/01-rocm-envs.sh /etc/profile.d/99-toolbox-banner.sh /etc/profile.d/zz-venv-last.sh \
    && printf 'ulimit -S -c 0\n' > /etc/profile.d/90-nocoredump.sh \
    && chmod 0644 /etc/profile.d/90-nocoredump.sh

# Server by default: the shared entrypoint applies the build-spec (mounts, critical
# checks, template seeding, model scanner) then execs ComfyUI on :8188. A user
# command (`podman run IMAGE bash`) still wins; distrobox/toolbx replace pid1 and
# run the same resolver from init_hooks instead.
WORKDIR /opt/ComfyUI
ENTRYPOINT ["/opt/resources/resolve/droste-entrypoint.sh"]
