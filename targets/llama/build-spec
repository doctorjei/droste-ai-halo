# ── SERVICE ──────────────────────────────────────────────────────────────────
# Placeholder argv; llama_pre_launch REBUILDS it after CFG_FILE is sourced so
# DROSTE_LLAMA_EXTRA_ARGS (from /opt/data/llama.cfg) can join the command line —
# SERVICE would otherwise be expanded at spec-source time, before the env file.
SERVICE=( llama-server )

# ── HEALTH — probe endpoint for droste-healthcheck.sh ────────────────────────
# llama-server's native /health: 200 once the model is loaded, 503 while loading.
# The 503 is deliberately NOT accepted (loading is not serving) — the podman
# --health-start-period must cover the load, or the box restart-loops.
HEALTH_PATH="/health"
HEALTH_ACCEPT="ok"

# ── CFG_FILE ─────────────────────────────────────────────────────────────────
# Seeded from the BUILD-GENERATED template (templates.yaml if_missing); carries
# LLAMA_ARG_* lines (llama-server reads them natively), the 74 DROSTE_LLAMA_* settings
# the tables below translate — 71 into argv, 3 into the environment — and
# DROSTE_LLAMA_EXTRA_ARGS.
# ⚠️ It is NOT sourced into this shell: droste::cfg_apply runs it in a CHILD shell
# and applies the difference, so a typo in it is a warning rather than a dead box.
# The practical consequence for anything written here is that the file is DATA — the
# SHELL STATE it builds (a cd, a function, a trap) dies with the child and only the
# variables it leaves behind reach us. Not a sandbox: a filesystem write in there still
# happens, because the child is a real shell.
CFG_FILE="/opt/data/llama.cfg"

# ── SERVE — the rows droste-serve.sh reads out of this spec ──────────────────
# The five SERVE settings live in the same CFG_FILE as everything else, under the
# prefix below: DROSTE_LLAMA_STARTUP_ENABLED / _HOST / _PORT / _TLS_CERT / _TLS_KEY.
# serve::read_config PARSES them with droste::cfg_get and never sources the file — that
# read also runs inside the healthcheck every 30s under --health-on-failure=restart,
# where an abort is a restart loop that ejects every shell in the box.
# 🚨 SERVE_CFG_PREFIX IS REQUIRED, and its absence is not a quiet degradation: a spec
# that names CFG_FILE and no prefix makes read_config refuse to serve and report the
# IMAGE as broken, because otherwise all five settings would read as absent and the box
# would silently stop serving.
SERVE_CFG_PREFIX="DROSTE_LLAMA_"
#
# 🚨 NO SERVE_HOST_FLAG ROW, AND THAT IS AN ANSWER RATHER THAN AN OMISSION: llama-server
# spells it --host, which is serve::apply_host's own default. The same goes for --port.
# ⭐ AND THIS BOX'S BEHAVIOR CHANGES IN s60. It bound llama.cpp's own default —
# `params.hostname = "127.0.0.1"` (common/common.h:606) — while every sibling bound
# 0.0.0.0, and NOTHING REPORTED IT: the health probe asked 127.0.0.1, which a
# loopback-only listener answers perfectly. llama_argv now bakes `--host 0.0.0.0` (see
# the block above the SERVICE rebuild for the whole reason), and serve::apply_host
# REPLACES that token with the user's address in the serving lane — the same path
# comfyui and finetuning already take. ⚠️ BOTH HALVES ARE NEEDED: the launcher covers
# the merged box, the baked token covers a direct `podman run`, where no launcher runs
# at all. Neither alone delivers "all five default to 0.0.0.0".
# 🚨 WHICH IS WHY THIS SPEC MUST NEVER ASSIGN LLAMA_ARG_HOST — see the
# _wrong_on_clear entry in PRE_LAUNCH for the other half of that story. A variable we
# never set cannot be blank, and `LLAMA_ARG_HOST=""` binds ::1 only and restart-loops
# the box (s57). The template's reserved block names both spellings for the same reason.
#
# The port a user gets when they set none, and the value llama.cfg already shows on its
# commented DROSTE_LLAMA_PORT line. 🚨 THE ROW IS WHAT MAKES THAT LINE TRUE (§7a, ruled
# s60): the address has a library-wide default and the port had none, so before this row
# an absent port did not mean "use this number" — it meant the box refused to serve.
# 🚨 IT IS NO LONGER llama-server's OWN DEFAULT, AND THAT IS DELIBERATE (s66). Upstream
# warns on every start that binds :8080 — "server default port will be changed to :9931
# in a future release", ggml-org/llama.cpp#26508, fired from a string_ends_with on the
# LISTENING ADDRESS in tools/server/server.cpp. Moving now means moving once, on our
# schedule, instead of inheriting the change mid-pin and explaining a port that moved by
# itself. ⚠️ SO THE OLD "they agree by coincidence" NOTE IS SPENT: this box's argv still
# carries no --port, so a direct `podman run` of the raw image gets llama.cpp's 8080
# while every box droste creates gets this number. That divergence is now BY DESIGN —
# the serve lane always applies SERVE_PORT_DEFAULT, and `podman run <image>` is not a
# lane we police (ruled s61).
SERVE_PORT_DEFAULT=9931
#
# ⚠️ THE TLS PAIR HAS NO LIBRARY DEFAULT, deliberately: there is no majority spelling,
# and a wrong flag is not a wrong value — the server rejects the argv and never starts.
# These are llama.cpp's own --ssl-cert-file / --ssl-key-file, the pair llama.cfg's
# Security block already names and the pair behind the native LLAMA_ARG_SSL_*_FILE
# variables the file still carries.
# ⭐ THE FLAGS ARE DECLARED HERE; WHETHER THEY ARE EMITTED IS THE LAUNCHER'S CALL —
# serve::apply_tls emits them ONLY when the user set both, because a flag we emit is
# parsed after the environment and would silently beat a user's own LLAMA_ARG_SSL_*
# line; a default here would destroy that choice for everyone.
SERVE_TLS_CERT_FLAG=--ssl-cert-file
SERVE_TLS_KEY_FLAG=--ssl-key-file

# ── OVERLAYS ─────────────────────────────────────────────────────────────────
# venv overlay is universal (per design). llama-server itself is a compiled
# binary — the overlay serves the user's own pip installs (whole venv, so
# console scripts in bin/ persist too). The upper is CACHE class (a pip install
# is re-runnable) → /opt/program-cache, which the installer may empty.
OVERLAYS=(
    "/opt/program-cache/venv:/opt/venv"
)

# ── SURFACES ─────────────────────────────────────────────────────────────────
SURFACES=()

# ── CACHES ───────────────────────────────────────────────────────────────────
# None. llama.cpp uses its own kernels (no Triton/MIOpen), and the slot store is
# CONSUMED in place: the --slot-save-path launch flag points INTO
# /opt/program-cache directly (no bind needed; dir pre-created in
# llama_pre_launch). The slots stay OUT of this array on purpose — a CACHES row
# is what offers a src to the cross-box shared store, and one box's saved KV
# slots mean nothing to another: cache CLASS, but never SHARED.
CACHES=()

# ── CRITICAL ─────────────────────────────────────────────────────────────────
# Shared HF cache: llama-server's -hf downloads land here (llama.cpp consolidated
# onto the standard HF hub cache); unbound = silent multi-GB re-download.
CRITICAL=(
    "hf-cache:$HOME/.cache/huggingface"
)

# ── OPTIONAL ─────────────────────────────────────────────────────────────────
# Read-only bind point for a local GGUF collection (LLAMA_ARG_MODEL can point
# here). Tell-once marker body: templates/mount_shared_models_here.
OPTIONAL=(
    "models:/opt/models:/opt/models/mount_shared_models_here"
)

# ── The llama.cfg → argv tables ──────────────────────────────────────────────
# ⭐ THESE TABLES ARE THE ONLY MAPPING. llama.cfg names a setting; this file says
# which flag it emits. There is NO derivation rule and there must never be one —
# 64 of the 71 names below happen to match `--$(lower suffix)` and seven do not
# (AUTO_MODEL, HF_TOKEN_FILE, BUILTIN_SPEC_DEFAULT, DRY_SEQ_BREAKERS and the three
# ENDPOINT_*), so a derivation would need seven exceptions. Jei's ruling on ds4
# stands here: A RULE WITH AN EXCEPTION IS WORSE THAN NO RULE, because a reader who
# derives a name gets a variable nothing reads. Adding a setting means editing
# llama.cfg AND this file; there is nothing to fall back on.
# ⚠️ 71 IS THIS SECTION'S COUNT, NOT THE FILE'S. Three more settings are wired further
# down, in the ENVIRONMENT tables — they have no flag to emit and never touch SERVICE.
#
# Every row was generated from the PINNED binary's own option table (paren-balanced
# parse of arg.cpp at fb2cc35a) and not from llama.cfg's inline comments — three of
# those comments name the wrong flag today.
# ✅ RE-CHECKED at the s64 bump: all 46 flags emitted below still exist in arg.cpp's
# alias lists. ⚠️ THAT 46 IS A RECORD OF THAT CHECK, NOT A LIVE COUNT — it was measured
# by an instrument that has since been widened, and the tables have grown; recount from
# the tree with scripts/check-llama-flags.sh, which is the thing to run at a pin bump.
# ⚠️ The build's own drift gate covers only THREE names
# (LLAMA_ARG_HOST/PORT/MODEL, targets/Container.llama), so a green CI says nothing
# about the other 43 — that cross-check is a dev-time step at every pin bump.
#
# 🚨 THE FOUR BOOLEAN KINDS ARE NOT INTERCHANGEABLE, and this is the whole reason
# every one of them is droste-named:
#   BOOL   has a real `--no-x` twin. on ⇒ `--x`, off ⇒ `--no-x`.
#   SWITCH is upstream `handler_void`: it has NO negation and is applied only
#          `if (is_truthy(value))`, so `off`/`no`/`false` are SILENTLY DISCARDED by
#          llama itself. off ⇒ WE EMIT NOTHING, which is the only way "off" can mean
#          off. A user cannot tell these two kinds apart by looking, which is why we
#          never expose the native names for either.
#   ONOFF  takes its answer as an ARGUMENT — `--fit on` — so both answers are
#          expressible and neither is a separate flag. Exactly one exists (see
#          LLAMA_ONOFF_FLAGS below for why it still cannot be a native line).
#   CHOICE is a menu where one value means "emit nothing" (comfyui's shape).
# ⭐ AND A FIFTH KIND SINCE s67, WHICH IS NOT A BOOLEAN AT ALL:
#   AUTO   a VALUE flag plus a droste-owned SENTINEL word. The sentinel emits
#          nothing; every other accepted spelling is a number that reaches the flag
#          unchanged. The sentinel is a word llama does not accept, so the value does
#          NOT pass through unprocessed — which is the server-class naming rule, and the
#          reason the row is droste-named rather than native.
# ⚠️ UNSET IS A THIRD STATE, DISTINCT FROM off. An unset bool emits NEITHER flag, so
# upstream's own default stands. That matters for --kv-unified, whose help says the
# effective default is "enabled if number of slots is auto": emitting --no-kv-unified
# just because the line is commented out would suppress that.
#
# "<SUFFIX>:<flag>" — the variable is DROSTE_LLAMA_<SUFFIX>.
LLAMA_VALUE_FLAGS=(
    "TEMP:--temp"                       "TOP_P:--top-p"
    "MIN_P:--min-p"                     "TOP_N_SIGMA:--top-nsigma"
    "XTC_PROBABILITY:--xtc-probability" "XTC_THRESHOLD:--xtc-threshold"
    "TYPICAL_P:--typical-p"             "REPEAT_LAST_N:--repeat-last-n"
    "REPEAT_PENALTY:--repeat-penalty"   "PRESENCE_PENALTY:--presence-penalty"
    "FREQUENCY_PENALTY:--frequency-penalty"
    "DRY_MULTIPLIER:--dry-multiplier"   "DRY_BASE:--dry-base"
    "DRY_ALLOWED_LENGTH:--dry-allowed-length"
    "DRY_PENALTY_LAST_N:--dry-penalty-last-n"
    "DYNATEMP_RANGE:--dynatemp-range"   "DYNATEMP_EXP:--dynatemp-exp"
    "ADAPTIVE_TARGET:--adaptive-target" "ADAPTIVE_DECAY:--adaptive-decay"
    "MIROSTAT:--mirostat"               "MIROSTAT_LR:--mirostat-lr"
    "MIROSTAT_ENT:--mirostat-ent"       "SEED:--seed"
    "GRAMMAR:--grammar"                 "GRAMMAR_FILE:--grammar-file"
    "JSON_SCHEMA:--json-schema"         "JSON_SCHEMA_FILE:--json-schema-file"
    "SAMPLERS:--samplers"               "SAMPLING_SEQ:--sampler-seq"
)
# "<SUFFIX>:<on-flag>:<off-flag>"
LLAMA_BOOL_FLAGS=(
    "MODELS_AUTOLOAD:--models-autoload:--no-models-autoload"
    "UI:--ui:--no-ui"
    "UI_MCP_PROXY:--ui-mcp-proxy:--no-ui-mcp-proxy"
    "CACHE_PROMPT:--cache-prompt:--no-cache-prompt"
    "CACHE_IDLE_SLOTS:--cache-idle-slots:--no-cache-idle-slots"
    "CONTEXT_SHIFT:--context-shift:--no-context-shift"
    "KV_UNIFIED:--kv-unified:--no-kv-unified"
    "JINJA:--jinja:--no-jinja"
    "PREFILL_ASSISTANT:--prefill-assistant:--no-prefill-assistant"
    "SKIP_CHAT_PARSING:--skip-chat-parsing:--no-skip-chat-parsing"
    "ENDPOINT_SLOTS:--slots:--no-slots"
    "PERF:--perf:--no-perf"
    "MMPROJ_AUTO:--mmproj-auto:--no-mmproj-auto"
    "MMPROJ_OFFLOAD:--mmproj-offload:--no-mmproj-offload"
    "CONT_BATCHING:--cont-batching:--no-cont-batching"
    "KV_OFFLOAD:--kv-offload:--no-kv-offload"
    "REPACK:--repack:--no-repack"
    "LOG_PREFIX:--log-prefix:--no-log-prefix"
    "LOG_TIMESTAMPS:--log-timestamps:--no-log-timestamps"
)
# handler_void — no negation exists upstream. off ⇒ emit nothing.
# ⚠️ NO_HOST IS A POSITIVE FLAG. `--no-host` is llama's own spelling for "bypass the
# host buffer"; there is no `--host` boolean it negates. Any future "strip the --no-
# to turn it off" cleverness must never touch this row.
LLAMA_SWITCH_FLAGS=(
    "BUILTIN_SPEC_DEFAULT:--spec-default" "SPEC_DRAFT_CPU_MOE:--spec-draft-cpu-moe"
    "SWA_FULL:--swa-full"                 "ENDPOINT_METRICS:--metrics"
    "ENDPOINT_PROPS:--props"              "EMBEDDINGS:--embeddings"
    "RERANKING:--reranking"               "REUSE_PORT:--reuse-port"
    "OFFLINE:--offline"                   "CPU_MOE:--cpu-moe"
    "NO_HOST:--no-host"
    "BACKEND_SAMPLING:--backend-sampling" "IGNORE_EOS:--ignore-eos"
)
# ONOFF — the flag carries its own `on`/`off` argument. "<SUFFIX>:<flag>".
#
# 🚨 ONE ROW, AND IT IS HERE BECAUSE IT IS A BOOLEAN, NOT BECAUSE IT MISBEHAVES.
# `--fit` is the ONLY two-valued on/off option llama.cfg surfaces — checked at the
# pin rather than remembered: of the 84 native LLAMA_ARG_* names the file names,
# arg.cpp gives exactly one an `is_truthy`/`is_falsey` pair with no third answer
# (arg.cpp:2442-2454), three more are on/off/AUTO menus and so are not booleans
# (FLASH_ATTN, LOG_COLORS, REASONING), and none is a `handler_bool`. The naming rule
# (s53) has no degrees: EVERY boolean is droste-named, whatever its native does.
# ⚠️ SO THE REASON IS NOT THE `off` FALL-THROUGH THAT DAMNS THE SWITCH KIND. Upstream
# reads this one correctly — `off`, `disabled`, `false` and `0` all really do turn
# fitting off. What it does NOT read is `Off`, `OFF`, `no` or a stray trailing space:
# is_truthy/is_falsey are exact, case-sensitive std::string comparisons
# (arg.cpp:988-994), and anything they both reject THROWS out of the env loop and the
# server never starts. droste::bool case-folds, strips spaces, and accepts our whole
# vocabulary, which is what makes this box answer `off` the same way the other four do.
#
# 🚨 THE FAILURE MODE CHANGES, AND THIS IS NOT MERELY A RENAME. Say it plainly:
#   before   `LLAMA_ARG_FIT=Off` ⇒ upstream throws ⇒ the box does not start. LOUD.
#   after    `DROSTE_LLAMA_FIT=Off` ⇒ droste::bool folds it ⇒ fitting really is off.
#            `DROSTE_LLAMA_FIT=maybe` ⇒ we warn and emit nothing ⇒ the box starts on
#            llama's default instead of dying.
# ⭐ THE FIRST LINE IS THE WHOLE POINT — `Off`, `OFF`, `no` and `yes` are DEAD BOXES
# today, and they are what people actually type. The second line is the price: a typo
# stops being fatal and becomes a warning, so a user who does not read the log gets a
# running server on a value they did not choose. That trade was already made for the
# other 37 booleans on this surface — 21 BOOL, 14 SWITCH and the 2 ENVIRONMENT ones,
# counted from the tables rather than from a sibling document — and consistency
# governs; it is recorded here so nobody re-derives it as a defect.
#
# 🚨 PRECEDENCE OVER A NATIVE LINE, AND IT IS UPSTREAM'S OWN ORDERING, NOT OURS.
# common_params_parse_ex handles environment variables FIRST (arg.cpp:509-530) and
# then walks argv (:539+), each handler overwriting the same `params.fit_params`. So
# a flag we emit always beats a `LLAMA_ARG_FIT` line — llama even says so on stderr,
# `warn: … environment variable is set, but will be overwritten by command line
# argument` (:563-564). The contract, same shape as the ENVIRONMENT tables below:
#   DROSTE_LLAMA_FIT unset or blank  → we emit nothing. A native line an older box
#                                      carries stands; with neither, llama's own
#                                      default stands. Blank behaves exactly as absent.
#   DROSTE_LLAMA_FIT set             → OURS WINS, because argv is parsed last.
#   DROSTE_LLAMA_FIT set to garbage  → warn, emit nothing. Same as unset, so a typo
#                                      can never destroy a native line the user meant.
# ⚠️ AND OUR FLAG CANNOT RESCUE A BLANK NATIVE ONE, for exactly that ordering reason:
# `LLAMA_ARG_FIT=` throws inside the env loop, before argv is ever read. That is why
# the name keeps its entry in _fatal_on_clear below even though it has left the
# surface — see the row there.
LLAMA_ONOFF_FLAGS=(
    "FIT:--fit"
)
# AUTO — "<SUFFIX>:<flag>:<sentinel>". The SENTINEL is the setting's default and emits
# NOTHING; any other value must be a non-negative integer and is passed to the flag.
# Anything else warns and falls back to the sentinel — no fall-through values.
#
# 🚨 ONE ROW, AND IT EXISTS BECAUSE THE NATIVE LINE COULD NOT KEEP THE FILE'S OWN
# PROMISE. llama.cfg's header says the value shown IS the default, so uncommenting a
# shown line must be a NO-OP — and `LLAMA_ARG_CTX_SIZE=0` is not one:
#   ABSENT   params.n_ctx stays 0 (common/common.h) and fit_params_min_ctx stays 4096,
#            so llama's fitter is free to SHRINK the context to fit memory.
#   `-c 0`   the {"-c","--ctx-size"} handler assigns n_ctx AND, only for the value 0,
#            sets fit_params_min_ctx = UINT32_MAX — which FORBIDS that reduction.
# Two different boxes from one gesture. ⭐ AND THE WIRING CANNOT SIMPLY SWALLOW `0`:
# "the full training context, and do not shrink it" is a legitimate distinct request,
# so what is missing is a THIRD spelling for "let the fitter decide". llama has none.
# `auto` is ours, which is exactly why the setting is ours.
# ✅ RULED (Jei, s67): "wrap this one for processing and list default as auto."
#
# 🚨 LLAMA_ARG_CTX_SIZE COMES OFF THE SURFACE WITH IT (Jei: "agreed re: surface"), and
# the reason is precedence: llama parses the environment BEFORE argv, so a flag we
# emit silently beats the user's own native line. Two settings writing n_ctx is a
# last-wins race we always win. ⚠️ THE NAME STILL WORKS — llama reads it whatever we
# do — so it keeps its _fatal_on_clear row and gets a RETIREMENT WARNING (llama_ctx_warn
# below) for one minor release, per the s66 policy. Config files are seeded if_missing,
# so an existing box carries the old line forever with no other way to learn it is no
# longer part of this surface.
LLAMA_AUTO_VALUE_FLAGS=(
    "CTX_SIZE:--ctx-size:auto"
)
# Upstream takes ONE item per occurrence and expects the flag REPEATED; the user
# gives us a `;`-separated list and we do the repeating. "<SUFFIX>:<flag>"
# ⚠️ --dry-sequence-breaker clears llama's four built-in breakers on its FIRST
# invocation only, so one combined argument would install a single absurd breaker
# rather than the four the user wrote.
LLAMA_LIST_FLAGS=(
    "DRY_SEQ_BREAKERS:--dry-sequence-breaker"
    "LOGIT_BIAS:--logit-bias"
)
# comfyui's record shape: "<SUFFIX>|<value>=<flags>|…", FIRST pair is the default,
# an EMPTY right-hand side emits nothing at all.
# 🚨 NUMA IS HERE AND NOT IN THE VALUE TABLE, and that is the fix for a real trap:
# arg.cpp:2298 reads `value == "distribute" || value == ""`, so passing --numa with
# an EMPTY argument turns NUMA **on** in distribute mode. `off` has to mean "emit no
# flag", which a value row cannot express. Anything llama does not recognize throws
# and kills startup, so the menu is closed.
# LOAD_MODE replaces --mmap/--mlock/--direct-io: at this pin all three are deprecated
# and each ASSIGNS params.load_mode, so they overwrote each other (MMAP=on + MLOCK=on
# meant "mmap off").
#
# 🚨 `none` IS OURS AND IT OVERRIDES UPSTREAM (Jei, s66): "There is no way I think keeping
# mmap is a good idea for this architecture. It directly leads to moving large models out
# of memory and trying to read from disk." Under mmap the weights ARE the mapped file
# pages, so the kernel may evict them under pressure and re-fault mid-inference — on a box
# whose own --fit sizing deliberately leaves ~1 GiB of headroom, that pressure is the
# design point, not a corner case. These images are sized for the model, so the graceful
# degradation mmap buys is worth less here than the eviction it costs.
# ⚠️ `none` RATHER THAN `dio`, which was the other candidate: both turn mmap off and both
# enable the chunked pinned-staging upload path (upload_backend is null whenever mmap is
# on), but dio's HOST path posix_memaligns a FULL-SIZE bounce buffer per tensor
# (llama-mmap.cpp read_aligned_chunk) where none reads straight into cur->data. dio's only
# advantage is skipping the page cache, and page cache is RECLAIMABLE; the bounce is
# anonymous memory that has to actually be there. And on an integrated GPU the bounce is
# MORE likely, not less: the scheduler may place tensors in pinned-host buffers, which
# report is_host == true. dio stays on the menu for a box measured to be fully on the
# device path, where the bounce never fires and 64 MiB chunks are free speed.
# 🚨 THE FIRST PAIR NOW EMITS A FLAG, AND IT HAS TO. Upstream's default is MMAP, so an
# empty right-hand side here would leave mmap standing — the opposite of the ruling. This
# is the N1a wiring default: it reaches every box on its next start, including boxes whose
# llama.cfg predates the setting, which a seeded line never could.
LLAMA_CHOICE_FLAGS=(
    # `auto` is omitted: llama-model.cpp rewrites it to MMAP before any consumer reads
    # it, so it is a synonym. check-llama-collisions.sh watches for that changing.
    "LOAD_MODE|none=--load-mode none|mmap=--load-mode mmap|mlock=--load-mode mlock|mmap+mlock=--load-mode mmap+mlock|dio=--load-mode dio"
    # Upstream's default is LLAMA_TENSOR_READ_LAZY_AUTO, so `auto` emits nothing.
    "TENSOR_READ_LAZY|auto=|on=--tensor-read-lazy on|off=--tensor-read-lazy off"
    "NUMA|off=|distribute=--numa distribute|isolate=--numa isolate|numactl=--numa numactl"
    "AUTO_MODEL|none=|embd-gemma=--embd-gemma-default|fim-qwen-1.5b=--fim-qwen-1.5b-default|fim-qwen-3b=--fim-qwen-3b-default|fim-qwen-7b=--fim-qwen-7b-default|fim-qwen-7b-spec=--fim-qwen-7b-spec|fim-qwen-14b-spec=--fim-qwen-14b-spec|fim-qwen-30b=--fim-qwen-30b-default|gpt-oss-20b=--gpt-oss-20b-default|gpt-oss-120b=--gpt-oss-120b-default|vision-gemma-4b=--vision-gemma-4b-default|vision-gemma-12b=--vision-gemma-12b-default"
)
# Settings that write the SAME field upstream, so more than one is a silent
# last-wins race. We say so instead of letting argument order decide.
# A shared field is not automatically a conflict — "set ONE of them" is false where one
# option is a superset of another (EMBEDDINGS/RERANKING) or the overlap is partial
# (CTX_SIZE/FIT_CTX). Those two are exemptions in check-llama-collisions.sh, not groups.
LLAMA_EXCLUSIVE_GROUPS=(
    "GRAMMAR GRAMMAR_FILE JSON_SCHEMA JSON_SCHEMA_FILE"
    "SAMPLERS SAMPLING_SEQ"
    # --reranking forces pooling_type=RANK, silently overriding a chosen pooling.
    "LLAMA_ARG_POOLING RERANKING"
    "LLAMA_ARG_CHAT_TEMPLATE LLAMA_ARG_CHAT_TEMPLATE_FILE"
    "LLAMA_ARG_UI_CONFIG LLAMA_ARG_UI_CONFIG_FILE"
    # Two upstream spellings of one field, not two knobs.
    "LLAMA_ARG_ROPE_SCALE LLAMA_ARG_ROPE_FREQ_SCALE"
)

# ── THE CONTEXT SIZE, AND THE ONE COMBINATION THAT KILLS A BOX (S1, s67) ─────
#
# llama_ctx_sentinel — the AUTO table's sentinel for CTX_SIZE, read OUT OF THE TABLE so
# that nothing spells it a second time. Both functions below compare against it.
llama_ctx_sentinel() {
    local row
    for row in ${LLAMA_AUTO_VALUE_FLAGS[@]+"${LLAMA_AUTO_VALUE_FLAGS[@]}"}; do
        case $row in CTX_SIZE:*) printf '%s' "${row##*:}"; return 0 ;; esac
    done
    printf 'auto'
}

# llama_ctx_size — the EFFECTIVE request as one word: the sentinel when nothing usable
# is set, otherwise the number that reaches `-c`. DELIBERATELY SILENT: llama_argv's
# AUTO_VALUE loop owns the diagnostic, and a value read in two places must not be
# complained about twice. A garbage value reads as the sentinel here BECAUSE that is
# what the box will actually run — no `-c` is emitted, so the trap below is live.
llama_ctx_size() {
    local sentinel v
    sentinel=$(llama_ctx_sentinel)
    v=${DROSTE_LLAMA_CTX_SIZE:-$sentinel}
    [ -n "$v" ] || v=$sentinel
    case "$v" in
        *[!0-9]*) printf '%s' "$sentinel" ;;
        *)        printf '%s' "$v" ;;
    esac
}

# The FIVE speculative types that are SIDECAR-BACKED. Enumerated from
# common_speculative_type_to_str (common/speculative.cpp) at the pin, which is the
# function that defines the spelling `--spec-type` accepts — not from a sibling note.
# Naming one of these sets the matching opts.download_<kind> in
# common_models_handler_init, and THAT is what puts a sidecar into the MAIN model's
# download plan; with no draft of the user's own, its callback assigns it as the draft.
# 🚨 draft-simple IS THE SIXTH draft-* TYPE AND MUST NEVER BE ADDED HERE. It sets NONE
# of the four download flags, so no plan entry appears and nothing is attached —
# including it would warn about a configuration that is fine.
LLAMA_SIDECAR_SPEC_TYPES=( draft-mtp draft-mtp-adaptive draft-dflash draft-eagle3 draft-dspark )

# llama_spec_type_has_sidecar — does ONE --spec-type value name a sidecar type?
# Exit status, not output: 0 yes, 1 no.
# ⚠️ TOKENS ARE MATCHED EXACTLY, WITH NO TRIMMING, BECAUSE UPSTREAM DOES NOT TRIM.
# string_split (common/common.h) keeps surrounding spaces and
# common_speculative_types_from_names THROWS on any name its map does not hold — so
# `draft-dflash, ngram-mod` is a box that does not start, not a warning we missed.
# Being more lenient than the parser would invent a case upstream does not have.
# 🚨 `none` ANYWHERE IN ONE VALUE CANCELS THAT WHOLE VALUE. types_from_names returns
# {NONE} the moment it sees it and drops everything else in the same string, so
# `draft-dflash,none` attaches nothing. ⚠️ That cancellation is PER VALUE STRING, not
# global: the handler APPENDS, so a later `--spec-type none` does not undo an earlier
# `LLAMA_ARG_SPEC_TYPE=draft-dflash`. Each value is asked on its own for that reason.
llama_spec_type_has_sidecar() {
    local v=${1:-} tok t
    local -a toks=()
    [ -n "$v" ] || return 1
    IFS=',' read -r -a toks <<<"$v"
    for tok in ${toks[@]+"${toks[@]}"}; do
        [ "$tok" = none ] && return 1
    done
    for tok in ${toks[@]+"${toks[@]}"}; do
        for t in "${LLAMA_SIDECAR_SPEC_TYPES[@]}"; do
            [ "$tok" = "$t" ] && return 0
        done
    done
    return 1
}

# llama_draft_attached — prints "yes" when this box will load a DRAFT MODEL, and
# nothing otherwise. It decides nothing about the argv; it exists for the warning.
# "$@" is the already-split catch-all argv.
#
# THE ENTRY POINTS, ENUMERATED FROM arg.cpp AT THE PIN rather than remembered. A draft
# exists when params.speculative.draft.mparams is non-empty (has_dft(), common/common.h),
# and these are the only ways a user reaches that from here:
#   · LLAMA_ARG_SPEC_DRAFT_MODEL     {--spec-draft-model, -md, --model-draft}
#   · LLAMA_ARG_SPEC_DRAFT_HF_REPO   {--spec-draft-hf, -hfd, -hfrd, --hf-repo-draft}
#   · either flag list written into DROSTE_LLAMA_EXTRA_ARGS, which is why the catch-all
#     is scanned and not just the two variables
#   · DROSTE_LLAMA_AUTO_MODEL=fim-qwen-7b-spec / fim-qwen-14b-spec — the only two of
#     the eleven presets whose handlers assign draft.mparams.hf_repo themselves. ⚠️ And
#     they are the WORST case rather than an edge one: both also set params.n_ctx = 0
#     inside the lambda, which never reaches the `-c` handler, so fit_params_min_ctx is
#     untouched and the pair arrives at exactly the state warned about below.
#   · LLAMA_ARG_SPEC_TYPE (or a --spec-type in the catch-all) naming one of the five
#     SIDECAR-BACKED types. THIS ONE ATTACHES A DRAFT WITH NOTHING ELSE SET, which is
#     why it is here: the type booleans set opts.download_<kind> DIRECTLY, the MAIN
#     model's plan then carries the sidecar, and with no draft repo of the user's own
#     `had_spec_url` is false, so the `if (params.speculative.draft.mparams.empty())`
#     callback assigns it as the draft. A 1.1B DFlash head with its own 1M declared
#     context, from a repo the user only named as the main model.
#
# ⭐ THAT ROUTE IS *NOT* THE ONE `spec_types_is_default` GATES, AND THE DISTINCTION IS
# THE WHOLE POINT OF THE ROW ABOVE. Everything gated on that predicate concerns
# `plan_spec` — the DRAFT REPO's plan — which needs a draft repo, i.e. a case the first
# two entries already catch. The main-model route reads only the type booleans.
# 🚨 SO `--spec-default` IS IRRELEVANT TO IT, IN BOTH DIRECTIONS, and this comment said
# the opposite until it was traced end to end: the route is reachable at this pin as
# shipped, and S1c-PATCH neither opens nor closes it. Do not reattach it to that patch.
#
# ⚠️ IT IS A NECESSARY CONDITION, NOT A SUFFICIENT ONE, AND THAT IS STATED RATHER THAN
# HIDDEN. Naming a sidecar type only attaches something if the main repo ACTUALLY SHIPS
# that sidecar (and the main model has to come from an hf_repo at all — `plan` is only
# built when `params.model.hf_repo` is non-empty). So this can warn when no draft ever
# materialises. ⭐ That is the right direction to be wrong in: the cost of the false
# warning is a line of log, and the cost of the false silence is the box.
#
# 🚨 IT IS STILL A FLOOR, NOT A SWEEP. A models PRESET (`plan.preset` →
# params.models_preset) carries per-model arguments in an .ini this shell never reads,
# so a draft named in there is invisible here. Do not read silence as "no draft".
llama_draft_attached() {
    local f take=0 a
    [ -n "${LLAMA_ARG_SPEC_DRAFT_MODEL:-}" ]   && { printf 'yes'; return 0; }
    [ -n "${LLAMA_ARG_SPEC_DRAFT_HF_REPO:-}" ] && { printf 'yes'; return 0; }
    case "${DROSTE_LLAMA_AUTO_MODEL:-}" in
        fim-qwen-7b-spec|fim-qwen-14b-spec) printf 'yes'; return 0 ;;
    esac
    llama_spec_type_has_sidecar "${LLAMA_ARG_SPEC_TYPE:-}" && { printf 'yes'; return 0; }
    for f in --spec-draft-model -md --model-draft \
             --spec-draft-hf -hfd -hfrd --hf-repo-draft; do
        [ -n "$(droste::arg_value "$f" "$@")" ] && { printf 'yes'; return 0; }
    done
    # ⚠️ NOT droste::arg_value, AND THE REASON IS UPSTREAM'S SEMANTICS. That helper
    # returns the LAST occurrence, because that is what an argument parser keeps — but
    # --spec-type's handler APPENDS to params.speculative.types, so EVERY occurrence
    # contributes and an earlier one cannot be overwritten by a later one. Asking only
    # the last would miss `--spec-type draft-dflash --spec-type ngram-mod`.
    for a in "$@"; do
        if [ "$take" = 1 ]; then
            take=0
            llama_spec_type_has_sidecar "$a" && { printf 'yes'; return 0; }
            continue
        fi
        case $a in
            --spec-type)   take=1 ;;
            --spec-type=*) llama_spec_type_has_sidecar "${a#*=}" && { printf 'yes'; return 0; } ;;
        esac
    done
    return 0
}

# llama_ctx_warn — the two things worth saying about the context size. "$@" is the
# already-split catch-all argv.
# ⚠️ EVERY ARM RETURNS 0 AND PRINTS ONLY. llama_argv runs inside PRE_LAUNCH, which the
# resolver calls BARE under `set -euo pipefail`, so a non-zero return from a diagnostic
# would take the box down. Verified by running every arm under errexit, not by reading.
# ⚠️ THE TWO SEVERITIES ARE A CHOICE, NOT AN ACCIDENT. The retirement is `serve::err`,
# like the MMAP/MLOCK/DIRECT_IO loop above it: the user wrote a line that no longer
# means what their file says it means. The draft trap is `serve::warn`, like
# llama_hf_cache_warn: nothing they wrote is wrong, and running a draft with no context
# ceiling is a legitimate thing to ask for on a model small enough to survive it.
# ⭐ So the LOUDER label is on the smaller problem, deliberately — severity here tracks
# "is this configuration a mistake", not "how much does it cost when it goes wrong".
llama_ctx_warn() {
    local ctx native sentinel eff
    sentinel=$(llama_ctx_sentinel)
    ctx=$(llama_ctx_size)
    native=${LLAMA_ARG_CTX_SIZE:-}

    # THE EFFECTIVE REQUEST, IN LLAMA'S OWN PRECEDENCE ORDER: argv is parsed after the
    # environment and a later occurrence overwrites an earlier one, and llama_argv puts
    # the catch-all LAST — so a `-c` there beats our flag, which beats the native line.
    # An empty result means NOTHING anywhere set a context size.
    # ⚠️ Two spellings, checked in a fixed order rather than by position: a user who
    # writes BOTH `-c` and `--ctx-size` into the catch-all gets whichever llama parses
    # last, which this cannot see. It decides only whether to PRINT, so the cost of
    # being wrong there is one message, not a wrong box.
    eff=$(droste::arg_value --ctx-size "$@")
    [ -n "$eff" ] || eff=$(droste::arg_value -c "$@")
    [ -n "$eff" ] || { [ "$ctx" = "$sentinel" ] || eff=$ctx; }
    [ -n "$eff" ] || eff=$native

    # ── 1. the retired native name (s66 policy: warn for ONE minor release) ────
    # ⭐ IT IS NOT UNSET, AND THAT IS DELIBERATE. Erasing a user's explicit context size
    # would drop that box into exactly the failure arm 2 exists to prevent, so the line
    # goes on working and the message says what to do. ⚠️ TWO ARMS, because the remedy
    # differs: with a droste value set the native is already being beaten silently;
    # with none it is still the thing sizing the context.
    # ⚠️ DELETE THIS BLOCK ONE MINOR RELEASE AFTER THE NAME LEFT llama.cfg. The policy
    # says the warning goes too — a retired name that warns forever is a second surface.
    if [ -n "$native" ]; then
        if [ "$ctx" = "$sentinel" ]; then
            serve::err "LLAMA_ARG_CTX_SIZE is no longer one of this box's settings — DROSTE_LLAMA_CTX_SIZE replaces it, and adds '$sentinel' (let llama size the context to fit memory) beside 0 and a number. Your line still sets the context today, but DROSTE_LLAMA_CTX_SIZE overrides it silently as soon as you use it. Move it in $CFG_FILE."
        else
            serve::err "LLAMA_ARG_CTX_SIZE is set and DROSTE_LLAMA_CTX_SIZE=$ctx is overriding it — llama reads environment variables before the command line, so the flag we emit wins. LLAMA_ARG_CTX_SIZE is retired; remove it from $CFG_FILE."
        fi
    fi

    # ── 2. a draft model with no BOUNDED context size: the box-killer (S1b) ────
    # 🚨 THE SMALL MODEL IS THE ONE WITH NO CEILING, WHICH IS WHY THIS IS NOT OBVIOUS.
    # A context of 0 — set or left unset — resolves PER MODEL from that model's own GGUF
    # (`n_ctx == 0 ? hparams.n_ctx_train : n_ctx`), and llama's fitter sizes only the
    # TARGET: common_fit_params mutates a LOCAL cparams and never writes back to
    # params.n_ctx, so common_base_params_to_speculative still copies a zero. The target
    # ends up bounded by free memory and the draft does not.
    # ⚠️ THERE IS NO VALUE WE COULD WRITE THAT FIXES IT, WHICH IS WHY IT IS A WARNING AND
    # NOT A DEFAULT. `-cd` / LLAMA_ARG_SPEC_DRAFT_N_CTX is dead code at this pin, and a
    # box-wide context default is model-specific: 262144 is right for a sliding-window
    # model and ~29 GiB of KV on a dense 80-layer one.
    # 🚨 `0` IS NOT A CURE, AND IT GETS ITS OWN MESSAGE. An explicit 0 stops the fitter
    # SHRINKING the target (fit_params_min_ctx = UINT32_MAX) but still leaves n_ctx at 0,
    # so each model takes its own declared maximum and the two need not be the same
    # number at all. Reporting that as "no context size is set" would be false — the user
    # set one — so the two arms say different things, as a loud entry owes.
    if [ "$(llama_draft_attached "$@")" = yes ]; then
        if [ -z "$eff" ]; then
            serve::warn "A draft model is configured and no context size is set, so the draft sizes its KV cache from its OWN training context — llama's fitter only sizes the main model, and it never passes the result on. A small long-context draft can ask for tens of GiB that way and take this box down. Set DROSTE_LLAMA_CTX_SIZE=<tokens> in $CFG_FILE; the main model and the draft always share it."
        elif [ "$eff" = 0 ]; then
            serve::warn "A draft model is configured and the context size is 0, which means 'the full training context' PER MODEL — so the draft claims its own declared maximum, not the main model's, and a small long-context draft can ask for tens of GiB and take this box down. Set DROSTE_LLAMA_CTX_SIZE=<tokens> in $CFG_FILE; the main model and the draft always share it."
        fi
    fi
    return 0
}

# llama_argv — DROSTE_LLAMA_* → SERVICE. Its own function, comfyui-style, so it can
# be driven alone (source the spec, call it, print SERVICE) without the mkdir, the
# HF token read or the health-prefix write. With 70 settings that is the difference
# between a testable translator and one nobody can check.
# ⚠️ It REBUILDS SERVICE from constants rather than appending: serve::build_service
# can run PRE_LAUNCH a second time in the same process, and a doubled argv of this
# length would be very hard to read in a log.
llama_argv() {
    local dyn=() entry suffix var val flag onf offf rest pairs=() pair def flags ok list _lm
    local sentinel
    local -a items=()
    local g first seen

    # ── the droste-supplied defaults (N1a: a default belongs in the WIRING) ─────
    # ⭐ ONE, and it is here rather than as an active line in llama.cfg because that
    # file seeds `if_missing`: an uncommented line would reach NEW boxes only.
    # llama.cfg's Speculative Decoding block stars `on` in its `{on*, off}` menu AND
    # shows `DROSTE_LLAMA_BUILTIN_SPEC_DEFAULT=on`, so the file states this default
    # twice. It is a SWITCH (handler_void), so an unset variable emitted nothing at
    # all and the box came up with ngram speculative decoding OFF — the file
    # asserting a default the box did not deliver.
    # ⚠️ IT IS A REAL BEHAVIOR CHANGE, not a no-op: --spec-default pushes
    # COMMON_SPECULATIVE_TYPE_NGRAM_MOD and sets ngram_mod n_match/n_min/n_max to
    # 24/48/64 — arg.cpp, the `{"--spec-default"}` handler (~:4691 at the pinned
    # fb2cc35a; anchor on the option name, the number moved 500+ lines at the bump).
    # That is what the file asks for.
    # 🚨 `:=` NOT `=`, AND THIS REVERSED IN s58 — READ THE REASON BEFORE CHANGING IT
    # BACK. It was `=` so that a blank meant "don't", on the N1a reading that a blank is
    # always the user's opt-out. Jei's three-category rule narrows that: a blank is the
    # opt-out only for an UNBOUNDED string whose blank is a meaningful answer. This
    # setting is a two-member menu — llama.cfg prints `{on*, off}` above
    # `DROSTE_LLAMA_BUILTIN_SPEC_DEFAULT` in its Speculative Decoding block —
    # so it is CATEGORY 2, a finite set, and a finite set has default behavior that a
    # blank must fall back to. What the user would reasonably expect from an emptied
    # line is our default, not a third state the file never offers.
    # ⭐ NOTHING IS LOST BY THE CHANGE: `off` is still the way to say off, it is one of
    # the two answers the file documents, and it still emits nothing. The blank simply
    # stops being an undocumented third answer that happened to mean `off`.
    : "${DROSTE_LLAMA_BUILTIN_SPEC_DEFAULT:=on}"

    for entry in "${LLAMA_VALUE_FLAGS[@]}"; do
        var="DROSTE_LLAMA_${entry%%:*}"; flag=${entry#*:}; val=${!var:-}
        [ -n "$val" ] && dyn+=( "$flag" "$val" )
    done

    # AUTO — a value flag with a sentinel that emits nothing. See the table.
    # ⚠️ BLANK IS THE SENTINEL, NOT A THIRD STATE. A number has a default the user is
    # entitled to get back (Jei's category 2), so a cleared line means "give me auto",
    # exactly as an absent one does. This is the narrowing of N1a's "blank ⇒ off": the
    # opt-out reading survives only for an unbounded string whose blank means something.
    for entry in "${LLAMA_AUTO_VALUE_FLAGS[@]}"; do
        suffix=${entry%%:*}; rest=${entry#*:}
        flag=${rest%%:*}; sentinel=${rest#*:}
        var="DROSTE_LLAMA_$suffix"; val=${!var:-}
        [ -n "$val" ] || val=$sentinel
        case "$val" in
            "$sentinel") ;;                    # the fitter's call — emit nothing
            *[!0-9]*)
                serve::err "$var='$val' is not $sentinel or a whole number — using '$sentinel', which lets llama size the context to fit memory. Fix it in $CFG_FILE and restart the box." ;;
            *) dyn+=( "$flag" "$val" ) ;;
        esac
    done

    for entry in "${LLAMA_BOOL_FLAGS[@]}"; do
        var="DROSTE_LLAMA_${entry%%:*}"; rest=${entry#*:}
        onf=${rest%%:*}; offf=${rest#*:}; val=${!var:-}
        # Unset/blank emits NEITHER flag — upstream's own default stands.
        [ -n "$val" ] || continue
        case "$(droste::bool "$val")" in
            on)  dyn+=( "$onf" ) ;;
            off) dyn+=( "$offf" ) ;;
            *)   serve::err "$var='$val' is not on/off — leaving $onf at llama's default. Use on or off. Fix it in $CFG_FILE and restart the box." ;;
        esac
    done

    for entry in "${LLAMA_SWITCH_FLAGS[@]}"; do
        var="DROSTE_LLAMA_${entry%%:*}"; flag=${entry#*:}; val=${!var:-}
        [ -n "$val" ] || continue
        case "$(droste::bool "$val")" in
            on)  dyn+=( "$flag" ) ;;
            off) ;;   # upstream has no negation; emitting nothing IS off
            *)   serve::err "$var='$val' is not on/off — leaving $flag off. Use on or off. Fix it in $CFG_FILE and restart the box." ;;
        esac
    done

    for entry in "${LLAMA_ONOFF_FLAGS[@]}"; do
        var="DROSTE_LLAMA_${entry%%:*}"; flag=${entry#*:}; val=${!var:-}
        # Unset/blank emits nothing — a native line, or llama's own default, stands.
        [ -n "$val" ] || continue
        # ⚠️ THE LITERAL IS OURS TO CHOOSE AND IT IS NOT THE USER'S WORD. `on` and `off`
        # are what is_truthy/is_falsey accept (arg.cpp:988-994); passing `$val` through
        # would hand `Off` or `yes` to a case-sensitive comparison that rejects both and
        # then throws, which is the whole reason this row is droste-named.
        case "$(droste::bool "$val")" in
            on)  dyn+=( "$flag" on ) ;;
            off) dyn+=( "$flag" off ) ;;
            *)   serve::err "$var='$val' is not on/off — leaving $flag at llama's default. Use on or off. Fix it in $CFG_FILE and restart the box." ;;
        esac
    done

    for entry in "${LLAMA_LIST_FLAGS[@]}"; do
        var="DROSTE_LLAMA_${entry%%:*}"; flag=${entry#*:}; val=${!var:-}
        [ -n "$val" ] || continue
        mapfile -d '' -t items < <(droste::split_list ';' "$val")
        for pair in ${items[@]+"${items[@]}"}; do dyn+=( "$flag" "$pair" ); done
    done

    for entry in "${LLAMA_CHOICE_FLAGS[@]}"; do
        suffix=${entry%%|*}; rest=${entry#*|}
        IFS='|' read -r -a pairs <<<"$rest"
        def=${pairs[0]%%=*}; flags=${pairs[0]#*=}
        var="DROSTE_LLAMA_$suffix"; val=${!var:-}
        if [ -n "$val" ]; then
            ok=0
            for pair in "${pairs[@]}"; do
                if [ "${pair%%=*}" = "$val" ]; then flags=${pair#*=}; ok=1; break; fi
            done
            if [ "$ok" -eq 0 ]; then
                list=""; for pair in "${pairs[@]}"; do list="$list ${pair%%=*}"; done
                serve::err "$var='$val' is not a valid value — using the default '$def'. Valid values:$list. Fix it in $CFG_FILE and restart the box."
            fi
        fi
        # Word-split ON PURPOSE: the right-hand side is a literal from the table
        # above, never user input, and one value may expand to a flag plus its value.
        # shellcheck disable=SC2206
        dyn+=( $flags )
    done

    # Two settings that write one upstream field are a silent last-wins race. Name it.
    for g in "${LLAMA_EXCLUSIVE_GROUPS[@]}"; do
        first=""; seen=""
        for suffix in $g; do
            # A member is either a droste suffix or a NATIVE name spelled in full.
            # Four of the six pairs upstream collides are native-vs-native, and a loop
            # that could only see DROSTE_LLAMA_* was blind to every one of them.
            case $suffix in
                LLAMA_*) var=$suffix ;;
                *)       var="DROSTE_LLAMA_$suffix" ;;
            esac
            [ -n "${!var:-}" ] || continue
            [ -n "$first" ] && seen="$seen $var" || first=$var
        done
        [ -n "$seen" ] && serve::err "$first and$seen all set the same thing in llama, so the last one on the command line silently wins. Set ONE of them in $CFG_FILE."
    done

    # Retired by the LOAD_MODE collapse. Config files are seeded if_missing, so an older
    # box still carries all three lines; they must not go quietly inert.
    for suffix in MMAP MLOCK DIRECT_IO; do
        var="DROSTE_LLAMA_$suffix"
        [ -n "${!var:-}" ] || continue
        serve::err "$var is retired and is being ignored. llama deprecated --mmap/--mlock/--direct-io in favor of --load-mode, where all three set ONE value instead of three independent switches. Use DROSTE_LLAMA_LOAD_MODE in $CFG_FILE: none, mmap, mlock, mmap+mlock or dio."
    done

    # A gating dependency, not a last-wins race: the two write different fields and the
    # CONSUMER ANDs them, so an exclusive group's "last one wins" would be false here.
    # Only warns when the user SET the lazy line — a default nobody chose is not worth a
    # message, which is why the inner case matches on|auto and never the empty string.
    #
    # 🚨 IT READS THE *EFFECTIVE* MODE, NOT THE VARIABLE. Since LOAD_MODE's wiring default
    # became `none`, the commonest way to reach the dead combination is to set the lazy
    # line and never mention the load mode at all — the box then has mmap off by OUR
    # choice, not the user's. Testing "${DROSTE_LLAMA_LOAD_MODE:-}" would see an empty
    # string, match nothing, and say nothing: a knob that reads as authoritative and does
    # nothing, which is the defect this project forbids outright.
    _lm=${DROSTE_LLAMA_LOAD_MODE:-none}
    case "$_lm" in
        none|mlock|dio)
            # ⚠️ `on` ONLY, NEVER `auto`. auto is this setting's OWN default and its
            # meaning is "let llama decide" — llama deciding "no lazy reads, there is no
            # mmap" is a legitimate outcome of that, not a thwarted request. Warning on
            # auto would also break the file's contract that uncommenting a shown line is
            # a no-op, since llama.cfg ships `TENSOR_READ_LAZY=auto` as its shown value.
            # `on` is the only spelling that asks for something we cannot deliver.
            case "${DROSTE_LLAMA_TENSOR_READ_LAZY:-}" in
                on)
                    # ⚠️ TWO SENTENCES, because the remedy differs by who chose the mode.
                    if [ -n "${DROSTE_LLAMA_LOAD_MODE:-}" ]; then
                        serve::err "DROSTE_LLAMA_TENSOR_READ_LAZY=$DROSTE_LLAMA_TENSOR_READ_LAZY does nothing while DROSTE_LLAMA_LOAD_MODE=$_lm is set. llama reads tensors lazily only when the load mode keeps mmap on, so use mmap or mmap+mlock, or remove the lazy line. Fix it in $CFG_FILE and restart the box."
                    else
                        serve::err "DROSTE_LLAMA_TENSOR_READ_LAZY=$DROSTE_LLAMA_TENSOR_READ_LAZY does nothing here. This box's load mode defaults to none, which turns mmap off, and llama reads tensors lazily only with mmap on. Set DROSTE_LLAMA_LOAD_MODE=mmap (or mmap+mlock) in $CFG_FILE if you want lazy reads, or remove the lazy line. Restart the box after editing."
                    fi ;;
            esac ;;
    esac

    # Ordering: droste's own flags FIRST, the user's catch-all LAST, because llama
    # parses argv left to right and a later occurrence wins — so the user beats us on
    # every conflict, deliberately. --slot-save-path rides here too (no env var).
    #
    # 🚨 `--host 0.0.0.0` IS A DROSTE DEFAULT, NOT A CONSTANT, AND IT IS THE ONE TOKEN
    # THAT CHANGES THIS BOX'S BEHAVIOR (Jei, s59: "all should default to 0.0.0.0").
    # llama-server's own default is `params.hostname = "127.0.0.1"` (common/common.h:606),
    # so until this line existed the box bound LOOPBACK ONLY while every sibling bound all
    # interfaces — and ⭐ NOTHING COULD REPORT IT: the health probe asks 127.0.0.1, which a
    # loopback-only listener answers perfectly. An asymmetry that hides its own symptom is
    # exactly why this is a baked token rather than an absent flag.
    # ⭐ IT MAKES THIS BOX STRUCTURALLY IDENTICAL TO comfyui AND finetuning, which is the
    # point of putting it here rather than leaving the flag to the launcher alone:
    # serve::apply_host REPLACES the value after an existing flag and only APPENDS when
    # there is none, so all three now take the replace path and llama stops being the one
    # box whose address depends on an absence. The user's own value still wins — it
    # arrives through DROSTE_LLAMA_HOST and the launcher overwrites this token with it.
    # ⚠️ AND IT IS A FLAG, NEVER `LLAMA_ARG_HOST`. argv is parsed AFTER the environment
    # (arg.cpp:509-530 then :539+) so the flag wins outright, and a variable we never set
    # cannot be blank — which sidesteps the s57 box-killer (`LLAMA_ARG_HOST=""` binds ::1
    # only and restart-loops the box) instead of having to survive it.
    # ⚠️ It sits BEFORE the catch-all, like every other droste flag: a --host in
    # DROSTE_LLAMA_EXTRA_ARGS still wins here, and the launcher then rewrites the value
    # after EVERY occurrence, so the two copies cannot disagree.
    # shellcheck disable=SC2206
    mapfile -d '' -t _extra < <(droste::split_args "${DROSTE_LLAMA_EXTRA_ARGS:-}")
    SERVICE=( llama-server --slot-save-path /opt/program-cache/slots --host 0.0.0.0
              ${dyn[@]+"${dyn[@]}"} ${_extra[@]+"${_extra[@]}"} )

    # 🚨 PLACEMENT IS LOAD-BEARING IN ONE DIRECTION: it must sit BELOW the mapfile,
    # because a user may reach a draft — or a context size — through the catch-all, and
    # a check that never looked there would go quiet on exactly the box that needs the
    # message. Below that line its position is free; it appends nothing to SERVICE.
    llama_ctx_warn ${_extra[@]+"${_extra[@]}"}
}

# ── The llama.cfg → ENVIRONMENT tables ───────────────────────────────────────
# ⭐ A SECOND DELIVERY MECHANISM, AND IT IS NOT THE ARGV ONE. Every table above turns
# a setting into a llama-server FLAG. The three settings here have no flag at all, at
# this pin or any other: they are read by getenv() deep inside ggml and
# llama_kv_cache, so the only way to reach them is an exported environment variable.
# That also means DROSTE_LLAMA_EXTRA_ARGS cannot reach them, which is why they need
# settings rather than a line in the catch-all list.
#
# 🚨 WHY ALL THREE ARE DROSTE-NAMED, AND IT IS THE `off` PROBLEM AGAIN. Each native is
# read by a hand-rolled getenv test that looks at ONE CHARACTER (pinned fb2cc35a;
# all three bodies are BYTE-IDENTICAL to the previous pin — only their lines moved):
#   TURBO_AUTO_ASYMMETRIC  llama-kv-cache.cpp  `const bool disabled = (env && env[0] == '0')`
#   TURBO_LAYER_ADAPTIVE   llama-kv-cache.cpp  atoi(env) — a mode NUMBER
#   GGML_TQ_NATIVE         ggml-cuda.cu        in `ggml_tq_convert_q8()`, native = env[0]=='1'
# ⚠️ READ THE VARIABLE, NOT UPSTREAM'S COMMENT, ON THAT LAST ONE. The line is
# `val = (env && env[0] == '1') ? 0 : 1;` with the comment "default ON,
# GGML_TQ_NATIVE=1 disables" — which is about the q8 CONVERSION, not about native
# mode. Setting it to 1 turns conversion off, i.e. turns NATIVE ON. Our phrasing is
# the user-facing effect and is correct; the comment reads as contradicting it.
# So a user writing the native `TURBO_AUTO_ASYMMETRIC=off` gets env[0]=='o', which is
# not '0', and the feature stays ON: a value that reads as off, is rejected by
# nothing, and does nothing. That is the fall-through this project forbids outright,
# and it is the same defect as llama's switch-type flags one level down.
# ⚠️ NOTE THE TWO POLARITIES — one native disables on '0', the other ENABLES on '1'.
# A user must not be asked to hold that in their head (One Surface, Five Servers); the
# wire columns below absorb it and the surface says on/off for both.
# ⚠️ ggml-cuda.cu IS COMPILED HERE. ggml/src/ggml-hip/CMakeLists.txt:63 globs
# `../ggml-cuda/*.cu`, so the HIP build gets it. "cuda" in the path is not a filter.
#
# 🚨 PRECEDENCE, AND IT IS A CONTRACT, NOT AN IMPLEMENTATION DETAIL. Templates seed
# `if_missing`, so a box created before these settings existed may already carry a
# hand-written native line, and it must go on working:
#   droste setting UNSET or BLANK  → we do not touch the native. Whatever the user
#                                    put there stands. This is also what makes blank
#                                    behave EXACTLY as absent, which is the rule.
#   droste setting SET to a value  → OURS WINS. We export the wire (or, for `auto`,
#                                    UNSET the native), so the answer the user gave on
#                                    our surface is the answer the engine gets.
#   droste setting SET to garbage  → warn, touch nothing. Same as unset, so a typo can
#                                    never destroy a native line the user meant.
# ⭐ The middle row is why `auto` UNSETS rather than skipping: `auto` is a real answer,
# and an answer that quietly loses to a stale native line is a fall-through value.
#
# ⚠️ BLANK GUARDS: exactly ONE of the three natives needs one, and it is measured
# rather than assumed (run the reader with the name absent, run it "", diff):
#   TURBO_AUTO_ASYMMETRIC=""  env[0]=='\0' != '0' ⇒ enabled ⇒ SAME as absent. No guard.
#   GGML_TQ_NATIVE=""         env[0]=='\0' != '1' ⇒ convert ⇒ SAME as absent. No guard.
#   TURBO_LAYER_ADAPTIVE=""   atoi("") == 0 ⇒ mode 0 ⇒ DIFFERENT from absent, because
#                             absent runs the auto-enable at :329-333. Guarded below.
# A longer guard list is not a better one; the two without an entry earn their absence.
#
# ❌ GGML_TURBO_MMA_FUSED IS DELIBERATELY NOT HERE, AND THIS IS THE STATED REASON SO
# NOBODY RE-ADDS IT. It is compiled into this build (fattn.cu:193) and it has exactly
# one consumer, fattn.cu:803, whose condition includes `turing_mma_available(cc)` —
# and that is `GGML_CUDA_CC_IS_NVIDIA(cc) && …` (common.cuh:348-350), i.e.
# `cc < 0x0100000`. gfx1151 is `GGML_CUDA_CC_OFFSET_AMD + 0x1151` = 0x1001151, so the
# test is false on every box this repo builds for. The setting would be a knob that
# is present, authoritative-looking, and inert — the exact thing a fall-through is.
# ⚠️ AND DO NOT HARVEST ITS DEFAULT FROM UPSTREAM'S OWN COMMENT: fattn.cu:181 says
# "DEFAULT OFF" and :190 says "opt-in via GGML_TURBO_MMA_FUSED=1", while :194 is
# `return !(s && s[0] == '0')` — default ON. The prose and the code disagree.
#
# ❌ TURBO_INNERQ AND TURBO_INNERQ_STRENGTH ARE ALSO DELIBERATELY NOT HERE, AND THE
# REASON IS THE OPPOSITE OF MMA_FUSED'S. MMA_FUSED is dead on this hardware. These two
# are LIVE: turbo-quant.cuh:164 and :172 read them, ggml/src/ggml-hip/CMakeLists.txt:63
# globs `../ggml-cuda/*.cu` so the HIP build compiles the path, and there is no
# architecture predicate anywhere in it — the only gate is `group_size < 128`
# (turbo-quant.cuh:265-268). Our own default puts a turbo type on V, so the code runs on
# every V cache write. So this is a Feature Exposure decision under the rule that hiding
# needs a STATED reason, not a report that the feature is absent.
# ⚠️ IT USED TO SAY "on every K and V cache write", WHICH WAS TRUE OF THE turbo3/turbo3
# DEFAULT AND IS NOT TRUE OF q8_0/turbo3 (s67). K is no longer a turbo type, so the path
# is V-only by construction now — see the ⚠️ paragraph below, whose conclusion the change
# strengthens rather than weakens.
# 🚨 THE REASON LIVES HERE ONLY, AND THAT IS JEI'S RULING (s61), NOT AN OMISSION.
# llama.cfg carried a prose half of this in its Misc block until s60's `129499f` removed
# it. Asked whether that deletion was intended, he ruled: "all correct and intended. All
# of them. And we should fix the buildspec to match." ⇒ THE SURFACE STAYS SILENT ABOUT
# THESE TWO NAMES. ❌ Do NOT "restore the other half" — the config file is his, the
# deletion was deliberate, and re-adding it would reverse a ruling on the strength of a
# comment. ⭐ Feature Exposure asks for a reason to be WRITTEN DOWN; it does not entitle
# an agent to put it back on a surface the owner cleared.
#
# 🚨 THE REASON IS THAT WE CANNOT DOCUMENT IT HONESTLY — NOT THAT IT DOES NOTHING:
#   · THE UNIT IS UNUSABLE, AND UPSTREAM'S OWN LOG LINE IS WRONG ABOUT IT.
#     turbo-quant.cuh:184-185 prints "target=%d tokens" and :284 compares the target
#     against a counter that set-rows.cu:292 increments ONCE PER 128-ELEMENT ROTATION
#     GROUP WRITE (`if (j == 0) atomicAdd(&d_innerq_count, 1)`), i.e. roughly
#     2 × n_layer × n_head_kv per token — about 576/token on a 36-layer, 8-KV-head
#     model. Any value a user would plausibly type is reached inside the FIRST ubatch
#     of the FIRST request. ⚠️ Do not repeat upstream's word "tokens": that is the
#     LLAMA_API_KEY=none failure mode, a printed word that is prose about the value.
#   · WHAT WAS WRITTEN BEFORE IT ACTIVATES STAYS MIS-SCALED FOR THE LIFE OF THE
#     PROCESS. Nothing clears the cache at finalisation (turbo-quant.cuh:189-250). In a
#     server that is the system prompt and the start of the first conversation.
#   · THE ACTIVATION POINT IS NOT DETERMINISTIC. The host reads the counter with a
#     BLOCKING cudaMemcpyFromSymbol on the legacy default stream (:283) while ggml's
#     compute streams are created cudaStreamNonBlocking, so activation can land between
#     two layers of one forward pass.
#   · CALIBRATION IS ONCE PER PROCESS and never persisted — a plain static latch
#     (`innerq_initialized`, :156/:161-162).
#   · TURBO_INNERQ_STRENGTH IS INERT UNLESS TURBO_INNERQ IS SET. Its getenv at :172
#     sits AFTER the early return at :165-168. A fall-through value in the s52 sense,
#     and one we would be publishing ourselves.
#   · ⚠️ IT IS NOT "CLAMPED TO (0,1]" — say rejected, not clamped. :174 is
#     `if (strength <= 0.0f || strength > 1.0f) strength = 0.5f`, so `2.0` becomes
#     0.5, NOT 1.0. (The genuine [0.5, 2.0] clamp is on the derived per-channel scale,
#     a different quantity.)
#   · AND THERE IS NOTHING TO SHOW FOR IT. It changes output quality only — no memory
#     saved, negligible speed cost — and the fork publishes no measurement, not even a
#     prose claim, unlike auto-asymmetric (PPL 2887 vs 7.4) or the MMA path (KLD).
#
# ⚠️ ONE OF THE REASONS IS OURS, NOT UPSTREAM'S, AND IT BELONGS IN OUR FILE. Our default
# is q8_0 on K and turbo3 on V (s67), so only V goes through the turbo set_rows path and
# InnerQ is V-ONLY equalisation on every box, which is not the thing it was written to
# do. That is our default interacting with the feature, so it is our defect to name.
# ⭐ THE s67 CACHE-TYPE CHANGE MADE THIS REASON STRONGER, NOT WEAKER, AND THE DIRECTION
# IS WORTH RECORDING. It used to hold only when DROSTE_LLAMA_KV_AUTO_ASYMMETRIC fired —
# which the old turbo3/turbo3 default armed on any high-GQA model, but not on every one.
# Setting K to q8_0 ourselves makes it unconditional and removes the model-dependence.
#
# ⭐ THE DOOR BACK, because a hidden feature with no way back is worse than one with a
# stated condition: if InnerQ is ever benchmarked on gfx1151 with turbo3 caches, this
# decision should be REOPENED. The blocker is a missing measurement, and a measurement
# is a thing that can arrive.
# ⚠️ BOTH ARE BLANK-SAFE AND NEITHER NEEDS A GUARD — measured the usual way, absent vs
# "": `getenv("TURBO_INNERQ")` returns a non-NULL "" whose `atoi` is 0, which fails the
# `atoi(env) <= 0` test at :165 exactly as a NULL does; STRENGTH's `atof("")` is 0.0f,
# which :174 replaces with the same 0.5f default it would have kept. Do not add one.
#
# "<SUFFIX>:<native>:<on-wire>:<off-wire>" — the variable is DROSTE_LLAMA_<SUFFIX>.
LLAMA_ENV_BOOLS=(
    "KV_AUTO_ASYMMETRIC:TURBO_AUTO_ASYMMETRIC:1:0"
    "TQ_NATIVE_WEIGHTS:GGML_TQ_NATIVE:1:0"
)
# "<SUFFIX>|<native>|<value>=<wire>|…" — llama_argv's CHOICE shape, with the native's
# name in the second field and one extra convention: a wire of `-` means DO NOT SET
# THE VARIABLE AT ALL. That is the only spelling `auto` has, because the absence is
# what runs llama-kv-cache.cpp:329-333 — the auto-enable of mode 7 when V is turbo2
# and the model has 8+ layers. Exporting a number, ANY number, suppresses it.
# ⚠️ THE MODE NUMBERS ARE NOT CONTIGUOUS AND THAT IS WHY THIS IS A WHITELIST. Upstream
# branches on 1, 2, 5, 6 and 7 (:339-369); 3 and 4 parse fine through atoi and match
# no branch, so raw numbers on the surface would hand the user two silent no-ops.
LLAMA_ENV_CHOICES=(
    "KV_LAYER_ADAPTIVE|TURBO_LAYER_ADAPTIVE|auto=-|off=0|q8-ends=1|q8-last8=2|v-turbo4-ends=5|v-turbo4-last8=6|v-q8-ends=7"
)

# llama_env — DROSTE_LLAMA_* → the exported environment. Its own function for the same
# reason llama_argv is: it can be driven alone, and it is the half of PRE_LAUNCH that
# produces no argv at all, so a test written against SERVICE is blind to it.
# ⚠️ `export`, NEVER a bare assignment: `set +a` runs before PRE_LAUNCH (the s52
# lesson), so an unexported value would never cross the exec.
llama_env() {
    local entry suffix native var val rest onw offw wire ok list pair
    local -a pairs=()

    for entry in "${LLAMA_ENV_BOOLS[@]}"; do
        suffix=${entry%%:*}; rest=${entry#*:}
        native=${rest%%:*}; rest=${rest#*:}
        onw=${rest%%:*}; offw=${rest#*:}
        var="DROSTE_LLAMA_$suffix"; val=${!var:-}
        # Unset/blank leaves the native alone — see PRECEDENCE above.
        [ -n "$val" ] || continue
        case "$(droste::bool "$val")" in
            on)  export "$native=$onw" ;;
            off) export "$native=$offw" ;;
            *)   serve::err "$var='$val' is not on/off — leaving $native alone. Use on or off. Fix it in $CFG_FILE and restart the box." ;;
        esac
    done

    for entry in "${LLAMA_ENV_CHOICES[@]}"; do
        suffix=${entry%%|*}; rest=${entry#*|}
        native=${rest%%|*}; rest=${rest#*|}
        IFS='|' read -r -a pairs <<<"$rest"
        var="DROSTE_LLAMA_$suffix"; val=${!var:-}
        [ -n "$val" ] || continue
        wire=""; ok=0
        for pair in "${pairs[@]}"; do
            if [ "${pair%%=*}" = "$val" ]; then wire=${pair#*=}; ok=1; break; fi
        done
        if [ "$ok" -eq 0 ]; then
            list=""; for pair in "${pairs[@]}"; do list="$list ${pair%%=*}"; done
            serve::err "$var='$val' is not a valid value — leaving $native alone. Valid values:$list. Fix it in $CFG_FILE and restart the box."
            continue
        fi
        if [ "$wire" = "-" ]; then unset "$native"; else export "$native=$wire"; fi
    done
}

# ── WHERE A `-hf` DOWNLOAD LANDS, AND THE FIVE NAMES THAT MOVE IT (N27, chain A)
#
# 🚨 THE CRITICAL ROW ABOVE IS STRUCTURALLY BLIND TO THIS, WHICH IS WHY THE CHECK IS
# HERE AND NOT THERE. resolve::apply_spec evaluates CRITICAL at STEP 3 and applies
# CFG_FILE at STEP 6 — the row is checked before the config that moves the path even
# exists. A "smarter CRITICAL" cannot see a user's HF_HOME, ever. PRE_LAUNCH is step 7,
# after the config is in effect, so it is the first place the question is answerable.
#
# THE CHAIN, read from the pinned fork (TheTom/llama-cpp-turboquant @ fb2cc35a),
# common/hf-cache.cpp — `get_cache_directory()`, whose body is
# `static const fs::path cache = []() {` over an `entries[]` table, i.e. a
# function-local static: the FIRST rung that is set-and-non-empty decides and nothing
# later re-reads it. The rungs, IN TABLE ORDER (re-verified at the bump; the table
# moved but neither its order nor its suffixes changed):
#
#   LLAMA_CACHE            <value>
#   HF_HUB_CACHE           <value>
#   HUGGINGFACE_HUB_CACHE  <value>
#   HF_HOME                <value>/hub
#   XDG_CACHE_HOME         <value>/huggingface/hub
#   HOME                   <value>/.cache/huggingface/hub   (spelled HOME_DIR)
#
# and it IS the `-hf` lane: common/download.cpp:786-848 (common_download_model) builds
# every task from hf_cache::* when `model.hf_repo` is non-empty, and hf_cache paths all
# come from get_repo_path() → get_cache_directory(). The `-mr`/docker lane goes through
# fs_get_cache_file (common/common.cpp) instead — a DIFFERENT chain, guarded separately
# above (see _cache_blank_is_unset), and NOT what this function is about.
#
# ⭐ ONLY THE FIRST FIVE ARE LISTED, AND THE OMISSION OF HOME IS THE DESIGN.
# HOME is the rung the CRITICAL row is WRITTEN against: `$HOME/.cache/huggingface`
# contains `$HOME/.cache/huggingface/hub` by construction, so reaching that rung is the
# supported path and has nothing to report. (Both lanes agree on which home that is —
# droste-init-hook.sh:53-54 exports HOME=$DROSTE_USER_HOME before the spec is sourced,
# and serve::launch:1321 hands the service the same value.) A user who re-points HOME
# itself moves far more than a model cache and is not what this guard is for.
#
# ⚠️ A BLANK RUNG NEEDS NO GUARD HERE — verified at the pin. hf-cache.cpp:51 is
# `if (auto * p = std::getenv(entry.var); p && *p)`, so an empty string is skipped and
# the chain falls through exactly as if the name were absent. The `[ -n … ] || continue`
# below is that same test, deliberately, and not a droste policy laid on top of it.
# (Its twin in chain B is a BARE `getenv()` with no `*p` — that asymmetry is why
# LLAMA_CACHE still needs the blank guard above. Same variable, same repository, two
# different answers; do not generalize one to the other.)
#
# ⭐ IT WARNS, IT DOES NOT REFUSE. Putting the cache somewhere else is a legitimate
# thing to want — a bigger disk, a share, a directory the user binds themselves. The
# defect this closes is that it happened SILENTLY. "Never resolve a failure toward more
# exposure" is about honoring a narrowing intent, and nothing here is narrowed by
# declining to start; the box would just be down.
#
# "<NAME>:<subdirectory the C++ appends to it>" — hf-cache.cpp:43-47, in ITS order.
LLAMA_HF_CACHE_RUNGS=(
    "LLAMA_CACHE:"
    "HF_HUB_CACHE:"
    "HUGGINGFACE_HUB_CACHE:"
    "HF_HOME:hub"
    "XDG_CACHE_HOME:huggingface/hub"
)

# llama_hf_cache_bind — the hf-cache path, read back out of the CRITICAL array the
# resolver itself checked rather than re-derived from $HOME. One source of truth: if
# the row ever moves, the warning follows it without a second edit, and the directory
# named in the message is provably the directory the box guaranteed. Prints nothing if
# the row is gone, which makes the caller a silent no-op rather than a liar.
# ⭐ CRITICAL IS POPULATED IN BOTH LANES: droste-resolve.sh sources the spec, and
# serve::build_service declares the array and sources the spec too (droste-serve.sh:1784).
llama_hf_cache_bind() {
    local entry
    for entry in ${CRITICAL[@]+"${CRITICAL[@]}"}; do
        case "$entry" in
            hf-cache:*) printf '%s\n' "${entry#hf-cache:}"; return 0 ;;
        esac
    done
    return 0
}

# llama_hf_path_norm — ONE spelling per directory. Two spellings of one place must not
# read as two places (the project's path rule), so `.../huggingface/hub/`,
# `.../huggingface/./hub` and `.../cache/../cache/huggingface/hub` all collapse before
# anything is compared. This is the in-box twin of the installer's same_dir, which is
# host-side and unreachable from here; -m so a directory that does not exist yet still
# normalizes. A realpath we cannot run leaves the string as written — degraded to a
# textual compare, never fatal.
llama_hf_path_norm() {
    local n
    n=$(realpath -m -- "$1" 2>/dev/null) || n=""
    [ -n "$n" ] || n=$1
    n=${n%/}
    [ -n "$n" ] || n=/
    printf '%s\n' "$n"
}

# llama_hf_cache_warn — say so, once, when the winning rung lands outside the bind.
# ⚠️ EVERY ARM RETURNS 0. The resolver calls PRE_LAUNCH BARE under `set -euo pipefail`
# (droste-resolve.sh), so a non-zero return from a DIAGNOSTIC would take the box down —
# the exact defect droste-common.sh's fallbacks were written to stop.
# ⚠️ IT MUST RUN AFTER the blank normalization above: an XDG_CACHE_HOME the user
# cleared is unset by then, so it is correctly not treated as the winning rung.
llama_hf_cache_warn() {
    local bind entry name suffix base dir nbind ndir
    bind=$(llama_hf_cache_bind)
    [ -n "$bind" ] || return 0
    nbind=$(llama_hf_path_norm "$bind")
    for entry in "${LLAMA_HF_CACHE_RUNGS[@]}"; do
        name=${entry%%:*}; suffix=${entry#*:}
        base=${!name:-}
        # unset OR blank — hf-cache.cpp:51's `p && *p`, not a policy of ours.
        [ -n "$base" ] || continue
        dir=$base
        [ -z "$suffix" ] || dir="$base/$suffix"
        ndir=$(llama_hf_path_norm "$dir")
        case "$ndir" in
            "$nbind" | "$nbind"/*) : ;;   # inside the bind — the guarantee still holds
            *)
                serve::warn "$name=$base moves llama-server's -hf downloads to $dir, outside the persisted hf-cache bind ($bind). Unless you have bound a host directory at $dir yourself, models downloaded there are lost when this box is recreated and llama re-downloads them. Remove $name from $CFG_FILE to download into $bind, or add a volume for $dir to this box."
                ;;
        esac
        # The chain STOPS at the first rung that is set (hf-cache.cpp:49-55), so a lower
        # rung pointing somewhere else is never read and must never be reported.
        return 0
    done
    return 0
}

# ── PRE_LAUNCH ───────────────────────────────────────────────────────────────
PRE_LAUNCH="llama_pre_launch"
llama_pre_launch() {
    # ── a NATIVE line whose PRINTED value does not do what it is annotated to ──
    # 🚨 llama.cfg prints `LLAMA_ARG_THREADS=-1   # -t, --threads (-1: count
    # machine's math cores)` and its header promises the values shown ARE the defaults — but
    # uncommenting that line ROUGHLY DOUBLES the thread count on an SMT machine, the
    # classic llama.cpp oversubscription regression.
    # The handler normalizes before the auto-detect can ever run: the
    # `.set_env("LLAMA_ARG_THREADS")` option's own lambda (pinned fb2cc35a) is
    # `params.cpuparams.n_threads = value; if (params.cpuparams.n_threads <= 0) {
