# vllm.env -- vLLM environment configuration (one half of this box's config surface).
#
# Seeded to /opt/data/vllm.env on first start and NEVER overwritten -- your edits
# here win. Everything ships commented out; uncomment a line to set it.
#
# THIS BOX HAS TWO CONFIG FILES, because vLLM has two kinds of setting and no
# single file can carry both:
#
#   /opt/data/vllm_config.yaml   SERVE FLAGS. Every long `vllm serve` flag is a
#                                key there (`--max-model-len` is `max-model-len:`).
#                                That is where the model, the memory settings and
#                                the scheduler live.
#
#   /opt/data/vllm.env  (this)   ENVIRONMENT VARIABLES. vLLM reads ~209 of them at
#                                runtime, and they are NOT expressible as YAML keys
#                                -- several are read before any config is parsed.
#                                The ROCm performance switches are all here.
#
# Anything assigned in this file is exported to the vLLM process. Command-line
# flags and YAML keys are the other mechanism; where a variable has a flag twin,
# the flag usually wins (--api-key beats VLLM_API_KEY, for instance).
#
# The full variable reference is upstream's, and it is a documented public API:
#   https://docs.vllm.ai/en/latest/configuration/env_vars.html
# This file names the ones that matter on this hardware. Any other variable from
# that page can simply be added as a line.
#
# Reserved by droste (do not set these)
# -------------------------------------
# Droste needs these to remain unchanged for its setup & teardown of boxes; any
# additions or changes are likely to break the box boot, services, and/or
# functionality.
#
#   --port      owned by PORT in /opt/data/server.env. The launcher rewrites the
#               value of any --port already on the command line and otherwise
#               appends its own, so a --port inside VLLM_EXTRA_ARGS is REWRITTEN
#               rather than beaten. Change the port in server.env.
#   VLLM_TARGET_DEVICE  this image is built for ROCm.


# Extra Arguments (options this file does not cover)
# --------------------------------------------------
# A "catch-all" for user-elected `vllm serve` arguments, appended after --config.
# vLLM splices the YAML's keys in first, so anything here OVERRIDES the same key
# in vllm_config.yaml. "Mix and match" with YAML keys may cause boot failure due
# to exclusions, so users should confirm the absence of argument conflicts in
# advance -- vLLM logs "Found duplicate keys" when it sees one.
#
# Entry should be one quoted value; it is then split on whitespace into separate
# arguments, so an individual argument cannot itself contain spaces.
#
# **This variable was advertised by the box before it had anywhere to live. It
# works now; this file is that anywhere.
#
# VLLM_EXTRA_ARGS="--attention-backend TRITON_ATTN --enforce-eager"


# Config File (which YAML the server reads)
# -----------------------------------------
# {path}
#
# A selector, not a raw path you must know: unset, the box serves the seeded
# /opt/data/vllm_config.yaml. Point it at another file to keep several
# configurations side by side and switch with a restart.
#
# VLLM_CONFIG=/opt/data/vllm_config.yaml


# ROCm Performance (the tuning surface for this GPU)
# --------------------------------------------------
# {boolean, 0 or 1}
#
# **AITER IS THE BIGGEST ROCm PERFORMANCE LEVER AND IT DEFAULTS TO OFF. The
# parent switch below gates 13 further VLLM_ROCM_USE_AITER_* switches (linear,
# MoE, attention, rmsnorm and so on), each of which can also be turned off
# individually once the parent is on. Until this file existed there was no way to
# turn any of them on for the served process.
#
# Treat it as an experiment, not a default: measure a workload before and after,
# and be ready to turn it back off. Nothing here is verified on gfx1151 by us.
#
# VLLM_ROCM_USE_AITER=0
#
# Per-kernel toggles, independent of aiter:
#
# VLLM_ROCM_FP8_PADDING=1              # default 1
# VLLM_ROCM_MOE_PADDING=1
# VLLM_ROCM_USE_SKINNY_GEMM=1
# VLLM_ROCM_CUSTOM_PAGED_ATTN=1
# VLLM_ROCM_SHUFFLE_KV_CACHE_LAYOUT=0


# FP8 on Strix Halo
# -----------------
# {boolean, 0 or 1}
#
# **THIS ONE IS OURS, not upstream's -- it opts into the patched FP8 kernels this
# image carries, and it is OFF by default. The FP8 model stanza in
# vllm_config.yaml tells you to export it; this is where that export goes.
# Without it, that model runs on stock torch._scaled_mm, silently, with nothing
# indicating the opt-in did not happen.
#
# VLLM_STRIX_FP8_TRITON=0


# Model Sources (where weights come from)
# ---------------------------------------
# {token}, {path}, {boolean}
#
#   HF_TOKEN                    for gated repos (Llama, Gemma, some Qwen mirrors).
#                               Without it the download fails with an error that
#                               does not name the missing token.
#   HF_HUB_OFFLINE              1 = never reach the network; use the cache only
#   VLLM_MODEL_REDIRECT_PATH    a file mapping repo ids to local paths -- the
#                               air-gap tool, and the way to serve a model from
#                               the /opt/models bind under its hub name
#
# HF_TOKEN=
# HF_HUB_OFFLINE=0
# VLLM_MODEL_REDIRECT_PATH=


# Context Length
# --------------
# {boolean, 0 or 1}
#
# The documented escape for asking for a longer context than the model's own
# config.json declares. There is no command-line equivalent -- this variable is
# the only way. Expect degraded quality past the trained length.
#
# VLLM_ALLOW_LONG_MAX_MODEL_LEN=0


# Logging
# -------
# {level} and {boolean}s
#
# The box's service log (/opt/data/.droste-serve.log) is the only diagnostic when
# something goes wrong, and there is no command-line verbosity knob.
#
# VLLM_LOGGING_LEVEL=INFO              # DEBUG when you need it
# VLLM_LOGGING_PREFIX=
# VLLM_LOGGING_STREAM=
# VLLM_DISABLE_LOG_LOGO=0
# VLLM_DEBUG_LOG_API_SERVER_RESPONSE=0


# Idle Behaviour & Timeouts
# -------------------------
# {boolean} and {seconds}
#
# **VLLM_SLEEP_WHEN_IDLE interacts with the box's supervision: the healthcheck
# probes /health on a schedule, so a server that sleeps still has to answer. It
# is a power knob on a desktop-class box, not a shutdown.
#
# VLLM_SLEEP_WHEN_IDLE=0
# VLLM_ENGINE_ITERATION_TIMEOUT_S=60
# VLLM_RPC_TIMEOUT=10000


# Cache Locations
# ---------------
# {path} and {MB}
#
# These interact with the box's cache mounts. ~/.cache/vllm is already bound to
# the shared compute-cache store, so re-pointing VLLM_CACHE_ROOT moves data off a
# volume that is deliberately shared between boxes.
#
# VLLM_CACHE_ROOT=
# VLLM_ASSETS_CACHE=
# VLLM_XGRAMMAR_CACHE_MB=


# Set by the image (listed so you can tell what is already done)
# ---------------------------------------------------------------
# These are baked into the container environment. They are shown because the
# model stanzas in vllm_config.yaml instruct some of them as exports, and without
# this list there is no way to tell an instruction that is already satisfied from
# one that is not. Uncommenting a line here DOES override the image's value.
#
# VLLM_USE_TRITON_AWQ=1                # the five AWQ stanzas rely on this
# VLLM_DISABLE_COMPILE_CACHE=1         # no persisted torch.compile graphs; if
#                                      # vLLM crashes after a version bump,
#                                      # rm -rf ~/.cache/vllm
# VLLM_NO_USAGE_STATS=1                # no usage reporting
# VLLM_TARGET_DEVICE=rocm              # reserved; see the header


# Options for Debugging & Development
# -----------------------------------
# Authentication
#   VLLM_API_KEY -- has a command-line twin, --api-key, which BEATS it. Use the
#   flag (in VLLM_EXTRA_ARGS or as api-key: in the YAML). It is safe with this
#   box's supervision: vLLM's auth middleware skips any path outside /v1, so
#   /health still answers and the healthcheck keeps working.
#
# Upstream's env-var page lists ~209 runtime variables; roughly 9 more are
# build-time only and do nothing here (CMAKE_BUILD_TYPE, MAX_JOBS, NVCC_THREADS,
# VERBOSE, CUDA_HOME, VLLM_USE_PRECOMPILED, VLLM_PRECOMPILED_WHEEL_LOCATION,
# VLLM_SKIP_PRECOMPILED_VERSION_SUFFIX).
