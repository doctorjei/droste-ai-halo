# LLAMA_ARG_FIT=on          # -fit, --fit
# LLAMA_ARG_FIT_TARGET=1024 # -fitt, --fit-target (MiB / device, comma-sep.)
# LLAMA_ARG_FIT_CTX=4096    # -fitc, --fit-ctx (smallest fitting may pick)


