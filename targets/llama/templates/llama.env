# RoPE & YaRN context scaling
# ---------------------------
# {<number>}, {none, linear, yarn}
#
# Stretching a model past the context length it was trained for. Every one of
# these is read from the model when unset, so leave them alone unless you are
# deliberately extending a model that did not ship with the longer context.
#
#   Covers: --rope-scaling, --rope-scale, --rope-freq-base, --rope-freq-scale,
#           --yarn-orig-ctx, --yarn-ext-factor, --yarn-attn-factor,
#           --yarn-beta-slow, --yarn-beta-fast
#
# LLAMA_ARG_ROPE_SCALING_TYPE=           # default: from the model
# LLAMA_ARG_ROPE_SCALE=                  # default: from the model
# LLAMA_ARG_ROPE_FREQ_BASE=0.0           # default: from the model
# LLAMA_ARG_ROPE_FREQ_SCALE=0.0          # default: from the model
# LLAMA_ARG_YARN_ORIG_CTX=0              # 0 = the model's trained context
# LLAMA_ARG_YARN_EXT_FACTOR=-1.0         # -1.0 = from the model, 0.0 = full
# LLAMA_ARG_YARN_ATTN_FACTOR=-1.0
# LLAMA_ARG_YARN_BETA_FAST=-1.0
# LLAMA_ARG_YARN_BETA_SLOW=-1.0


