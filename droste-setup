)

# Config file seeded (if missing) onto /opt/data at first start.
declare -A BOX_CONFIG=(
  [comfyui]="extra_model_paths.yaml"
  [llama]="llama.env"
  [vllm]="vllm_config.yaml"
  [ds4]="ds4.env"
  [finetuning]=""
)

# One-line explanations for the prompted bind families (what lives there).
# Reference only since the per-bind headers were dropped — kept as the record of
# what each prompted bind actually holds.
# shellcheck disable=SC2034
declare -A BIND_DESC=(
  [data]="venv overlay upper, caches, seeded config"
  [input]="source files you feed ComfyUI"
  [output]="generated images/videos"
  [workspace]="notebooks + trained adapters - your work"
)

# The ONE pre-first-use action (dashboard Notes column; @DATA@ substituted).
declare -A BOX_NOTE=(
  [comfyui]=""
  [llama]="Set model: @DATA@/llama.env"
  [vllm]="Set model: @DATA@/vllm_config.yaml"
  [ds4]="Set model: @DATA@/ds4.env"
  [finetuning]="Token: podman logs droste-finetuning-halo-server"
)

IMAGE_PREFIX="ghcr.io/doctorjei/droste-"   # + <box> + "-halo:" + tag
IMAGE_SUFFIX="-halo:latest"
# Container/box names = droste-<box>-halo-<lane> (mirrors the image stem); see
# server_name()/dbox_name(). No fixed prefix works since <box> sits before -halo.
INIT_HOOK="/opt/resources/resolve/droste-init-hook.sh"

# ── Copy-mode size + fuse speed constants ────────────────────────────────────
# Rough size of the baked content copy-mode would duplicate onto /opt/data
# (mostly the venv; torch-stack boxes are multi-GB, llama/ds4 are compiled
# binaries with a small venv). TODO(Jei-tune): replace with measured numbers
# from `podman image inspect` / du on a real host; same for the fuse ballpark.
declare -A BOX_COPY_GB=(
  [comfyui]=14 [llama]=1 [vllm]=15 [ds4]=1 [finetuning]=16
)
FUSE_SPEED_NOTE="~30% on app files; models unaffected"  # TODO(Jei-tune)

# Filesystems kernel overlayfs rejects as an upper (the ecryptfs lesson).
overlay_hostile_fs() {
  case "$1" in
    ecryptfs|nfs*|virtiofs|fuse*|vfat|exfat|msdos|cifs|smb*|9p|overlay)
      return 0 ;;
    *) return 1 ;;
  esac
}

# ── Usage ────────────────────────────────────────────────────────────────────
usage() {
  cat <<'EOF'
Usage: droste-setup [OPTIONS] [BOX ...]

Interactive setup for the droste *-halo AI boxes (Strix Halo / gfx1151).
Guides lanes (server container / distrobox), binds, ports, and filesystem
gotchas; writes per-box recreation records (compose.yaml + distrobox ini)
plus a NOTES.md, and can pull images, create boxes, and start servers.

BOX      comfyui llama vllm ds4 finetuning   (default: interactive menu)

Options:
  --plain    ASCII output (no emoji / ANSI) — auto-detected on dumb terminals
  -h, --help show this help

Safe to re-run: existing setups are detected and never clobbered.
EOF
}

# ── Output / display helpers ─────────────────────────────────────────────────
PLAIN=0
ARG_BOXES=()
for arg in "$@"; do
  case "$arg" in
    --plain) PLAIN=1 ;;
    -h|--help) usage; exit 0 ;;
    -*) printf 'droste-setup: unknown option: %s\n' "$arg" >&2; usage >&2; exit 2 ;;
    *) ARG_BOXES+=("$arg") ;;
  esac
done
case "${TERM:-dumb}" in dumb|unknown) PLAIN=1 ;; esac
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
  *[Uu][Tt][Ff]*8*|*[Uu][Tt][Ff]*) : ;;
  *) PLAIN=1 ;;
esac

if [[ $PLAIN -eq 1 ]]; then
  RESET="" DIVCH="-"
  # Foreground-only palette (see the rework spec). EVERY color rides on one of
  # these variables so --plain / dumb terminals stay byte-for-byte colorless.
  C_FRAME="" C_TITLE="" C_BTITLE="" C_LABEL="" C_LABEL2="" C_SUB="" C_SUB2="" C_TEXT=""
  C_BRK="" C_DEF="" C_OKB="" C_OK="" C_OKT="" C_BADB="" C_BAD=""
  C_TBRK="" C_TIDX="" C_ALLB="" C_ALL="" C_ALLT="" C_ARROW="" C_SUBJ="" C_NOTE=""
  C_HDR="" C_SVC="" C_PORT="" C_GLYPH="" C_STAR=""
  C_EXE="" C_CMD="" C_TGT="" C_PH=""
  C_EXH="" C_FILE="" C_ERR=""
  # Repaint plumbing for the pull progress bar. Empty here on purpose: --plain
  # (and any dumb terminal) gets ONE static status line per image instead, so
  # the section stays byte-for-byte free of control sequences.
  CR="" EL="" BAR_F="#" BAR_E="-"
  # Dashboard state cell — ONE glyph triplet serves all four of On/Srv/Box/Auto.
  # The ASCII glyph already carries its own brackets, so the Legend adds none
  # (GB_L/GB_R empty); LEG_PAD is the trailing pad of Jei's approved Key row.
  GS_YES="[+]" GS_NO="[-]" GS_NA="[?]" W_STATE=3 GB_L="" GB_R="" LEG_PAD=""
  BULLET="-" ARROW_G=" ---> "
  BOXTL="." BOXTR="." BOXBL="'" BOXBR="'" BOXH="-" BOXV="|"
else
  RESET=$'\e[0m' DIVCH="─"
  C_FRAME=$'\e[0;94m'   # box-drawing frames + section rules
  C_TITLE=$'\e[1;96m'   # installer title (top banner only)
  C_BTITLE=$'\e[0;96m'  # per-box banner title
  C_LABEL=$'\e[0;97m'   # section label inside the rule
  C_LABEL2=$'\e[1;97m'  # section label, intro variant (Preflight, Resource Path)
  C_SUB=$'\e[4;97m'     # underlined subtitle / table header
  C_SUB2=$'\e[4;37m'    # underlined subtitle, intro variant (Resource Path)
  C_TEXT=$'\e[0;37m'    # body + prompt text
  C_BRK=$'\e[0;32m'     # [default] brackets
  C_DEF=$'\e[0;92m'     # [default] value
  C_OKB=$'\e[0;32m' C_OK=$'\e[0;92m' C_OKT=$'\e[0;36m'    # preflight ok row
  C_BADB=$'\e[0;31m' C_BAD=$'\e[0;91m'                    # preflight [!!] row
  C_TBRK=$'\e[0;34m' C_TIDX=$'\e[0;94m'                   # table [N]
  C_ALLB=$'\e[0;32m' C_ALL=$'\e[0;92m' C_ALLT=$'\e[0;97m' # table [all] row
  C_ARROW=$'\e[1;91m'   # sub-notice `-> arrow
  C_SUBJ=$'\e[1;97m'    # sub-notice subject
  C_NOTE=$'\e[3;97m'    # propagated-choice note
  C_HDR=$'\e[1;4;97m'   # dashboard section titles + column headers
  C_SVC=$'\e[3;37m'     # dashboard service name, and inline asides
  C_PORT=$'\e[1;93m'    # dashboard host port
  C_STAR=$'\e[1;3;97m'  # the *ComfyUI footnote
  C_EXE=$'\e[0;33m'     # a command's executable   (podman, distrobox)
  C_CMD=$'\e[0;95m'     # its verb                 (enter, compose, assemble create)
  C_TGT=$'\e[0;92m'     # its target               (paths, container names)
  C_PH=$'\e[0;94m'      # the <box> placeholder inside a target
  C_EXH=$'\e[1;4;97m'   # Executing-section headers (same SGR as C_HDR)
  C_FILE=$'\e[3;37m'    # emitted file names + the closing "Wrote NOTES.md."
  C_ERR=$'\e[1;91m'     # the [ERROR] tag of a failed pull/create status line
  # Repaint plumbing for the pull progress bar: carriage return + erase-to-EOL
  # (the bar can be wider than the status line that replaces it).
  CR=$'\r' EL=$'\e[K' BAR_F="▓" BAR_E="░"
  # The emoji glyphs bring their own color, so the state cell resets to bare.
  C_GLYPH=$RESET
  # Dashboard state cell — ONE glyph triplet serves all four of On/Srv/Box/Auto.
  # ⚫ covers NA *and* unknown, so there is no separate "unknown" glyph. The
  # Legend wraps the emoji in its own brackets (GB_L/GB_R); LEG_PAD is the
  # trailing pad of Jei's approved Key row.
  GS_YES=$'\U1F7E2' GS_NO=$'\U1F6D1' GS_NA=$'⚫' W_STATE=2 GB_L="[" GB_R="]"
  LEG_PAD="  "
  BULLET="·" ARROW_G=" 🭹🭹🭹⮞ "
  BOXTL="┌" BOXTR="┐" BOXBL="└" BOXBR="┘" BOXH="─" BOXV="│"
fi

say()  { printf '%s\n' "$*"; }
warn() { printf 'WARNING: %s\n' "$*" | fold -s -w 79; }
die()  { printf 'droste-setup: %s\n' "$*" >&2; exit 1; }
wrap() { printf '%s\n' "$*" | fold -s -w 79; }

section() {   # ── Name ──────... divider, 78 cols.  name [intro]
  # "intro" = the opening sections (Preflight, Resource Path), which Jei drew
  # with a bolder label than the rest.
  local name=$1 style=${2:-} line fill i n lcol=$C_LABEL
  [[ $style == intro ]] && lcol=$C_LABEL2
  n=$(( 79 - ${#name} - 6 ))
  fill=""
  # shellcheck disable=SC2324  # string append of the divider char, not math
  for (( i = 0; i < n; i = i + 1 )); do fill+=$DIVCH; done
  printf '\n%s%s %s%s%s %s%s%s\n' \
    "$C_FRAME" "$DIVCH$DIVCH" "$lcol" "$name" "$C_FRAME" "$fill" "$DIVCH" "$RESET"
}

# One combined SGR ("1;4;97") rather than color-then-attributes: three separate
# codes render identically but cost three sequences instead of one.
hdr() { printf '%s%s%s\n' "$C_HDR" "$1" "$RESET"; }

# One selectable menu option row: "  [x]rest<pad>tail". The option that is the
# CURRENT DEFAULT wears the green [default] colors; every other option wears
# the blue index colors.
#
# The letter's CASE is set here, not by the caller: capital when it is the
# current default, lowercase otherwise -- the [Y/n] convention, and the same
# rule ask_choice's own "[d/s/B]" hint follows. Callers used to hard-code it,
# which pinned each group's INITIAL default (K, F, B, A) capital forever, so a
# moved default left the rows contradicting the hint one line below them. Case
# is display-only: ask_choice lowercases both sides before validating.
# Padding is emitted only when there is a tail.
opt_row() {   # letter rest tail column-width is-default
  local ltr=$1 rest=$2 tail=$3 cw=$4 isdef=$5 brk idx pad=0
  if [[ $isdef -eq 1 ]]; then
    brk=$C_BRK idx=$C_DEF ltr=${ltr^^}
  else
    brk=$C_TBRK idx=$C_TIDX ltr=${ltr,,}
  fi
  if [[ -n $tail ]]; then
    pad=$(( cw - ${#rest} - 3 )); [[ $pad -lt 1 ]] && pad=1
  fi
  printf '  %s[%s%s%s]%s%s%*s%s%s\n' \
    "$brk" "$idx" "$ltr" "$brk" "$C_TEXT" "$rest" "$pad" "" "$tail" "$RESET"
}

# 1 when $1 is the default letter of an ask_choice letters string ($2 = that
# string; its first character is the default, by ask_choice's own contract).
isdef() { [[ $1 == "${2:0:1}" ]] && printf 1 || printf 0; }

# A colored "[default]" bracket for prompt suffixes (green [ ], bright value).
dflt() { printf '%s[%s%s%s]%s' "$C_BRK" "$C_DEF" "$1" "$C_BRK" "$C_TEXT"; }

# Indented red `-> sub-notice (secondary information about the answer above),
# set off from the next prompt by a blank line.
subnote() { printf '  %s `-> %s%s%s\n\n' "$C_ARROW" "$C_TEXT" "$1" "$RESET"; }

# Preflight rows: cyan [ok] / red [!!]. Preflight never blocks, so a problem is
# reported here rather than through warn().
pf_ok()  { printf '  %s[%s%s%s]%s %s%s\n' "$C_OKB" "$C_OK" "ok" "$C_OKB" "$C_OKT" "$1" "$RESET"; }
pf_bad() { printf '  %s[%s%s%s]%s %s%s\n' "$C_BADB" "$C_BAD" "!!" "$C_BADB" "$C_BADB" "$1" "$RESET"; }

# A titled box drawn with the light box-drawing glyphs (ASCII in --plain mode).
# banner text [bold]  — titles are all-ASCII so byte length == display width.
banner() {   # text [bold]
  local text=$1 bold=${2:-} n i fill top mid bot tcol
  n=$(( ${#text} + 2 ))          # text plus one space of padding each side
  fill=""
  for (( i = 0; i < n; i = i + 1 )); do fill+=$BOXH; done
  top="$BOXTL$fill$BOXTR"
  bot="$BOXBL$fill$BOXBR"
  # "bold" marks the per-box banners; the top installer banner is the title one.
  if [[ $bold == bold ]]; then tcol=$C_BTITLE; else tcol=$C_TITLE; fi
  mid="$BOXV $tcol$text$C_FRAME $BOXV"
  printf '\n'
  # Wrap each line separately so it renders even when RESET is empty (--plain).
  printf '  %s%s%s\n' "$C_FRAME" "$top" "$RESET"
  printf '  %s%s%s\n' "$C_FRAME" "$mid" "$RESET"
  printf '  %s%s%s\n' "$C_FRAME" "$bot" "$RESET"
}

# Underlined subtitle printed under a section divider (blank line, then indent).
# "intro" = the Resource Path subtitle, drawn a shade dimmer in the mockup.
sub() {   # text [intro]
  local scol=$C_SUB
  [[ ${2:-} == intro ]] && scol=$C_SUB2
  printf '\n  %s%s%s\n' "$scol" "$1" "$RESET"
}

# Pad a cell whose DISPLAY width may differ from its byte length (emoji).
pad_cell() {   # text display-width column-width
  local text=$1 dw=$2 cw=$3 n
  n=$(( cw - dw )); [[ $n -lt 1 ]] && n=1
  printf '%s%*s' "$text" "$n" ""
}

# Same as pad_cell, but styles the WORDS only — the padding stays plain.
# UNDERLINE is the one attribute in this palette that renders on blanks (a bold
# space is a space; a colored space is a space), which is why this variant, and
# only this variant, spends a RESET before the padding.
pad_cell_u() {   # text display-width column-width
  local text=$1 dw=$2 cw=$3 n
  n=$(( cw - dw )); [[ $n -lt 1 ]] && n=1
  printf '%s%s%s%*s' "$C_HDR" "$text" "$RESET" "$n" ""
}

# Responsive output width, one column under the terminal so nothing ever touches
# the right edge. 59 is the floor (a phone) — narrower than that we accept
# wrapping rather than eliding, because the command lines below the table are
# copy-paste payload and a truncated command is worse than a wrapped one.
#
# `tput cols` FIRST, not COLUMNS: bash only maintains COLUMNS in an interactive
# shell with checkwinsize, so in the documented `curl … | bash` path it is always
# unset and a COLUMNS-only reading would silently pin the width to the fallback
# forever. COLUMNS still wins when explicitly exported, which is how the tests
# drive this.
term_width() {
  local w=${COLUMNS:-}
  [[ -z $w ]] && w=$(tput cols 2>/dev/null || echo 80)
  case "$w" in ''|*[!0-9]*) w=80 ;; esac
  w=$(( w - 1 )); [[ $w -lt 59 ]] && w=59
  printf '%s' "$w"
}

home_disp() {  # compress $HOME → ~ for display
  local p=$1
  if [[ $p == "$HOME" ]]; then printf '~'
  elif [[ $p == "$HOME"/* ]]; then printf '~%s' "${p#"$HOME"}"
  else printf '%s' "$p"; fi
}

# ── Path fitting ─────────────────────────────────────────────────────────────
# Shrink a path to a cell budget, surrendering detail in this order (the LAST
# item surrendered is the most protected):
#   4. inner directories — revealed a character at a time from BOTH ends
#   3. the rest of the leaf filename
#   2. ~, the level below it, and the leaf's PARENT directory
#   1. the leaf's first 8 characters — held while anything else remains
# Tier 2 outranks tier 3, so a squeezed path keeps its SHAPE (where the file
# lives) even at the cost of a blunter filename. It is CONDITIONAL: a path that
# already fits is left alone. Abbreviation is three literal dots, never "…",
# because the ellipsis character is tofu on some of the terminals this runs on.
# Widths are character counts: these are filesystem paths, all narrow.
FP_LEAF_MIN=8
_FP_HEAD="" _FP_D1="" _FP_PARENT="" _FP_LEAF="" _FP_INNER="" _FP_BUDGET=0

# Truncate to n characters and append "..." — stripping any separator left
# stranded against it first, since "vllm_config." + "..." reads as four dots.
_fp_cut() {   # text n
  local s=${1:0:$2}
  while [[ -n $s && $s == *[-._\ ] ]]; do s=${s%?}; done
  printf '%s...' "$s"
}

# One candidate rendering. leaf_k/inner_n of -1 mean "whole", inner_n of 0 means
# "replaced by ...", and keep_d1/keep_parent are the two tier-2 components.
_fp_render() {   # leaf_k inner_n keep_d1 keep_parent
  local lk=$1 inn=$2 kd1=$3 kp=$4 ls mid="" l r parts=()
  if [[ $lk -lt 0 ]]; then ls=$_FP_LEAF; else ls=$(_fp_cut "$_FP_LEAF" "$lk"); fi
  if [[ -n $_FP_INNER ]]; then
    if [[ $inn -lt 0 ]]; then mid=$_FP_INNER
    elif [[ $inn -eq 0 ]]; then mid="..."
    else
      l=$(( (inn + 1) / 2 )); r=$(( inn - l ))
      mid="${_FP_INNER:0:l}..."
      [[ $r -gt 0 ]] && mid+="${_FP_INNER: -r}"
    fi
  fi
  parts=("$_FP_HEAD")
  [[ $kd1 -eq 1 ]] && parts+=("$_FP_D1")
  if [[ -n $mid ]]; then parts+=("$mid")
  elif [[ $kd1 -eq 0 ]]; then parts+=("...")   # never let the head abut the parent
  fi
  [[ $kp -eq 1 ]] && parts+=("$_FP_PARENT")
  parts+=("$ls")
  local IFS=/
  printf '%s' "${parts[*]}"
}

# The richest rendering that fits for one tier-2 configuration: buy back the
# leaf first (tier 3), then the inner directories (tier 4). Returns 1 when even
# the bluntest rendering of this configuration is too wide.
_fp_best() {   # keep_d1 keep_parent
  local kd1=$1 kp=$2 lk cand out k n
  cand=$(_fp_render "$FP_LEAF_MIN" 0 "$kd1" "$kp")
  [[ ${#cand} -le $_FP_BUDGET ]] || return 1
  lk=$FP_LEAF_MIN
  cand=$(_fp_render -1 0 "$kd1" "$kp")
  if [[ ${#cand} -le $_FP_BUDGET ]]; then
    lk=-1
  else
    for (( k = ${#_FP_LEAF} - 1; k >= FP_LEAF_MIN; k = k - 1 )); do
      cand=$(_fp_render "$k" 0 "$kd1" "$kp")
      if [[ ${#cand} -le $_FP_BUDGET ]]; then lk=$k; break; fi
    done
  fi
  # Re-maximise the inner directories against the leaf we just settled on: an
  # earlier draft kept the first fit and wasted up to five cells.
  out=$(_fp_render "$lk" 0 "$kd1" "$kp")
  cand=$(_fp_render "$lk" -1 "$kd1" "$kp")
  if [[ ${#cand} -le $_FP_BUDGET ]]; then
    out=$cand
  else
    for (( n = ${#_FP_INNER}; n >= 1; n = n - 1 )); do
      cand=$(_fp_render "$lk" "$n" "$kd1" "$kp")
      if [[ ${#cand} -le $_FP_BUDGET ]]; then out=$cand; break; fi
    done
  fi
  printf '%s' "$out"
}

fit_path() {   # path budget → path shrunk to fit
  local p=$1 comps=() n m i cand
  # Tier-2 configurations, richest first: keep ~/<level>/…/<parent>, then drop
  # the level below ~, then drop the leaf's parent too.
  local kd1s=(1 0 0) kps=(1 1 0)
  _FP_BUDGET=$2
  if [[ ${#p} -le $_FP_BUDGET ]]; then printf '%s' "$p"; return 0; fi
  IFS=/ read -r -a comps <<<"$p"
  n=${#comps[@]}
  m=$(( _FP_BUDGET - 3 )); [[ $m -lt 1 ]] && m=1
  if [[ $n -lt 4 ]]; then _fp_cut "$p" "$m"; return 0; fi
  _FP_HEAD=${comps[0]} _FP_D1=${comps[1]}
  _FP_PARENT=${comps[n - 2]} _FP_LEAF=${comps[n - 1]}
  _FP_INNER=$(IFS=/; printf '%s' "${comps[*]:2:n - 4}")
  for (( i = 0; i < 3; i = i + 1 )); do
    if cand=$(_fp_best "${kd1s[i]}" "${kps[i]}"); then
      printf '%s' "$cand"; return 0
    fi
  done
  _fp_cut "$_FP_LEAF" "$m"
}

# Shrink the PAYLOAD of a "label: payload" note (the label is the part that says
# what to do, so it is never touched). Notes with no label shrink whole.
fit_note() {   # note budget → note
  local note=$1 budget=$2 label=""
  [[ -z $note ]] && { printf ''; return 0; }
  if [[ $note == *": "* ]]; then label="${note%%: *}: "; note=${note#"$label"}; fi
  printf '%s' "$label"
  fit_path "$note" "$(( budget - ${#label} ))"
}

expand_path() {  # ~ expansion + absolutize + normalize (realpath -m style)
  local p=$1
  # shellcheck disable=SC2088  # matching a LITERAL leading ~ is the point
  case "$p" in
    "~") p=$HOME ;;
    "~/"*) p=$HOME/${p#\~/} ;;
    /*) : ;;
    *) p=$PWD/$p ;;
  esac
  # Collapse ., .., //  without requiring the path to exist.
  p=$(realpath -m -- "$p" 2>/dev/null) || :
  printf '%s' "$p"
}

# ── Prompt plumbing (curl|bash-safe: /dev/tty, or the scripted-input hook) ───
ASK_FD=""
SCRIPTED=0
init_input() {
  if [[ -n "${DROSTE_SETUP_INPUT:-}" ]]; then
    [[ -r "$DROSTE_SETUP_INPUT" ]] || die "cannot read DROSTE_SETUP_INPUT=$DROSTE_SETUP_INPUT"
    exec {ASK_FD}<"$DROSTE_SETUP_INPUT"
    SCRIPTED=1
  else
    if ! exec {ASK_FD}</dev/tty; then
      die "no controlling terminal for prompts (this installer is interactive)"
    fi
  fi
}

ANS=""
ask_raw() {  # $1 = prompt text (printed without newline)
  # ONE place owns the 2-space prompt indent — call sites pass bare text.
  printf '  %s' "$1"
  if ! IFS= read -r ANS <&"$ASK_FD"; then
    printf '\n'
    die "prompt input exhausted"
  fi
  if [[ $SCRIPTED -eq 1 ]]; then printf '%s\n' "$ANS"; fi
}

ANS_YN=0
ask_yn() {  # question default(Y|N)  → ANS_YN=1/0
  local q=$1 def=$2 hint
  [[ $def == Y ]] && hint=$(dflt "Y/n") || hint=$(dflt "y/N")
  while :; do
    ask_raw "$q $hint: "
    case "$ANS" in
      "") [[ $def == Y ]] && ANS_YN=1 || ANS_YN=0; return 0 ;;
      y|Y) ANS_YN=1; return 0 ;;
      n|N) ANS_YN=0; return 0 ;;
    esac
  done
}

ask_yn_q() {  # question default(Y|N) → ANS_YN  (renders "... [y/N]?: ")
  local q=$1 def=$2 hint
  [[ $def == Y ]] && hint=$(dflt "Y/n") || hint=$(dflt "y/N")
  while :; do
    ask_raw "$q $hint?: "
    case "$ANS" in
      "") [[ $def == Y ]] && ANS_YN=1 || ANS_YN=0; return 0 ;;
      y|Y) ANS_YN=1; return 0 ;;
      n|N) ANS_YN=0; return 0 ;;
    esac
  done
}

ANS_CH=""
ask_choice() {  # prompt letters(first=default, shown capital) → ANS_CH (lower)
  local q=$1 letters=$2 def=${2:0:1} c
  # Color a trailing "[a/b/C]" hint exactly like every other [default] bracket
  # (the hint is part of the caller's prompt text, so it is re-wrapped here).
  if [[ $q =~ ^(.*)\[([^][]*)\]$ ]]; then
    q="${BASH_REMATCH[1]}$(dflt "${BASH_REMATCH[2]}")"
  fi
  while :; do
    ask_raw "$q: "
    [[ -z $ANS ]] && ANS=$def
    c=${ANS,,}
    if [[ ${#c} -eq 1 && ${letters,,} == *"$c"* ]]; then
      ANS_CH=$c
      return 0
    fi
  done
}

ANS_PATH=""
ask_path_raw() {  # label default → ANS_PATH (absolute; NOT created)
  local label=$1 def=$2 typed
  ask_raw "What path should be used for $label? $(dflt "$(home_disp "$def")") "
  typed=$ANS
  [[ -z $ANS ]] && ANS=$def
  ANS_PATH=$(expand_path "$ANS")
  # Make the interpretation visible whenever the typed answer was not
  # already the resolved absolute form (relative tokens, ~, ./x, x/../y).
  if [[ -n $typed && $typed != "$ANS_PATH" ]]; then
    say "  -> $ANS_PATH"
  fi
  return 0
}

ask_path() {  # label default → ANS_PATH (existing dir, or confirm-create, else re-ask)
  # No silent mkdir: an existing dir is accepted as-is; otherwise confirm before
  # creating, and re-ask the path if the user declines or the create fails.
  while :; do
    ask_path_raw "$1" "$2"
    [[ -d $ANS_PATH ]] && return 0
    ask_yn "Create $(home_disp "$ANS_PATH")?" Y
    if [[ $ANS_YN -eq 1 ]]; then
      mkdir -p "$ANS_PATH" 2>/dev/null && return 0
      warn "could not create $ANS_PATH — pick another location"
    fi
  done
}

# Terse variant: the caller supplies the FULL prompt label; we append the
# "[default]: " suffix. Same expand + interpretation-echo as ask_path_raw.
ask_path_as_raw() {  # "prompt label" default → ANS_PATH (absolute; NOT created)
  local label=$1 def=$2 typed
  ask_raw "$label $(dflt "$(home_disp "$def")"): "
  typed=$ANS
  [[ -z $ANS ]] && ANS=$def
  ANS_PATH=$(expand_path "$ANS")
  if [[ -n $typed && $typed != "$ANS_PATH" ]]; then
    say "  -> $ANS_PATH"
  fi
  return 0
}

ask_path_as() {  # "prompt label" default → ANS_PATH (existing dir, or confirm-create, else re-ask)
  # No silent mkdir: an existing dir is accepted as-is; otherwise confirm before
  # creating, and re-ask the path if the user declines or the create fails.
  while :; do
    ask_path_as_raw "$1" "$2"
    [[ -d $ANS_PATH ]] && return 0
    ask_yn "Create $(home_disp "$ANS_PATH")?" Y
    if [[ $ANS_YN -eq 1 ]]; then
      mkdir -p "$ANS_PATH" 2>/dev/null && return 0
      warn "could not create $ANS_PATH — pick another location"
    fi
  done
}

ANS_PORT=""
ask_port() {  # box default → ANS_PORT
  local box=$1 def=$2 other
  while :; do
    ask_raw "What host port should be used for ${BOX_NAME[$box]} $(dflt "$def")? "
    [[ -z $ANS ]] && ANS=$def
    if [[ ! $ANS =~ ^[0-9]+$ ]] || (( ANS < 1 || ANS > 65535 )); then
      say "  Please give a port number (1-65535)."
      continue
    fi
    other=""
    local b
    for b in "${BOXES[@]}"; do
      [[ $b == "$box" ]] && continue
      [[ "${CFG_PORT[$b]:-}" == "$ANS" ]] && other=$b
    done
    if [[ -n $other ]]; then
      subnote "Port $ANS is already assigned to $other — pick another."
      continue
    fi
    ANS_PORT=$ANS
    return 0
  done
}

# ── State ────────────────────────────────────────────────────────────────────
declare -A ACTION            # box → new|keep|recreate|modify
declare -A CFG_LANE          # box → server|distrobox|both
declare -A CFG_AS            # box → 1|""
declare -A CFG_PORT          # box → host port ("" for distrobox-only)
declare -A CFG_MODE          # box → ""|fuse|copy|ignore  (overlay mitigation)
declare -A CFG_FS            # box → probed fstype of the data dir
declare -A PATHS             # "box:label" → absolute host path
declare -A EX_COMPOSE EX_INI EX_CTR EX_DBX     # detection (1/"" ; EX_CTR=state)
declare -A EXD_PATH          # "box:label" → parsed host path from old files
declare -A EXD_PORT EXD_AS EXD_MODE EXD_LANE   # parsed defaults
declare -A SESSION_STATE     # box → ACTIVE|STOPPED (what this run did)
SELECTED=()                  # chosen boxes, canonical order
CONFIGURE=()                 # SELECTED minus keeps (definitions (re)generated)
KEEP=()                      # kept boxes (untouched files; ladder still offered)
HF_CACHE=""
COMPUTE_CACHE=""             # shared MIOpen/Triton/torch/vLLM kernel cache
MODELS_DIR=""                # "" = not configured
EMIT_DIR=""
RUNG="w"                     # w|p|c|a

RUNTIME="" ROOTLESS=0 COMPOSE_CMD="" HAVE_DISTROBOX=0
GROUP_MODE="" GROUP_GIDS=""

# ── Preflight (warn, never block) ────────────────────────────────────────────
preflight() {
  section "Preflight" intro
  say ""
  if command -v podman >/dev/null 2>&1; then
    RUNTIME=podman
    [[ ${EUID:-$(id -u)} -ne 0 ]] && ROOTLESS=1
    pf_ok "podman found ($([[ $ROOTLESS -eq 1 ]] && echo rootless || echo rootful))"
  elif command -v docker >/dev/null 2>&1; then
    RUNTIME=docker
    pf_ok "docker found (podman not present)"
  else
    pf_bad "neither podman nor docker found — definitions will still be written"
  fi
  if [[ -e /dev/kfd && -e /dev/dri ]]; then
    pf_ok "GPU devices present: /dev/kfd /dev/dri"
  else
    pf_bad "GPU devices missing (/dev/kfd, /dev/dri) — fine on a non-GPU host"
  fi
  local g missing=""
  for g in render video; do
    id -nG 2>/dev/null | tr ' ' '\n' | grep -qx "$g" || missing="$missing,$g"
  done
  missing=${missing#,}
  if [[ -n $missing ]]; then
    pf_bad "not in group(s) $missing (fix: sudo usermod -aG $missing \$USER; re-login)"
  else
    pf_ok "user is in the render + video groups"
  fi
  if [[ -e /dev/fuse ]]; then
    pf_ok "/dev/fuse present (fuse-overlayfs fallback available)"
  else
    pf_bad "/dev/fuse missing — fuse-overlayfs fallback unavailable"
  fi
  if [[ -n $RUNTIME ]] && "$RUNTIME" compose version >/dev/null 2>&1; then
    COMPOSE_CMD="$RUNTIME compose"
    pf_ok "compose provider: $COMPOSE_CMD"
  elif command -v podman-compose >/dev/null 2>&1; then
    COMPOSE_CMD="podman-compose"
    pf_ok "compose provider: podman-compose"
  else
    pf_bad "no compose provider — compose files written anyway; plain $RUNTIME used"
  fi
  # python3 renders the pull progress bar (it aggregates the REST API's
  # per-layer byte counts); without it an image pull has no way to report.
  if command -v python3 >/dev/null 2>&1; then
    pf_ok "python3 found (image-pull progress)"
  else
    pf_bad "python3 not found — image pulls will fail (definitions still written)"
  fi
  command -v distrobox >/dev/null 2>&1 && HAVE_DISTROBOX=1
  [[ $HAVE_DISTROBOX -eq 0 ]] && pf_bad "distrobox not found (needed for the distrobox lane)"
  # group_add strategy: rootless podman must use keep-groups (numeric GIDs get
  # remapped away by the userns); rootful/docker take real GIDs.
  # VERIFY-AT-USE: podman-compose is expected to pass group_add keep-groups
  # through unmodified (plain `podman create` fallback definitely honors it).
  if [[ $RUNTIME == podman && $ROOTLESS -eq 1 ]]; then
    GROUP_MODE="keep-groups"
  else
    GROUP_MODE="gids"
    local gid
    for g in render video; do
      gid=$(getent group "$g" 2>/dev/null | cut -d: -f3) || gid=""
      [[ -n $gid ]] && GROUP_GIDS="$GROUP_GIDS $gid"
    done
    GROUP_GIDS=${GROUP_GIDS# }
    [[ -z $GROUP_GIDS ]] && pf_bad "render/video groups not found; edit group_add later"
  fi
  return 0
}

# ── Existing-setup detection + parsing (re-run safety) ───────────────────────
# Names mirror the image stem (droste-<box>-halo) plus a lane suffix so BOTH
# lanes of one box coexist without colliding — only the CONTAINER NAME differs
# between lanes; the /opt/data host path (PATHS[box:data]) is SHARED by both.
server_name() { printf 'droste-%s-halo-server' "$1"; }
dbox_name()   { printf 'droste-%s-halo-box' "$1"; }
# FILE names are deliberately SHORTER than the container names they describe:
# the emit dir is a user-facing directory, so the redundant "droste-" prefix is
# dropped and the lane words abbreviated (server→srv, box→dbox, compose→cmp).
# Container names are unchanged — only the on-disk records were renamed.
compose_file() { printf '%s/%s-halo-srv.cmp.yaml' "$EMIT_DIR" "$1"; }
ini_file()     { printf '%s/%s-halo-dbox.ini' "$EMIT_DIR" "$1"; }

dest_to_label() {  # box dest → label ("" if unknown)
  local box=$1 dest=$2 pair
  case "$dest" in
    /opt/data) printf 'data'; return 0 ;;
    /opt/models) printf 'models'; return 0 ;;
    /opt/caches) printf 'caches'; return 0 ;;
    */.cache/huggingface) printf 'hf'; return 0 ;;
  esac
  for pair in ${BOX_EXTRA_BINDS[$box]}; do
    if [[ ${pair#*:} == "$dest" ]]; then printf '%s' "${pair%%:*}"; return 0; fi
  done
  printf ''
}

parse_existing_compose() {  # box
  local box=$1 f line src dest label
  f=$(compose_file "$box")
  [[ -f $f ]] || return 0
  while IFS= read -r line; do
    if [[ $line =~ ^[[:space:]]*-[[:space:]]+(/[^:]+):(/[^:\"]+)(:ro)?$ ]]; then
      src=${BASH_REMATCH[1]} dest=${BASH_REMATCH[2]}
      label=$(dest_to_label "$box" "$dest")
      [[ -n $label ]] && EXD_PATH["$box:$label"]=$src
    elif [[ $line =~ ^[[:space:]]*-[[:space:]]+\"?([0-9]+): ]]; then
      EXD_PORT[$box]=${BASH_REMATCH[1]}
    elif [[ $line =~ DROSTE_OVERLAY_MODE=([a-z]+) ]]; then
      EXD_MODE[$box]=${BASH_REMATCH[1]}
    elif [[ $line =~ ^[[:space:]]*restart: ]]; then
      EXD_AS[$box]=1
    fi
  done < "$f"
  return 0
}

parse_existing_ini() {  # box
  local box=$1 f line vols entry src dest label
  f=$(ini_file "$box")
  [[ -f $f ]] || return 0
  while IFS= read -r line; do
    if [[ $line =~ ^volume=\"(.*)\"$ ]]; then
      vols=${BASH_REMATCH[1]}
      for entry in $vols; do
        src=${entry%%:*}
        dest=${entry#*:}; dest=${dest%%:*}
        src=$(expand_path "$src")
        label=$(dest_to_label "$box" "$dest")
        # Both lanes share the same /opt/data host path → label 'data'.
        [[ -n $label && -z "${EXD_PATH["$box:$label"]:-}" ]] \
          && EXD_PATH["$box:$label"]=$src
      done
    elif [[ $line =~ DROSTE_OVERLAY_MODE=([a-z]+) ]]; then
      # additional_flags carries --env DROSTE_OVERLAY_MODE=<mode>; a parsed
      # compose file (both-lane box) wins over the ini copy.
      [[ -z "${EXD_MODE[$box]:-}" ]] && EXD_MODE[$box]=${BASH_REMATCH[1]}
    fi
  done < "$f"
  return 0
}

detect_existing() {
  local box any=0 items state
  for box in "${BOXES[@]}"; do
    [[ -f $(compose_file "$box") ]] && EX_COMPOSE[$box]=1
    [[ -f $(ini_file "$box") ]] && EX_INI[$box]=1
    if [[ -n $RUNTIME ]]; then
      state=$("$RUNTIME" ps -a --filter "name=^$(server_name "$box")\$" \
              --format '{{.State}}' 2>/dev/null | head -n1) || state=""
      [[ -n $state ]] && EX_CTR[$box]=$state
    fi
    if [[ $HAVE_DISTROBOX -eq 1 ]]; then
      distrobox list --no-color 2>/dev/null | \
        awk -F'|' '{gsub(/ /,"",$2); print $2}' | \
        grep -qx "$(dbox_name "$box")" && EX_DBX[$box]=1 || true
    fi
    parse_existing_compose "$box"
    parse_existing_ini "$box"
    if [[ -n "${EX_COMPOSE[$box]:-}${EX_INI[$box]:-}" ]]; then
      if [[ -n "${EX_COMPOSE[$box]:-}" && -n "${EX_INI[$box]:-}" ]]; then
        EXD_LANE[$box]=both
      elif [[ -n "${EX_COMPOSE[$box]:-}" ]]; then
        EXD_LANE[$box]=server
      else
        EXD_LANE[$box]=distrobox
      fi
    fi
  done
  for box in "${BOXES[@]}"; do
    [[ -n "${EX_COMPOSE[$box]:-}${EX_INI[$box]:-}${EX_CTR[$box]:-}${EX_DBX[$box]:-}" ]] \
      && any=1
  done
  if [[ $any -eq 1 ]]; then
    section "Existing setup detected"
    say ""
    for box in "${BOXES[@]}"; do
      items=""
      [[ -n "${EX_COMPOSE[$box]:-}" ]] && items="$items compose-file"
      [[ -n "${EX_INI[$box]:-}" ]] && items="$items ini-file"
      [[ -n "${EX_CTR[$box]:-}" ]] && items="$items container(${EX_CTR[$box]})"
      [[ -n "${EX_DBX[$box]:-}" ]] && items="$items distrobox"
      [[ -n $items ]] && say "  $box:$items"
    done
    printf '%sExisting boxes are never clobbered — you will choose keep/recreate/modify.%s\n' \
      "$C_TEXT" "$RESET"
  fi
  return 0
}

box_exists() {  # box → 0 if any trace exists
  local box=$1
  [[ -n "${EX_COMPOSE[$box]:-}${EX_INI[$box]:-}${EX_CTR[$box]:-}${EX_DBX[$box]:-}" ]]
}

# ── Box selection ────────────────────────────────────────────────────────────
select_boxes() {
  local box tok idx pick
  declare -A want=()
  if [[ ${#ARG_BOXES[@]} -gt 0 ]]; then
    for tok in "${ARG_BOXES[@]}"; do
      [[ -n "${BOX_PORT[$tok]:-}" ]] || die "unknown box: $tok"
      want[$tok]=1
    done
  else
    section "Select Boxes"
    say ""
    # Columns land at 2 / 8 / 21 / 35 / 72 (see the display spec).
    printf '  %s %-5s%-13s%-14s%-37s%-5s%s\n' \
      "$C_SUB" "#" "Container" "Service" "Description" "Port" "$RESET"
    idx=1
    for box in "${BOXES[@]}"; do
      printf '  %s[%s%d%s]%s   %-13s%-14s%-37s%s%s\n' \
        "$C_TBRK" "$C_TIDX" "$idx" "$C_TBRK" "$C_TEXT" \
        "$box" "${BOX_SERVICE[$box]}" "${BOX_DESC[$box]}" "${BOX_HOST_PORT[$box]}" "$RESET"
      idx=$((idx+1))
    done
    printf '  %s[%s%s%s]%s %s%s%s\n' \
      "$C_ALLB" "$C_ALL" "all" "$C_ALLB" "$C_TEXT" "$C_ALLT" "all of these" "$RESET"
    say ""
    while :; do
      ask_raw "Which box(es)? (names or numbers, space-separated) $(dflt all): "
      [[ -z $ANS ]] && ANS=all
      want=()
      local ok=1
      for tok in $ANS; do
        case "$tok" in
          all|6) for box in "${BOXES[@]}"; do want[$box]=1; done ;;
          [1-5]) pick=${BOXES[$((tok-1))]}; want[$pick]=1 ;;
          *) if [[ -n "${BOX_PORT[$tok]:-}" ]]; then want[$tok]=1
             else say "  Unknown box: $tok"; ok=0; fi ;;
        esac
      done
      [[ $ok -eq 1 && ${#want[@]} -gt 0 ]] && break
    done
  fi
  SELECTED=()
  for box in "${BOXES[@]}"; do
    [[ -n "${want[$box]:-}" ]] && SELECTED+=("$box")
  done
  return 0
}

# For each selected box that already exists: keep / recreate / modify.
# CONFIGURE = boxes whose definitions are (re)generated (new/recreate/modify).
# KEEP      = boxes left untouched, but STILL offered the build ladder so a
#             prior "write only" run can later pull/create/start them.
resolve_actions() {
  local box letters="Krm"
  CONFIGURE=()
  KEEP=()
  for box in "${SELECTED[@]}"; do
    if box_exists "$box"; then
      say ""
      printf '%sdroste-%s-halo already exists.%s\n' "$C_TEXT" "$box" "$RESET"
      opt_row K "eep as-is (do not rewrite definitions)" "" 0 "$(isdef K "$letters")"
      opt_row r "ecreate (fresh defaults; old container replaced at create step)" "" 0 "$(isdef r "$letters")"
      opt_row m "odify (re-ask questions, defaulting to the current values)" "" 0 "$(isdef m "$letters")"
      ask_choice "[K/r/m]" "$letters"
      case "$ANS_CH" in
        k) ACTION[$box]=keep; KEEP+=("$box") ;;
        r) ACTION[$box]=recreate; CONFIGURE+=("$box") ;;
        m) ACTION[$box]=modify;   CONFIGURE+=("$box") ;;
      esac
    else
      ACTION[$box]=new
      CONFIGURE+=("$box")
    fi
  done
  return 0
}

# Populate a kept box's CFG_*/PATHS from its parsed existing files so the build
# ladder (pull/create/start) and the dashboard/notes work without re-asking.
hydrate_keep() {  # box
  local box=$1 pair label
  CFG_LANE[$box]=${EXD_LANE[$box]:-both}
  CFG_PORT[$box]=${EXD_PORT[$box]:-${BOX_HOST_PORT[$box]}}
  CFG_AS[$box]=${EXD_AS[$box]:-}
  CFG_MODE[$box]=${EXD_MODE[$box]:-}
  CFG_FS[$box]=${CFG_FS[$box]:-?}
  [[ -n "${EXD_PATH["$box:data"]:-}" ]] && PATHS["$box:data"]=${EXD_PATH["$box:data"]}
  for pair in ${BOX_EXTRA_BINDS[$box]}; do
    label=${pair%%:*}
    [[ -n "${EXD_PATH["$box:$label"]:-}" ]] && PATHS["$box:$label"]=${EXD_PATH["$box:$label"]}
  done
  # Shared dirs (needed only for the no-compose-provider plain-create fallback).
  [[ -z $HF_CACHE      && -n "${EXD_PATH["$box:hf"]:-}" ]]     && HF_CACHE=${EXD_PATH["$box:hf"]}
  [[ -z $COMPUTE_CACHE && -n "${EXD_PATH["$box:caches"]:-}" ]] && COMPUTE_CACHE=${EXD_PATH["$box:caches"]}
  [[ -z $MODELS_DIR    && -n "${EXD_PATH["$box:models"]:-}" ]] && MODELS_DIR=${EXD_PATH["$box:models"]}
  return 0
}

# ── Shared questions ─────────────────────────────────────────────────────────
shared_questions() {
  section "Shared Storage"
  sub "Please provide paths for caches, models, & other data shared across boxes."
  local def=$HOME/.cache/huggingface box
  for box in "${BOXES[@]}"; do    # seed default from an existing setup
    if [[ -n "${EXD_PATH["$box:hf"]:-}" ]]; then
      def=${EXD_PATH["$box:hf"]}
      break
    fi
  done
  ask_path_as "HuggingFace cache (models)" "$def"
  HF_CACHE=$ANS_PATH
  def=$HOME/droste/caches
  for box in "${BOXES[@]}"; do
    if [[ -n "${EXD_PATH["$box:caches"]:-}" ]]; then
      def=${EXD_PATH["$box:caches"]}
      break
    fi
  done
  ask_path_as "Compute cache (MIOpen/Triton/torch/vLLM kernels)" "$def"
  COMPUTE_CACHE=$ANS_PATH
  # Same y/N semantics as ask_yn (default N); inline only so the "?" renders
  # after the [y/N] bracket per the display spec.
  while :; do
    ask_raw "Bind read-only local model collection at /opt/models (optional) $(dflt "y/N")? "
    case "$ANS" in
      ""|n|N) ANS_YN=0; break ;;
      y|Y) ANS_YN=1; break ;;
    esac
  done
  if [[ $ANS_YN -eq 1 ]]; then
    def=$HOME/models
    for box in "${BOXES[@]}"; do
      if [[ -n "${EXD_PATH["$box:models"]:-}" ]]; then
        def=${EXD_PATH["$box:models"]}
        break
      fi
    done
    ask_path_as "Path for local model collections" "$def"
    MODELS_DIR=$ANS_PATH
  fi
  return 0
}

# ── Filesystem probe + overlay mitigation (the ecryptfs lesson) ──────────────
FSTYPE=""
probe_fstype() {  # dir → FSTYPE
  local d=$1
  if [[ -n "${DROSTE_SETUP_FSTYPE:-}" ]]; then
    FSTYPE=$DROSTE_SETUP_FSTYPE
    return 0
  fi
  while [[ ! -e $d && $d != / ]]; do d=$(dirname "$d"); done
  FSTYPE=$(findmnt -n -o FSTYPE --target "$d" 2>/dev/null) \
    || FSTYPE=$(stat -f -c %T "$d" 2>/dev/null) || FSTYPE=unknown
  [[ -z $FSTYPE ]] && FSTYPE=unknown
  return 0
}

MIT_ALL=""        # ""=unset, else fuse|copy|ignore applied to all later paths
MIT_ASKED=0

fs_mitigation_menu() {  # box dir fstype → ANS_CH in {f,c,i,n}
  local box=$1 dir=$2 fstype=$3 letters="Fcni"
  : "$fstype"   # probed type kept in the signature (no longer shown inline)
  say ""
  # Fixed three-line wording (not wrap, so the phrasing stays exact); only the
  # first line grows with the path.
  say "  The filesystem for $(home_disp "$dir") is incompatible with droste's"
  say "  default tool, Linux's overlayfs. Note: if ignored, filesystem must be"
  say "  changed before containers can load."
  say ""
  printf '  %s%s%s\n' "$C_SUB" \
    "Review the following and select a mechanism to address the incompatibility." "$RESET"
  opt_row F "use overlay fallback" \
    "(userspace; app files ~30% slower; models OK)" 28 "$(isdef F "$letters")"
  opt_row c "opies files as fallback" \
    "(no overlay; more storage: ~${BOX_COPY_GB[$box]} GB for $box)" 28 "$(isdef c "$letters")"
  opt_row n "ew path" "(most efficient)" 28 "$(isdef n "$letters")"
  opt_row i "gnore" "(\"ostrich solution\"; box will fail on start)" 28 "$(isdef i "$letters")"
  say ""
  ask_choice "Identify how to proceed [F/c/n/i]" "$letters"
  return 0
}

# ── Pattern propagation for the path family ──────────────────────────────────
PATTERN_ROOT=""      # user-approved root for auto-filled paths
PATTERN_ASKED=0
DEFAULT_ROOT=""      # emit dir (default ~/droste)

path_default() {  # box label → default path (existing > pattern > root)
  local box=$1 label=$2
  if [[ ${ACTION[$box]} == modify && -n "${EXD_PATH["$box:$label"]:-}" ]]; then
    printf '%s' "${EXD_PATH["$box:$label"]}"
  elif [[ -n $PATTERN_ROOT ]]; then
    printf '%s/%s/%s' "$PATTERN_ROOT" "$box" "$label"
  else
    printf '%s/%s/%s' "$DEFAULT_ROOT" "$box" "$label"
  fi
}

maybe_offer_pattern() {  # box label answered-path
  local box=$1 label=$2 got=$3 root example
  [[ $PATTERN_ASKED -eq 1 ]] && return 0
  [[ ${ACTION[$box]} == modify ]] && return 0
  PATTERN_ASKED=1
  [[ $got == "$DEFAULT_ROOT/$box/$label" ]] && return 0
  if [[ $got == */"$box"/"$label" ]]; then
    root=${got%/"$box"/"$label"}
  elif [[ $got == */"$label" ]]; then
    root=${got%/"$label"}
    root=$(dirname "$root")
  else
    root=$(dirname "$got")
  fi
  [[ -z $root || $root == / ]] && return 0
  example="$root/comfyui/input"
  say "  Apply this pattern to all shared resource bindings"
  ask_yn "(e.g. $(home_disp "$example"))?" Y
  [[ $ANS_YN -eq 1 ]] && PATTERN_ROOT=$root
  return 0
}

# Ask (or pattern-fill) one bind path for a box; sets PATHS[box:label].
ask_bind_path() {  # box label dest prose
  local box=$1 label=$2 dest=$3 prose=$4 def
  : "$prose" "$dest"   # kept for call-site compatibility; the prompt derives both
  def=$(path_default "$box" "$label")
  if [[ -n $PATTERN_ROOT && ${ACTION[$box]} != modify && $PATTERN_ASKED -eq 1 ]]; then
    PATHS["$box:$label"]=$def
    mkdir -p "$def" 2>/dev/null || warn "could not create $def"
    say "  $box $label: $(home_disp "$def") (pattern)"
  else
    # No per-bind header: the prompt itself names the box + bind family.
    ask_path_as "Path for ${BOX_NAME[$box]} ${BIND_TITLE[$label],,}" "$def"
    PATHS["$box:$label"]=$ANS_PATH
    maybe_offer_pattern "$box" "$label" "$ANS_PATH"
  fi
  return 0
}

# Data dir + fs probe + mitigation loop; sets PATHS[box:data] CFG_MODE CFG_FS.
choose_data_dir() {  # box
  local box=$1 def dir
  while :; do
    ask_bind_path "$box" data /opt/data "the data dir"
    dir=${PATHS["$box:data"]}
    probe_fstype "$dir"
    CFG_FS[$box]=$FSTYPE
    if ! overlay_hostile_fs "$FSTYPE"; then
      CFG_MODE[$box]=""
      break
    fi
    # Both lanes build the same overlays on /opt/data (the init hook runs
    # the resolver in-box), so distrobox-only boxes get the same menu.
    if [[ -n $MIT_ALL ]]; then
      CFG_MODE[$box]=$MIT_ALL
      subnote "${C_SUBJ}$FSTYPE detected${C_TEXT} — applying earlier choice ($MIT_ALL)."
      break
    fi
    # Modify with the same path: keep the recorded mitigation (re-prompts
    # default to current values); a changed path gets the full menu.
    if [[ ${ACTION[$box]} == modify && -n "${EXD_MODE[$box]:-}" \
          && $dir == "${EXD_PATH["$box:data"]:-}" ]]; then
      CFG_MODE[$box]=${EXD_MODE[$box]}
      subnote "${C_SUBJ}$FSTYPE detected${C_TEXT} — keeping the existing choice (DROSTE_OVERLAY_MODE=${EXD_MODE[$box]})."
      break
    fi
    fs_mitigation_menu "$box" "$dir" "$FSTYPE"
    case "$ANS_CH" in
      f) CFG_MODE[$box]=fuse ;;
      c) CFG_MODE[$box]=copy ;;
      i) CFG_MODE[$box]=ignore ;;
      n) PATTERN_ROOT=""; continue ;;   # re-ask this path explicitly
    esac
    if [[ $MIT_ASKED -eq 0 ]]; then
      MIT_ASKED=1
      ask_yn "Apply this decision to all paths?" Y
      [[ $ANS_YN -eq 1 ]] && MIT_ALL=${CFG_MODE[$box]}
    fi
    break
  done
  return 0
}

# ── Per-box configuration ────────────────────────────────────────────────────
LANE_ALL=""      # propagated lane
AS_ALL=""        # propagated autostart (only meaningful with a server lane)
LANE_ASKED=0

configure_box() {  # box remaining-after-this (count)
  local box=$1 remaining=$2 pair label dest lane_def lane_letters lane_hint
  banner "${BOX_BANNER[$box]}" bold

  # Lane (Db/Sv/both) + AutoStart — propagatable after the first box.
  section "Installation Variant(s)"
  if [[ -n $LANE_ALL && ${ACTION[$box]} != modify ]]; then
    CFG_LANE[$box]=$LANE_ALL
    CFG_AS[$box]=$AS_ALL
    printf '%s  Lane: %s (applied to all boxes)%s\n' "$C_NOTE" "$LANE_ALL" "$RESET"
  else
    # The default lane must be settled BEFORE the options are drawn, so the
    # green option and the capitalised letter in the hint always agree.
    lane_def="b"   # default = BOTH lanes (server + distrobox)
    if [[ ${ACTION[$box]} == modify ]]; then
      case "${EXD_LANE[$box]:-both}" in
        server) lane_def="S" ;;
        distrobox) lane_def="d" ;;
        *) lane_def="b" ;;
      esac
    fi
    # Letters string first char = shown default (validation unchanged); only the
    # displayed [d/s/B] order + capitalization reflects the current default.
    case "$lane_def" in
      S) lane_letters="Sdb"; lane_hint="[d/S/b]" ;;
      d) lane_letters="Dsb"; lane_hint="[D/s/b]" ;;
      *) lane_letters="Bsd"; lane_hint="[d/s/B]" ;;
    esac
    sub "Select the containers to install."
    opt_row d "istrobox" '(interactive $HOME-native toolbox)' 22 "$(isdef D "$lane_letters")"
    opt_row s "erver container" "(podman/docker, runs the service)" 22 "$(isdef S "$lane_letters")"
    opt_row B "oth" "" 0 "$(isdef B "$lane_letters")"
    say ""
    ask_choice "Identify variants to install for ${BOX_NAME[$box]} $lane_hint" "$lane_letters"
    case "$ANS_CH" in
      s) CFG_LANE[$box]=server ;;
      d) CFG_LANE[$box]=distrobox ;;
      b) CFG_LANE[$box]=both ;;
    esac
    CFG_AS[$box]=""
    if [[ ${CFG_LANE[$box]} != distrobox ]]; then
      if [[ ${ACTION[$box]} == modify && -n "${EXD_AS[$box]:-}" ]]; then
        ask_yn_q "Auto-start the $box server at boot" Y
      else
        ask_yn_q "Auto-start the $box server at boot" N
      fi
      [[ $ANS_YN -eq 1 ]] && CFG_AS[$box]=1
    fi
    if [[ $LANE_ASKED -eq 0 && $remaining -gt 0 ]]; then
      LANE_ASKED=1
      ask_yn "Apply this choice to all boxes?" Y
      if [[ $ANS_YN -eq 1 ]]; then
        LANE_ALL=${CFG_LANE[$box]}
        AS_ALL=${CFG_AS[$box]}
      fi
    fi
  fi

  # Data dir (+ fs probe / overlay mitigation), then the other CRITICAL binds.
  # Both lanes share this ONE /opt/data host path (only the container name
  # differs between lanes).
  section "Data Mapping"
  sub "Program data, input, output, etc."
  choose_data_dir "$box"
  for pair in ${BOX_EXTRA_BINDS[$box]}; do
    label=${pair%%:*} dest=${pair#*:}
    case "$label" in
      workspace) ask_bind_path "$box" "$label" "$dest" "the workspace" ;;
      *) ask_bind_path "$box" "$label" "$dest" "the $label dir" ;;
    esac
  done

  # Host port (server lane only).
  if [[ ${CFG_LANE[$box]} != distrobox ]]; then
    local pdef=${BOX_HOST_PORT[$box]}
    [[ ${ACTION[$box]} == modify && -n "${EXD_PORT[$box]:-}" ]] \
      && pdef=${EXD_PORT[$box]}
    ask_port "$box" "$pdef"
    CFG_PORT[$box]=$ANS_PORT
  else
    CFG_PORT[$box]=""
  fi
  return 0
}

# ── Build ladder ─────────────────────────────────────────────────────────────
ask_ladder() {
  local letters="Awpc"
  section "Build & Activation"
  sub "Options for records & startup"
  opt_row w "" "Write definition(s) only (compose & ini)" 4 "$(isdef w "$letters")"
  opt_row p "" "Pull image(s) & write definition(s)" 4 "$(isdef p "$letters")"
  opt_row c "" "Pull, write, & create box(es)" 4 "$(isdef c "$letters")"
  opt_row A "" "All of the above, and start server(s)" 4 "$(isdef A "$letters")"
  say ""
  ask_choice "Select box preparation option [w/p/c/A]" "$letters"
  RUNG=$ANS_CH
  return 0
}

# ── Emitters ─────────────────────────────────────────────────────────────────
emit_compose() {  # box → writes <box>-halo-srv.cmp.yaml
  local box=$1 f base pair label dest
  f=$(compose_file "$box")
  base=$(basename "$f")     # resolved OUTSIDE the redirect (it names the file)
  {
    printf '# %s — generated by droste-setup on %s\n' "$base" "$(date +%F)"
    printf '# Recreate this box any time with:\n'
    printf '#   %s compose -f %s up -d\n' "${RUNTIME:-podman}" "$f"
    printf '# Contract source: targets/%s/build-spec (droste-ai-halo repo).\n' "$box"
    printf 'services:\n'
    printf '  %s:\n' "$box"
    printf '    image: %s%s%s\n' "$IMAGE_PREFIX" "$box" "$IMAGE_SUFFIX"
    printf '    container_name: %s\n' "$(server_name "$box")"
    # PID 1 must be an init, not the server. The entrypoint `exec`s python, and the
    # kernel ignores default signal dispositions for PID 1 — so `podman stop`'s
    # SIGTERM is a no-op, the 10s grace elapses, and the container is always SIGKILLed
    # ("StopSignal SIGTERM failed to stop container ... resorting to SIGKILL",
    # measured 10.55s on hardware 2026-08-08). An init forwards signals, so the server
    # shuts down cleanly and stop returns promptly.
    printf '    init: true\n'
    printf '    ports:\n'
    printf '      - "%s:%s"\n' "${CFG_PORT[$box]}" "${BOX_PORT[$box]}"
    printf '    devices:\n'
    printf '      - /dev/kfd\n'
    printf '      - /dev/dri\n'
    if [[ "${CFG_MODE[$box]:-}" == fuse ]]; then
      printf '      - /dev/fuse   # fuse-overlayfs (overlay-hostile data fs)\n'
    fi
    printf '    cap_add:\n'
    printf '      - SYS_ADMIN   # entrypoint mounts inside the container\n'
    printf '    group_add:\n'
    if [[ $GROUP_MODE == keep-groups ]]; then
      printf '      - keep-groups   # rootless podman: carry render/video groups\n'
    else
      local gid
      if [[ -n $GROUP_GIDS ]]; then
        for gid in $GROUP_GIDS; do
          printf '      - "%s"\n' "$gid"
        done
      else
        printf '      # - "<render-gid>"   # getent group render/video failed\n'
      fi
    fi
    printf '    volumes:\n'
    printf '      - %s:/opt/data\n' "${PATHS["$box:data"]}"
    for pair in ${BOX_EXTRA_BINDS[$box]}; do
      label=${pair%%:*} dest=${pair#*:}
      printf '      - %s:%s\n' "${PATHS["$box:$label"]}" "$dest"
    done
    printf '      - %s:/root/.cache/huggingface\n' "$HF_CACHE"
    printf '      # shared compute cache (MIOpen/Triton/torch/vLLM kernels):\n'
    printf '      - %s:/opt/caches\n' "$COMPUTE_CACHE"
    if [[ ${BOX_HAS_MODELS[$box]} -eq 1 ]]; then
      if [[ -n $MODELS_DIR ]]; then
        # Opted in: the dir was confirmed-or-created at prompt time, so this
        # :ro bind is safe. Native `podman compose` handles it fine (older
        # podman-compose 1.0.6 may emit a non-fatal read-only-mount warning).
        printf '      # read-only local model collection (scanner source #2):\n'
        printf '      - %s:/opt/models:ro\n' "$MODELS_DIR"
      else
        # Not opted in: a :ro bind to a missing dir is fatal — uncomment (and
        # create the dir) to enable a local model collection.
        printf '      # Optional read-only local model collection — uncomment to enable:\n'
        printf '      # - %s:/opt/models:ro\n' "$HOME/models"
      fi
    fi
    case "${CFG_MODE[$box]:-}" in
      fuse|copy)
        printf '    environment:\n'
        printf '      - DROSTE_OVERLAY_MODE=%s\n' "${CFG_MODE[$box]}"
        ;;
    esac
    if [[ -n "${CFG_AS[$box]:-}" ]]; then
      printf '    restart: unless-stopped\n'
    fi
    printf '    # security_opt: ["seccomp=unconfined"]  # uncomment if GPU fails\n'
  } > "$f"
  exec_file "$base"
  return 0
}

emit_ini() {  # box → writes <box>-halo-dbox.ini (distrobox assemble record)
  local box=$1 f base pair label dest vols flags data
  f=$(ini_file "$box")
  base=$(basename "$f")     # resolved OUTSIDE the redirect (it names the file)
  # Same /opt/data host path as the server lane (emit_compose) — shared.
  data=${PATHS["$box:data"]}
  {
    printf '# %s — generated by droste-setup on %s\n' "$base" "$(date +%F)"
    printf '# Create/recreate with:  distrobox assemble create --file %s\n' "$f"
    printf '# Modeled on targets/%s/distrobox.ini (droste-ai-halo repo).\n' "$box"
    printf '# Unified lane: the init hook runs the same resolver as the\n'
    printf '# server lane — overlays, surfaces, and caches are mounted\n'
    printf '# in-box on /opt/data, so in-box installs survive recreation.\n'
    printf '\n'
    printf '[%s]\n' "$(dbox_name "$box")"
    printf 'image=%s%s%s\n' "$IMAGE_PREFIX" "$box" "$IMAGE_SUFFIX"
    printf 'init_hooks="%s"\n' "$INIT_HOOK"
    # additional_flags append to `podman|docker create` (--env is the
    # distrobox docs' own example flag): sys_admin permits the in-box
    # resolver mounts, /dev/fuse enables the fuse-overlayfs fallback,
    # and --env carries the overlay-mitigation mode to the init hook.
    flags="--cap-add sys_admin --device /dev/fuse"
    case "${CFG_MODE[$box]:-}" in
      fuse|copy) flags+=" --env DROSTE_OVERLAY_MODE=${CFG_MODE[$box]}" ;;
    esac
    printf 'additional_flags="%s"\n' "$flags"
    # CRITICAL: distrobox assemble reads only the LAST volume= key, so EVERY
    # bind must live in ONE space-separated volume= value. Accumulate them all
    # here and emit a single line.
    vols="$data:/opt/data"
    for pair in ${BOX_EXTRA_BINDS[$box]}; do
      label=${pair%%:*} dest=${pair#*:}
      vols="$vols ${PATHS["$box:$label"]}:$dest"
    done
    # Shared compute cache (MIOpen/Triton/torch/vLLM kernels) — appended into
    # the same value (remove to keep caches per-box).
    vols="$vols $COMPUTE_CACHE:/opt/caches"
    # A non-default HF cache (outside the auto-bound host home) needs an
    # explicit bind to the in-box expected location — also same value.
    if [[ $HF_CACHE != "$HOME/.cache/huggingface" ]]; then
      vols="$vols $HF_CACHE:$HOME/.cache/huggingface"
    fi
    # Opted-in read-only model collection: the dir was confirmed-or-created at
    # prompt time, so the :ro bind is safe (a bind to a missing dir would be
    # fatal to `distrobox assemble create`). It lands INSIDE the single volume=.
    [[ -n $MODELS_DIR ]] && vols="$vols $MODELS_DIR:/opt/models:ro"
    printf '# Shared compute caches across ALL droste boxes are folded into the\n'
    printf '# single volume= value below (distrobox reads only the LAST volume=).\n'
    printf 'volume="%s"\n' "$vols"
    if [[ ${BOX_HAS_MODELS[$box]} -eq 1 ]]; then
      if [[ -n $MODELS_DIR ]]; then
        printf '# The read-only local model collection (%s -> /opt/models:ro)\n' \
          "$(home_disp "$MODELS_DIR")"
        printf '# is already included in the single volume= value above.\n'
      else
        # Not opted in: a read-only /opt/models bind to a missing dir is fatal to
        # `distrobox assemble create`, so it is not added — enable it by hand.
        printf '# Optional read-only local model collection: to enable, APPEND\n'
        printf '#   %s:/opt/models:ro\n' "$(home_disp "$HOME/models")"
        printf '# (space-separated) INSIDE the single volume= value above — do NOT add a\n'
        printf '# second volume= line (distrobox reads only the LAST, dropping the rest).\n'
      fi
    fi
  } > "$f"
  exec_file "$base"
  return 0
}

# ── Executing-section output ─────────────────────────────────────────────────
# Every line the Executing section prints comes from one of these four helpers,
# and NOTHING a tool writes reaches the screen: podman's and distrobox's own
# chatter is captured to a log (see step_log) and only its tail is shown, and
# only on failure. The section is the one place the installer speaks while
# something slow is happening, so it stays a fixed, readable shape.

# Underlined bright-white group header; the blank line above it is part of it.
exec_hdr() { printf '\n  %s%s%s\n' "$C_EXH" "$1" "$RESET"; }

# One emitted file name, italic light grey.
exec_file() { printf '  %s%s%s\n' "$C_FILE" "$1" "$RESET"; }

# Width of the name column in [OK]/[ERROR] status lines: the longest name in
# the group plus the mockup's five-space gap, clamped so the tag still lands
# inside the terminal (a name longer than that simply pushes the tag right).
STATUS_W=0
status_width() {   # name...
  local n max=0 w avail
  for n in "$@"; do [[ ${#n} -gt $max ]] && max=${#n}; done
  w=$(( max + 5 ))
  avail=$(( $(term_width) - 2 - 7 ))    # indent + "[ERROR]"
  [[ $w -gt $avail ]] && w=$avail
  [[ $w -lt 1 ]] && w=1
  STATUS_W=$w
  return 0
}

# The two status lines. Both open with CR + close with erase-to-EOL so a line
# can overwrite a progress bar of any width (both are empty in --plain, where
# no bar was ever drawn).
status_ok() {   # name
  printf '%s  %s%-*s%s%s[%s%s%s]%s%s\n' \
    "$CR" "$C_TEXT" "$STATUS_W" "$1" "$RESET" \
    "$C_OKB" "$C_OK" "OK" "$C_OKB" "$RESET" "$EL"
}

# Failure: the tag, then the LAST THREE captured lines (enough to name the
# cause), then where the whole capture lives. Raw tool output is never streamed.
status_err() {   # name log-path
  local name=$1 log=$2 line
  printf '%s  %s%-*s%s%s[%s%s%s]%s%s\n' \
    "$CR" "$C_TEXT" "$STATUS_W" "$name" "$RESET" \
    "$C_BADB" "$C_ERR" "ERROR" "$C_BADB" "$RESET" "$EL"
  while IFS= read -r line; do
    [[ -z $line ]] && continue
    printf '    %s%s%s\n' "$C_TEXT" "$line" "$RESET"
  done < <(tail -n 3 "$log" 2>/dev/null)
  printf '  %sfull log: %s%s\n' "$C_FILE" "$(home_disp "$log")" "$RESET"
  return 0
}

# Per-step capture file under the resource path (whose stated purpose is
# "(re)creation records, logs, & data"). Falls back to the temp dir if that
# directory cannot be made, so a failed pull still has somewhere to say why.
step_log() {   # step name → path
  local d=$EMIT_DIR/logs
  mkdir -p "$d" 2>/dev/null || d=${TMPDIR:-/tmp}
  printf '%s/%s-%s.log' "$d" "$1" "$2"
}

# ── Image pull: podman REST API + one aggregated progress bar ────────────────
# `podman pull` draws its per-layer bars only on a tty, so ANY capture or filter
# of the CLI destroys exactly the progress that matters on multi-GB ROCm layers
# (and the old `grep -Ev 'skipped: already exists'` filter matched the tty
# wording, which is not what a piped pull emits — so it dropped nothing while
# silencing everything). The API reports byte counts regardless of tty: bring up
# a transient service, POST the Docker-compat /images/create, and aggregate the
# JSON stream into ONE line per image.
PULL_SOCK=""
PULL_SVC_PID=""

pull_service_stop() {
  [[ -n $PULL_SVC_PID ]] && kill "$PULL_SVC_PID" 2>/dev/null
  [[ -n $PULL_SOCK ]] && rm -f "$PULL_SOCK" 2>/dev/null
  PULL_SVC_PID="" PULL_SOCK=""
  return 0
}

# Unique socket per run, in the runtime dir (never /tmp when we can help it).
pull_service_start() {   # log → 0 once the socket is live
  local log=$1 i
  PULL_SOCK=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/droste-pull-$$.sock
  rm -f "$PULL_SOCK" 2>/dev/null || :
  "${RUNTIME:-podman}" system service --time=0 "unix://$PULL_SOCK" >>"$log" 2>&1 &
  PULL_SVC_PID=$!
  trap pull_service_stop EXIT
  for (( i = 0; i < 100; i = i + 1 )); do
    [[ -S $PULL_SOCK ]] && return 0
    # A service that died says so above this line, in its own words.
    if ! kill -0 "$PULL_SVC_PID" 2>/dev/null; then
      printf 'the API service exited before creating %s\n' "$PULL_SOCK" >>"$log"
      pull_service_stop
      return 1
    fi
    sleep 0.1
  done
  printf 'no API socket at %s after 10s\n' "$PULL_SOCK" >>"$log"
  pull_service_stop
  return 1
}

# The aggregator. Reads the /images/create JSON stream on stdin, sums every
# layer's progressDetail, and repaints ONE line; cached ("Already exists")
# layers count as complete and print nothing of their own. It leaves the cursor
# on that line WITHOUT a newline — the caller's status line overwrites it.
_pull_progress_py() {
  cat <<'PY'
import json, sys, time

label, width, fill, empty, plain = sys.argv[1:6]
width = int(width)
quiet = plain == "1"
out = sys.stdout

layers = {}                                    # id -> [current, total]
state = {"seen": False, "last": 0.0, "extract": set()}
dec = json.JSONDecoder()


def sizes(cur, tot):
    for unit, div in (("GB", 1 << 30), ("MB", 1 << 20)):
        if tot >= div:
            return "%.1f/%.1f %s" % (cur / float(div), tot / float(div), unit)
    return "%.0f/%.0f KB" % (cur / 1024.0, tot / 1024.0)


def paint(final=False):
    if quiet:
        return
    now = time.time()
    if not final and now - state["last"] < 0.1:
        return
    state["last"] = now
    cur = sum(v[0] for v in layers.values())
    tot = sum(v[1] for v in layers.values())
    if final:
        pct = 100
    elif tot:
        pct = min(100, int(cur * 100 // tot))
    else:
        pct = 0
    if state["extract"] and (not tot or cur >= tot):
        tail = "  %3d%%  extracting" % pct
    elif tot:
        tail = "  %3d%%  %s" % (pct, sizes(cur, tot))
    else:
        tail = "  %3d%%" % pct           # every layer cached: no bytes to count
    # The tail is padded to a fixed width so the bar cannot change length
    # mid-download (the size text grows by a digit as it climbs).
    tail = tail.ljust(20)
    room = width - 4 - len(label) - len(tail)
    if room >= 8:
        n = min(room, 40)
        done = n * pct // 100
        line = "  %s  %s%s" % (label, fill * done + empty * (n - done), tail)
    else:
        line = "  %s%s" % (label, tail)
    out.write("\r" + line + "\x1b[K")
    out.flush()


def handle(o):
    state["seen"] = True
    if o.get("error") or o.get("errorDetail"):
        msg = o.get("error") or (o.get("errorDetail") or {}).get("message")
        sys.stderr.write("pull API: %s\n" % (msg or "unknown error"))
        sys.exit(1)
    st = o.get("status") or ""
    lid = o.get("id") or ""
    if not lid:
        return
    pd = o.get("progressDetail") or {}
    if st.startswith("Already exists"):
        layers.setdefault(lid, [0, 0])
    elif st.startswith("Downloading"):
        layers[lid] = [int(pd.get("current") or 0), int(pd.get("total") or 0)]
    elif st.startswith("Download complete") or st.startswith("Pull complete"):
        if lid in layers:
            layers[lid][0] = layers[lid][1]
        state["extract"].discard(lid)
    elif st.startswith("Extracting"):
        state["extract"].add(lid)
    paint()


buf = ""
for chunk in sys.stdin:
    buf += chunk
    while True:
        buf = buf.lstrip()
        if not buf:
            break
        try:
            obj, idx = dec.raw_decode(buf)
        except ValueError:
            break
        buf = buf[idx:]
        handle(obj)

if not state["seen"]:
    sys.stderr.write("pull API: no progress stream received\n")
    sys.exit(1)
paint(final=True)
PY
}

pull_image() {   # box → 0 on success (draws the bar; caller draws the status)
  local box=$1 img repo tag log rc=0
  img="${IMAGE_PREFIX}${box}${IMAGE_SUFFIX}"
  repo=${img%:*} tag=${img##*:}
  log=$(step_log pull "$box")
  : > "$log"
  curl -fsS --unix-socket "$PULL_SOCK" -X POST \
       "http://d/v1.40/images/create?fromImage=$repo&tag=$tag" 2>>"$log" \
    | python3 -c "$(_pull_progress_py)" \
        "$img..." "$(term_width)" "$BAR_F" "$BAR_E" "$PLAIN" 2>>"$log" \
    || rc=$?
  return $rc
}

# ── Execution (the ladder rungs) ─────────────────────────────────────────────
plain_create_args() {  # box → prints podman/docker create args (one per line)
  local box=$1 pair label dest gid
  printf -- '--name\n%s\n' "$(server_name "$box")"
  # Run an init as PID 1 — the entrypoint `exec`s python, and PID 1 ignores default
  # signal dispositions, so without this `podman stop` always falls through to SIGKILL
  # after the grace period (compose emitter sets `init: true` for the same reason).
  printf -- '--init\n'
  printf -- '-p\n%s:%s\n' "${CFG_PORT[$box]}" "${BOX_PORT[$box]}"
  printf -- '--device\n/dev/kfd\n--device\n/dev/dri\n'
  [[ "${CFG_MODE[$box]:-}" == fuse ]] && printf -- '--device\n/dev/fuse\n'
  printf -- '--cap-add\nsys_admin\n'
  if [[ $GROUP_MODE == keep-groups ]]; then
    printf -- '--group-add\nkeep-groups\n'
  else
    for gid in $GROUP_GIDS; do printf -- '--group-add\n%s\n' "$gid"; done
  fi
  printf -- '-v\n%s:/opt/data\n' "${PATHS["$box:data"]}"
  for pair in ${BOX_EXTRA_BINDS[$box]}; do
    label=${pair%%:*} dest=${pair#*:}
    printf -- '-v\n%s:%s\n' "${PATHS["$box:$label"]}" "$dest"
  done
  printf -- '-v\n%s:/root/.cache/huggingface\n' "$HF_CACHE"
  printf -- '-v\n%s:/opt/caches\n' "$COMPUTE_CACHE"
  # The optional /opt/models bind is added when opted in (MODELS_DIR set); it is
  # safe because the dir was confirmed-or-created at prompt time (a :ro bind to a
  # missing dir would be fatal). Skipped entirely when not opted in.
  [[ -n $MODELS_DIR && ${BOX_HAS_MODELS[$box]} -eq 1 ]] \
    && printf -- '-v\n%s:/opt/models:ro\n' "$MODELS_DIR"
  case "${CFG_MODE[$box]:-}" in
    fuse|copy) printf -- '-e\nDROSTE_OVERLAY_MODE=%s\n' "${CFG_MODE[$box]}" ;;
  esac
  [[ -n "${CFG_AS[$box]:-}" ]] && printf -- '--restart\nunless-stopped\n'
  printf '%s%s%s\n' "$IMAGE_PREFIX" "$box" "$IMAGE_SUFFIX"
  return 0
}

create_server() {  # box
  local box=$1 f name log args=() rc=0
  name=$(server_name "$box")
  f=$(compose_file "$box")
  log=$(step_log create "$name")
  : > "$log"
  if [[ ${ACTION[$box]:-} == recreate && -n "${EX_CTR[$box]:-}" ]]; then
    "$RUNTIME" rm -f "$name" >>"$log" 2>&1 \
      || printf 'could not remove the old container %s\n' "$name" >>"$log"
  fi
  # Everything the runtime says goes to the log, not the screen: one status
  # line per container is the whole report (the log's tail speaks on failure).
  if [[ -n $COMPOSE_CMD ]]; then
    if [[ $RUNG == a ]]; then
      if $COMPOSE_CMD -f "$f" up -d >>"$log" 2>&1; then
        SESSION_STATE[$box]=ACTIVE
      else
        rc=1
      fi
    elif $COMPOSE_CMD -f "$f" up --no-start >>"$log" 2>&1 \
         || $COMPOSE_CMD -f "$f" create >>"$log" 2>&1; then
      SESSION_STATE[$box]=STOPPED
    else
      rc=1
    fi
  else
    mapfile -t args < <(plain_create_args "$box")
    if "$RUNTIME" create "${args[@]}" >>"$log" 2>&1; then
      SESSION_STATE[$box]=STOPPED
      if [[ $RUNG == a ]] && ! "$RUNTIME" start "$name" >>"$log" 2>&1; then
        rc=1
      elif [[ $RUNG == a ]]; then
        SESSION_STATE[$box]=ACTIVE
      fi
    else
      rc=1
    fi
  fi
  if [[ $rc -eq 0 ]]; then status_ok "$name..."; else status_err "$name..." "$log"; fi
  return 0
}

create_distrobox() {  # box
  local box=$1 name log rc=0
  name=$(dbox_name "$box")
  log=$(step_log create "$name")
  : > "$log"
  if [[ $HAVE_DISTROBOX -eq 0 ]]; then
    printf 'distrobox is not installed, so %s cannot be created\n' "$name" >>"$log"
    printf 'install it (https://distrobox.it) and re-run droste-setup\n' >>"$log"
    status_err "$name..." "$log"
    return 0
  fi
  if [[ ${ACTION[$box]:-} == recreate && -n "${EX_DBX[$box]:-}" ]]; then
    distrobox rm -f "$name" >>"$log" 2>&1 \
      || printf 'could not remove the old distrobox %s\n' "$name" >>"$log"
  fi
  # distrobox narrates its own creation ("Creating '<name>' using image ...",
  # "Distrobox '<name>' successfully created.", "To enter, run:") — three lines
  # per box that say what our one status line already says. The former grep
  # filter matched almost none of them (it wanted a " - Creating" prefix
  # upstream never emitted, and had no pattern at all for "successfully
  # created"), so the whole capture goes to the log instead.
  distrobox assemble create --file "$(ini_file "$box")" >>"$log" 2>&1 || rc=$?
  if [[ $rc -eq 0 ]]; then status_ok "$name..."; else status_err "$name..." "$log"; fi
  return 0
}

execute() {
  local box lane b ladder=() names=() svc_log rc=0
  section "Executing"
  # Ladder acts on (re)configured boxes AND kept boxes (kept = pull/create/
  # start from their existing, un-rewritten definitions), in canonical order.
  for b in "${BOXES[@]}"; do
    for box in "${CONFIGURE[@]}" "${KEEP[@]}"; do
      [[ $box == "$b" ]] && { ladder+=("$b"); break; }
    done
  done
  # Emit definitions ONLY for (re)configured boxes — kept boxes are never
  # rewritten (never-clobber).
  if [[ ${#CONFIGURE[@]} -gt 0 ]]; then
    exec_hdr "Writing Configuration Files"
    for box in "${CONFIGURE[@]}"; do
      lane=${CFG_LANE[$box]}
      [[ $lane != distrobox ]] && emit_compose "$box"
      [[ $lane != server ]] && emit_ini "$box"
    done
  fi
  if [[ $RUNG != w && ${#ladder[@]} -gt 0 ]]; then
    exec_hdr "Pulling Images"
    names=()
    for box in "${ladder[@]}"; do
      names+=("${IMAGE_PREFIX}${box}${IMAGE_SUFFIX}...")
    done
    status_width "${names[@]}"
    svc_log=$(step_log pull service)
    : > "$svc_log"
    # The API service is the pull mechanism, not an optimisation: if it will not
    # start, that is an error like any other (same binary, user, and storage as
    # the CLI), reported once — the per-image lines would all say the same thing.
    if pull_service_start "$svc_log"; then
      for box in "${ladder[@]}"; do
        rc=0
        pull_image "$box" || rc=$?
        if [[ $rc -eq 0 ]]; then
          status_ok "${IMAGE_PREFIX}${box}${IMAGE_SUFFIX}..."
        else
          status_err "${IMAGE_PREFIX}${box}${IMAGE_SUFFIX}..." "$(step_log pull "$box")"
        fi
      done
      pull_service_stop
    else
      status_err "${RUNTIME:-podman} system service..." "$svc_log"
    fi
  fi
  if [[ ( $RUNG == c || $RUNG == a ) && ${#ladder[@]} -gt 0 ]]; then
    exec_hdr "Creating Boxes"
    names=()
    for box in "${ladder[@]}"; do
      lane=${CFG_LANE[$box]}
      [[ $lane != distrobox ]] && names+=("$(server_name "$box")...")
      [[ $lane != server ]] && names+=("$(dbox_name "$box")...")
    done
    status_width "${names[@]}"
    for box in "${ladder[@]}"; do
      lane=${CFG_LANE[$box]}
      [[ $lane != distrobox ]] && create_server "$box"
      [[ $lane != server ]] && create_distrobox "$box"
    done
  fi
  return 0
}

